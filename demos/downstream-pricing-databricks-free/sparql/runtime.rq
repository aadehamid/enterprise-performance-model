# What the last run left: the host and the source databases with their row counts, each Databricks object's rows and
# last refresh, the Genie agents and the views they bind, the orchestrator, and the data-quality checks with their last
# result. SPARQL Anything reads out/tech/live.json, which `tech_graph collect` writes from Postgres and Databricks. The
# terms are the technical-graph module's (EPM-DEC-001-0112, item 4): counts are xsd:decimal, a label is English, and a
# check's result is a value of the module's check-result list.
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>
PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tg:  <https://w3id.org/lsc/ontology/modules/technical-graph/>

CONSTRUCT {
  ?host a tg:Host ; tg:name ?hostName ; rdfs:label ?hostLabel .
  ?db a tg:SourceDatabase ; tg:name ?dbName ; tg:hidden ?hidden ; tg:tables ?tablesCount ; tg:rows ?dbRowsCount ; tg:hostedOn ?host .
  ?obj tg:rows ?rowsCount ; tg:lastRefresh ?refresh .
  <urn:pricing-demo:tech:triples/epm_triples> a tg:Table ; tg:name ?triples .
  ?agent a tg:Agent ; tg:name ?agentTitle ; tg:binds ?bound .
  <urn:pricing-demo:tech:orchestrator> a tg:Orchestrator ; tg:name "Orchestrator (pricing_demo/supervisor.py)" ; tg:routesTo ?agent .
  ?check a tg:QualityCheck ; tg:name ?checkId ; rdfs:label ?label ; tg:result ?resultValue ; tg:detail ?detail ;
         tg:checkedAt ?checkedAt ; tg:checks ?covered .
}
WHERE {
  SERVICE <x-sparql-anything:> {
    fx:properties fx:location "%LIVE%" ; fx:media-type "application/json" .
    ?root a fx:root ; xyz:catalog ?catalog ; xyz:triples ?triples ; xyz:host ?h .
    ?h xyz:name ?hostName ; xyz:kind ?hostKind .
    {
      ?root xyz:databases ?dbs . ?dbs ?i ?d .
      ?d xyz:name ?dbName ; xyz:hidden ?hidden ; xyz:tables ?dbTables ; xyz:rows ?dbRows .
    } UNION {
      ?root xyz:objects ?objs . ?objs ?j ?o .
      ?o xyz:id ?objId ; xyz:rows ?rows ; xyz:last_refresh ?refreshText .
    } UNION {
      ?root xyz:agents ?ags . ?ags ?k ?a .
      ?a xyz:slug ?agentSlug ; xyz:title ?agentTitle ; xyz:views ?views . ?views ?m ?view .
    } UNION {
      ?root xyz:checks ?cks . ?cks ?n ?c .
      ?c xyz:id ?checkId ; xyz:label ?checkLabel ; xyz:result ?result ; xyz:detail ?detail ; xyz:checked_at ?checkedText .
      OPTIONAL { ?c xyz:covers ?cov . ?cov ?p ?coveredId . }
    }
  }
  BIND(STRLANG(?hostKind, "en") AS ?hostLabel)
  BIND(STRDT(STR(?dbTables), xsd:decimal) AS ?tablesCount)
  BIND(STRDT(STR(?dbRows), xsd:decimal) AS ?dbRowsCount)
  BIND(STRDT(STR(?rows), xsd:decimal) AS ?rowsCount)
  BIND(STRLANG(?checkLabel, "en") AS ?label)
  BIND(IRI(CONCAT("https://w3id.org/lsc/ontology/modules/technical-graph/check-result/", ?result)) AS ?resultValue)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:host/", ENCODE_FOR_URI(?hostName))) AS ?host)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:database/", ?dbName)) AS ?db)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:object/", ?objId)) AS ?obj)
  BIND(STRDT(?refreshText, xsd:dateTime) AS ?refresh)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:agent/", ?agentSlug)) AS ?agent)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:object/", ?view)) AS ?bound)
  BIND(IRI(CONCAT("urn:pricing-demo:tech:check/", ?checkId)) AS ?check)
  BIND(STRDT(?checkedText, xsd:dateTime) AS ?checkedAt)
  BIND(IF(STRSTARTS(?coveredId, "database:"), IRI(CONCAT("urn:pricing-demo:tech:database/", STRAFTER(?coveredId, "database:"))),
       IF(?coveredId = "epm_triples", <urn:pricing-demo:tech:triples/epm_triples>,
          IRI(CONCAT("urn:pricing-demo:tech:object/", ?coveredId)))) AS ?covered)
}
