# Run by rdflib over the graph the other queries built (plain SPARQL 1.1, no SPARQL Anything): each step points to the
# next in the README's order, and each node points to the step that makes or fills it (sync fills the tech_graph tables,
# the tables of no layer that a SQL file creates; the triple table has no step here).
PREFIX tg: <https://w3id.org/lsc/ontology/modules/technical-graph/>
PREFIX layer: <https://w3id.org/lsc/ontology/modules/data-product/layer/>

CONSTRUCT {
  ?step tg:next ?following .
  ?made tg:producedBy ?maker .
}
WHERE {
  {
    ?step a tg:PipelineStep ; tg:order ?order .
    ?following a tg:PipelineStep ; tg:order ?nextOrder .
    FILTER(?nextOrder > ?order)
    FILTER NOT EXISTS { ?between a tg:PipelineStep ; tg:order ?o . FILTER(?o > ?order && ?o < ?nextOrder) }
  } UNION {
    VALUES (?class ?maker) {
      (tg:SourceDatabase <urn:pricing-demo:tech:step/load_postgres>)
      (tg:MetricView <urn:pricing-demo:tech:step/databricks-build>)
      (tg:DefinitionsView <urn:pricing-demo:tech:step/databricks-build>)
      (tg:Agent <urn:pricing-demo:tech:step/genie>)
      (tg:Orchestrator <urn:pricing-demo:tech:step/supervisor-ask>)
      (tg:QualityCheck <urn:pricing-demo:tech:step/tech_graph-collect>)
    }
    ?made a ?class .
    ?maker a tg:PipelineStep .
  } UNION {
    VALUES ?layer { layer:replica layer:silver layer:gold }
    ?made a tg:Table ; tg:layer ?layer .
    BIND(<urn:pricing-demo:tech:step/databricks-build> AS ?maker)
    ?maker a tg:PipelineStep .
  } UNION {
    ?made a tg:Table .
    FILTER NOT EXISTS { ?made tg:layer ?any }
    FILTER(STRSTARTS(STR(?made), "urn:pricing-demo:tech:object/"))
    BIND(<urn:pricing-demo:tech:step/tech_graph-sync> AS ?maker)
    ?maker a tg:PipelineStep .
  }
}
