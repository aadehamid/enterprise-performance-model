# Source databases. One Postgres server, one database per source system. Change the host to move them
# (for example to an exe.dev VM); nothing else in the pipeline names the host.
SOURCE_PG_DSN=postgresql://demo:demo@localhost:55432
# Databricks Free Edition. Never commit real values.
DATABRICKS_HOST=https://xxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxx
DEMO_CATALOG=workspace
# The ontology's triple table, for the definitions views; by default epm.env's DATABRICKS_CATALOG.DATABRICKS_SCHEMA.epm_triples.
# EPM_TRIPLES=workspace.epm_ontology.epm_triples
# Parallel Decisions API key, only for refreshing data/parallel/ (the committed cache is enough to run the demo);
# outside.py also reads ~/.config/parallel/api.env.
# PARALLEL_API_KEY=
# EIA Open Data API key, only for refreshing data/public/ (the committed cache is enough to run the demo).
EIA_API_KEY=
