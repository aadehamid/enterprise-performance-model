version: v2
title: The Metadata Journey — KPI Store & Semantic Governance
size: [960, 540]
theme:
  colors:
    text: "#1F2937"
    grey: "#6B7280"
    line: "#D8DEE4"
    green: "#6B9E3F"
    greenLight: "#EAF3E0"
    orange: "#C77F2A"
    orangeLight: "#FBF0DF"
    blue: "#2E6E8E"
    blueLight: "#E6F0F5"
    navy: "#34495E"
    navyLight: "#EAEEF2"
    teal: "#2E8B7A"
    tealLight: "#E3F2EF"
  textStyles:
    h1:
      fontSize: 25
      color: "$text"
      bold: true
    subtitle:
      fontSize: 10
      color: "$grey"
    sectionLabel:
      fontSize: 8
      color: "$grey"
      bold: true
      letterSpacing: 1.5
    cardTitle:
      fontSize: 8.5
      color: "$text"
      bold: true
    micro:
      fontSize: 6.8
      color: "$text"
      lineHeight: 1.3
    sor:
      fontSize: 6.3
      color: "$grey"
      italic: true
      lineHeight: 1.25
    footnote:
      fontSize: 6
      color: "$grey"
      italic: true
      lineHeight: 1.2
pages:
  - pages/1_journey.page
  - pages/2_fieldsets.page
