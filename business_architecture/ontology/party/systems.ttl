    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

src:decision-owner-answers-2026-10-24-systems a dcterms:BibliographicResource ;
    dcterms:title "The decision owner's identifications of systems, Claude Code session of 2026-10-24, business_architecture/ontology/step4/review-evidence/decision-owner-answers/answers-2026-10-24-systems.md"@en .

<https://w3id.org/lsc/ontology/modules/party/system/magic> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:decision-owner-answers-2026-10-24-systems ;
    skos:altLabel "Marketing Applications Graphical Interface for Clients"@en ;
    skos:definition "Marketing Applications Graphical Interface for Clients: an MPC-built integration that sets up new customer accounts. When SAP MDG creates a customer, MAGIC assigns the SAP MDG customer number and the KittyHawk territory manager to the account in Salesforce, and converts the prospect into a customer account. Every day it syncs the customer's number, name, address, FEIN, status, credit monitor and territory manager to Salesforce."@en ;
    skos:exactMatch system:magic ;
    skos:inScheme party:customer-systems ;
    skos:notation "magic" ;
    skos:prefLabel "MAGIC"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "The new customer account integration: it assigns the SAP MDG customer number and the Kittyhawk territory manager to Salesforce, converts the prospect into a customer account, and syncs the customer number, name, address, FEIN, status, credit monitor and territory manager every day."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/salesforce> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/integration> .

<https://w3id.org/lsc/ontology/modules/party/system/terminal-download> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:decision-owner-customer-inputs ;
    skos:altLabel "Terminal Download"@en ;
    skos:definition "A system that sends customer data from SAP MDG to the terminals, through FuelFacs, so that the customer can load there."@en ;
    skos:editorialNote "Drafted by Claude from the repository: its customer role, data flows and attributes as the party module holds them from the decision owner's customer inputs; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "terminal-download" ;
    skos:prefLabel "Terminal download"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "Sends customer data to terminals so the customer can load there."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/fuelfacs> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

<https://w3id.org/lsc/ontology/modules/party/system/kittyhawk> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:decision-owner-answers-2026-10-24-systems ;
    skos:altLabel "KH"@en,
        "Kittyhawk"@en ;
    skos:definition "An MPC in-house application used by the Commercial organization. It gets all of its data from RightAngle and is almost a replica of it."@en ;
    skos:editorialNote "Terminal Upload sends KittyHawk cross-reference customer ID mappings directly, as the decision owner's input shows; KittyHawk's customer data itself comes from RightAngle (EPM-DEC-001-0099)."@en ;
    skos:exactMatch system:kittyhawk ;
    skos:inScheme party:customer-systems ;
    skos:notation "kittyhawk" ;
    skos:prefLabel "KittyHawk"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "Records physical product movements. It receives customers from RightAngle, holds the territory manager, and feeds Gravitate and MAGIC."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/gravitate>,
        <https://w3id.org/lsc/ontology/modules/party/system/magic>,
        <https://w3id.org/lsc/ontology/modules/party/system/profisee>,
        <https://w3id.org/lsc/ontology/modules/party/system/rcms> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

src:decision-owner-customer-inputs-2026-10-27 a dcterms:BibliographicResource ;
    dcterms:title "The decision owner's customer inputs of 2026-10-27 (two images and two Dealer Master documents, kept out of the repository by EPM-DEC-001-0108), as the party module holds them"@en .

<https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:vendor-sap-s4hana-help ;
    skos:altLabel "S/4"@en,
        "S4"@en,
        "SAP S/4"@en ;
    skos:definition "SAP's business suite. By the vendor's description, it is the next-generation business suite, built on the SAP HANA in-memory platform."@en ;
    skos:exactMatch system:sap ;
    skos:inScheme party:customer-systems ;
    skos:notation "sap-s4hana" ;
    skos:prefLabel "SAP S/4HANA"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "The financial system of record. It receives the business partner from SAP MDG, with company codes, sales areas and partner roles, adds credit and collection data, and takes transaction postings and invoices from the execution systems."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/bridger-insight> ;
    party:implements party:CustomerAccount,
        party:Party,
        party:PartyRole ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/profisee> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:vendor-profisee-platform ;
    skos:altLabel "Profisee Data Storage"@en ;
    skos:definition "Profisee's master data management (MDM) platform. By the vendor's description, it cleans, unifies and improves the quality of an enterprise's critical data across its systems."@en ;
    skos:exactMatch system:profisee ;
    skos:inScheme party:customer-systems ;
    skos:notation "profisee" ;
    skos:prefLabel "Profisee"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "Customer data storage and mastering used by IDP, for customer ID mapping, customer roll-ups and cross-references."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/data-products-idp> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

src:decision-owner-customer-inputs a dcterms:BibliographicResource ;
    dcterms:title "The decision owner's customer inputs (seven files, kept out of the repository by EPM-DEC-001-0067), as the party module holds them in its customer roles, data flows and attributes"@en .

<https://w3id.org/lsc/ontology/modules/party/system/polaris> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:phmsa-marathon-pipeline-noa-2024-09-26 ;
    skos:definition "A scheduling system of Marathon Pipeline LLC, named in a PHMSA notice of amendment of 2024-09-26. Whether MPC built or bought it is not known."@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "polaris" ;
    skos:prefLabel "Polaris"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "The pipeline operations and invoicing system. It takes the SAP customer number and basic attributes from SAP MDG, adds operational data, records pipeline movements and revenue, and sends the transport invoices it generates to SAP S/4HANA."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> ;
    party:implements party:CustomerAccount,
        party:PartyTransactionAssociation,
        party:Site ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/dealer-master> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:decision-owner-customer-inputs,
        src:decision-owner-customer-inputs-2026-10-27 ;
    skos:changeNote "2026-10-27: its role and definition are corrected from the decision owner's customer inputs of that day. Salesforce is only its intake, not what it is built on; jobbers are mastered in SAP MDG and RightAngle and replicated here; it masters the ship-to stations (EPM-DEC-001-0108)."@en ;
    skos:definition "The Retail Payments Application, the system of record for the branded dealer network's ship-to stations: it masters each station, links it to the jobber that supplies it, settles with the dealers and aggregates the stations' point-of-sale transactions. Jobbers are mastered in SAP MDG and RightAngle and replicated here. It sends bank and payment details to SAP S/4HANA."@en ;
    skos:editorialNote "Corrected on 2026-10-27 from the decision owner's customer inputs of that day: Salesforce is only its intake, not what it is built on, and jobbers do not start here (EPM-DEC-001-0108). Drafted by Claude from the repository: its customer role, data flows and attributes as the party module holds them from the decision owner's customer inputs; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "dealer-master" ;
    skos:prefLabel "Dealer Master"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "The system of record for the branded dealer network's ship-to stations, the Retail Payments Application. It masters each station, links it to the jobber that supplies it, settles with the dealers, and aggregates the stations' point-of-sale transactions. Jobbers are mastered in SAP MDG and RightAngle and replicated here. It sends bank and payment details to SAP S/4HANA and station locations to PRM."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/credit-card-summary>,
        <https://w3id.org/lsc/ontology/modules/party/system/prm>,
        <https://w3id.org/lsc/ontology/modules/party/system/rightangle>,
        <https://w3id.org/lsc/ontology/modules/party/system/salesforce>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-mdg>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> ;
    party:implements party:Agreement,
        party:PartyRole,
        party:Site,
        party:SiteBrandAssignment ;
    party:systemOfRecordFor party:PartyRelationship,
        party:Site ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/sap-mdg> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:vendor-sap-mdg ;
    skos:altLabel "MDG"@en ;
    skos:definition "SAP's master data governance software. By the vendor's description, it is the governance layer for an enterprise's business data, unifying master data, policy and metadata."@en ;
    skos:exactMatch system:sap-mdg ;
    skos:inScheme party:customer-systems ;
    skos:notation "sap-mdg" ;
    skos:prefLabel "SAP MDG"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "The point of control for customer creation and governance: every commercial customer is created here. It runs duplicate checks on identifiers, validates addresses, applies authorization groups by line of business and generates the canonical SAP customer number. It is the system of record for the customer and holds the tax ID and bank data."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/dealer-master>,
        <https://w3id.org/lsc/ontology/modules/party/system/magic>,
        <https://w3id.org/lsc/ontology/modules/party/system/polaris>,
        <https://w3id.org/lsc/ontology/modules/party/system/quorum>,
        <https://w3id.org/lsc/ontology/modules/party/system/rightangle>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana>,
        <https://w3id.org/lsc/ontology/modules/party/system/sirion>,
        <https://w3id.org/lsc/ontology/modules/party/system/star>,
        <https://w3id.org/lsc/ontology/modules/party/system/terminal-download> ;
    party:implements party:ExternalIdentifier,
        party:Party ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/salesforce> a skos:Concept,
        party:CustomerSystem ;
    dcterms:source src:vendor-salesforce ;
    skos:altLabel "SF"@en,
        "Salesforce CRM"@en ;
    skos:definition "Salesforce's customer relationship management (CRM) platform. By the vendor's description, it helps companies connect with their customers."@en ;
    skos:exactMatch system:salesforce ;
    skos:inScheme party:customer-systems ;
    skos:notation "salesforce" ;
    skos:prefLabel "Salesforce"@en ;
    skos:topConceptOf party:customer-systems ;
    party:customerRole "Where a prospect is first captured and a new customer setup and credit check start, on two tracks: Trade (the commodity trading desk) and CRM/Basic (goods and products). It triggers creation in SAP MDG, receives the SAP customer number back, and serves the customer portal."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/dealer-master>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-mdg> ;
    party:implements party:Address,
        party:ContactPoint,
        party:Party ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

