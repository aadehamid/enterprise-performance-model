# SHACL shapes for the `party` module (Step 9; EPM-DEC-001-0068, EPM-DEC-001-0069, EPM-DEC-001-0070). They check the
# shape of customer records that systems or examples state in these terms: each role held by one
# party, each dated record with a start date and no end before its start, each coded value from its
# own list, and no class other than Person and Organization made a subclass of party. They also
# check the module's systems, data flows, sourcings and system attributes (EPM-DEC-001-0069), and that
# only a business lifecycle stage is done by processes and only a system stage is held by systems
# (EPM-DEC-001-0070).
@prefix party: <https://w3id.org/lsc/ontology/modules/party/> .
@prefix partysh: <https://w3id.org/lsc/ontology/modules/party/shapes/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---- A coded value comes from its own list ----

partysh:InPartyType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:party-type ] .
partysh:InPartyRole a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:party-role ] .
partysh:InRelationshipType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:relationship-type ] .
partysh:InAgreementType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:agreement-type ] .
partysh:InLineOfBusiness a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:line-of-business ] .
partysh:InSiteType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:site-type ] .
partysh:InOperatingModel a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:operating-model ] .
partysh:InIdentifierType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:identifier-type ] .
partysh:InAddressUsage a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:address-usage ] .
partysh:InContactType a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:contact-type ] .
partysh:InTransactionKind a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:transaction-kind ] .
# A class assignment names a class, never one of the four groups: the value has a broader group.
partysh:InCustomerClass a sh:NodeShape ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue party:customer-class ] ;
    sh:property [ sh:path skos:broader ; sh:minCount 1 ;
                  sh:message "A customer class assignment names one of the four groups, not a class." ] .

# ---- Identity ----

partysh:Party a sh:NodeShape ;
    sh:targetClass party:Party ;
    sh:xone ( [ sh:class party:Person ] [ sh:class party:Organization ] ) ;
    sh:property [ sh:path party:legalName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path party:partyType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InPartyType ] ;
    sh:property [ sh:path party:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

partysh:PersonType a sh:NodeShape ;
    sh:targetClass party:Person ;
    sh:property [ sh:path party:partyType ; sh:hasValue <https://w3id.org/lsc/ontology/modules/party/party-type/person> ] .

partysh:OrganizationType a sh:NodeShape ;
    sh:targetClass party:Organization ;
    sh:property [ sh:path party:partyType ; sh:hasValue <https://w3id.org/lsc/ontology/modules/party/party-type/organization> ] .

partysh:ExternalIdentifier a sh:NodeShape ;
    sh:targetClass party:ExternalIdentifier ;
    sh:property [ sh:path party:identifierType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InIdentifierType ] ;
    sh:property [ sh:path party:issuer ; sh:maxCount 1 ; sh:datatype xsd:string ] .

partysh:Address a sh:NodeShape ;
    sh:targetClass party:Address ;
    sh:property [ sh:path party:addressUsage ; sh:minCount 1 ; sh:node partysh:InAddressUsage ] ;
    sh:property [ sh:path party:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

partysh:ContactPoint a sh:NodeShape ;
    sh:targetClass party:ContactPoint ;
    sh:property [ sh:path party:contactType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InContactType ] ;
    sh:property [ sh:path party:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

# ---- Roles and relationships ----

partysh:PartyRole a sh:NodeShape ;
    sh:targetClass party:PartyRole ;
    sh:property [ sh:path [ sh:inversePath party:plays ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:Party ;
                  sh:message "A party role is held by exactly one party." ] ;
    sh:property [ sh:path party:roleType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InPartyRole ] ;
    sh:property [ sh:path party:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ;
                  sh:message "A party role is held from a start date, and does not end before it starts." ] ;
    sh:property [ sh:path party:validTo ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path party:atSite ; sh:class party:Site ] .

partysh:PartyRelationship a sh:NodeShape ;
    sh:targetClass party:PartyRelationship ;
    sh:property [ sh:path party:fromRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:PartyRole ] ;
    sh:property [ sh:path party:toRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:PartyRole ] ;
    sh:property [ sh:path party:relationshipType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InRelationshipType ] ;
    sh:property [ sh:path party:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

# ---- The account ----

partysh:CustomerAccount a sh:NodeShape ;
    sh:targetClass party:CustomerAccount ;
    sh:property [ sh:path [ sh:inversePath party:transactsThrough ] ; sh:minCount 1 ; sh:class party:Party ;
                  sh:message "A customer account belongs to at least one party." ] ;
    sh:property [ sh:path party:classifiedAs ; sh:class party:CustomerClass ] ;
    sh:property [ sh:path party:managedUnder ; sh:node partysh:InLineOfBusiness ] ;
    sh:property [ sh:path party:framedBy ; sh:class party:Agreement ] ;
    sh:property [ sh:path party:suppliedFrom ; sh:class party:Site ] ;
    sh:property [ sh:path party:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

partysh:CustomerClass a sh:NodeShape ;
    sh:targetClass party:CustomerClass ;
    sh:property [ sh:path [ sh:inversePath party:classifiedAs ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:CustomerAccount ] ;
    sh:property [ sh:path party:classValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InCustomerClass ] ;
    sh:property [ sh:path party:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ;
                  sh:message "A customer class is assigned from a start date." ] .

# ---- Agreements, brands and sites ----

partysh:Agreement a sh:NodeShape ;
    sh:targetClass party:Agreement ;
    sh:property [ sh:path party:agreementType ; sh:minCount 1 ; sh:node partysh:InAgreementType ] ;
    sh:property [ sh:path party:scopedToProduct ; sh:class party:Product ] ;
    sh:property [ sh:path party:coversBrand ; sh:class party:Brand ] ;
    sh:property [ sh:path party:authorizesBrandAtSite ; sh:class party:SiteBrandAssignment ] ;
    sh:property [ sh:path party:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

partysh:SiteBrandAssignment a sh:NodeShape ;
    sh:targetClass party:SiteBrandAssignment ;
    sh:property [ sh:path party:assignsBrand ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:Brand ] ;
    sh:property [ sh:path party:appliesTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:Site ] ;
    sh:property [ sh:path [ sh:inversePath party:authorizesBrandAtSite ] ; sh:minCount 1 ; sh:class party:Agreement ;
                  sh:message "A site brand assignment is made under an agreement." ] ;
    sh:property [ sh:path party:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals party:validTo ] .

partysh:Site a sh:NodeShape ;
    sh:targetClass party:Site ;
    sh:property [ sh:path party:siteType ; sh:maxCount 1 ; sh:node partysh:InSiteType ] ;
    sh:property [ sh:path party:operatingModel ; sh:maxCount 1 ; sh:node partysh:InOperatingModel ] ;
    sh:property [ sh:path party:suppliedByTerminal ; sh:class party:Site ] .

# ---- Transactions ----

partysh:PartyTransactionAssociation a sh:NodeShape ;
    sh:targetClass party:PartyTransactionAssociation ;
    sh:property [ sh:path party:transactionKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InTransactionKind ] ;
    sh:property [ sh:path party:transactionReference ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path party:forAccount ; sh:maxCount 1 ; sh:class party:CustomerAccount ] ;
    sh:or ( [ sh:path [ sh:inversePath party:participatesIn ] ; sh:minCount 1 ]
            [ sh:path party:forAccount ; sh:minCount 1 ] ) .

# ---- Systems, data flow and attributes (EPM-DEC-001-0069) ----

partysh:InSystemTier a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:system-tier ] .
partysh:InAttributeCategory a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:attribute-category ] .
partysh:InSharedAttribute a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:shared-attribute ] .
partysh:InSourcingKind a sh:NodeShape ; sh:property [ sh:path skos:inScheme ; sh:hasValue party:sourcing-kind ] .

partysh:CustomerSystem a sh:NodeShape ;
    sh:targetClass party:CustomerSystem ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue party:customer-systems ] ;
    sh:property [ sh:path party:systemTier ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InSystemTier ] ;
    sh:property [ sh:path party:customerRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ;
                  sh:message "A customer system says what it does with the customer." ] ;
    sh:property [ sh:path party:implements ;
                  sh:in ( party:Party party:ExternalIdentifier party:Address party:ContactPoint party:PartyRole
                          party:PartyRelationship party:CustomerAccount party:CustomerClass party:LineOfBusiness
                          party:Brand party:Agreement party:SiteBrandAssignment party:PartyTransactionAssociation
                          party:Product party:Site ) ;
                  sh:message "A customer system implements entities of the conceptual model only." ] ;
    sh:property [ sh:path party:feeds ; sh:class party:CustomerSystem ] .

partysh:DataFlow a sh:NodeShape ;
    sh:targetClass party:DataFlow ;
    sh:property [ sh:path party:fromSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:CustomerSystem ] ;
    sh:property [ sh:path party:toSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:CustomerSystem ;
                  sh:message "A data flow goes from one customer system to one other." ] ;
    sh:property [ sh:path party:carries ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ;
                  sh:message "A data flow says what it carries." ] ;
    sh:property [ sh:path party:evidenceInput ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[1-7](, [1-7])*$" ;
                  sh:message "A data flow names the inputs that show it, from the seven inputs." ] .

partysh:CustomerSourcing a sh:NodeShape ;
    sh:targetClass party:CustomerSourcing ;
    sh:property [ sh:path party:sourcingSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:CustomerSystem ] ;
    sh:property [ sh:path party:sourcingKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InSourcingKind ] ;
    sh:property [ sh:path party:sourcedConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:or ( [ sh:path skos:inScheme ; sh:hasValue party:party-role ]
                          [ sh:path skos:inScheme ; sh:hasValue party:customer-class ]
                          [ sh:path skos:inScheme ; sh:hasValue party:line-of-business ]
                          [ sh:path skos:inScheme ; sh:hasValue party:party-type ] ) ;
                  sh:message "A customer sourcing names a party role, a customer class, a line of business or a party type." ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "\\S" ;
                  sh:message "A customer sourcing has a note." ] ;
    sh:property [ sh:path party:evidenceInput ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[1-7](, [1-7])*$" ;
                  sh:message "A customer sourcing names the inputs that show it, from the seven inputs." ] .

partysh:SystemAttribute a sh:NodeShape ;
    sh:targetClass party:SystemAttribute ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path party:inSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:class party:CustomerSystem ] ;
    sh:property [ sh:path party:attributeCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:node partysh:InAttributeCategory ;
                  sh:message "A system attribute is Create or Enrich." ] ;
    sh:property [ sh:path party:describes ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( party:Party party:ExternalIdentifier party:Address party:ContactPoint party:PartyRole
                          party:PartyRelationship party:CustomerAccount party:CustomerClass party:LineOfBusiness
                          party:Brand party:Agreement party:SiteBrandAssignment party:PartyTransactionAssociation
                          party:Product party:Site party:SystemRecord ) ;
                  sh:message "A system attribute describes one entity of the conceptual model, or the system record." ] ;
    sh:property [ sh:path party:sharedAttribute ; sh:maxCount 1 ; sh:node partysh:InSharedAttribute ] .

# ---- The customer lifecycle (EPM-DEC-001-0070) ----

partysh:LifecycleStage a sh:NodeShape ;
    sh:targetSubjectsOf party:stageProcess ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue party:lifecycle-stage ;
                  sh:message "Only a business lifecycle stage is done by processes." ] ;
    sh:property [ sh:path party:stageProcess ; sh:nodeKind sh:IRI ;
                  sh:pattern "^https://w3id.org/lsc/ontology/process/" ] ;
    sh:property [ sh:path party:correspondsTo ; sh:node [ sh:property [ sh:path skos:inScheme ; sh:hasValue party:system-stage ] ] ] .

partysh:SystemStage a sh:NodeShape ;
    sh:targetSubjectsOf party:stageSystem ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue party:system-stage ;
                  sh:message "Only a system stage is held by systems." ] ;
    sh:property [ sh:path party:stageSystem ; sh:class party:CustomerSystem ] .

# ---- The vocabulary: customer is not a kind of party ----
# Any chain of subclass links counts: a class under Person or Organization is a subclass of party too.

partysh:NoCustomerSubclass a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:subClassOf ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Only person and organization are kinds of party. A customer, or any role, is a party role, not a subclass of party." ;
        sh:select """
            SELECT $this WHERE {
                $this <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://w3id.org/lsc/ontology/modules/party/Party> .
                FILTER ($this NOT IN (<https://w3id.org/lsc/ontology/modules/party/Party>,
                                      <https://w3id.org/lsc/ontology/modules/party/Person>,
                                      <https://w3id.org/lsc/ontology/modules/party/Organization>))
            }""" ] .
