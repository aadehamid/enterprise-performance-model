# The `party` module's vocabulary (Steps 5 to 7; EPM-DEC-001-0067, EPM-DEC-001-0068; for the systems,
# data flow and attributes EPM-DEC-001-0069; for the lifecycle EPM-DEC-001-0070; for question 25's binding rule EPM-DEC-001-0071): the
# decision owner's conceptual data model of Customer, as classes and properties. The definitions
# are Claude's words, derived from that model, which is not in this repository (EPM-DEC-001-0067).
# The module holds definitions only: customer records stay in the systems (EPM-DEC-001-0005).
# Its code lists are in code-lists.ttl, built from code-lists.csv.
@prefix party: <https://w3id.org/lsc/ontology/modules/party/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---- Identity: who the party is, independent of any role ----

party:Party a owl:Class ;
    rdfs:label "party"@en ;
    skos:definition "A person or an organization, as one identity, whatever roles it plays. It has a legal name, a status and a period it is valid for. Each party is a person or an organization, never both."@en ;
    skos:scopeNote "Customer is not a kind of party. A party becomes a customer by holding a customer role exercised within a customer account."@en ;
    skos:closeMatch <http://xmlns.com/foaf/0.1/Agent> ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en .

party:Person a owl:Class ;
    rdfs:subClassOf party:Party ;
    owl:disjointWith party:Organization ;
    rdfs:label "person"@en ;
    skos:definition "A party that is a natural person."@en ;
    skos:closeMatch <http://xmlns.com/foaf/0.1/Person> ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:Organization a owl:Class ;
    rdfs:subClassOf party:Party ;
    rdfs:label "organization"@en ;
    skos:definition "A party that is an organization, such as a company, a partnership or a public body."@en ;
    skos:closeMatch <http://www.w3.org/ns/org#Organization> ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:ExternalIdentifier a owl:Class ;
    rdfs:label "external identifier"@en ;
    skos:definition "An identifier of a party or of one of its roles, issued by an authority, an industry body or an earlier system, such as a tax identifier, a public-company identifier, an industry code or a legacy identifier. It records its issuer and its type."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:Address a owl:Class ;
    rdfs:label "address"@en ;
    skos:definition "A physical or postal location of a party, such as its registered office, a mailing address, a billing address or an operating location. It records its type, how it is used and the period it is valid for. A party can hold several addresses at once."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:ContactPoint a owl:Class ;
    rdfs:label "contact point"@en ;
    skos:definition "A telephone number, an email address or a fax number through which a party can be reached. It records its usage type and the period it is valid for."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Customer anatomy: how a party becomes a customer ----

party:PartyRole a owl:Class ;
    rdfs:label "party role"@en ;
    skos:definition "A function one party performs in a business context, held from a start date to an end date. Customer roles and other roles sit side by side on the same party. Its role type comes from a governed list; a new role type needs a governance decision."@en ;
    skos:scopeNote "A role is a node, not a subclass of party: one party can hold many roles at once, each for its own period (ontology-playbook.md, Step 5)."@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5; EPM-DEC-001-0068"@en .

party:PartyRelationship a owl:Class ;
    rdfs:label "party relationship"@en ;
    skos:definition "A dated, typed link from one party role to another, such as parent of, guarantor of, supplies, credit roll-up or contact for."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:CustomerAccount a owl:Class ;
    rdfs:label "customer account"@en ;
    skos:definition "The commercial and financial container for a party's relationship with the company; the party transacts through it. It holds the account status, payment and credit terms, the company-code assignment, settlement details and the period it is valid for. The customer class is assigned at this level."@en ;
    skos:scopeNote "A customer-grained measure binds to the customer account by default, because credit terms and the class sit here and exposure aggregates from it. A measure about one role binds to that role, such as the payer for receivables or the sold-to for sales volume, and a measure about a location binds to the site. None binds to the bare word customer, which names no single thing (competency question 25; EPM-DEC-001-0071)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068; EPM-DEC-001-0071"@en .

party:CustomerClass a owl:Class ;
    rdfs:label "customer class"@en ;
    skos:definition "The assignment of a class from the customer-class list to a customer account, from a start date to an end date. A class describes how the customer buys: its role, its channel and its supply pattern."@en ;
    skos:scopeNote "The class values are concepts of the customer-class scheme; this class is the dated assignment of one of them to one account."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0047, What follows, item 5; EPM-DEC-001-0068"@en .

party:LineOfBusiness a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "line of business"@en ;
    skos:definition "A governed category of the company's business that a customer sits under. It decides which information is needed to set the customer up. A customer can sit under more than one."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:Brand a owl:Class ;
    rdfs:label "brand"@en ;
    skos:definition "A trademark a product is marketed under. The network carries owned, licensed and competitor brands. A brand is owned by or licensed to a party for a period, through a Brand License agreement."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:Agreement a owl:Class ;
    rdfs:label "agreement"@en ;
    skos:definition "The commercial frame that party roles work under. It sets terms, pricing, volume, product scope, brand, territory, exclusivity and assignment rights. Its types overlap: one agreement can have several."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:SiteBrandAssignment a owl:Class ;
    rdfs:label "site brand assignment"@en ;
    skos:definition "The link of a site to a brand under an agreement, from a start date to an end date. It survives a change in who owns the site. When the supply agreement expires, the site converts."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067, What follows, item 4; EPM-DEC-001-0068"@en .

# ---- Operational context: where the customer operates ----

party:PartyTransactionAssociation a owl:Class ;
    rdfs:label "party transaction association"@en ;
    skos:definition "The link of a party role, or of an account, to one transaction, with the role it played there. A transaction can be an order, a ticket or bill of lading, an invoice, a payment or a case, or a trade or transfer captured in a deal. It records the transaction reference, the role, the account and the period it is valid for."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:Product a owl:Class ;
    rdfs:label "product"@en ;
    skos:definition "A marketable hydrocarbon product or grade. The class stands in for a Product domain that this repository does not model yet. Contract terms are set per product, so specialty buyers are told apart by an agreement's product scope."@en ;
    skos:scopeNote "Since 1.1.0 its values are the refined products MPC's FY2025 Form 10-K names, in the scheme party:product, each mapped with SKOS to the Open Energy Ontology where a class fits (OEO v2.14.0, released 2026-10-08), and given its PIDX product family where one fits (EPM-DEC-001-0088, 0092). The business confirms or replaces the list (ontology/business-closeout.md, point 5)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068; EPM-DEC-001-0092"@en .

party:Site a owl:Class ;
    rdfs:label "site"@en ;
    skos:definition "A physical operating location with its own lifecycle, whoever owns it: a station, a bulk plant, a cardlock, a terminal, an airport location or a pipeline delivery point. It records its operating model, amenities, image compliance and the terminals that supply it. A party owns or operates it for a period, through a party role held at the site."@en ;
    skos:scopeNote "A ship-to is a site, not a role: the party that receives product there holds the Consignee role (competency question 21; EPM-DEC-001-0068)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Validity, shared by the dated classes ----

party:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ; rdfs:range xsd:date ;
    skos:definition "The first day the record holds."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to"@en ; rdfs:range xsd:date ;
    skos:definition "The last day the record holds. A record with no end date still holds."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Identity links ----

party:partyType a owl:ObjectProperty ;
    rdfs:label "party type"@en ; rdfs:domain party:Party ; rdfs:range skos:Concept ;
    skos:definition "Person or organization, from the party-type list. It agrees with the party's class."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:legalName a owl:DatatypeProperty ;
    rdfs:label "legal name"@en ; rdfs:domain party:Party ; rdfs:range xsd:string ;
    skos:definition "The party's name as registered."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:partyStatus a owl:DatatypeProperty ;
    rdfs:label "party status"@en ; rdfs:domain party:Party ; rdfs:range xsd:string ;
    skos:definition "Whether the party is active. The list of statuses is not yet defined."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:identifiedBy a owl:ObjectProperty ;
    rdfs:label "identified by"@en ; rdfs:domain party:Party ; rdfs:range party:ExternalIdentifier ;
    skos:definition "An external identifier of the party."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:identifierType a owl:ObjectProperty ;
    rdfs:label "identifier type"@en ; rdfs:domain party:ExternalIdentifier ; rdfs:range skos:Concept ;
    skos:definition "The kind of identifier, from the identifier-type list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:issuer a owl:DatatypeProperty ;
    rdfs:label "issuer"@en ; rdfs:domain party:ExternalIdentifier ; rdfs:range xsd:string ;
    skos:definition "The authority, industry body or system that issued the identifier."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:locatedAt a owl:ObjectProperty ;
    rdfs:label "located at"@en ; rdfs:domain party:Party ; rdfs:range party:Address ;
    skos:definition "An address of the party."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:addressUsage a owl:ObjectProperty ;
    rdfs:label "address usage"@en ; rdfs:domain party:Address ; rdfs:range skos:Concept ;
    skos:definition "How the address is used, from the address-usage list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:reachableAt a owl:ObjectProperty ;
    rdfs:label "reachable at"@en ; rdfs:domain party:Party ; rdfs:range party:ContactPoint ;
    skos:definition "A contact point of the party."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:contactType a owl:ObjectProperty ;
    rdfs:label "contact type"@en ; rdfs:domain party:ContactPoint ; rdfs:range skos:Concept ;
    skos:definition "Telephone, email or fax, from the contact-type list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Roles and relationships ----

party:plays a owl:ObjectProperty ;
    rdfs:label "plays"@en ; rdfs:domain party:Party ; rdfs:range party:PartyRole ;
    skos:definition "A role the party holds. Each role is held by exactly one party."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:roleType a owl:ObjectProperty ;
    rdfs:label "role type"@en ; rdfs:domain party:PartyRole ; rdfs:range skos:Concept ;
    skos:definition "The kind of role, from the party-role list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067, What follows, item 10; EPM-DEC-001-0068"@en .

party:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ; rdfs:domain party:PartyRole ; rdfs:range party:Site ;
    skos:definition "The site where the role is held, such as the station a dealer operates or the terminal a loading-authorized party lifts at."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:fromRole a owl:ObjectProperty ;
    rdfs:label "from role"@en ; rdfs:domain party:PartyRelationship ; rdfs:range party:PartyRole ;
    skos:definition "The role the relationship starts from: the parent, the guarantor, the supplier, the role whose credit rolls up, or the contact."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:toRole a owl:ObjectProperty ;
    rdfs:label "to role"@en ; rdfs:domain party:PartyRelationship ; rdfs:range party:PartyRole ;
    skos:definition "The role the relationship points to."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:relationshipType a owl:ObjectProperty ;
    rdfs:label "relationship type"@en ; rdfs:domain party:PartyRelationship ; rdfs:range skos:Concept ;
    skos:definition "The kind of relationship, from the relationship-type list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- The account ----

party:transactsThrough a owl:ObjectProperty ;
    rdfs:label "transacts through"@en ; rdfs:domain party:Party ; rdfs:range party:CustomerAccount ;
    skos:definition "An account the party transacts through."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:exercisedWithin a owl:ObjectProperty ;
    rdfs:label "exercised within"@en ; rdfs:domain party:PartyRole ; rdfs:range party:CustomerAccount ;
    skos:definition "The account a role is exercised within, such as the account a payer pays for."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:classifiedAs a owl:ObjectProperty ;
    rdfs:label "classified as"@en ; rdfs:domain party:CustomerAccount ; rdfs:range party:CustomerClass ;
    skos:definition "A dated class assignment of the account."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:classValue a owl:ObjectProperty ;
    rdfs:label "class value"@en ; rdfs:domain party:CustomerClass ; rdfs:range skos:Concept ;
    skos:definition "The class assigned, from the customer-class list. Only a class, never one of the four groups, is assigned."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:managedUnder a owl:ObjectProperty ;
    rdfs:label "managed under"@en ; rdfs:domain party:CustomerAccount ; rdfs:range party:LineOfBusiness ;
    skos:definition "A line of business the account sits under."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:accountStatus a owl:DatatypeProperty ;
    rdfs:label "account status"@en ; rdfs:domain party:CustomerAccount ; rdfs:range xsd:string ;
    skos:definition "Whether the account is active, blocked or closed. The list of statuses is not yet defined."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:paymentTerms a owl:DatatypeProperty ;
    rdfs:label "payment terms"@en ; rdfs:domain party:CustomerAccount ; rdfs:range xsd:string ;
    skos:definition "When and how the account pays its invoices."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:creditTerms a owl:DatatypeProperty ;
    rdfs:label "credit terms"@en ; rdfs:domain party:CustomerAccount ; rdfs:range xsd:string ;
    skos:definition "The credit the company extends on the account: its limit and its conditions. Credit sits on the account; a credit roll-up relationship counts one role's exposure under another's."@en ;
    dcterms:bibliographicCitation "competency question 23; EPM-DEC-001-0068"@en .

party:companyCode a owl:DatatypeProperty ;
    rdfs:label "company code"@en ; rdfs:domain party:CustomerAccount ; rdfs:range xsd:string ;
    skos:definition "The company code the account is assigned to in the financial system."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:settlementDetails a owl:DatatypeProperty ;
    rdfs:label "settlement details"@en ; rdfs:domain party:CustomerAccount ; rdfs:range xsd:string ;
    skos:definition "How the account settles: the method and the bank or payment details it uses."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:accountFacet a owl:ObjectProperty ;
    rdfs:label "account facet"@en ; rdfs:domain party:CustomerAccount ; rdfs:range skos:Concept ;
    skos:definition "A secondary facet of the account: its brand status, contract type, product line, segment, geography or delivery tier. The values of these facets are not yet defined."@en ;
    skos:scopeNote "The delivery tier covers the delivery-mode candidate, which is not added separately (EPM-DEC-001-0067, What follows, item 9)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Agreements, brands and sites ----

party:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by"@en ; rdfs:domain party:PartyRole ; rdfs:range party:Agreement ;
    skos:definition "An agreement the role works under."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:framedBy a owl:ObjectProperty ;
    rdfs:label "framed by"@en ; rdfs:domain party:CustomerAccount ; rdfs:range party:Agreement ;
    skos:definition "An agreement that frames the account."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:agreementType a owl:ObjectProperty ;
    rdfs:label "agreement type"@en ; rdfs:domain party:Agreement ; rdfs:range skos:Concept ;
    skos:definition "A type of the agreement, from the agreement-type list. An agreement can have more than one."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:scopedToProduct a owl:ObjectProperty ;
    rdfs:label "scoped to product"@en ; rdfs:domain party:Agreement ; rdfs:range party:Product ;
    skos:definition "A product the agreement covers."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en .

party:coversBrand a owl:ObjectProperty ;
    rdfs:label "covers brand"@en ; rdfs:domain party:Agreement ; rdfs:range party:Brand ;
    skos:definition "A brand the agreement sets terms for. A Brand License agreement licenses the brand to a party for the agreement's period."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:authorizesBrandAtSite a owl:ObjectProperty ;
    rdfs:label "authorizes brand at site"@en ; rdfs:domain party:Agreement ; rdfs:range party:SiteBrandAssignment ;
    skos:definition "A site brand assignment the agreement authorizes."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067, What follows, item 4; EPM-DEC-001-0068"@en .

party:assignsBrand a owl:ObjectProperty ;
    rdfs:label "assigns brand"@en ; rdfs:domain party:SiteBrandAssignment ; rdfs:range party:Brand ;
    skos:definition "The brand the assignment gives the site."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ; rdfs:domain party:SiteBrandAssignment ; rdfs:range party:Site ;
    skos:definition "The site the assignment brands."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:suppliedFrom a owl:ObjectProperty ;
    rdfs:label "supplied from"@en ; rdfs:domain party:CustomerAccount ; rdfs:range party:Site ;
    skos:definition "A site the account is supplied from, such as a refinery or a terminal."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en .

party:siteType a owl:ObjectProperty ;
    rdfs:label "site type"@en ; rdfs:domain party:Site ; rdfs:range skos:Concept ;
    skos:definition "The kind of site, from the site-type list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:operatingModel a owl:ObjectProperty ;
    rdfs:label "operating model"@en ; rdfs:domain party:Site ; rdfs:range skos:Concept ;
    skos:definition "Who owns and who operates the site: COCO, CODO or DODO, from the operating-model list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en .

party:suppliedByTerminal a owl:ObjectProperty ;
    rdfs:label "supplied by terminal"@en ; rdfs:domain party:Site ; rdfs:range party:Site ;
    skos:definition "A terminal that supplies the site."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- Transactions ----

party:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"@en ; rdfs:domain party:PartyRole ; rdfs:range party:PartyTransactionAssociation ;
    skos:definition "A transaction association the role takes part in."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:forAccount a owl:ObjectProperty ;
    rdfs:label "for account"@en ; rdfs:domain party:PartyTransactionAssociation ; rdfs:range party:CustomerAccount ;
    skos:definition "The account the transaction is booked to."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:transactionKind a owl:ObjectProperty ;
    rdfs:label "transaction kind"@en ; rdfs:domain party:PartyTransactionAssociation ; rdfs:range skos:Concept ;
    skos:definition "The kind of transaction, from the transaction-kind list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

party:transactionReference a owl:DatatypeProperty ;
    rdfs:label "transaction reference"@en ; rdfs:domain party:PartyTransactionAssociation ; rdfs:range xsd:string ;
    skos:definition "The identifier of the transaction in the system that holds it."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en .

# ---- The MPC customer classification (the channel dimension, MPC-P06) ----

party:mpcClassification a owl:DatatypeProperty ;
    rdfs:label "MPC classification"@en ; rdfs:domain skos:Concept ; rdfs:range xsd:string ;
    skos:definition "The code, C1 to C8, of the class in the repository's MPC customer classification (built from MPC's filings and website, with C8 added by the decision owner), which the class corresponds to."@en ;
    dcterms:bibliographicCitation "business_architecture/reference/mpc/customer-classification-evidence.md; EPM-DEC-001-0047, What follows, item 5; EPM-DEC-001-0068"@en .

# ---- Systems, data flow and attributes (EPM-DEC-001-0069) ----

party:SystemRecord a owl:Class ;
    rdfs:label "system record"@en ;
    skos:definition "A system's own record of a customer: who created or changed it, when, and the system's notes on it. It is not an entity of the conceptual model; system attributes that describe only the record point here."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:CustomerSystem a owl:Class ;
    rdfs:label "customer system"@en ;
    skos:definition "A system the customer passes through: where it is created, recorded, enriched or used, or a source of customers of a kind. A customer system that the process map also names matches the system module's system (skos:exactMatch)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:systemTier a owl:ObjectProperty ;
    rdfs:label "system tier"@en ; rdfs:domain party:CustomerSystem ; rdfs:range skos:Concept ;
    skos:definition "Where the system sits in the customer's data flow, from the system-tier list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:customerRole a owl:DatatypeProperty ;
    rdfs:label "customer role"@en ; rdfs:domain party:CustomerSystem ; rdfs:range rdf:langString ;
    skos:definition "What the system does with the customer, in a sentence or two."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ; rdfs:domain party:CustomerSystem ; rdfs:range owl:Class ;
    skos:definition "An entity of the conceptual model the system holds records of, as the decision owner's model maps it."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:DataFlow a owl:Class ;
    rdfs:label "data flow"@en ;
    skos:definition "A movement of customer data from one system to another, with what it carries."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:fromSystem a owl:ObjectProperty ;
    rdfs:label "from system"@en ; rdfs:domain party:DataFlow ; rdfs:range party:CustomerSystem ;
    skos:definition "The system the data comes from."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:toSystem a owl:ObjectProperty ;
    rdfs:label "to system"@en ; rdfs:domain party:DataFlow ; rdfs:range party:CustomerSystem ;
    skos:definition "The system the data goes to."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:carries a owl:DatatypeProperty ;
    rdfs:label "carries"@en ; rdfs:domain party:DataFlow ; rdfs:range rdf:langString ;
    skos:definition "What the flow carries, in a sentence."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:feeds a owl:ObjectProperty ;
    rdfs:label "feeds"@en ; rdfs:domain party:CustomerSystem ; rdfs:range party:CustomerSystem ;
    skos:definition "The system sends customer data to the other: the short form of a data flow."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:pidxProductFamily a owl:DatatypeProperty ;
    rdfs:label "PIDX product family"@en ; rdfs:domain party:Product ; rdfs:range xsd:string ;
    skos:definition "The one-letter family of PIDX's downstream product codes that the product's PIDX codes belong to. A plain identifier: PIDX publishes no IRIs, and a PIDX code names one company's traded grade, so the product is not mapped to PIDX codes."@en ;
    skos:scopeNote "Source: PIDX Downstream Product Codes, document 04-101-15-45-2010, file PIDX_ProductCodes_10_20_2026.xlsx from https://pidx.org/standards/ (retrieved 2026-10-23). Its Families sheet is dated 2015-09-29, and PIDX's notice of 2024-07-31 changed family S, so the letters are to be confirmed with PIDX (ontology/business-closeout.md, point 5). \u00a9 PIDX, Inc. 2023. Use of this copyrighted material is subject to the PIDX End User License Agreement available at www.pidx.org/license."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0064; EPM-DEC-001-0092"@en .

party:evidenceInput a owl:DatatypeProperty ;
    rdfs:label "evidence input"@en ; rdfs:range xsd:string ;
    skos:definition "The numbers of the decision owner's customer inputs that show the statement, as EPM-DEC-001-0067's Context lists them. The inputs are not in this repository."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0069"@en .

party:CustomerSourcing a owl:Class ;
    rdfs:label "customer sourcing"@en ;
    skos:definition "How a system relates to a kind of customer: the kind starts there, is set up there for a line of business, or comes from there."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:sourcingSystem a owl:ObjectProperty ;
    rdfs:label "sourcing system"@en ; rdfs:domain party:CustomerSourcing ; rdfs:range party:CustomerSystem ;
    skos:definition "The system."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:sourcingKind a owl:ObjectProperty ;
    rdfs:label "sourcing kind"@en ; rdfs:domain party:CustomerSourcing ; rdfs:range skos:Concept ;
    skos:definition "Origin, setup or source, from the sourcing-kind list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:sourcedConcept a owl:ObjectProperty ;
    rdfs:label "sourced concept"@en ; rdfs:domain party:CustomerSourcing ; rdfs:range skos:Concept ;
    skos:definition "The kind of customer: a party role, a customer class, a line of business or a party type."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:SystemAttribute a owl:Class ;
    rdfs:label "system attribute"@en ;
    skos:definition "A field a system keeps for a customer, in one of the decision owner's two categories: Create, which defines the customer in the system, or Enrich, which is added afterwards. Its label is the system's field name, with spelling corrected and repeats removed."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0069"@en .

party:inSystem a owl:ObjectProperty ;
    rdfs:label "in system"@en ; rdfs:domain party:SystemAttribute ; rdfs:range party:CustomerSystem ;
    skos:definition "The system that keeps the attribute."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:attributeCategory a owl:ObjectProperty ;
    rdfs:label "attribute category"@en ; rdfs:domain party:SystemAttribute ; rdfs:range skos:Concept ;
    skos:definition "Create or Enrich, from the attribute-category list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:describes a owl:ObjectProperty ;
    rdfs:label "describes"@en ; rdfs:domain party:SystemAttribute ; rdfs:range owl:Class ;
    skos:definition "The entity of the conceptual model the attribute is a fact about, or the system record for a field about the record itself."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

party:sharedAttribute a owl:ObjectProperty ;
    rdfs:label "shared attribute"@en ; rdfs:domain party:SystemAttribute ; rdfs:range skos:Concept ;
    skos:definition "The one thing several systems' attributes stand for under different names, from the shared-attribute list."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en .

# ---- The customer lifecycle (EPM-DEC-001-0070) ----

party:stageProcess a owl:ObjectProperty ;
    rdfs:label "stage process"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    skos:definition "A process of the core process scheme that does the work of the lifecycle stage. A process can serve several stages."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en .

party:stageSystem a owl:ObjectProperty ;
    rdfs:label "stage system"@en ; rdfs:domain skos:Concept ; rdfs:range party:CustomerSystem ;
    skos:definition "A customer system that holds the customer's record in the system stage."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en .

party:correspondsTo a owl:ObjectProperty ;
    rdfs:label "corresponds to"@en ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    skos:definition "A system stage that the business lifecycle stage spans: the two lifecycles describe the same customer life from the business side and the system side."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en .
