<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/offboarding> a skos:Concept ;
    skos:definition "The customer is suspended or closed and made inactive in the company's systems."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "offboarding" ;
    skos:prefLabel "Offboarding"@en ;
    skos:topConceptOf party:lifecycle-stage .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/onboarding> a skos:Concept ;
    skos:definition "The customer passes the credit and compliance checks and is set up in the company's systems: created and governed in the customer master, then replicated, enriched and activated in the systems that use it."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "onboarding" ;
    skos:prefLabel "Onboarding"@en ;
    skos:topConceptOf party:lifecycle-stage .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/payment-management> a skos:Concept ;
    skos:definition "The customer's payments are received and applied, and past-due amounts are collected."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "payment-management" ;
    skos:prefLabel "Payment management"@en ;
    skos:topConceptOf party:lifecycle-stage .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/prospect> a skos:Concept ;
    skos:definition "The company qualifies a prospective customer: it captures the prospect and collects its credit application, financial statements, bank information and tax ID."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "prospect" ;
    skos:prefLabel "Prospect"@en ;
    skos:topConceptOf party:lifecycle-stage .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/relationship-management> a skos:Concept ;
    skos:definition "The company manages the relationship: account reviews, the annual credit limit review, the customer portal and the territory manager."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "relationship-management" ;
    skos:prefLabel "Relationship management"@en ;
    skos:topConceptOf party:lifecycle-stage .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/risk-management> a skos:Concept ;
    skos:definition "The customer's credit exposure is watched against its limit, with news and ratings, and holds are applied when policy says so."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "risk-management" ;
    skos:prefLabel "Risk management"@en ;
    skos:topConceptOf party:lifecycle-stage .

