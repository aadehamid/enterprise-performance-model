[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The published series of the crack-spreads measure, from MPC Economics' definition first, with their benchmarks, regions, legs and RIN treatment; the prices the decision owner's pricing views report for the other pricing measures; and where each measure's complete list of series is (Step 7). Definitions only, never prices."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-25"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-25"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/1.2.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC Market Data Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/1.1.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.1.0"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/Benchmark",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "MPC FY2025 Form 10-K, Item 7 (business_architecture/reference/mpc/mpc-performance-measures-evidence.md, row 11); EPM-DEC-001-0057; EPM-DEC-001-0066"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "benchmark price"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A published price that a series is built from: a crude marker, a refined-product benchmark at a named market, or a compliance cost such as the RVO."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkKind",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "mpc-performance-measures-evidence.md, row 11; EPM-DEC-001-0066"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "benchmark kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The kinds of benchmark price a series is built from."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/compliance-cost"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/crude-marker"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/product-benchmark"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkSeries",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 31; EPM-DEC-001-0046, EPM-DEC-001-0057"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "benchmark series"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One published series of a market measure, identified by what it is built from: its region, its crude and product legs and their ratio, and what it leaves out. Two series of the same measure are different series when any of these differ."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/Leg",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0057"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "series leg"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One part of a series' recipe: a benchmark and the number of barrels of it."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/MarketPrice",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, items 4 and 5"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "market price"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A named market price that a pricing measure of the kpi module presents, as the decision owner's pricing views report it: a product price at a market, a crude differential, a futures settlement, or a renewables or NGL price. A definition, never a price."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/MarketRegions",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 4.1; EPM-DEC-001-0066"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "market regions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The product market regions of MPC Economics' published 3-2-1 crack series: USGC, Chicago, Group 3 (Tulsa), LA, PNW and SLC. They are price markets, not MPC's refining regions."
   }
  ],
