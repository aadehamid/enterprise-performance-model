 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/SeriesEnumeration",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, item 5"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "series enumeration"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Where the complete list of a measure's series is: a view and the columns that identify, name and group each series, with the rows' filter. The module names only examples; the view lists them all."
   }
  ]
 },
