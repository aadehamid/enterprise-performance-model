   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "MPC Economics' published LA 3-2-1 crack: three barrels of ANS crude against two barrels of LA gasoline and one of LA ULSD, with the RVO cost deducted from each product barrel."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/Series"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "crack-mpr-36855"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "LA 3-2-1 Crack ANS, ex-RIN"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Computed daily by MPC Economics' Ex-RVO formula, ((CBOB x 42 x 2) + (ULSD x 42 x 1)) / 3 - Crude - (RVO x 42), with product prices in dollars per gallon and crude in dollars per barrel; the monthly series is the mean of the daily published values (crack-spread-kpi-definition.md, sections 3.2 and 5.3). MPC's price data labels this treatment ex-RIN."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/market-data/excludesRINCost": [
