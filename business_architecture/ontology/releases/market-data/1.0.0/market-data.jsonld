 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/blendOf",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "MPC FY2025 Form 10-K, Item 7 (mpc-performance-measures-evidence.md, row 10)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkSeries"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "blend of"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkSeries"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A series the blended series is weighted from. The weights are stated in the series' scope note, with their source and period, because they change."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/excludesRINCost",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "MPC FY2025 Form 10-K, Item 7: the crack spreads \"do not reflect the market cost of RINs\" (mpc-performance-measures-evidence.md, row 10); MPC Economics, 3-2-1 Crack Spread KPI Definition, section 3 (reference/internal/crack-spread-kpi-definition.md); competency question 31"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkSeries"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "excludes RIN cost"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#boolean"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "True when the series does not reflect the market cost of RINs, as MPC's 10-K crack spreads do not (MPC Economics' Inc-RVO treatment). False when the series deducts the RVO cost (MPC Economics' Ex-RVO treatment, which MPC's price data labels ex-RIN). A series with RIN costs and one without are different series."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The labels run opposite to this property's name: an ex-RIN series deducts the RVO cost, so it has false here (EPM-DEC-001-0066)."
   }
  ]
 },
