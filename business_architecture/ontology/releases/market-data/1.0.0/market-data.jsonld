   {
    "@value": "compliance-cost"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Compliance cost"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/crude-marker",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A published crude oil price that a crack spread uses for its crude leg."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "crude-marker"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Crude marker"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/product-benchmark",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A published refined-product price at a named market, used for a crack spread's product legs."
