   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "benchmark"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/Benchmark"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The benchmark price the leg uses."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/compliance-cost",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 3.2; EPM-DEC-001-0066"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A published per-gallon compliance cost, such as the RVO, that an Ex-RVO crack deducts from each product barrel."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/BenchmarkKind"
