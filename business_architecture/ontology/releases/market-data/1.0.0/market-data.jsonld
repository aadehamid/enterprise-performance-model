  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "MPC Economics' published SLC 3-2-1 crack, a WTI crack, with the RVO cost deducted. The definition does not list its input legs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/Series"
