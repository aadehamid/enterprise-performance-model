@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/lsc/ontology/catalog> a dcat:Catalog ;
    dcat:dataset <https://w3id.org/lsc/ontology/modules/organization/1.0.0-rc.1> .

<https://w3id.org/lsc/ontology/modules/organization/1.0.0-rc.1> a dcat:Dataset ;
    dcterms:isVersionOf <https://w3id.org/lsc/ontology/modules/organization> ;
    dcterms:title "LSC Organization Module 1.0.0-rc.1"@en ;
    owl:versionInfo "1.0.0-rc.1" ;
    dcat:distribution <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.jsonld>,
        <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.ttl>,
        <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/shapes.ttl> .

<https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.jsonld> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/organization.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/shapes.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/organization/releases/1.0.0-rc.1/shapes.ttl> ;
    dcat:mediaType "text/turtle" .

