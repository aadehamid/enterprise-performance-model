[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "Roles, RACI responsibility assignments and control between legal entities (Step 5)."
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/1.0.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC Organization Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/organization/1.0.0-rc.1"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.0.0-rc.1"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization/ControlRelationship",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 5; EPM-DEC-001-0015, EPM-DEC-001-0020, EPM-DEC-001-0030"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "control relationship"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One legal entity's control of another, with the ownership share, the date it held and its source. A node of its own because it carries a share and a date. Separate from org:subOrganizationOf, which means a unit inside one organization."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization/RaciLevel",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "The four levels as the process authority uses them: business_architecture/business_process/downstream_process_map.json, raci (responsible, accountable, consulted, informed). Generic support only: PMI, Roles, responsibilities, and resources (https://www.pmi.org/learning/library/best-practices-managing-people-quality-management-7012), which names the RACI chart."
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "RACI level"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The four kinds of design-time responsibility a role can have on a process."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization/ResponsibilityAssignment",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 5; EPM-DEC-001-0030"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "responsibility assignment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One role's RACI level on one process, as designed: who is responsible, accountable, consulted or informed. A node of its own, because a single property cannot bind a role, a process and a level together. Design-time responsibility, not a record of who did the work."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization/asOf",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 5 (cite a source and an as-of date for each fact); EPM-DEC-001-0030"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/organization/ControlRelationship"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "as of"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#date"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The date the source states the relationship held."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/organization/assignedRole",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 5; EPM-DEC-001-0030"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/organization/ResponsibilityAssignment"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "assigned role"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/ns/org#Role"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The role that holds the RACI level. A role is a position people hold, not a person."
   }
  ]
 },
