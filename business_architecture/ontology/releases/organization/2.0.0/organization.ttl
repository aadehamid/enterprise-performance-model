<https://w3id.org/lsc/ontology/modules/organization> a owl:Ontology ;
    dcterms:description "Roles, RACI responsibility assignments and control between legal entities (Step 5)."@en ;
    dcterms:issued "2026-10-18"^^xsd:date ;
    dcterms:modified "2026-10-18"^^xsd:date ;
    dcterms:requires <https://w3id.org/lsc/ontology/modules/core/2.0.0> ;
    dcterms:title "LSC Organization Module"@en ;
    owl:versionIRI orgm:2.0.0 ;
    owl:versionInfo "2.0.0" .

orgm:asOf a owl:DatatypeProperty ;
    rdfs:label "as of"@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5 (cite a source and an as-of date for each fact); EPM-DEC-001-0030"@en ;
    rdfs:domain orgm:ControlRelationship ;
    rdfs:range xsd:date ;
    skos:definition "The date the source states the relationship held."@en .

orgm:assignedRole a owl:ObjectProperty ;
    rdfs:label "assigned role"@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5; EPM-DEC-001-0030"@en ;
    rdfs:domain orgm:ResponsibilityAssignment ;
    rdfs:range org:Role ;
    skos:definition "The role that holds the RACI level. A role is a position people hold, not a person."@en .

