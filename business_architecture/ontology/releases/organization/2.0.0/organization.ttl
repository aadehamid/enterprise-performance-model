orgm:ControlRelationship a owl:Class ;
    rdfs:label "control relationship"@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5; EPM-DEC-001-0015, EPM-DEC-001-0020, EPM-DEC-001-0030"@en ;
    skos:definition "One legal entity's control of another, with the ownership share, the date it held and its source. A node of its own because it carries a share and a date. Separate from org:subOrganizationOf, which means a unit inside one organization."@en .

orgm:RaciLevel a skos:ConceptScheme ;
    rdfs:label "RACI level"@en ;
    dcterms:bibliographicCitation "The four levels as the process authority uses them: business_architecture/business_process/downstream_process_map.json, raci (responsible, accountable, consulted, informed). Generic support only: PMI, Roles, responsibilities, and resources (https://www.pmi.org/learning/library/best-practices-managing-people-quality-management-7012), which names the RACI chart."@en ;
    skos:definition "The four kinds of design-time responsibility a role can have on a process."@en .

