raci:accountable a skos:Concept ;
    skos:definition "Answers for the outcome of the process and signs it off."@en ;
    skos:inScheme orgm:RaciLevel ;
    skos:notation "A" ;
    skos:prefLabel "Accountable"@en .

raci:responsible a skos:Concept ;
    skos:definition "Does the work of the process."@en ;
    skos:inScheme orgm:RaciLevel ;
    skos:notation "R" ;
    skos:prefLabel "Responsible"@en .

raci:informed a skos:Concept ;
    skos:definition "Is told of progress or the result, in one-way communication."@en ;
    skos:inScheme orgm:RaciLevel ;
    skos:notation "I" ;
    skos:prefLabel "Informed"@en .

raci:consulted a skos:Concept ;
    skos:definition "Gives input before or during the work, in two-way communication."@en ;
    skos:inScheme orgm:RaciLevel ;
    skos:notation "C" ;
    skos:prefLabel "Consulted"@en .

orgm:ResponsibilityAssignment a owl:Class ;
    rdfs:label "responsibility assignment"@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5; EPM-DEC-001-0030"@en ;
    skos:definition "One role's RACI level on one process, as designed: who is responsible, accountable, consulted or informed. A node of its own, because a single property cannot bind a role, a process and a level together. Design-time responsibility, not a record of who did the work."@en .

src:downstream-process-map a dcterms:BibliographicResource ;
    dcterms:title "Downstream process map, business_architecture/business_process/downstream_process_map.json"@en .

