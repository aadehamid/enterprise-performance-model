[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The Commercial Hydrocarbon Lifecycle and Order to Cash value streams: their stages, capabilities and value-stream processes, which realize core processes, produce and consume data products and carry cited measure links (Step 7)."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-22"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-22"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/2.2.0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/1.0.0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/1.0.1"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC Value Stream Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/1.0.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.0.0"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/Capability",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "capability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An enduring ability the business needs, which a value stream's stages use and which processes realize. Reusable across value streams."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/MeasureLink",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json, measures; EPM-DEC-001-0047 (MPC-P09)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "measure link"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A cited link between a value-stream process and a measure of the kpi module, with the kind of relationship. Context for where the measure is used, not a KPI designation and not a certification of the process."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/MeasureRelationship",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "measure relationship"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The three ways a value-stream process can relate to a measure."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/Stage",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "value-stream stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One step of a value stream, in a fixed sequence, grouping the value-stream processes done in it."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/ValueStream",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json; ontology-playbook.md, Step 7; EPM-DEC-001-0054"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "value stream"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An end-to-end sequence of stages that delivers an outcome, from a trigger, cutting across the process hierarchy. It references processes; it is never their parent."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/schema/value_stream.schema.json, $defs.process"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "value-stream process"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A unit of work in a value-stream stage, as the value stream's source names it. It uses one capability and realizes the process-map processes its source names, which it references by IRI; the source may name none."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/alignsToProcessGroup",
