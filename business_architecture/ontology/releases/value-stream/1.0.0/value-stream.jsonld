   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to analyze the costs of customers against the revenue they provide, and generate insights that may inform changes or adjustments in commercial terms in specific accounts or more broadly inform the strategy associated with commercial terms."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-analyze-customer-profitability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
