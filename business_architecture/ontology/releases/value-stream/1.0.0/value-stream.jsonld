   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
