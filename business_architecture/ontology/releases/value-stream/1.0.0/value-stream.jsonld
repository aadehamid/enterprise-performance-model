   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/master-pricing"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/rack-pricing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-billing"
   }
  ]
 },
 {
