    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-close"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-create-credit-memo-chargeback",
