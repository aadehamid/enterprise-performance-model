   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-collections"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-initiate-legal-action",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process includes the sub-processes associated with initiating and managing customer accounts where legal action has or is to be taken to address unpaid balances."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-initiate-legal-action"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Initiate Legal Action"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-collections"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-issue-quotes-renewals",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to initiate, issue and close quotes and renewals when requested by, or targeted to the customer for a particular product and service. It also includes managing responses to RFPs and creating sale contracts."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-issue-quotes-renewals"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Issue Quotes & Renewals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/consumes": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/master-pricing"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/product-availability-allocations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-quote-sale"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-commercial-policies",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with maintaining the underlying policies associated with commercial terms (e.g., payment terms, discounts, rebates).  It aims at establishing a common standard understanding of the commercial terms to establish contracts between seller, partners, and buyer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-commercial-policies"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Commercial Policies"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-quote-sale"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-credit-policies",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to maintain the customer credit policies and aims at driving the strategic and tactical use of credit as a tool to support the sales strategy while managing credit related losses (i.e., bad debt) to the desired target."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-credit-policies"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Credit Policies"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-customer-credit"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-customer-master",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with the creation of a new customer and/or maintenance of current customers master data attributes.  The customer master retains the fundamental attributes that enable key activities across Orders & Fulfilment (e.g., order validation), Billing (e.g., invoice generation) and other areas across O2C (e.g., taxation)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-customer-master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Customer Master"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-master-data-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-price-discount-master",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with managing and maintaining attributes associated with prices and discounts.  The maturity level of this environment influences directly the volume and impact of price related disputes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-price-discount-master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Price & Discount Master"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/consumes": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/master-pricing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-master-data-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-product-master",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process contains the sub-processes associated with creating and maintaining all the product related attributes and is a key component supporting the order in-take supporting validation and accuracy."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-product-master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Product Master"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-master-data-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-tax-master",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to populate and maintain key master data attributes that supports the effective and accurate calculation of indirect tax - which is usually maintained within a bolt-on environment outside of the customer and product master data environment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-tax-master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Tax Master"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-master-data-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-workflows",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to manage the rules and hierarchy associated with functioning of workflows across O2C - and it is fundamental to support enforcement of controls and approval hierarchy."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-maintain-workflows"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Workflows"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-master-data-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-manage-fulfillment",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process contains the sub-processes associated with fulfilling orders.  It is largely focused on the interactions between the order management team and the fulfillment team in support of accuracy, timeliness, and exceptions resolution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-manage-fulfillment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Fulfillment"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/consumes": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/logistic-execution"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-order-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-manage-returns",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with managing product returns - including setting returns budget for return to stock (RTS) products as well as receiving, approving, and creating the return authorization (RA) across all return types (e.g., RTS, defective, shipment integrity)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-manage-returns"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Returns"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-order-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-manage-unapplied-receipts",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with identifying and addressing unapplied receipts.  This includes activities associated with identifying, evaluating and addressing exceptions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-manage-unapplied-receipts"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Unapplied Receipts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-cash-application"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-monitor-credit-against-limit",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to monitor, evaluate, and release credit order blocks - i.e., orders “held” in queue due to systematic holds triggered by credit based violations usually set based on the credit risk category (a customer master attribute).  It also triggers potential reviews and revisions of the credit limit."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-monitor-credit-against-limit"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Monitor Credit Against Limit"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-customer-credit"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-negotiate-settlements",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process includes the sub-processes associated with negotiated settlements with customers who are in an overdue position.  Reviews and approvals are sometimes part of the settlement process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-negotiate-settlements"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Negotiate Settlements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-collections"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-perform-appeasements",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to review, approve, issue, and manage customer / consumer related appeasement / concessions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-perform-appeasements"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Appeasements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-disputes"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-perform-reconciliations-settlements",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with performing reconciliations and settlements largely associated with highly transactional environments where high frequency reconciliations (e.g., daily) are a key component of managing and conducting business (e.g., sales audit, credit card settlements, rebate settlements)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-perform-reconciliations-settlements"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Reconciliations & Settlements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-cash-application"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-perform-revenue-accounting",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to review contracts to determine appropriate GAAP treatment and book the entries including revenue recognition, accruals (e.g., shipped but not billed) and to calculate, evaluate and record revenue impacting provisions or reserves (e.g., product returns, post-invoice discounts)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-perform-revenue-accounting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Revenue Accounting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-close"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-process-bad-debt",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with calculating, evaluating, and determining proper bad debt reserve levels and recording respective accrual to bring bad debt reserves to required levels"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-process-bad-debt"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Process Bad Debt"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-close"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-receive-payments",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with the receiving of customer payment information - usually through a bank lock-box interface.  This is a fundamental input to support the cash application process (i.e., apply receipts)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-receive-payments"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Receive Payments"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/consumes": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/retail-payments"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-cash-application"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-receive-remittance-advice",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with receiving of customer remittance information to support effective and efficient execution of cash application activities (i.e., apply receipts)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-receive-remittance-advice"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Receive Remittance Advice"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-cash-application"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-receive-validate-queries",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to receive and validate a customer query / claim. A customer query / claim is usually associated with perceived errors associated with products (e.g., product type, quantity of products) which are largely classified as “shipment integrity” claims or pricing and discounts."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-receive-validate-queries"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Receive & Validate Queries"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/consumes": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/product/loss-control"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-disputes"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-reconcile-indirect-tax",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to reconcile indirect taxes and identify and resolve unreconciled items."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-reconcile-indirect-tax"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Reconcile Indirect Tax"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-close"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-review-credit-limit-risk-code",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to review the existing customers' creditworthiness to revise the customer's credit limit and risk code.  The credit assessment is conducted based on information from customer financials, third party credit agencies and past order / credit history with the organization."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-review-credit-limit-risk-code"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Review Credit Limit & Risk Code"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Present in the O2C process with a definition; no dedicated L5 in LSC. Closest: Monitor Credit Against Limit (CM 1.3.7.4.3)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-customer-credit"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-root-cause-action-plan",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with analyzing valid claims and deductions with the purpose of identifying the root cause and inform upstream processes to take corrective action.  This is a fundamental capability needed to support continuous improvement across the end-to-end O2C process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-root-cause-action-plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Root Cause Analysis & Action Plan"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-maintain-commercial-policies"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-disputes"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-track-forecast-order",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to monitor the customer order status and respond to their inquiries including backorder management.  Additionally, the process also includes the use of the order book as a predictor of product demand and revenues."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-track-forecast-order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Track & Forecast Order"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-order-management"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-validate-deductions",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to initiate, analyze, and approve deductions. Deductions are initiated by the customer upon payment and are consequently managed and monitored. A valid and approved deduction requires no action while an invalid or rejected deduction triggers the action of a charge back to the customer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
