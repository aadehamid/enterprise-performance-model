   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with applying customer payments to the respective open invoices, clearing the AR sub-ledger."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
