   {
    "@language": "en",
    "@value": "This process contains the sub-processes to close the AR sub ledger and reconcile to the GL.  In addition, it includes addressing unreconciled items and booking adjustments as needed (e.g., unapplied cash)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
