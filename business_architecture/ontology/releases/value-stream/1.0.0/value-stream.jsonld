   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to determine the proper taxability of invoices to support the calculation and reporting of tax related transactions and record tax liabilities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
