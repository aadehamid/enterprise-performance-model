   {
    "@language": "en",
    "@value": "This process group houses the processes involved in the close of the sub ledger, including rev rec, AR and revenue related provisions, and reconciliations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
