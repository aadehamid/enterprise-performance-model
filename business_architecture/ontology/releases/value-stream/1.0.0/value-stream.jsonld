   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to define payment methods and financing options being made available to the customers in the stages leading to pricing and quoting activities with the potential customers."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-define-financing-payment-methods"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Financing & Payment Methods"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-quote-sale"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-determine-taxability",
