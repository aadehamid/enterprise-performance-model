    "@language": "en",
    "@value": "This process contains the sub-processes that trigger the creation of the invoice (e.g., billing due list), record revenue and AR, as well as distribute the customer invoice.  This is largely an automated environment with exception handling activities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
