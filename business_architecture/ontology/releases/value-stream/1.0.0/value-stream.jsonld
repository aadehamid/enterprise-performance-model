   {
    "@language": "en",
    "@value": "This process group houses the processes involved in assessing, measuring, and managing credit risk. It also includes maintaining policies and analyzing portfolio credit risk."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
