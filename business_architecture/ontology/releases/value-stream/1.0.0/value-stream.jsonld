   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-analyze-customer-profitability",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
