   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Determine Taxability & Record Tax Liabilities"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-billing"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-develop-monitor-revenue-plan",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to develop and monitor the revenue plan on the basis of past, actual and expected future sales, to guide quote development, support product allocation, and promotion development.  Additionally, this is a key part of monthly, quarterly, and annual planning and forecasting processes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-develop-monitor-revenue-plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop & Monitor Revenue Plan"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-quote-sale"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-establish-collection-targets",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to determine collection targets used to optimize collections activities. This allows operations to focus resources on the accounts that are most likely to pay and help improve the effectiveness of the collections process by recovering a higher amount of outstanding balances."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-establish-collection-targets"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Establish Collection Targets"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-collections"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-establish-commercial-terms-contracts",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to establish and execute commercial contracts, licenses, agreements with customers and/or partners.  It incorporates the steps of drafting, approving, executing and sending the commercial contract with the commercial terms and conditions to be included in commercial contracts."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-establish-commercial-terms-contracts"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Establish Commercial Terms & Contracts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-quote-sale"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-establish-credit-limit-risk-code",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to assess the customer's creditworthiness in order to establish the customer's credit limit and assign a risk code (e.g., risk rating and risk category). The credit assessment is largely based on customer financials and third party credit agency scores."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-establish-credit-limit-risk-code"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Establish Credit Limit & Risk Code"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-customer-credit"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-execute-collections",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/value-stream/ValueStreamProcess"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated with collecting overdue receivables thru engagement with customers."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-execute-collections"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
