    "@id": "https://w3id.org/lsc/ontology/source/value-stream-order-to-cash"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes associated analyzing and developing insights associated with the health of the AR portfolio.  Additionally, contains the sub-processes for defining and refining the parameters for risk tolerances within the portfolio as well as approvals and escalations for exceptions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-analyze-portfolio-credit-risk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
