   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process group houses the processes involved in the execution of receiving and applying payments, settling other tender type transactions (e.g., credit cards), and performing high frequency reconciliations (e.g., daily) in the course of the business."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
