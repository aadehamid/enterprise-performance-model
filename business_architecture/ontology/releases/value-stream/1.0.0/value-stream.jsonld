   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-customer-credit"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-apply-receipts",
