   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "This process contains the sub-processes to create exception invoices - either driven by billing errors or by the need to, on an exception basis, create a manual invoice."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "p-otc-create-exception-invoice"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create Exception Invoice"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/realizes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/value-stream/usesCapability": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/value-stream/capability/otc-billing"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/value-stream/process/otc-customer-closure-reinstatement",
