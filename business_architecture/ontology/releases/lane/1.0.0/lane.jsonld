    "@value": "One of the four office lanes of the trading organization."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/lane/OfficeLanes",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/business_process/office_lanes.json; EPM-DEC-001-0056"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "office lanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The four office lanes of the trading organization: front office, middle office, back office and operations. The lanes are not declared disjoint."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/lane/lane/back-office",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/lane/OfficeLane"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/office-lanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administrative and operational completion of the trade lifecycle: settlements, invoicing and netting, accounting and sub-ledger management, regulatory reporting, dispute resolution, and record-keeping."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/lane/OfficeLanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "back_office"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Back Office"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/lane/lane/front-office",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/lane/OfficeLane"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/office-lanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Revenue-generating, market-facing functions of the trading organization: trading and deal execution, forecasting, pre-trade analysis, bidding strategy, and customer/counterparty engagement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/lane/OfficeLanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "front_office"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Front Office"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/lane/lane/middle-office",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/lane/OfficeLane"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/office-lanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Control and analytical layer between front and back office: monitors market and credit risk and exposure, validates captured trades, calculates P&L, manages confirmations and scenario modelling, and enforces risk limits, controls, and compliance."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/lane/OfficeLanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "middle_office"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Middle Office"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/lane/lane/operations",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/lane/OfficeLane"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/office-lanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Physical supply chain execution supporting the traded book: scheduling, movement actualization, feedstock and product inventory management, transportation, and terminal operations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/lane/OfficeLanes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Operations"
   }
  ]
 },
