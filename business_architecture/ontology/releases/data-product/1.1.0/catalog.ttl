@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lsc/ontology/catalog> a dcat:Catalog ;
    dcat:dataset <https://w3id.org/lsc/ontology/modules/data-product/1.1.0> .

<https://w3id.org/lsc/ontology/modules/data-product/1.1.0> a dcat:Dataset ;
    dcterms:isVersionOf <https://w3id.org/lsc/ontology/modules/data-product> ;
    dcterms:issued "2026-10-23"^^xsd:date ;
    dcterms:title "LSC Data Product Module 1.1.0"@en ;
    owl:versionInfo "1.1.0" ;
    dcat:distribution <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.jsonld>,
        <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.ttl>,
        <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/shapes.ttl> .

<https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.jsonld> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/data-product.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/shapes.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/data-product/releases/1.1.0/shapes.ttl> ;
    dcat:mediaType "text/turtle" .

