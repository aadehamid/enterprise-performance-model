[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The data products of the portfolio, the product lines and segments that group them, and the processes that produce them; and the pricing tables and views on the data platform, foundational or derived, with their lineage and the Genie agents that use them (Step 7). Definitions only, never data values; mapped to DCAT, not imported."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-25"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-25"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/2.3.0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/1.2.0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/1.2.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC Data Product Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/1.2.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.2.0"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProduct",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/business_process/data_product_portfolio.json; W3C Data Catalog Vocabulary (DCAT) Version 3, W3C Recommendation, 22 August 2024; EPM-DEC-001-0053"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data product"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#closeMatch": [
   {
    "@id": "http://www.w3.org/ns/dcat#Dataset"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A named, governed set of data that a business area publishes for others to use, defined by what it covers. A definition, never the data: the platforms that hold the data product hold its records."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Mapped to DCAT 3's dcat:Dataset with skos:closeMatch, not imported (EPM-DEC-001-0023). A data product here is the business definition; a DCAT dataset record of it would describe one published release of its data."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductKind",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, item 14"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data product kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The two kinds of data product, told apart by what they are built from and what logic they add."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/kind/derived"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/kind/foundational"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductLine",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/business_process/data_product_portfolio.json; EPM-DEC-001-0053"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data product line"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A group of related data products in one segment of the portfolio, such as Energy Trading & Risk Management."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProducts",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "business_architecture/business_process/data_product_portfolio.json"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data product portfolio"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The portfolio's segments, data product lines and data products, as one hierarchy: a data product's skos:broader is its line, and a line's is its segment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/segment/commercial"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/segment/corporate"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/segment/midstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/Layer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, item 8"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "platform layer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The layers of the decision owner's data platform, in their names, each built from the one before."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/gold"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/metric-view"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/replica"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/silver"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/PlatformColumn",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, item 11"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "platform column"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A value column of a platform table, recorded only where its lineage is recorded: the price columns."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/PlatformDataProduct",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, items 13 to 15"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "platform data product"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A platform table or view that is published as a governed data product, as part of a data product of the portfolio, and classified as foundational or derived. A replica table is a platform table but not a platform data product: it copies a system's own records."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/PlatformTable",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, items 7 and 8"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "platform table"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A table or view on a data platform, named by its full name (catalog, schema and name), in one layer of the platform: replica, silver, gold or metric view. A definition of the table, never its rows."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/PlatformTables",
