   {
    "@language": "en",
    "@value": "layer"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The platform layer the table is in, from the layer code list."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/gold",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Tables that join and calculate silver data for a known group of consumers."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/Layer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "gold"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Gold"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/Layer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/metric-view",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A view that defines measures, once, over a gold or silver table, which consumers such as Genie agents query."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/Layer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "metric-view"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Metric view"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/Layer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer/replica",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
