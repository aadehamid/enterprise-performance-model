   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The table's or view's full name on its platform: catalog, schema and name."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/kind/derived",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/databricks-medallion-architecture"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/datamesh-architecture-innoq"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/dehghani-data-mesh-2019"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/odps-4-0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/purview-data-products"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/w3c-prov-o"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A governed data product built from one or more other data products, adding business logic (aggregation, calculation, measures or a model for a use case) for a known group of consumers."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "derived"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Derived data product"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Inputs: other data products. Logic: aggregation, calculation and measures. Consumers: fitted to a group of use cases. Owner: the consuming team. Rate of change: changes more often, and can be rebuilt from its sources. Gold tables and metric views are derived."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductKind"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/kind/foundational",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/databricks-medallion-architecture"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/datamesh-architecture-innoq"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/dehghani-data-mesh-2019"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/odps-4-0"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/purview-data-products"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/w3c-prov-o"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A governed data product that publishes the facts or master data of one business domain, built only from the operational systems of record, with transformations limited to cleansing, validation, conforming and identity resolution, and not modelled for a particular consumer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "foundational"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Foundational data product"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Inputs: operational systems, not other data products. Logic: cleansing and conforming only. Consumers: not fitted to one. Owner: the source or domain team. Rate of change: stable. Silver tables are foundational."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProductKind"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/data-product/layer",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0097, item 8"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/PlatformTable"
   }
  ],
