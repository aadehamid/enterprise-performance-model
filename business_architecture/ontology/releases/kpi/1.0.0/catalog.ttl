@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lsc/ontology/catalog> a dcat:Catalog ;
    dcat:dataset <https://w3id.org/lsc/ontology/modules/kpi/1.0.0> .

<https://w3id.org/lsc/ontology/modules/kpi/1.0.0> a dcat:Dataset ;
    dcterms:isVersionOf <https://w3id.org/lsc/ontology/modules/kpi> ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    dcterms:title "LSC KPI Module 1.0.0"@en ;
    owl:versionInfo "1.0.0" ;
    dcat:distribution <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.jsonld>,
        <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.ttl>,
        <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/shapes.ttl> .

<https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.jsonld> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/kpi.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/shapes.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/kpi/releases/1.0.0/shapes.ttl> ;
    dcat:mediaType "text/turtle" .

