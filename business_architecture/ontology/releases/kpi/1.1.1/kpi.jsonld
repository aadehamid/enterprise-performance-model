    "@language": "en",
    "@value": "Plans the prompt month for the region's refineries from the latest schedule, and watches hourly and daily execution against it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
