   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-2-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
   {
