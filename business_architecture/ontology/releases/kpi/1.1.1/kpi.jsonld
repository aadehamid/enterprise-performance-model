 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/clean-product-make",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 p. 53; DP-01 p. 42"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "clean products production"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Total clean product output by refinery over the plan horizon."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "clean-product-make"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Production Make (Clean Products)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not a yield: it is a volume."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "clean products production (bbl/d)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Clean product output by refinery. Phillips 66 sets a clean product yield target, which would make a yield ratio a candidate at that company, but the list's measure is a volume with no target."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "distribution plan; prior forecast"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "daily and month to date, by refinery"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 5 (yields); Phillips 66 clean product yield target"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/distribution-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/crack-spreads",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 Item 7 pp. 46, 51; KI-27; KI-28"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "3-2-1 crack"
   },
   {
    "@language": "en",
    "@value": "crack spread"
   },
   {
    "@language": "en",
    "@value": "the crack"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Benchmark crack spreads: the market value of products made from a set ratio of crude, less the crude's price."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "crack-spreads"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Crack Spreads Pricing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not realized refinery margin, not margin capture, and not MPC's R&M Margin Indicator. A 3-2-1 built from separate product and crude legs is not the published series."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "products price - crude price, for a stated crude:product ratio (for example 3-2-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC files crack spreads under market indicators and calls margins dependent on factors beyond its control. The list's cracks (NYMEX 3-2-1, USGC 3-2-1 MEH ex-RIN, Chicago WTI 3-2-1 ex-RIN) are benchmarks, not performance."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "30-day trend; 5-year history"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "daily, by market hub"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/market-indicator"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/margin-capture"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/rm-margin-indicator"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/rm-margin-per-barrel"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 10 (Gulf Coast, Mid-Continent, West Coast and blended 3-2-1 cracks)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/distribution-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/prompt-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/short-term-planner"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/population/excludes": [
   {
    "@language": "en",
    "@value": "The market cost of RINs, in MPC's 10-K regional and blended crack spreads."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/population/includes": [
   {
    "@language": "en",
    "@value": "The crude and product benchmarks of each series' recipe (the market-data module's series)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/population/populationEvidence": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "mpc-performance-measures-evidence.md, row 10"
   }
  ]
 },
