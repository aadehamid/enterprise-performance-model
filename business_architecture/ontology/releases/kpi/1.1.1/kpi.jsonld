   {
    "@language": "en",
    "@value": "historical product make vs MTP"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The submitted mid-term plan for a month compared with the same month's average over prior years, by product (crude, gasoline, diesel, jet)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "plan-vs-historical-averages"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Current Plan vs. Historical Averages (Crude, Gas, Diesel, Jet)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "plan volume against the same-month average of 2 to 5 prior years"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "The submitted plan compared with history for the same month. A comparison of a plan with a reference, used to test the plan, not to score performance."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "same-month average over prior years"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "monthly, by refinery and product"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-6-1"
   }
  ],
