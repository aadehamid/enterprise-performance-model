 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/turnaround-cost-per-barrel",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 p. 85; VT-26; VT-28"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/mpc-performance-measures-evidence"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "turnaround cost per barrel"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Planned turnaround and major maintenance costs, expensed as incurred, per barrel of net refinery throughput."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "turnaround-cost-per-barrel"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Planned Turnaround Costs per Barrel"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not refining operating costs per barrel, which exclude planned turnaround costs. Also not an annualized turnaround cost: MPC expenses turnarounds when incurred, so the figure rises in heavy turnaround years."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "planned turnaround costs ($) / throughput (bbl)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Expensed as incurred, so it rises in heavy turnaround years; an annualized cost (Solomon) compares years and peers more fairly. A turnaround outcome the Mid-Term Planner's sequencing affects (Part B, Q9)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "quarterly guidance; prior periods"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "quarterly and annual, company and region"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L2-refinery-asset-reliability-and-turnaround-coordination"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/refining-opex-per-barrel"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 16"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/mid-term-planner"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/population/includes": [
   {
    "@language": "en",
    "@value": "Planned turnaround and other major maintenance costs, expensed in the period incurred: contractor repair services, materials and supplies, equipment rentals and MPC's labor costs."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/population/populationEvidence": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "mpc-performance-measures-evidence.md, row 16"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/turnaround-lost-margin",
