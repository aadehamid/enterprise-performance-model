    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "crude-utilization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Crude Utilization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not unit utilization: it covers only the fresh crude charged to the crude units. Also not MPC's published figure, which is company-wide and uses average calendar-day capacity."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "crude throughput (bbl/d) / constrained crude capacity (bbl/d); MPC divides by average calendar-day capacity"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Crude unit utilization is the headline refining measure that MPC, EIA and Solomon report and that Phillips 66 targets, so it is the strongest candidate. It stays an operational metric until a target and owner are recorded. The planner's denominator (constrained capacity) differs from MPC's (average calendar-day capacity)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "submitted mid-term plan; same month in prior years (2 to 5 years)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "monthly, by refinery"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-6-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/unit-utilization"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 2 (crude oil capacity utilization, average calendar-day capacity)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/mid-term-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/crude-value-to-breakeven",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "VT-01; VT-02; VT-04; VT-09; VT-12; VT-20"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "V2Be"
   },
   {
    "@language": "en",
    "@value": "incremental crude value"
   },
   {
    "@language": "en",
    "@value": "variance to breakeven"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A screen of each crude's breakeven value from the planning model against its delivered price, by refinery, to pick incremental barrels for a full evaluation."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "crude-value-to-breakeven"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Crude Value to Breakeven"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not a measure of how well crude was bought: that is margin capture or a backcast."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "breakeven value ($/bbl) against delivered price ($/bbl)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "A crude-selection screen: each crude's breakeven value from the LP model against its delivered price, flagging incremental barrels for a full LP evaluation. It moves with the market and starts a decision; it has no target. The decision owner asked for this to be researched (Part B, Q8)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "delivered crude price"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "monthly, by refinery and crude"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/decision-support-indicator"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/margin-capture"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "none (MPC names crude selection as a lever; margin capture is its after-the-fact counterpart)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/prompt-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/demand-vs-forecast",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "KI-25; KI-26; KI-23"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "sales vs forecast"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Actual sales less forecast sales for the period, against the plan version named."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "demand-vs-forecast"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Demand vs. Forecast"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not forecast accuracy over many periods, which would be a separate measure."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "actual demand - forecast demand (bbl)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Actual sales less forecast for one period. A single-period gap is a diagnostic (Gartner Correct tier). Forecast accuracy over many periods, with a target, could be a KPI (Gartner puts it top-tier as a driver); that would be a separate measure."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "distribution plan; short-term LP plan; mid-term vs short-term plan"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "daily and month to date, by product and region"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/plan-variance-diagnostic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 18 (refined product sales volumes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/distribution-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/mid-term-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/prompt-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/short-term-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/distillate-prices",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 p. 51; KI-27"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "ULSD prices"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Benchmark distillate and jet spot prices at named hubs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "distillate-prices"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Distillate Market Pricing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "$/gal as published"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Benchmark distillate prices (NYH, USGC and Chicago ULSD; USGC jet). External market observations."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "30-day trend; 5-year history"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "daily, by hub"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/market-indicator"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 11 (benchmark spot prices)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/distribution-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/prompt-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/short-term-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/distillate-yield",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 p. 53; KI-04"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "diesel yield"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Distillate produced (ULSD, kerosene, jet) as a share of crude and feed charged."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "distillate-yield"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Distillate Yield"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not distillate sales: it counts production."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "distillate production (bbl) / total crude and feed charged (bbl) x 100"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Distillate output as a share of crude and feed charged. MPC reports yields as operating statistics, not as key measures; no target or owner is recorded."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "opening forecast plan; latest weekly schedule; short-term LP plan; distribution plan"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "daily and month to date, by refinery"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": false
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/publicCounterpart": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC 5 (distillates, mbpd)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/usedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/distribution-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/prompt-planner"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/persona/short-term-planner"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/distribution-cost-per-barrel",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S01 pp. 46, 51, 52"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/mpc-performance-measures-evidence"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Distribution costs, excluding depreciation and amortization, per barrel of net refinery throughput; mostly long-term agreements with MPLX."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
