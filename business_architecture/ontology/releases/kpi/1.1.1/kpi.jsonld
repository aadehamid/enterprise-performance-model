   {
    "@language": "en",
    "@value": "TAR tracker"
   },
   {
    "@language": "en",
    "@value": "turnaround tracker"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A list of turnaround activities planned for the next four months, by refinery."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "tar-activities-tracker"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "TAR Activities Tracker"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not a turnaround optimization: it tracks the activities already planned."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "A list of turnaround activities for the next four months. The Mid-Term Planner's turnaround work is optimization of windows and sequence, not tracking (Part B, Q9); its measures are listed separately below."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "next 4 months"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
