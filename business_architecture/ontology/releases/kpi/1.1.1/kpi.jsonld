 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/unit-utilization",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "KI-04; KI-26; KI-13; MPC-S01"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/planner-measure-list-2026-10-18"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "unit rates"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A process unit's throughput as a share of its constrained capacity, for one refinery."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "unit-utilization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Unit Utilization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not crude utilization: it covers every unit, not only the crude unit, and uses constrained capacity."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "unit throughput (bbl/d) / constrained unit capacity (bbl/d), averaged over the period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "A unit-level ratio of throughput to constrained capacity, watched by exception for units missing plan. Unit-level plant utilization sits in Gartner's Correct tier; no target or owner is recorded."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "plan (prompt schedule; short-term LP handover); prior plan version (mid-term vs short-term); last hour and last 24 hours"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "hourly and daily, by unit and refinery"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
