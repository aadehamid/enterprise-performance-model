   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "WoW Variances on DPO Input Tables"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "week-on-week change above X%"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Raised when an input table changes by more than X% week on week. It fires on a condition, so it is an alert, not a series."
   }
  ],
