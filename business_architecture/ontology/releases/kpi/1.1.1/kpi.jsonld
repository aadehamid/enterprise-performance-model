[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "Measure definitions, classified by kind, with the planning personas who use them and the core processes they inform (Step 7). Definitions only, never values."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-23"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-23"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/2.3.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC KPI Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/1.1.1"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.1.1"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 7 (measures are definitions, never values); EPM-DEC-001-0005, EPM-DEC-001-0043"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "measure definition"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "What a measure is, before anyone computes it: its meaning, kind, grain, basis and the processes it informs. A definition, never a value: the systems that compute the measure hold its values."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0042; business_architecture/reference/downstream-peers/kpi-classification-evidence.md"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "measure kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The eight kinds a measure in the kpi module can be, assigned by EPM-DEC-001-0042's five tests."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0040, EPM-DEC-001-0042"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The measures the kpi module defines: the planning team's measures and the measures MPC publishes."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/basis",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0042, decision 8"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "basis"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How the measure is formed, in words: its numerator, its denominator and its unit. A description, not a formula the ontology computes."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/classificationReason",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0042"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "classification reason"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Why the measure has its kind, in one or two sentences."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/classificationTest",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0042"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "classification test"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#integer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The number of the test, from 1 to 5, in EPM-DEC-001-0042's rule that assigned the measure's kind."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 30; EPM-DEC-001-0042, decision 7"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "compared against"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The references the measure is asked against: plans, forecasts, plan versions or history. For a plan-variance diagnostic the comparison is part of the measure. For any other kind it is a way of asking for the same measure, not a second measure."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/grain",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 29"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "grain"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The time and dimension the measure is stated at, for example daily by refinery."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/informsProcess",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 33, 37 and 38; EPM-DEC-001-0043"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "informs process"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A process the measure informs. The link is context for where the measure is used, not a certification that the process owns or computes it."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0042"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "KPI candidate"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#boolean"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "True when industry practice and public information make the measure a strong KPI candidate. It becomes a KPI only by a recorded decision that names its target and owner."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/alert",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An event raised when a condition is met, for someone to notice or act on."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "alert"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Alert"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/decision-support-indicator",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A value computed from market prices and the planning model to start or rank a decision, with no performance target."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "decision-support-indicator"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Decision-support indicator"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/kpi",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "key performance indicator"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A measure the business names as one of the few measures of a stated objective, with a target and an accountable owner."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "kpi"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "KPI"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/market-indicator",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An external price, spread or benchmark that the region cannot influence."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "market-indicator"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Market indicator"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/not-a-measure",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A capability request on the measure list that is not a measure, parked for a later phase."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "not-a-measure"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Not a measure"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A recurring performance measure of a unit, asset or flow, watched by exception."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "operational-metric"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Operational metric"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/plan-variance-diagnostic",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Actual results against a plan, forecast, plan version or history, for one period."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "plan-variance-diagnostic"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Plan-variance diagnostic"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/tracker-or-report",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A list, status or schedule of activities and dates, with no formula, unit or time grain."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "tracker-or-report"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Tracker or report"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/ad-hoc-plan-trends",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
