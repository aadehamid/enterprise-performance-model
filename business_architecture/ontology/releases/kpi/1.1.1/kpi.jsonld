 {
  "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure/margin-capture",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "MPC-S07 p. 5; MPC-S16"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/kpi-classification-evidence"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/mpc-performance-measures-evidence"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "capture"
   },
   {
    "@language": "en",
    "@value": "refining margin capture"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reported R&M margin as a share of the R&M Margin Indicator: how much of the benchmark margin was realized."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/Measures"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "margin-capture"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Margin Capture"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Not the crack spread and not the indicator: it is the ratio of realized margin to the indicator."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/basis": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "R&M margin / R&M Margin Indicator"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationReason": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "Reported R&M margin divided by the R&M Margin Indicator. MPC calls it \"an operations metric\" and highlights it in the proxy, but sets no bonus target on it. It is the controllable measure built on the market indicators."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/classificationTest": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/comparedAgainst": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "R&M Margin Indicator"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/grain": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "quarterly and annual, company"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/informsProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-5"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/measureKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measure-kind/operational-metric"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/kpi/notToBeConfusedWith": [
