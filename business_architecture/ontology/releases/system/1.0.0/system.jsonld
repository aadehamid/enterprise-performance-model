   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "system"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An application, office tool or working document that the process map names as used by a process."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/SystemKind",
