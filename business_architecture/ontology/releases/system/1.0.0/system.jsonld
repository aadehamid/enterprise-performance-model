   {
    "@language": "en",
    "@value": "system kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The three kinds of thing the process map's systems field names."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/Systems",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
