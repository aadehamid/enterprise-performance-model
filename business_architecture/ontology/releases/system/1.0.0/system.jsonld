   {
    "@language": "en",
    "@value": "systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The systems the process map names, one per distinct name after spelling merges."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/kind/application",
