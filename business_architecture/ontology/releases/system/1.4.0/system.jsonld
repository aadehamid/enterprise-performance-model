 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/system/dpo",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/system/System"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-answers-2026-10-24-systems"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/downstream-process-map"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "DPO"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An MPC-built optimization model and application that produces the distribution plan for the prompt month to M+3, across pipelines, marine and inventory. Planners build a base distribution plan in it, reconcile it with the XPIMS refinery plan, update its network constraints, and hand over the final distribution plan. It is also used in the distribution backcast, to evaluate actuals cases and optimization cases."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/Systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "dpo"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Distribution Planning Optimizer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/Systems"
   }
  ],
