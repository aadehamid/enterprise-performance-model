   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-aspentech-ppims-course"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An Aspen PIMS planning model that optimizes refinery plans across several plants and several periods. Aspen PIMS is AspenTech's refinery and olefins linear programming (LP) planning software, by the vendor's description."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Which Aspen PIMS model XPIMS is rests on the decision owner's answer of 2026-10-25 (multi-plant and multi-period). AspenTech's training names XPIMS models, but no AspenTech page read on 2026-10-25 defines them; its courses define multi-period (PPIMS) and multi-plant (MPIMS) models (EPM-DEC-001-0099)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/Systems"
   }
