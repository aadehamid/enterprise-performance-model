 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/system/mpr",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/system/System"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-pricing-assets-2026-10-25"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/downstream-process-map"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The price master system: it holds each priced instrument (the price master) with its reference data, and its daily price details and settlement prices. The pricing views read it through its replica, for the crack spreads' and benchmarks' settlement prices."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "The decision owner's files expand MPR as both Master Price Record and Market Price Report (EPM-DEC-001-0100)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/Systems"
   }
  ],
