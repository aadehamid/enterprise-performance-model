   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The database that holds the regional planning cases: the standard scenarios run in XPIMS for the regional plan, the crude oil and product evaluations, the step cases for the out and prompt months, and the backcasting case results. Planners publish results to it, and the regional plan is handed over from it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the repository: the processes the process map says use it and their definitions in core 2.3.0; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."
   }
  ],
