 {
  "@id": "https://w3id.org/lsc/ontology/modules/system/system/xpims-dpo-integration-macro",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/system/System"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/core-2-3-0-process-definitions"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/downstream-process-map"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The macro used in the XPIMS and DPO reconciliation, where the regional plan from XPIMS and the base distribution plan from DPO are compared and their model constraints reconciled."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the repository: the processes the process map says use it and their definitions in core 2.3.0; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."
