  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Market Information and Pricing System"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The system that holds market price assessments, organized in price sheets, price groups and price batches. The pricing views read it through its replica, for the sheets and groups that classify each price."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/Systems"
   }
  ],
