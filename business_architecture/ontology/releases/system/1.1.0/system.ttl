        sys:System ;
    dcterms:source src:decision-owner-answers-2026-10-24-systems,
        src:downstream-process-map ;
    skos:definition "An MPC-built application that supplies actual data, including actual product prices, used as inputs to the regional backcast."@en ;
    skos:editorialNote "The description says what CargoTracker feeds, not what it is; a fuller one waits for its owners (EPM-DEC-001-0099)."@en ;
    skos:inScheme sys:Systems ;
    skos:notation "cargotracker"^^xsd:string ;
    skos:prefLabel "CargoTracker"@en ;
