<https://w3id.org/lsc/ontology/modules/system> a owl:Ontology ;
    dcterms:description "The systems, office tools and working documents the process map names, with their kind and the processes that use them (Step 7)."@en ;
    dcterms:issued "2026-10-25"^^xsd:date ;
    dcterms:modified "2026-10-25"^^xsd:date ;
    dcterms:requires <https://w3id.org/lsc/ontology/modules/core/2.3.0> ;
    dcterms:title "LSC System Module"@en ;
    owl:versionIRI sys:1.1.0 ;
    owl:versionInfo "1.1.0" .

sys:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    dcterms:bibliographicCitation "business_architecture/business_process/downstream_process_map.json, systems; competency question 6"@en ;
    rdfs:domain sys:System ;
    rdfs:range skos:Concept ;
    skos:definition "A process the process map says uses the system. Read the other way, the process depends on the system."@en .

sys:systemKind a owl:ObjectProperty ;
    rdfs:label "system kind"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0055"@en ;
    rdfs:domain sys:System ;
    rdfs:range skos:Concept ;
    skos:definition "Whether the system is an application, an office tool or a working document, from the system-kind code list."@en .

system:actuals-case-prep-file a skos:Concept,
        sys:System ;
    dcterms:source src:downstream-process-map ;
    skos:editorialNote "The process map names this system but no source in the repository says what it does. Its definition waits for its owners (EPM-DEC-001-0055)."@en ;
    skos:inScheme sys:Systems ;
    skos:notation "actuals-case-prep-file"^^xsd:string ;
    skos:prefLabel "Actuals Case Prep File"@en ;
    skos:topConceptOf sys:Systems ;
    sys:supports proc:CM-1-1-5-1 ;
    sys:systemKind kind:document .

system:aps a skos:Concept,
        sys:System ;
    dcterms:source src:decision-owner-answers-2026-10-24-systems,
        src:downstream-process-map,
