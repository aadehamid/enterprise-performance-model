 {
  "@id": "https://w3id.org/lsc/ontology/modules/ref-mpc/segment-midstream",
  "@type": [
   "http://www.w3.org/ns/org#OrganizationalUnit"
  ],
  "http://purl.org/dc/terms/date": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2025-12-31"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/mpc-s01"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "MPC's reportable segment that gathers, transports, stores and distributes crude oil, refined products and natural gas liquids, and processes natural gas. It is primarily MPLX."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Midstream"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "A reporting segment of MPC, separate from the legal entity MPLX whose operations roll up into it (EPM-DEC-001-0015)."
   }
  ],
  "http://www.w3.org/ns/org#unitOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/ref-mpc/mpc"
   }
  ]
 },
