refmpc:mplx a org:FormalOrganization,
        party:Organization ;
    dcterms:date "2025-12-31"^^xsd:date ;
    dcterms:source src:gleif-lei,
        src:mpc-s01 ;
    rdfs:seeAlso <https://api.gleif.org/api/v1/lei-records/5493000CZJ19CK4P3G36> ;
    skos:altLabel "MPLX"@en ;
    skos:note "GLEIF lists this LEI's registration as LAPSED (last updated 2023-08-04) and records no accounting-consolidation parent (reporting exception NO_KNOWN_PERSON), so the control relationship below has no GLEIF Level 2 counterpart."@en ;
    skos:prefLabel "MPLX LP"@en ;
    skos:scopeNote "A master limited partnership that MPC sponsors. A separate legal entity, not a unit of MPC: MPC's control of it is the control relationship below, not org:subOrganizationOf."@en ;
    org:identifier "5493000CZJ19CK4P3G36" ;
    party:legalName "MPLX LP" ;
    party:partyType pt:organization ;
    party:plays rp:mplx-carrier,
        rp:mplx-vendor .

