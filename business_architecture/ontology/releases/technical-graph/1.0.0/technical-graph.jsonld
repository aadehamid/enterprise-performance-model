   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The check compared two accounts of the same thing, such as designed and observed lineage, and found a difference that is not on its list of known differences."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/technical-graph/CheckResults"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "differs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Differs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/technical-graph/CheckResults"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/technical-graph/check-result/fail",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The check found a problem the platform must fix."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/technical-graph/CheckResults"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "fail"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Fail"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/technical-graph/CheckResults"
