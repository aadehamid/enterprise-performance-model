   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A source system of the customer logical model, which provides one fact table, Mcs_Cogeneral_Fact."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the decision owner's customer inputs of 2026-10-27 (EPM-DEC-001-0108); it waits for its owners to confirm it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/mcs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "mcs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "MCS"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "A source system of the customer logical model, which provides one fact table, Mcs_Cogeneral_Fact."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/landscape"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/msmis",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-customer-inputs-2026-10-27"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A system of master contact details and point-of-contact profiles for customers in marine terminal and wholesale environments."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the decision owner's customer inputs of 2026-10-27 (EPM-DEC-001-0108); it waits for its owners to confirm it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/msmis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "msmis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "MSMIS"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Holds the master contact details and point-of-contact profiles of customers in marine terminal and wholesale environments."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/landscape"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/onesource",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-answers-2026-10-24-systems"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-thomson-reuters-onesource-determination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Thomson Reuters' tax engine, ONESOURCE Determination. By the vendor's description, it calculates sales and use tax, excise tax, VAT and GST."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "onesource"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "OneSource"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Calculates tax and supports tax compliance and reporting, for RightAngle and SAP S/4HANA invoices."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/polaris",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/phmsa-marathon-pipeline-noa-2024-09-26"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A scheduling system of Marathon Pipeline LLC, named in a PHMSA notice of amendment of 2024-09-26. Whether MPC built or bought it is not known."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "The decision owner believes it is bought, an off-the-shelf product (2026-10-28); a web search that day found no liquids-pipeline scheduling product of that name, so the vendor and what it does stay open (EPM-DEC-001-0099, amendment of 2026-10-28)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "polaris"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Polaris"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The pipeline operations and invoicing system. It takes the SAP customer number and basic attributes from SAP MDG, adds operational data, records pipeline movements and revenue, and sends the transport invoices it generates to SAP S/4HANA."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/implements": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerAccount"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/PartyTransactionAssociation"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Site"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/core"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/prm",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-customer-inputs-2026-10-27"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Pricing System"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The pricing system that manages street-level fuel prices. It receives each station's location and channel of trade from Dealer Master, so it knows which stations need a street price the company manages. It is a different system from MPR."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the decision owner's customer inputs of 2026-10-27 (EPM-DEC-001-0108); it waits for its owners to confirm it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/prm"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "prm"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "PRM"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The pricing system: from Dealer Master it receives each station's location and channel of trade, so it knows which stations need a street price the company manages. It is restricted."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-profisee-platform"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Profisee Data Storage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Profisee's master data management (MDM) platform. By the vendor's description, it cleans, unifies and improves the quality of an enterprise's critical data across its systems."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/profisee"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "profisee"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Profisee"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Customer data storage and mastering used by IDP, for customer ID mapping, customer roll-ups and cross-references."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/data-products-idp"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/quorum",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-answers-2026-10-24-systems"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-quorum-software"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Software from Quorum Software, a vendor of software for energy companies; which Quorum product it is is not known. By the vendor's description, its software connects energy workflows from the field to the boardroom."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Which Quorum product this is stays open (the decision owner, 2026-10-24); the definition is at vendor level (EPM-DEC-001-0099)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "quorum"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Quorum"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Records gathering and processing movements and settlements; it receives customers from SAP MDG and enriches them through the contract or relationship."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/rcms",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-customer-inputs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Renewable Compliance Management System"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The Renewable Compliance Management System: it holds a reference ID tied to a fuel movement or a RIN trade."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the repository: its customer role, data flows and attributes as the party module holds them from the decision owner's customer inputs; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "rcms"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "RCMS"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The renewable compliance system: a reference ID tied to a fuel movement or a RIN trade."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/rightangle",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-ion-rightangle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "RA"
   },
   {
    "@language": "en",
    "@value": "Right Angle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "ION's commodities trading and risk management system for liquid hydrocarbon companies, such as refiners and fuel marketers. By the vendor's description, it covers the work from front to back and is strongest in scheduling, logistics and operations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/rightangle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "rightangle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "RightAngle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The commercial and logistics system for trading, deals, scheduling and financial exposure. It takes basic customer data from SAP MDG, creates the business associate and its locations, sends the business associate ID and locale back to SAP MDG, and shares data with Kittyhawk and the trading desks."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/allocation-manager"
   },
