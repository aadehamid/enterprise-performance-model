  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The data products platform for customer data: the customer master, sales, credit exposure and delinquency, fed with customer ID mappings, roll-ups and cross-references from Profisee."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Drafted by Claude from the repository: its customer role, data flows and attributes as the party module holds them from the decision owner's customer inputs; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "data-products-idp"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Data Products IDP"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Data products on the customer master, sales, credit exposure and delinquency."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/dealer-master",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-customer-inputs"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-customer-inputs-2026-10-27"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#changeNote": [
   {
    "@language": "en",
    "@value": "2026-10-27: its role and definition are corrected from the decision owner's customer inputs of that day. Salesforce is only its intake, not what it is built on; jobbers are mastered in SAP MDG and RightAngle and replicated here; it masters the ship-to stations (EPM-DEC-001-0108)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The Retail Payments Application, the system of record for the branded dealer network's ship-to stations: it masters each station, links it to the jobber that supplies it, settles with the dealers and aggregates the stations' point-of-sale transactions. Jobbers are mastered in SAP MDG and RightAngle and replicated here. It sends bank and payment details to SAP S/4HANA."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Corrected on 2026-10-27 from the decision owner's customer inputs of that day: Salesforce is only its intake, not what it is built on, and jobbers do not start here (EPM-DEC-001-0108). Drafted by Claude from the repository: its customer role, data flows and attributes as the party module holds them from the decision owner's customer inputs; approved under EPM-DEC-001-0028 (EPM-DEC-001-0103); it waits for its owners to confirm it (business-closeout.md, point 16)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "dealer-master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Dealer Master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The system of record for the branded dealer network's ship-to stations, the Retail Payments Application. It masters each station, links it to the jobber that supplies it, settles with the dealers, and aggregates the stations' point-of-sale transactions. Jobbers are mastered in SAP MDG and RightAngle and replicated here. It sends bank and payment details to SAP S/4HANA and station locations to PRM."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
