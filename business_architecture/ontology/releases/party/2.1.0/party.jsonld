  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The customer is suspended or closed and made inactive in the company's systems."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
