    "@language": "en",
    "@value": "dealer classes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Dealer Master's three classes of the records in its dealer master table. A record stays in the class it was created in."
   }
  ],
