 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/gas-buddy",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-gasbuddy-about"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "GasBuddy's fuel-savings service for drivers. By the vendor's description, it gives real-time gas price information at more than 150,000 stations, cashback rewards with brand partners and a payments card with cents off per gallon; its app has been downloaded over 100 million times. What MPC sends it is not known."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "gas-buddy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Gas Buddy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "A system downstream of MAGIC that sends customer data to Profisee."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/gravitate",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-gravitate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Gravitate's software for fuel operations. By the vendor's description, it optimizes supply, pricing, freight and dispatch in real time for fuel operators."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "gravitate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Gravitate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The gathering and processing customer portal."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
