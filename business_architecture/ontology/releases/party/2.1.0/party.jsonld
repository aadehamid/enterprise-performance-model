   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/PartyRole"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/core"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/salesforce",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-salesforce"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "SF"
   },
   {
    "@language": "en",
    "@value": "Salesforce CRM"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Salesforce's customer relationship management (CRM) platform. By the vendor's description, it helps companies connect with their customers."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/salesforce"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "salesforce"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Salesforce"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Where a prospect is first captured and a new customer setup and credit check start, on two tracks: Trade (the commodity trading desk) and CRM/Basic (goods and products). It triggers creation in SAP MDG, receives the SAP customer number back, and serves the customer portal."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/dealer-master"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-mdg"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/implements": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Address"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/ContactPoint"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Party"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/core"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-mdg",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-sap-mdg"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "MDG"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "SAP's master data governance software. By the vendor's description, it is the governance layer for an enterprise's business data, unifying master data, policy and metadata."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/sap-mdg"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "sap-mdg"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "SAP MDG"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The point of control for customer creation and governance: every commercial customer is created here. It runs duplicate checks on identifiers, validates addresses, applies authorization groups by line of business and generates the canonical SAP customer number. It is the system of record for the customer and holds the tax ID and bank data."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/dealer-master"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/magic"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/polaris"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/quorum"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/rightangle"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sirion"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/star"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/terminal-download"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/implements": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/ExternalIdentifier"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Party"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/core"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-sap-s4hana-help"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "S/4"
   },
   {
    "@language": "en",
    "@value": "S4"
   },
   {
    "@language": "en",
    "@value": "SAP S/4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "SAP's business suite. By the vendor's description, it is the next-generation business suite, built on the SAP HANA in-memory platform."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/sap"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "sap-s4hana"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "SAP S/4HANA"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The financial system of record. It receives the business partner from SAP MDG, with company codes, sales areas and partner roles, adds credit and collection data, and takes transaction postings and invoices from the execution systems."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/bridger-insight"
