    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Whether the account is active, blocked or closed. The list of statuses is not yet defined."
   }
  ]
 },
