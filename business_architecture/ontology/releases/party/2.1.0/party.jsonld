  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Dealer Master's class for a group of a jobber's stations that a third party runs and that settles apart from the jobber's own."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
