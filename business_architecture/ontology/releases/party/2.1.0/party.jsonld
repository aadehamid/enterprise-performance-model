   {
    "@id": "http://www.w3.org/2001/XMLSchema#string"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The one-letter family of PIDX's downstream product codes that the product's PIDX codes belong to. A plain identifier: PIDX publishes no IRIs, and a PIDX code names one company's traded grade, so the product is not mapped to PIDX codes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Source: PIDX Downstream Product Codes, document 04-101-15-45-2010, file PIDX_ProductCodes_10_20_2026.xlsx from https://pidx.org/standards/ (retrieved 2026-10-23). Its Families sheet is dated 2015-09-29, and PIDX's notice of 2024-07-31 changed family S, so the letters are to be confirmed with PIDX (ontology/business-closeout.md, point 5). © PIDX, Inc. 2023. Use of this copyrighted material is subject to the PIDX End User License Agreement available at www.pidx.org/license."
   }
  ]
 },
