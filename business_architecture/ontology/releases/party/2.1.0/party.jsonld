 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0108"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "classes of trade"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The channels of trade a station is supplied under, which tell the pricing system whether the company manages the station's street price."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade/dtw"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade/mst"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade/dtw",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The channel of trade of a station supplied at the dealer tank wagon price, whose street price the company manages."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "dtw"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Dealer Tank Wagon"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade/mst",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The channel of trade of a station supplied under a multi-site throughput arrangement, whose street price the company manages."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "mst"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Multi-Site Throughput"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/class-of-trade"
   }
  ]
 },
