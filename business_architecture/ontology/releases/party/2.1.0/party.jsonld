 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/kittyhawk",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-answers-2026-10-24-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "KH"
   },
   {
    "@language": "en",
    "@value": "Kittyhawk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An MPC in-house application used by the Commercial organization. It gets all of its data from RightAngle and is almost a replica of it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Terminal Upload sends KittyHawk cross-reference customer ID mappings directly, as the decision owner's input shows; KittyHawk's customer data itself comes from RightAngle (EPM-DEC-001-0099)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/kittyhawk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "kittyhawk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "KittyHawk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "Records physical product movements. It receives customers from RightAngle, holds the territory manager, and feeds Gravitate and MAGIC."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/gravitate"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/magic"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/rcms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/lenel-onguard",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-lenels2-onguard"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "LenelS2's physical access control system, OnGuard, a Honeywell brand. By the vendor's description, it is an integrated and customizable security management system."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "lenel-onguard"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Lenel Onguard"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "A source of employee parties."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/landscape"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/magic",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/decision-owner-answers-2026-10-24-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Marketing Applications Graphical Interface for Clients"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Marketing Applications Graphical Interface for Clients: an MPC-built integration that sets up new customer accounts. When SAP MDG creates a customer, MAGIC assigns the SAP MDG customer number and the KittyHawk territory manager to the account in Salesforce, and converts the prospect into a customer account. Every day it syncs the customer's number, name, address, FEIN, status, credit monitor and territory manager to Salesforce."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/system/system/magic"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "magic"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "MAGIC"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "The new customer account integration: it assigns the SAP MDG customer number and the Kittyhawk territory manager to Salesforce, converts the prospect into a customer account, and syncs the customer number, name, address, FEIN, status, credit monitor and territory manager every day."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/salesforce"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/integration"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/mcs",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
