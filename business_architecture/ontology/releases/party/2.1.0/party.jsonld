   {
    "@value": "sold-to"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Sold-To"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Also called the Capital C customer. A sold-to is identified by a six-digit SAP customer number; SAP MDG and RightAngle master it, and Dealer Master holds a replica to link it to its stations (EPM-DEC-001-0108)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/party-role"
   }
  ]
 },
 {
