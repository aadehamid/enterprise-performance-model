  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The role of a party that runs a group of a jobber's stations for a third party, so that the group settles and routes its payments apart from the jobber's own. Dealer Master holds it, and it is used rarely."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#exactMatch": [
