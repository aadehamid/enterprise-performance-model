   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "SAP's data quality software, SAP Information Steward. By the vendor's description, it supports data profiling and monitoring and information policy management."
   }
  ],
