  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The site where the role is held, such as the station a dealer operates or the terminal a loading-authorized party lifts at."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/attribute-category",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0067; EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "attribute categories"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The decision owner's two categories of a system's customer attributes: those that define the customer there, and those that enrich it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/attribute-category/create"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/attribute-category/enrich"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/attribute-category/create",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An attribute that defines the customer in the system: set when the customer is created there."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/attribute-category"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
