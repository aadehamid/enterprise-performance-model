 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/drop-tank",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/drop-tank-points-release-2018-04-23"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A gas station loyalty technology company's service. By the company's own description in a 2018 press release, Drop Tank specializes in gas station loyalty technology and partners with fuel and c-store brands to deploy consistent loyalty functionality across stations which may have inconsistent retail technology. The same release, issued on 2018-04-23 with Points, announces that Drop Tank and Points power Marathon Petroleum Company LP's MakeItCount rewards program. Its own site now redirects to PDI Technologies. What MPC sends it is not known."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "drop-tank"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Drop Tank"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "A system downstream of MAGIC that sends customer data to Profisee."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/systemTier": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/downstream"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system/dtn-file-server",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept",
   "https://w3id.org/lsc/ontology/modules/party/CustomerSystem"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/vendor-dtn-refined-fuels"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The DTN File Server, named for DTN. By DTN's description, DTN helps energy companies decide across the fuel value chain, from supply to pricing to compliance, through its Fuel Operations Hub, and offers bi-directional, API-ready data exchange. DTN's page does not describe the file server, and what MPC sends through it is not known."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "dtn-file-server"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "DTN File Server"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/customerRole": [
   {
    "@language": "en",
    "@value": "A file server downstream of MAGIC that sends customer data to Profisee."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/profisee"
