   {
    "@language": "en",
    "@value": "The enterprise-wide terminal integration and business-information system (EPM-DEC-001-0072): it holds terminal data on suppliers, products and carriers, and receives customer data from Terminal download."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/feeds": [
