@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix oeo: <https://openenergyplatform.org/ontology/oeo/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix party: <https://w3id.org/lsc/ontology/modules/party/> .
@prefix proc: <https://w3id.org/lsc/ontology/process/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix system: <https://w3id.org/lsc/ontology/modules/system/system/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lsc/ontology/modules/party> a owl:Ontology ;
    dcterms:description "The Customer domain's concepts: parties, the roles they hold for a period, accounts, agreements and sites; the customer's systems, data flow and attributes; and the customer lifecycle linked to core processes (Steps 5 to 7). Definitions only, never records."@en ;
    dcterms:issued "2026-10-23"^^xsd:date ;
    dcterms:modified "2026-10-23"^^xsd:date ;
    dcterms:requires <https://w3id.org/lsc/ontology/modules/core/2.3.0> ;
    dcterms:title "LSC Party Module"@en ;
    owl:versionIRI party:1.1.0 ;
    owl:versionInfo "1.1.0" .

party:Person a owl:Class ;
    rdfs:label "person"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:subClassOf party:Party ;
    owl:disjointWith party:Organization ;
    skos:closeMatch foaf:Person ;
    skos:definition "A party that is a natural person."@en .

party:accountFacet a owl:ObjectProperty ;
    rdfs:label "account facet"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range skos:Concept ;
    skos:definition "A secondary facet of the account: its brand status, contract type, product line, segment, geography or delivery tier. The values of these facets are not yet defined."@en ;
    skos:scopeNote "The delivery tier covers the delivery-mode candidate, which is not added separately (EPM-DEC-001-0067, What follows, item 9)."@en .

party:accountStatus a owl:DatatypeProperty ;
    rdfs:label "account status"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range xsd:string ;
    skos:definition "Whether the account is active, blocked or closed. The list of statuses is not yet defined."@en .

<https://w3id.org/lsc/ontology/modules/party/address-usage/billing> a skos:Concept ;
    skos:definition "The address a party's invoices go to."@en ;
    skos:inScheme party:address-usage ;
    skos:notation "billing" ;
    skos:prefLabel "Billing"@en ;
    skos:topConceptOf party:address-usage .

<https://w3id.org/lsc/ontology/modules/party/address-usage/mailing> a skos:Concept ;
    skos:definition "The address a party receives mail at."@en ;
    skos:inScheme party:address-usage ;
    skos:notation "mailing" ;
    skos:prefLabel "Mailing"@en ;
    skos:topConceptOf party:address-usage .

<https://w3id.org/lsc/ontology/modules/party/address-usage/operating-location> a skos:Concept ;
    skos:definition "An address where a party operates."@en ;
    skos:inScheme party:address-usage ;
    skos:notation "operating-location" ;
    skos:prefLabel "Operating location"@en ;
    skos:topConceptOf party:address-usage .

<https://w3id.org/lsc/ontology/modules/party/address-usage/registered-office> a skos:Concept ;
    skos:definition "The address of a party's registered office."@en ;
    skos:inScheme party:address-usage ;
    skos:notation "registered-office" ;
    skos:prefLabel "Registered office"@en ;
    skos:topConceptOf party:address-usage .

party:addressUsage a owl:ObjectProperty ;
    rdfs:label "address usage"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:Address ;
    rdfs:range skos:Concept ;
    skos:definition "How the address is used, from the address-usage list."@en .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/brand-license> a skos:Concept ;
    skos:definition "An agreement that grants a party the right to use a brand for a period."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "brand-license" ;
    skos:prefLabel "Brand License"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/consignment-commission> a skos:Concept ;
    skos:definition "An agreement under which the company keeps ownership of product held at a party's site, which sells it for a commission."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "consignment-commission" ;
    skos:prefLabel "Consignment / Commission"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/exchange-buy-sell> a skos:Concept ;
    skos:definition "An agreement to swap product barrel for barrel or to buy and sell product with a counterparty."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "exchange-buy-sell" ;
    skos:prefLabel "Exchange / Buy-Sell"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/fleet-card-program> a skos:Concept ;
    skos:definition "An agreement that lets a party's vehicles buy fuel with a fleet card."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "fleet-card-program" ;
    skos:prefLabel "Fleet Card Program"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/fuel-supply> a skos:Concept ;
    skos:definition "An agreement under which the company supplies fuel, as a branded jobber, direct dealer or unbranded term agreement."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "fuel-supply" ;
    skos:prefLabel "Fuel Supply"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/offtake> a skos:Concept ;
    skos:definition "An agreement to take product from a source in agreed volumes over a period."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "offtake" ;
    skos:prefLabel "Offtake"@en ;
    skos:topConceptOf party:agreement-type .

<https://w3id.org/lsc/ontology/modules/party/agreement-type/throughput-storage> a skos:Concept ;
    skos:definition "An agreement to move or store a party's volumes through pipelines, terminals or tanks."@en ;
    skos:inScheme party:agreement-type ;
    skos:notation "throughput-storage" ;
    skos:prefLabel "Throughput / Storage"@en ;
    skos:topConceptOf party:agreement-type .

party:agreementType a owl:ObjectProperty ;
    rdfs:label "agreement type"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:Agreement ;
    rdfs:range skos:Concept ;
    skos:definition "A type of the agreement, from the agreement-type list. An agreement can have more than one."@en .

party:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:SiteBrandAssignment ;
    rdfs:range party:Site ;
    skos:definition "The site the assignment brands."@en .

party:assignsBrand a owl:ObjectProperty ;
    rdfs:label "assigns brand"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:SiteBrandAssignment ;
    rdfs:range party:Brand ;
    skos:definition "The brand the assignment gives the site."@en .

party:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:PartyRole ;
    rdfs:range party:Site ;
    skos:definition "The site where the role is held, such as the station a dealer operates or the terminal a loading-authorized party lifts at."@en .

