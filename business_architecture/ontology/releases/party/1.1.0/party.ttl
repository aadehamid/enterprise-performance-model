    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

<https://w3id.org/lsc/ontology/modules/party/system/rcms> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Renewable Compliance Management System"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "rcms" ;
    skos:prefLabel "RCMS"@en ;
    party:customerRole "The renewable compliance system: a reference ID tied to a fuel movement or a RIN trade."@en ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

<https://w3id.org/lsc/ontology/modules/party/system/tasdm> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Terminal Automation System Data Manager"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "tasdm" ;
    skos:prefLabel "TASDM"@en ;
    party:customerRole "Creates the customers and destinations of MPLX's third-party suppliers in the terminal automation system."@en ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

<https://w3id.org/lsc/ontology/modules/party/system/xref> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Cross Reference System"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "xref" ;
    skos:prefLabel "XREF"@en ;
    party:customerRole "The cross-reference on the Salesforce to RightAngle interface that excludes specific customers."@en ;
