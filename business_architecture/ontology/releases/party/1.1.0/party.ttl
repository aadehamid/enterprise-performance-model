    rdfs:domain party:CustomerSystem ;
    rdfs:range skos:Concept ;
    skos:definition "Where the system sits in the customer's data flow, from the system-tier list."@en .

party:toRole a owl:ObjectProperty ;
    rdfs:label "to role"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:PartyRelationship ;
    rdfs:range party:PartyRole ;
