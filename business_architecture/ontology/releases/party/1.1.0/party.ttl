party:attributeCategory a owl:ObjectProperty ;
    rdfs:label "attribute category"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:SystemAttribute ;
    rdfs:range skos:Concept ;
    skos:definition "Create or Enrich, from the attribute-category list."@en .

party:authorizesBrandAtSite a owl:ObjectProperty ;
    rdfs:label "authorizes brand at site"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067, What follows, item 4; EPM-DEC-001-0068"@en ;
    rdfs:domain party:Agreement ;
    rdfs:range party:SiteBrandAssignment ;
    skos:definition "A site brand assignment the agreement authorizes."@en .

party:carries a owl:DatatypeProperty ;
    rdfs:label "carries"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:DataFlow ;
    rdfs:range rdf:langString ;
    skos:definition "What the flow carries, in a sentence."@en .

party:classValue a owl:ObjectProperty ;
    rdfs:label "class value"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerClass ;
    rdfs:range skos:Concept ;
    skos:definition "The class assigned, from the customer-class list. Only a class, never one of the four groups, is assigned."@en .

party:classifiedAs a owl:ObjectProperty ;
    rdfs:label "classified as"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range party:CustomerClass ;
    skos:definition "A dated class assignment of the account."@en .

party:companyCode a owl:DatatypeProperty ;
    rdfs:label "company code"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range xsd:string ;
    skos:definition "The company code the account is assigned to in the financial system."@en .

<https://w3id.org/lsc/ontology/modules/party/contact-type/email> a skos:Concept ;
    skos:definition "An email address."@en ;
    skos:inScheme party:contact-type ;
    skos:notation "email" ;
    skos:prefLabel "Email"@en ;
    skos:topConceptOf party:contact-type .

<https://w3id.org/lsc/ontology/modules/party/contact-type/fax> a skos:Concept ;
    skos:definition "A fax number."@en ;
    skos:inScheme party:contact-type ;
    skos:notation "fax" ;
    skos:prefLabel "Fax"@en ;
    skos:topConceptOf party:contact-type .

<https://w3id.org/lsc/ontology/modules/party/contact-type/telephone> a skos:Concept ;
    skos:definition "A telephone number."@en ;
    skos:inScheme party:contact-type ;
    skos:notation "telephone" ;
    skos:prefLabel "Telephone"@en ;
    skos:topConceptOf party:contact-type .

party:contactType a owl:ObjectProperty ;
    rdfs:label "contact type"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:ContactPoint ;
    rdfs:range skos:Concept ;
    skos:definition "Telephone, email or fax, from the contact-type list."@en .

party:correspondsTo a owl:ObjectProperty ;
    rdfs:label "corresponds to"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    skos:definition "A system stage that the business lifecycle stage spans: the two lifecycles describe the same customer life from the business side and the system side."@en .

party:coversBrand a owl:ObjectProperty ;
    rdfs:label "covers brand"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:Agreement ;
    rdfs:range party:Brand ;
    skos:definition "A brand the agreement sets terms for. A Brand License agreement licenses the brand to a party for the agreement's period."@en .

party:creditTerms a owl:DatatypeProperty ;
    rdfs:label "credit terms"@en ;
    dcterms:bibliographicCitation "competency question 23; EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range xsd:string ;
    skos:definition "The credit the company extends on the account: its limit and its conditions. Credit sits on the account; a credit roll-up relationship counts one role's exposure under another's."@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/branded-jobber> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/brand-attached-resellers> ;
    skos:definition "An independent reseller of branded fuel under a branded supply agreement, which owns or operates its outlets. The usual pattern is the Jobber role, a Fuel Supply agreement and sites branded through site brand assignments."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "branded-jobber" ;
    skos:prefLabel "Branded jobber / marketer"@en ;
    party:mpcClassification "C1" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/commercial-industrial-end-user> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty> ;
    skos:definition "A customer that uses the product in its own operations, such as a fleet, an airline, a utility or a railroad. The usual pattern is the Sold-To role and a Fuel Supply or Fleet Card Program agreement."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "commercial-industrial-end-user" ;
    skos:prefLabel "Commercial and industrial end-user"@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/crude-oil-customer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties> ;
    skos:definition "An external customer that buys crude oil or refinery feedstock from the company. Part of these sales go to companies in the crude oil or refinery feedstock trading and supply business, or to other refiners."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "crude-oil-customer" ;
    skos:prefLabel "Crude oil customer"@en ;
    party:mpcClassification "C8" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/export-customer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> ;
    skos:definition "A buyer overseas. Product is lifted at a coastal refinery or at terminal gates, and supply usually comes from a refinery or terminal site."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "export-customer" ;
    skos:prefLabel "Export customer"@en ;
    party:mpcClassification "C7" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/independent-retailer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> ;
    skos:definition "A retailer that is not a brand jobber or direct dealer and buys refined products for its own outlets."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "independent-retailer" ;
    skos:prefLabel "Independent retailer"@en ;
    party:mpcClassification "C4" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/spot-market-buyer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties> ;
    skos:definition "A buyer that buys refined products on the spot market, not under a term agreement."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "spot-market-buyer" ;
    skos:prefLabel "Spot market buyer"@en ;
    party:mpcClassification "C6" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/unbranded-customer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> ;
    skos:definition "A customer that buys gasoline or diesel without a brand: an independent marketer, a commercial end-user, an unbranded distributor or a high-volume retailer."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "unbranded-customer" ;
    skos:prefLabel "Unbranded customer"@en ;
    party:mpcClassification "C5" .

party:customerRole a owl:DatatypeProperty ;
    rdfs:label "customer role"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:CustomerSystem ;
    rdfs:range rdf:langString ;
    skos:definition "What the system does with the customer, in a sentence or two."@en .

party:describes a owl:ObjectProperty ;
