        proc:CM-1-3-7-4-5 .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/onboarding> a skos:Concept ;
    skos:definition "The customer passes the credit and compliance checks and is set up in the company's systems: created and governed in the customer master, then replicated, enriched and activated in the systems that use it."@en ;
    skos:inScheme party:lifecycle-stage ;
    skos:notation "onboarding" ;
    skos:prefLabel "Onboarding"@en ;
    skos:topConceptOf party:lifecycle-stage ;
    party:correspondsTo <https://w3id.org/lsc/ontology/modules/party/system-stage/master>,
