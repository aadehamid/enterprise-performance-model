    party:stageProcess proc:CM-1-3-7-1-1,
        proc:CM-1-3-7-1-7,
        proc:CM-1-3-7-2-1,
        proc:CM-1-3-7-4-2,
        proc:CM-1-3-7-4-6 .

<https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/payment-management> a skos:Concept ;
