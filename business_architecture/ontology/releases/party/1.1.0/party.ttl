    skos:definition "Person or organization: the two kinds of party."@en .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/sap-customer-number> a skos:Concept ;
    skos:definition "The canonical customer number SAP MDG generates; other systems carry it to point back to the MDG customer."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "sap-customer-number" ;
    skos:prefLabel "SAP customer number"@en ;
    skos:topConceptOf party:shared-attribute .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/status> a skos:Concept ;
    skos:definition "Whether the customer is active, blocked or inactive."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "status" ;
    skos:prefLabel "Status"@en ;
    skos:topConceptOf party:shared-attribute .

<https://w3id.org/lsc/ontology/modules/party/product/asphalt> a skos:Concept,
        party:Product ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 1"@en ;
    skos:definition "The asphalt products the refineries make: asphalt cements, polymer-modified, emulsified and industrial asphalts, and roofing flux."@en ;
    skos:editorialNote "Named in MPC's FY2025 Form 10-K; the definition is Claude's words (EPM-DEC-001-0092)."@en ;
    skos:inScheme party:product ;
    skos:notation "asphalt" ;
    skos:prefLabel "Asphalt"@en ;
    skos:topConceptOf party:product ;
    party:pidxProductFamily "Y" .

<https://w3id.org/lsc/ontology/modules/party/product/distillates> a skos:Concept,
        party:Product ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 1"@en ;
    skos:definition "The middle distillates the refineries make: ultra-low-sulfur diesel, jet fuel, kerosene, and No. 1 and No. 2 fuel oils."@en ;
    skos:editorialNote "Named in MPC's FY2025 Form 10-K; the definition is Claude's words (EPM-DEC-001-0092)."@en ;
    skos:inScheme party:product ;
    skos:notation "distillates" ;
    skos:prefLabel "Distillates"@en ;
    skos:topConceptOf party:product .

<https://w3id.org/lsc/ontology/modules/party/system-tier/enrich> a skos:Concept ;
    skos:definition "A system or tool that adds to or checks the customer after it is created."@en ;
    skos:inScheme party:system-tier ;
    skos:notation "enrich" ;
    skos:prefLabel "Enrichment"@en ;
    skos:topConceptOf party:system-tier .

<https://w3id.org/lsc/ontology/modules/party/system/magic> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Marketing Applications Graphical Interface for Clients"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "magic" ;
    skos:prefLabel "MAGIC"@en ;
    party:customerRole "The new customer account integration: it assigns the SAP MDG customer number and the Kittyhawk territory manager to Salesforce, converts the prospect into a customer account, and syncs the customer number, name, address, FEIN, status, credit monitor and territory manager every day."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/salesforce> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/integration> .

<https://w3id.org/lsc/ontology/modules/party/system/terminal-download> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Terminal Download"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "terminal-download" ;
    skos:prefLabel "Terminal download"@en ;
    party:customerRole "Sends customer data to terminals so the customer can load there."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/fuelfacs> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

party:contact-type a skos:ConceptScheme ;
    rdfs:label "contact types"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of contact point."@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> a skos:Concept ;
    skos:definition "The customer classes that buy fuel in bulk or without a brand, for resale."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "wholesale-unbranded" ;
    skos:prefLabel "Wholesale and unbranded"@en ;
    skos:topConceptOf party:customer-class .

party:operating-model a skos:ConceptScheme ;
    rdfs:label "site operating models"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "Who owns and who operates a site."@en .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/tax-id> a skos:Concept ;
    skos:definition "The party's tax identifier, such as its FEIN."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "tax-id" ;
    skos:prefLabel "Tax ID"@en ;
    skos:topConceptOf party:shared-attribute .

party:sourcing-kind a skos:ConceptScheme ;
    rdfs:label "customer sourcing kinds"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "How a system relates to a kind of customer: where it starts, where it is set up, or a source of it."@en .

<https://w3id.org/lsc/ontology/modules/party/system-tier/core> a skos:Concept ;
    skos:definition "One of the six systems the customer is created, recorded or executed in: SAP MDG, SAP S/4HANA, Salesforce, RightAngle, Polaris and Dealer Master."@en ;
    skos:inScheme party:system-tier ;
    skos:notation "core" ;
    skos:prefLabel "Core system"@en ;
    skos:topConceptOf party:system-tier .

<https://w3id.org/lsc/ontology/modules/party/system/kittyhawk> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "KH"@en,
        "Kittyhawk"@en ;
    skos:exactMatch system:kittyhawk ;
    skos:inScheme party:customer-systems ;
    skos:notation "kittyhawk" ;
    skos:prefLabel "KittyHawk"@en ;
    party:customerRole "Records physical product movements. It receives customers from RightAngle, holds the territory manager, and feeds Gravitate and MAGIC."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/gravitate>,
        <https://w3id.org/lsc/ontology/modules/party/system/magic>,
        <https://w3id.org/lsc/ontology/modules/party/system/profisee> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

party:address-usage a skos:ConceptScheme ;
    rdfs:label "address usages"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "How an address is used."@en .

party:identifier-type a skos:ConceptScheme ;
    rdfs:label "identifier types"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of external identifier of a party."@en .

<https://w3id.org/lsc/ontology/modules/party/product/ngls-and-petrochemicals> a skos:Concept,
        party:Product ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 1"@en ;
    skos:definition "The natural gas liquids and petrochemicals the refineries make, among them propylene, xylene, butane, benzene, toluene and cumene, with fuel-grade and anode-grade coke."@en ;
    skos:editorialNote "Named in MPC's FY2025 Form 10-K; the definition is Claude's words (EPM-DEC-001-0092)."@en ;
    skos:inScheme party:product ;
    skos:notation "ngls-and-petrochemicals" ;
    skos:prefLabel "NGLs and petrochemicals"@en ;
    skos:topConceptOf party:product .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/bp-role-group> a skos:Concept ;
    skos:definition "The SAP business partner's roles and grouping, which set what the partner may do and how it is numbered."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "bp-role-group" ;
    skos:prefLabel "Business partner role and group"@en ;
    skos:topConceptOf party:shared-attribute .

<https://w3id.org/lsc/ontology/modules/party/system-tier/landscape> a skos:Concept ;
    skos:definition "Another system in the landscape that is a source of customers of a kind."@en ;
    skos:inScheme party:system-tier ;
    skos:notation "landscape" ;
    skos:prefLabel "Landscape source"@en ;
    skos:topConceptOf party:system-tier .

party:CustomerClass a owl:Class ;
    rdfs:label "customer class"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0047, What follows, item 5; EPM-DEC-001-0068"@en ;
    skos:definition "The assignment of a class from the customer-class list to a customer account, from a start date to an end date. A class describes how the customer buys: its role, its channel and its supply pattern."@en ;
    skos:scopeNote "The class values are concepts of the customer-class scheme; this class is the dated assignment of one of them to one account."@en .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/legal-name> a skos:Concept ;
    skos:definition "The party's registered name."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "legal-name" ;
    skos:prefLabel "Legal name"@en ;
    skos:topConceptOf party:shared-attribute .

<https://w3id.org/lsc/ontology/modules/party/sourcing-kind/setup> a skos:Concept ;
    skos:definition "A system the customer is created or activated in for this line of business."@en ;
    skos:inScheme party:sourcing-kind ;
    skos:notation "setup" ;
    skos:prefLabel "Setup"@en ;
    skos:topConceptOf party:sourcing-kind .

party:PartyTransactionAssociation a owl:Class ;
    rdfs:label "party transaction association"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "The link of a party role, or of an account, to one transaction, with the role it played there. A transaction can be an order, a ticket or bill of lading, an invoice, a payment or a case, or a trade or transfer captured in a deal. It records the transaction reference, the role, the account and the period it is valid for."@en .

party:relationship-type a skos:ConceptScheme ;
    rdfs:label "party relationship types"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of link from one party role to another."@en .

<https://w3id.org/lsc/ontology/modules/party/shared-attribute/credit> a skos:Concept ;
    skos:definition "The customer's credit: its limit, monitoring, blocks and roll-up."@en ;
    skos:inScheme party:shared-attribute ;
    skos:notation "credit" ;
    skos:prefLabel "Credit"@en ;
    skos:topConceptOf party:shared-attribute .

party:system-stage a skos:ConceptScheme ;
    rdfs:label "customer system stages"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en ;
    skos:definition "The five stages of a customer's record across the systems, from the first record to settlement."@en .

party:system-tier a skos:ConceptScheme ;
    rdfs:label "customer system tiers"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "Where a system sits in the customer's data flow: core, integration, enrichment, downstream or landscape source."@en .

party:Site a owl:Class ;
    rdfs:label "site"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "A physical operating location with its own lifecycle, whoever owns it: a station, a bulk plant, a cardlock, a terminal, an airport location or a pipeline delivery point. It records its operating model, amenities, image compliance and the terminals that supply it. A party owns or operates it for a period, through a party role held at the site."@en ;
    skos:scopeNote "A ship-to is a site, not a role: the party that receives product there holds the Consignee role (competency question 21; EPM-DEC-001-0068)."@en .

party:lifecycle-stage a skos:ConceptScheme ;
    rdfs:label "customer lifecycle stages"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en ;
    skos:definition "The six business stages of a customer's life with the company, from prospect to offboarding."@en .

party:site-type a skos:ConceptScheme ;
    rdfs:label "site types"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of physical operating location."@en .

<https://w3id.org/lsc/ontology/modules/party/sourcing-kind/source> a skos:Concept ;
    skos:definition "A system in the landscape that is a source of customers of this kind."@en ;
    skos:inScheme party:sourcing-kind ;
    skos:notation "source" ;
    skos:prefLabel "Source"@en ;
    skos:topConceptOf party:sourcing-kind .

party:PartyRelationship a owl:Class ;
    rdfs:label "party relationship"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "A dated, typed link from one party role to another, such as parent of, guarantor of, supplies, credit roll-up or contact for."@en .

party:SystemRecord a owl:Class ;
    rdfs:label "system record"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "A system's own record of a customer: who created or changed it, when, and the system's notes on it. It is not an entity of the conceptual model; system attributes that describe only the record point here."@en .

party:agreement-type a skos:ConceptScheme ;
    rdfs:label "agreement types"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The types of agreement. They overlap: one agreement can have several."@en .

party:transaction-kind a skos:ConceptScheme ;
    rdfs:label "transaction kinds"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of transaction a party or an account is associated with."@en .

party:LineOfBusiness a owl:Class ;
    rdfs:label "line of business"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A governed category of the company's business that a customer sits under. It decides which information is needed to set the customer up. A customer can sit under more than one."@en .

party:shared-attribute a skos:ConceptScheme ;
    rdfs:label "shared attributes"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "Attributes that several systems carry under different names for one thing."@en .

party:PartyRole a owl:Class ;
    rdfs:label "party role"@en ;
    dcterms:bibliographicCitation "ontology-playbook.md, Step 5; EPM-DEC-001-0068"@en ;
    skos:definition "A function one party performs in a business context, held from a start date to an end date. Customer roles and other roles sit side by side on the same party. Its role type comes from a governed list; a new role type needs a governance decision."@en ;
    skos:scopeNote "A role is a node, not a subclass of party: one party can hold many roles at once, each for its own period (ontology-playbook.md, Step 5)."@en .

<https://w3id.org/lsc/ontology/modules/party/system/profisee> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Profisee Data Storage"@en ;
    skos:exactMatch system:profisee ;
    skos:inScheme party:customer-systems ;
    skos:notation "profisee" ;
    skos:prefLabel "Profisee"@en ;
    party:customerRole "Customer data storage and mastering used by IDP, for customer ID mapping, customer roll-ups and cross-references."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/data-products-idp> ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

<https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "S/4"@en,
        "S4"@en,
        "SAP S/4"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "sap-s4hana" ;
    skos:prefLabel "SAP S/4HANA"@en ;
    party:customerRole "The financial system of record. It receives the business partner from SAP MDG, with company codes, sales areas and partner roles, adds credit and collection data, and takes transaction postings and invoices from the execution systems."@en ;
    party:implements party:CustomerAccount,
        party:Party,
        party:PartyRole ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

party:line-of-business a skos:ConceptScheme ;
    rdfs:label "lines of business"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The governed categories of the company's business that a customer sits under."@en .

party:ContactPoint a owl:Class ;
    rdfs:label "contact point"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "A telephone number, an email address or a fax number through which a party can be reached. It records its usage type and the period it is valid for."@en .

party:customer-class a skos:ConceptScheme ;
    rdfs:label "customer classes"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The kinds of customer, grouped by value-chain role and brand attachment. Each class is assigned to a customer account with dates. Together with MPC's classification C1 to C8 they form the channel dimension of MPC-P06."@en .

<https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> a skos:Concept ;
    skos:definition "A system that receives and uses the customer."@en ;
    skos:inScheme party:system-tier ;
    skos:notation "downstream" ;
    skos:prefLabel "Downstream"@en ;
    skos:topConceptOf party:system-tier .

party:Agreement a owl:Class ;
    rdfs:label "agreement"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "The commercial frame that party roles work under. It sets terms, pricing, volume, product scope, brand, territory, exclusivity and assignment rights. Its types overlap: one agreement can have several."@en .

party:CustomerSourcing a owl:Class ;
    rdfs:label "customer sourcing"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "How a system relates to a kind of customer: the kind starts there, is set up there for a line of business, or comes from there."@en .

party:party-role a skos:ConceptScheme ;
    rdfs:label "party roles"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:definition "The governed list of role types a party can hold. A new role type needs a governance decision."@en .

<https://w3id.org/lsc/ontology/modules/party/system/dealer-master> a skos:Concept,
        party:CustomerSystem ;
    skos:inScheme party:customer-systems ;
    skos:notation "dealer-master" ;
    skos:prefLabel "Dealer Master"@en ;
    party:customerRole "The system of record for the branded dealer network: brand customers and their stations and ship-tos. It is built on Salesforce and aggregates station point-of-sale transactions executed in other systems. Jobbers start here and go to SAP MDG; direct dealers start in SAP MDG and come here. It sends bank and payment details to SAP S/4HANA."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/salesforce>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-mdg>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> ;
    party:implements party:Agreement,
        party:PartyRole,
        party:Site,
        party:SiteBrandAssignment ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/polaris> a skos:Concept,
        party:CustomerSystem ;
    skos:inScheme party:customer-systems ;
    skos:notation "polaris" ;
    skos:prefLabel "Polaris"@en ;
    party:customerRole "The pipeline operations and invoicing system. It takes the SAP customer number and basic attributes from SAP MDG, adds operational data, records pipeline movements and revenue, and sends the transport invoices it generates to SAP S/4HANA."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana> ;
    party:implements party:CustomerAccount,
        party:PartyTransactionAssociation,
        party:Site ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

party:Product a owl:Class ;
    rdfs:label "product"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068; EPM-DEC-001-0092"@en ;
    skos:definition "A marketable hydrocarbon product or grade. The class stands in for a Product domain that this repository does not model yet. Contract terms are set per product, so specialty buyers are told apart by an agreement's product scope."@en ;
    skos:scopeNote "Since 1.1.0 its values are the refined products MPC's FY2025 Form 10-K names, in the scheme party:product, each mapped with SKOS to the Open Energy Ontology where a class fits (OEO v2.14.0, released 2026-10-08), and given its PIDX product family where one fits (EPM-DEC-001-0088, 0092). The business confirms or replaces the list (ontology/business-closeout.md, point 5)."@en .

party:product a skos:ConceptScheme ;
    rdfs:label "products"@en ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 1; business_architecture/reference/mpc/mpc-fy2025-10k-fact-sheet.md, section 4; EPM-DEC-001-0088; EPM-DEC-001-0092"@en ;
    skos:definition "The refined products the company makes and sells, as MPC's FY2025 Form 10-K names them: its six refinery product groups and the products it names under them, and renewable diesel. Each value is a party:Product."@en .

party:DataFlow a owl:Class ;
    rdfs:label "data flow"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "A movement of customer data from one system to another, with what it carries."@en .

party:customer-systems a skos:ConceptScheme ;
    rdfs:label "customer systems"@en ;
    skos:definition "The systems the customer passes through, from the decision owner's customer inputs (EPM-DEC-001-0069)."@en .

<https://w3id.org/lsc/ontology/modules/party/attribute-category/create> a skos:Concept ;
    skos:definition "An attribute that defines the customer in the system: set when the customer is created there."@en ;
    skos:inScheme party:attribute-category ;
    skos:notation "create" ;
    skos:prefLabel "Create"@en ;
    skos:topConceptOf party:attribute-category .

party:ExternalIdentifier a owl:Class ;
    rdfs:label "external identifier"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "An identifier of a party or of one of its roles, issued by an authority, an industry body or an earlier system, such as a tax identifier, a public-company identifier, an industry code or a legacy identifier. It records its issuer and its type."@en .

party:Party a owl:Class ;
    rdfs:label "party"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    skos:closeMatch foaf:Agent ;
    skos:definition "A person or an organization, as one identity, whatever roles it plays. It has a legal name, a status and a period it is valid for. Each party is a person or an organization, never both."@en ;
    skos:scopeNote "Customer is not a kind of party. A party becomes a customer by holding a customer role exercised within a customer account."@en .

party:Address a owl:Class ;
    rdfs:label "address"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    skos:definition "A physical or postal location of a party, such as its registered office, a mailing address, a billing address or an operating location. It records its type, how it is used and the period it is valid for. A party can hold several addresses at once."@en .

party:CustomerSystem a owl:Class ;
    rdfs:label "customer system"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    skos:definition "A system the customer passes through: where it is created, recorded, enriched or used, or a source of customers of a kind. A customer system that the process map also names matches the system module's system (skos:exactMatch)."@en .

<https://w3id.org/lsc/ontology/modules/party/system/sap-mdg> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "MDG"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "sap-mdg" ;
    skos:prefLabel "SAP MDG"@en ;
    party:customerRole "The point of control for customer creation and governance: every commercial customer is created here. It runs duplicate checks on identifiers, validates addresses, applies authorization groups by line of business and generates the canonical SAP customer number. It is the system of record for the customer and holds the tax ID and bank data."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/dealer-master>,
        <https://w3id.org/lsc/ontology/modules/party/system/magic>,
        <https://w3id.org/lsc/ontology/modules/party/system/polaris>,
        <https://w3id.org/lsc/ontology/modules/party/system/quorum>,
        <https://w3id.org/lsc/ontology/modules/party/system/rightangle>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana>,
        <https://w3id.org/lsc/ontology/modules/party/system/sirion>,
        <https://w3id.org/lsc/ontology/modules/party/system/star>,
        <https://w3id.org/lsc/ontology/modules/party/system/terminal-download> ;
    party:implements party:ExternalIdentifier,
        party:Party ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/system/salesforce> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "SF"@en,
        "Salesforce CRM"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "salesforce" ;
    skos:prefLabel "Salesforce"@en ;
    party:customerRole "Where a prospect is first captured and a new customer setup and credit check start, on two tracks: Trade (the commodity trading desk) and CRM/Basic (goods and products). It triggers creation in SAP MDG, receives the SAP customer number back, and serves the customer portal."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/dealer-master>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-mdg> ;
    party:implements party:Address,
        party:ContactPoint,
        party:Party ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

party:CustomerAccount a owl:Class ;
    rdfs:label "customer account"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068; EPM-DEC-001-0071"@en ;
    skos:definition "The commercial and financial container for a party's relationship with the company; the party transacts through it. It holds the account status, payment and credit terms, the company-code assignment, settlement details and the period it is valid for. The customer class is assigned at this level."@en ;
    skos:scopeNote "A customer-grained measure binds to the customer account by default, because credit terms and the class sit here and exposure aggregates from it. A measure about one role binds to that role, such as the payer for receivables or the sold-to for sales volume, and a measure about a location binds to the site. None binds to the bare word customer, which names no single thing (competency question 25; EPM-DEC-001-0071)."@en .

<https://w3id.org/lsc/ontology/modules/party/system/rightangle> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "RA"@en,
        "Right Angle"@en ;
    skos:exactMatch system:rightangle ;
    skos:inScheme party:customer-systems ;
    skos:notation "rightangle" ;
    skos:prefLabel "RightAngle"@en ;
    party:customerRole "The commercial and logistics system for trading, deals, scheduling and financial exposure. It takes basic customer data from SAP MDG, creates the business associate and its locations, sends the business associate ID and locale back to SAP MDG, and shares data with Kittyhawk and the trading desks."@en ;
    party:feeds <https://w3id.org/lsc/ontology/modules/party/system/allocation-manager>,
        <https://w3id.org/lsc/ontology/modules/party/system/kittyhawk>,
        <https://w3id.org/lsc/ontology/modules/party/system/sap-mdg> ;
    party:implements party:Agreement,
        party:ContactPoint,
        party:Party,
        party:PartyRole ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/core> .

<https://w3id.org/lsc/ontology/modules/party/attribute-category/enrich> a skos:Concept ;
    skos:definition "An attribute added to the customer in the system after it is created."@en ;
    skos:inScheme party:attribute-category ;
    skos:notation "enrich" ;
    skos:prefLabel "Enrich"@en ;
    skos:topConceptOf party:attribute-category .

party:SystemAttribute a owl:Class ;
    rdfs:label "system attribute"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0069"@en ;
    skos:definition "A field a system keeps for a customer, in one of the decision owner's two categories: Create, which defines the customer in the system, or Enrich, which is added afterwards. Its label is the system's field name, with spelling corrected and repeats removed."@en .

