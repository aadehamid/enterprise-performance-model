party:transactsThrough a owl:ObjectProperty ;
    rdfs:label "transacts through"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:Party ;
    rdfs:range party:CustomerAccount ;
