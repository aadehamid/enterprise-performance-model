party:transactionKind a owl:ObjectProperty ;
    rdfs:label "transaction kind"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:PartyTransactionAssociation ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of transaction, from the transaction-kind list."@en .

party:transactionReference a owl:DatatypeProperty ;
    rdfs:label "transaction reference"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:PartyTransactionAssociation ;
    rdfs:range xsd:string ;
