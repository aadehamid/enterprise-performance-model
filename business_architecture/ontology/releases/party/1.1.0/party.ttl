party:sourcingKind a owl:ObjectProperty ;
    rdfs:label "sourcing kind"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:CustomerSourcing ;
    rdfs:range skos:Concept ;
    skos:definition "Origin, setup or source, from the sourcing-kind list."@en .

party:sourcingSystem a owl:ObjectProperty ;
    rdfs:label "sourcing system"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:CustomerSourcing ;
    rdfs:range party:CustomerSystem ;
    skos:definition "The system."@en .

party:stageProcess a owl:ObjectProperty ;
    rdfs:label "stage process"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept ;
    skos:definition "A process of the core process scheme that does the work of the lifecycle stage. A process can serve several stages."@en .

party:stageSystem a owl:ObjectProperty ;
    rdfs:label "stage system"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0070"@en ;
    rdfs:domain skos:Concept ;
    rdfs:range party:CustomerSystem ;
    skos:definition "A customer system that holds the customer's record in the system stage."@en .

party:suppliedByTerminal a owl:ObjectProperty ;
    rdfs:label "supplied by terminal"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:domain party:Site ;
    rdfs:range party:Site ;
    skos:definition "A terminal that supplies the site."@en .

party:suppliedFrom a owl:ObjectProperty ;
    rdfs:label "supplied from"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0068"@en ;
    rdfs:domain party:CustomerAccount ;
    rdfs:range party:Site ;
    skos:definition "A site the account is supplied from, such as a refinery or a terminal."@en .

<https://w3id.org/lsc/ontology/modules/party/system-stage/execute> a skos:Concept ;
    skos:definition "The systems that hold the customer's record while its orders, movements, loadings and station sales are carried out: RightAngle, Polaris, Dealer Master and Terminal download. Dealer Master aggregates station sales that other systems execute. Input 6 also names card systems here; none of the customer systems executes card transactions, so none is linked (EPM-DEC-001-0070, item 3)."@en ;
    skos:inScheme party:system-stage ;
    skos:notation "execute" ;
    skos:prefLabel "Execute"@en ;
    skos:topConceptOf party:system-stage ;
    party:stageSystem <https://w3id.org/lsc/ontology/modules/party/system/dealer-master>,
        <https://w3id.org/lsc/ontology/modules/party/system/polaris>,
        <https://w3id.org/lsc/ontology/modules/party/system/rightangle>,
        <https://w3id.org/lsc/ontology/modules/party/system/terminal-download> .

<https://w3id.org/lsc/ontology/modules/party/system/bridger-insight> a skos:Concept,
        party:CustomerSystem ;
    skos:altLabel "Bridger"@en ;
    skos:inScheme party:customer-systems ;
    skos:notation "bridger-insight" ;
    skos:prefLabel "Bridger Insight"@en ;
    party:customerRole "The compliance check of a customer against government watchlists."@en ;
    party:systemTier <https://w3id.org/lsc/ontology/modules/party/system-tier/downstream> .

