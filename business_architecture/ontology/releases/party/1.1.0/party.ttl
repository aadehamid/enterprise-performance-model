    skos:inScheme party:lifecycle-stage ;
    skos:notation "risk-management" ;
    skos:prefLabel "Risk management"@en ;
    skos:topConceptOf party:lifecycle-stage ;
    party:stageProcess proc:CM-1-3-7-4-3,
        proc:CM-1-3-7-4-4 .

