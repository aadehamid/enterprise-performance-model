    dcterms:bibliographicCitation "EPM-DEC-001-0069"@en ;
    rdfs:domain party:SystemAttribute ;
    rdfs:range owl:Class ;
    skos:definition "The entity of the conceptual model the attribute is a fact about, or the system record for a field about the record itself."@en .

party:evidenceInput a owl:DatatypeProperty ;
    rdfs:label "evidence input"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0067; EPM-DEC-001-0069"@en ;
    rdfs:range xsd:string ;
    skos:definition "The numbers of the decision owner's customer inputs that show the statement, as EPM-DEC-001-0067's Context lists them. The inputs are not in this repository."@en .

party:exercisedWithin a owl:ObjectProperty ;
