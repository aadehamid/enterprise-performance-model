party:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:range xsd:date ;
    skos:definition "The last day the record holds. A record with no end date still holds."@en .

party:Organization a owl:Class ;
    rdfs:label "organization"@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0068"@en ;
    rdfs:subClassOf party:Party ;
    skos:closeMatch org:Organization ;
    skos:definition "A party that is an organization, such as a company, a partnership or a public body."@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/asphalt-bitumen-buyer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty> ;
    skos:definition "A paving or roofing buyer of asphalt or bitumen. Public bids and tax-exempt purchases are common. An agreement whose product scope is asphalt usually identifies the customer."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "asphalt-bitumen-buyer" ;
    skos:prefLabel "Asphalt / Bitumen buyer"@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/direct-dealer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/brand-attached-resellers> ;
    skos:definition "A dealer that operates a branded site under a long-term supply agreement with the company. The usual pattern is the Dealer role, a Fuel Supply agreement and a site brand assignment."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "direct-dealer" ;
    skos:prefLabel "Direct dealer"@en ;
    party:mpcClassification "C2" .

<https://w3id.org/lsc/ontology/modules/party/customer-class/exchange-trading-counterparty> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties> ;
    skos:definition "A party that swaps product with the company barrel for barrel, or trades with it on a buy or sell basis, with differences settled as imbalances. It acts through the Exchange Counterparty role and is a customer only when a revenue-recognized relationship exists."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "exchange-trading-counterparty" ;
    skos:prefLabel "Exchange / Trading counterparty"@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/forecast-driven-customer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> ;
    skos:definition "A customer whose supply is planned from forecasts, not fixed orders, usually as an account facet with demand planning."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "forecast-driven-customer" ;
    skos:prefLabel "Forecast-driven customer"@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/pipeline-customer> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty> ;
    skos:definition "A customer that ships or stores volumes under a throughput, storage or transport agreement, with invoices that flow back to settlement. The usual pattern is a Throughput / Storage agreement and party transaction associations on tickets and invoices."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "pipeline-customer" ;
    skos:prefLabel "Pipeline customer"@en .

<https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-marketing> a skos:Concept ;
    skos:broader <https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded> ;
    skos:definition "A customer that buys in bulk for resale, in domestic or international markets, under term or spot arrangements. The usual pattern is the Sold-To role and a Fuel Supply or Offtake agreement."@en ;
    skos:inScheme party:customer-class ;
    skos:notation "wholesale-marketing" ;
    skos:prefLabel "Wholesale marketing customer"@en ;
    party:mpcClassification "C3" .

<https://w3id.org/lsc/ontology/modules/party/line-of-business/petrochemicals> a skos:Concept,
        party:LineOfBusiness ;
    skos:definition "The line of business that sells petrochemical products."@en ;
    skos:inScheme party:line-of-business ;
    skos:notation "petrochemicals" ;
