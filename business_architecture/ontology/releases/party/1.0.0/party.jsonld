[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "The Customer domain's concepts: parties, the roles they hold for a period, accounts, agreements and sites; the customer's systems, data flow and attributes; and the customer lifecycle linked to core processes (Steps 5 to 7). Definitions only, never records."
   }
  ],
  "http://purl.org/dc/terms/issued": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-22"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-22"
   }
  ],
  "http://purl.org/dc/terms/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/2.1.0"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "en",
    "@value": "LSC Party Module"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/1.0.0"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionInfo": [
   {
    "@value": "1.0.0"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Address",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "address"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A physical or postal location of a party, such as its registered office, a mailing address, a billing address or an operating location. It records its type, how it is used and the period it is valid for. A party can hold several addresses at once."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Agreement",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "agreement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The commercial frame that party roles work under. It sets terms, pricing, volume, product scope, brand, territory, exclusivity and assignment rights. Its types overlap: one agreement can have several."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Brand",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "brand"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A trademark a product is marketed under. The network carries owned, licensed and competitor brands. A brand is owned by or licensed to a party for a period, through a Brand License agreement."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/ContactPoint",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "contact point"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A telephone number, an email address or a fax number through which a party can be reached. It records its usage type and the period it is valid for."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerAccount",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068; EPM-DEC-001-0071"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer account"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The commercial and financial container for a party's relationship with the company; the party transacts through it. It holds the account status, payment and credit terms, the company-code assignment, settlement details and the period it is valid for. The customer class is assigned at this level."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "A customer-grained measure binds to the customer account by default, because credit terms and the class sit here and exposure aggregates from it. A measure about one role binds to that role, such as the payer for receivables or the sold-to for sales volume, and a measure about a location binds to the site. None binds to the bare word customer, which names no single thing (competency question 25; EPM-DEC-001-0071)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerClass",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0047, What follows, item 5; EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The assignment of a class from the customer-class list to a customer account, from a start date to an end date. A class describes how the customer buys: its role, its channel and its supply pattern."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The class values are concepts of the customer-class scheme; this class is the dated assignment of one of them to one account."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerSourcing",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer sourcing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How a system relates to a kind of customer: the kind starts there, is set up there for a line of business, or comes from there."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerSystem",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer system"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A system the customer passes through: where it is created, recorded, enriched or used, or a source of customers of a kind. A customer system that the process map also names matches the system module's system (skos:exactMatch)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/DataFlow",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "data flow"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A movement of customer data from one system to another, with what it carries."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/ExternalIdentifier",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "external identifier"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An identifier of a party or of one of its roles, issued by an authority, an industry body or an earlier system, such as a tax identifier, a public-company identifier, an industry code or a legacy identifier. It records its issuer and its type."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/LineOfBusiness",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "line of business"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A governed category of the company's business that a customer sits under. It decides which information is needed to set the customer up. A customer can sit under more than one."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Organization",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "organization"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Party"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#closeMatch": [
   {
    "@id": "http://www.w3.org/ns/org#Organization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A party that is an organization, such as a company, a partnership or a public body."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Party",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0067; EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "party"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#closeMatch": [
   {
    "@id": "http://xmlns.com/foaf/0.1/Agent"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A person or an organization, as one identity, whatever roles it plays. It has a legal name, a status and a period it is valid for. Each party is a person or an organization, never both."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Customer is not a kind of party. A party becomes a customer by holding a customer role exercised within a customer account."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/PartyRelationship",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "party relationship"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A dated, typed link from one party role to another, such as parent of, guarantor of, supplies, credit roll-up or contact for."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/PartyRole",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ontology-playbook.md, Step 5; EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "party role"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A function one party performs in a business context, held from a start date to an end date. Customer roles and other roles sit side by side on the same party. Its role type comes from a governed list; a new role type needs a governance decision."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "A role is a node, not a subclass of party: one party can hold many roles at once, each for its own period (ontology-playbook.md, Step 5)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/PartyTransactionAssociation",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "party transaction association"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The link of a party role, or of an account, to one transaction, with the role it played there. A transaction can be an order, a ticket or bill of lading, an invoice, a payment or a case, or a trade or transfer captured in a deal. It records the transaction reference, the role, the account and the period it is valid for."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Person",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "person"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Party"
   }
  ],
  "http://www.w3.org/2002/07/owl#disjointWith": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/Organization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#closeMatch": [
   {
    "@id": "http://xmlns.com/foaf/0.1/Person"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A party that is a natural person."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Product",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "product"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A marketable hydrocarbon product or grade. The class stands in for a Product domain that this repository does not model yet; the module gives products no properties or values. Contract terms are set per product, so specialty buyers are told apart by an agreement's product scope."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/Site",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "site"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A physical operating location with its own lifecycle, whoever owns it: a station, a bulk plant, a cardlock, a terminal, an airport location or a pipeline delivery point. It records its operating model, amenities, image compliance and the terminals that supply it. A party owns or operates it for a period, through a party role held at the site."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "A ship-to is a site, not a role: the party that receives product there holds the Consignee role (competency question 21; EPM-DEC-001-0068)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/SiteBrandAssignment",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0067, What follows, item 4; EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "site brand assignment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The link of a site to a brand under an agreement, from a start date to an end date. It survives a change in who owns the site. When the supply agreement expires, the site converts."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/SystemAttribute",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0067; EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "system attribute"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A field a system keeps for a customer, in one of the decision owner's two categories: Create, which defines the customer in the system, or Enrich, which is added afterwards. Its label is the system's field name, with spelling corrected and repeats removed."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/SystemRecord",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "system record"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A system's own record of a customer: who created or changed it, when, and the system's notes on it. It is not an entity of the conceptual model; system attributes that describe only the record point here."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/accountFacet",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/CustomerAccount"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "account facet"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A secondary facet of the account: its brand status, contract type, product line, segment, geography or delivery tier. The values of these facets are not yet defined."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The delivery tier covers the delivery-mode candidate, which is not added separately (EPM-DEC-001-0067, What follows, item 9)."
   }
  ]
 },
