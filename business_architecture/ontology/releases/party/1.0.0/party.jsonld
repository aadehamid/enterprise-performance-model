   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-mdg"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage/prospect",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Salesforce holds the first record of a prospect, on the Trade or the CRM/Basic track. Jobbers start in Dealer Master and direct dealers in SAP MDG."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "prospect"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Prospect"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/stageSystem": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/salesforce"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage/record",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "SAP S/4HANA holds the customer's company codes and sales areas and serves as the accounts payable and receivable skeleton."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "record"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Record"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/stageSystem": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/sap-s4hana"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage/settle",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Invoices and postings from the execution systems return to SAP S/4HANA."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "settle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Settle"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
