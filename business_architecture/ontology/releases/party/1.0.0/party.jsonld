 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0070"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer system stages"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The five stages of a customer's record across the systems, from the first record to settlement."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage/execute",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The systems that hold the customer's record while its orders, movements, loadings and station sales are carried out: RightAngle, Polaris, Dealer Master and Terminal download. Dealer Master aggregates station sales that other systems execute. Input 6 also names card systems here; none of the customer systems executes card transactions, so none is linked (EPM-DEC-001-0070, item 3)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "execute"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Execute"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/stageSystem": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/dealer-master"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/polaris"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/rightangle"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system/terminal-download"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage/master",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "SAP MDG creates the customer, runs duplicate checks, applies authorization groups and generates the canonical SAP customer number."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/system-stage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Master"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
