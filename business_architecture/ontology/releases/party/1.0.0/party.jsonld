  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0069"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "customer system tiers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Where a system sits in the customer's data flow: core, integration, enrichment, downstream or landscape source."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/system-tier/core",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "One of the six systems the customer is created, recorded or executed in: SAP MDG, SAP S/4HANA, Salesforce, RightAngle, Polaris and Dealer Master."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
