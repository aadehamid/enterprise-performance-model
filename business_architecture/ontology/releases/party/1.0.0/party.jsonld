    "@value": "customer lifecycle stages"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The six business stages of a customer's life with the company, from prospect to offboarding."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/lifecycle-stage/offboarding",
