    "@language": "en",
    "@value": "The kinds of customer, grouped by value-chain role and brand attachment. Each class is assigned to a customer account with dates. Together with MPC's classification C1 to C8 they form the channel dimension of MPC-P06."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/asphalt-bitumen-buyer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A paving or roofing buyer of asphalt or bitumen. Public bids and tax-exempt purchases are common. An agreement whose product scope is asphalt usually identifies the customer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "asphalt-bitumen-buyer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Asphalt / Bitumen buyer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/brand-attached-resellers",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The customer classes that resell fuel under a company brand."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "brand-attached-resellers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Brand-attached resellers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/branded-jobber",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/brand-attached-resellers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An independent reseller of branded fuel under a branded supply agreement, which owns or operates its outlets. The usual pattern is the Jobber role, a Fuel Supply agreement and sites branded through site brand assignments."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "branded-jobber"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Branded jobber / marketer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C1"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/commercial-industrial-end-user",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer that uses the product in its own operations, such as a fleet, an airline, a utility or a railroad. The usual pattern is the Sold-To role and a Fuel Supply or Fleet Card Program agreement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "commercial-industrial-end-user"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Commercial and industrial end-user"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/crude-oil-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An external customer that buys crude oil or refinery feedstock from the company. Part of these sales go to companies in the crude oil or refinery feedstock trading and supply business, or to other refiners."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "crude-oil-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Crude oil customer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C8"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/direct-dealer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/brand-attached-resellers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A dealer that operates a branded site under a long-term supply agreement with the company. The usual pattern is the Dealer role, a Fuel Supply agreement and a site brand assignment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "direct-dealer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Direct dealer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C2"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The customer classes that use the product themselves, or buy a specialty product or service."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "end-users-specialty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "End-users and specialty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/exchange-trading-counterparty",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A party that swaps product with the company barrel for barrel, or trades with it on a buy or sell basis, with differences settled as imbalances. It acts through the Exchange Counterparty role and is a customer only when a revenue-recognized relationship exists."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "exchange-trading-counterparty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Exchange / Trading counterparty"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/export-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A buyer overseas. Product is lifted at a coastal refinery or at terminal gates, and supply usually comes from a refinery or terminal site."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "export-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Export customer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C7"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/forecast-driven-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer whose supply is planned from forecasts, not fixed orders, usually as an account facet with demand planning."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "forecast-driven-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Forecast-driven customer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/independent-retailer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A retailer that is not a brand jobber or direct dealer and buys refined products for its own outlets."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "independent-retailer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Independent retailer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C4"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/pipeline-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/end-users-specialty"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer that ships or stores volumes under a throughput, storage or transport agreement, with invoices that flow back to settlement. The usual pattern is a Throughput / Storage agreement and party transaction associations on tickets and invoices."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "pipeline-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Pipeline customer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/spot-market-buyer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A buyer that buys refined products on the spot market, not under a term agreement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "spot-market-buyer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Spot market buyer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C6"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/terminal-rack-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer that lifts product at terminal racks. Each lifting records the position holder, the customer and the carrier, usually as party transaction associations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "terminal-rack-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Terminal / Rack customer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/trading-counterparties",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The customer classes that trade with the company, product for product or on a buy or sell basis."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "trading-counterparties"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Trading counterparties"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/unbranded-customer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer that buys gasoline or diesel without a brand: an independent marketer, a commercial end-user, an unbranded distributor or a high-volume retailer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "unbranded-customer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Unbranded customer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C5"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-marketing",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A customer that buys in bulk for resale, in domestic or international markets, under term or spot arrangements. The usual pattern is the Sold-To role and a Fuel Supply or Offtake agreement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "wholesale-marketing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Wholesale marketing customer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/party/mpcClassification": [
   {
    "@value": "C3"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class/wholesale-unbranded",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The customer classes that buy fuel in bulk or without a brand, for resale."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "wholesale-unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Wholesale and unbranded"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/customer-class"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/party/customer-systems",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
