[
 {
  "@id": "https://w3id.org/lsc/ontology/modules/authority/EvidenceTier",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "AGENTS.md, Working rules; the decision owner's instruction in answers-2026-10-19-completion-search.md; EPM-DEC-001-0059"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "evidence tier"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The evidence order the repository applies: the process authority and the decision owner's own material, then Marathon Petroleum, then U.S. refining peers, then industry and regulatory sources, then generic frameworks as support only."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/authority/evidenceTier",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "AGENTS.md, Working rules (evidence order); competency question 44; EPM-DEC-001-0059"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "evidence tier"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The tier of the evidence order a source belongs to. Where two sources of one concept disagree, the source with the lower rank wins."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/authority/rank",
  "@type": [
   "http://www.w3.org/2002/07/owl#DatatypeProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0059"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "rank"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2001/XMLSchema#integer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The tier's place in the evidence order, from 1 (most authoritative)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/authority/tier/framework",
