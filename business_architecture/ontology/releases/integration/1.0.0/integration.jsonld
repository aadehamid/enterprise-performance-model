   {
    "@language": "en",
    "@value": "rule kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The two kinds of consumer rule."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/publishesMeasure",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 35; EPM-DEC-001-0005, EPM-DEC-001-0061"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/data-product/DataProduct"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "publishes measure"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/MeasureDefinition"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The binding a catalog row uses to point at a Named KPI: the data product that publishes a measure's values points at the measure's IRI. Both must already be defined: the measure with its kind in the kpi module, and the data product in the data-product module. The values stay in the data product's platform."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/reliesOn",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "EPM-DEC-001-0061"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/Rule"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "relies on"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A graph term the rule rests on: the property or class an answer reads, or whose absence makes a refusal necessary."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/may-answer",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The agent may answer from the graph alone."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/RuleKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "may-answer"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "May answer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The agent must refuse, and say where the answer lives instead."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/RuleKind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "must-refuse"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Must refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/definitions",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 13, 16, 27 and 41"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The definition, name, aliases and kind of any concept, measure, data product, series, system or lane, read from its skos:definition, labels and kind."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "What a thing is"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#altLabel"
   },
   {
    "@id": "http://www.w3.org/2004/02/skos/core#definition"
   },
   {
    "@id": "http://www.w3.org/2004/02/skos/core#prefLabel"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measureKind"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/may-answer"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/no-context-as-ownership",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 38; EPM-DEC-001-0058"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Say a process owns, computes or approves a measure because the measure is placed on it. Only a certification placement says that."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Present context as ownership"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/placement/placementKind"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/no-crack-from-legs",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 32 and 42; EPM-DEC-001-0057"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Calculate a crack spread from the prices of its crude and product legs. The official series is the published one; a homemade crack is a different number."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Build a crack from its legs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/leg"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/market-data/seriesOf"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/no-customer-without-role",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 25, 26 and 42; EPM-DEC-001-0004; EPM-DEC-001-0067; EPM-DEC-001-0068"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Answer \"who is the customer\" without naming a role: sold-to, bill-to, payer or another. Customer is not a role or a KPI; the answer resolves to one role."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Name the customer without a role"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The roles are the `party` module's party-role list, which a party role names through party:roleType (EPM-DEC-001-0068). The core concept CM 1.3.7.1.1 keeps them apart too: a customer record must not collapse Sold-To, Bill-To, Payer and the other roles. A ship-to is a site, and the party that receives product there holds the Consignee role."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/party/roleType"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/no-report-as-kpi",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 42; EPM-DEC-001-0042"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Call a tracker, report or report column a KPI, or call a KPI candidate a KPI. A tracker has no grain, and a KPI needs a recorded decision that names its target and owner."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Treat a report column as the KPI"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/kpiCandidate"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/measureKind"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/no-values",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency question 42; EPM-DEC-001-0005"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Calculate a measure's value, or quote one, from the graph. The graph holds definitions; the values are in the systems that compute them. A basis is a description, not a formula."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Compute or quote a value"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/reliesOn": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/kpi/basis"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/consumer/ruleKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule-kind/must-refuse"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/rule/not-to-be-confused-with",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/consumer/Rule"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 31, 32 and 36"
