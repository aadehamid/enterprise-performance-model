   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/Rule",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "competency questions 41 and 42; EPM-DEC-001-0061"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "consumer rule"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A rule for an agent that answers from the graph: what it may answer without reading a table or inventing a formula, or what it must refuse."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/consumer/RuleKind",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
