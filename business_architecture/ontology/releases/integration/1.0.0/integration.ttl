auth:evidenceTier a owl:ObjectProperty ;
    rdfs:label "evidence tier"@en ;
    dcterms:bibliographicCitation "AGENTS.md, Working rules (evidence order); competency question 44; EPM-DEC-001-0059"@en ;
    rdfs:range skos:Concept ;
    skos:definition "The tier of the evidence order a source belongs to. Where two sources of one concept disagree, the source with the lower rank wins."@en .

tier:peers a skos:Concept ;
    skos:definition "U.S. refining peers' SEC filings, as read into business_architecture/reference/downstream-peers/."@en ;
    skos:inScheme auth:EvidenceTier ;
    skos:notation "3" ;
    skos:prefLabel "U.S. refining peers"@en ;
    auth:rank 3 .

kpi:informsProcess plc:placementKind kind:context .

mkt:region plc:placementKind kind:context .

vs:consumes plc:placementKind kind:context .

vs:measureLink plc:placementKind kind:context .

vs:produces plc:placementKind kind:certification .

con:RuleKind a skos:ConceptScheme ;
    rdfs:label "rule kind"@en ;
    dcterms:bibliographicCitation "competency questions 41 and 42"@en ;
    skos:definition "The two kinds of consumer rule."@en .

plc:PlacementKind a skos:ConceptScheme ;
    rdfs:label "placement kind"@en ;
    dcterms:bibliographicCitation "competency question 38; EPM-DEC-001-0058"@en ;
    skos:definition "The two things a placement can claim."@en .

kind:certification a skos:Concept ;
    skos:definition "The link names a data product's owning process: the producing process, which is the subject of vs:produces and the target of dp:producedBy."@en ;
    skos:inScheme plc:PlacementKind ;
    skos:notation "certification" ;
    skos:prefLabel "Certification"@en .

plc:placementKind a owl:AnnotationProperty ;
    rdfs:label "placement kind"@en ;
    dcterms:bibliographicCitation "competency question 38; EPM-DEC-001-0058"@en ;
    skos:definition "What a placing property claims: certification (the link names the owning process of a data product) or context (the link says only where one thing is used or placed with another)."@en .

tier:mpc a skos:Concept ;
    skos:definition "MPC's filings and public materials, as read into business_architecture/reference/mpc/."@en ;
    skos:inScheme auth:EvidenceTier ;
    skos:notation "2" ;
    skos:prefLabel "Marathon Petroleum"@en ;
    auth:rank 2 .

auth:EvidenceTier a skos:ConceptScheme ;
    rdfs:label "evidence tier"@en ;
    dcterms:bibliographicCitation "AGENTS.md, Working rules; the decision owner's instruction in answers-2026-10-19-completion-search.md; EPM-DEC-001-0059"@en ;
    skos:definition "The evidence order the repository applies: the process authority and the decision owner's own material, then Marathon Petroleum, then U.S. refining peers, then industry and regulatory sources, then generic frameworks as support only."@en .

rk:must-refuse a skos:Concept ;
    skos:definition "The agent must refuse, and say where the answer lives instead."@en ;
    skos:inScheme con:RuleKind ;
    skos:notation "must-refuse" ;
    skos:prefLabel "Must refuse"@en .

rk:may-answer a skos:Concept ;
    skos:definition "The agent may answer from the graph alone."@en ;
    skos:inScheme con:RuleKind ;
    skos:notation "may-answer" ;
    skos:prefLabel "May answer"@en .

tier:framework a skos:Concept ;
    skos:definition "Cross-industry frameworks, method standards and academic papers, such as APQC's PCF, ASCM and SKOS. Support only."@en ;
    skos:inScheme auth:EvidenceTier ;
    skos:notation "5" ;
    skos:prefLabel "Generic frameworks"@en ;
    auth:rank 5 .

tier:process-authority a skos:Concept ;
    skos:definition "The process map, value streams, data product portfolio and office lanes in business_architecture/, the decision owner's approved definitions and measure list, and the source author's recorded answers."@en ;
    skos:inScheme auth:EvidenceTier ;
    skos:notation "1" ;
    skos:prefLabel "Process authority"@en ;
    auth:rank 1 .

kind:context a skos:Concept ;
    skos:definition "The link says only where one thing is used or placed with another. It does not say either end owns, computes or approves the other."@en ;
    skos:inScheme plc:PlacementKind ;
    skos:notation "context" ;
    skos:prefLabel "Context"@en .

con:Rule a owl:Class ;
    rdfs:label "consumer rule"@en ;
    dcterms:bibliographicCitation "competency questions 41 and 42; EPM-DEC-001-0061"@en ;
    skos:definition "A rule for an agent that answers from the graph: what it may answer without reading a table or inventing a formula, or what it must refuse."@en .

tier:industry a skos:Concept ;
    skos:definition "Standards bodies, exchanges, registries, regulators and agencies, such as API, the Energy Institute, CME Group, GLEIF, CFTC, EIA, EPA and FASB."@en ;
    skos:inScheme auth:EvidenceTier ;
    skos:notation "4" ;
    skos:prefLabel "Industry and regulatory sources"@en ;
    auth:rank 4 .

