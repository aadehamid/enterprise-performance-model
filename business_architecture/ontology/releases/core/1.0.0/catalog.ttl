@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lsc/ontology/catalog> a dcat:Catalog ;
    dcat:dataset <https://w3id.org/lsc/ontology/modules/core/1.0.0> .

<https://w3id.org/lsc/ontology/modules/core/1.0.0> a dcat:Dataset ;
    dcterms:isVersionOf <https://w3id.org/lsc/ontology/modules/core> ;
    dcterms:issued "2026-10-13"^^xsd:date ;
    dcterms:title "LSC Core Process Ontology 1.0.0"@en ;
    owl:versionInfo "1.0.0" ;
    dcat:distribution <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/canonical-facts.csv>,
        <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.jsonld>,
        <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.ttl>,
        <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/shapes.ttl> .

<https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/canonical-facts.csv> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/canonical-facts.csv> ;
    dcat:mediaType "text/csv" .

<https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.jsonld> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/core.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/shapes.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/1.0.0/shapes.ttl> ;
    dcat:mediaType "text/turtle" .

