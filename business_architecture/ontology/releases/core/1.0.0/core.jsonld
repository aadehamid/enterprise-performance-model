   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 23 (2026-09-20). Template row (see CM-1-3-3-1-4); review terminology decision: domain measurement framework, not KPI governance — preferred label 'Define Channel Measurement Framework' queued prominently. Standard measurement-framework statement verbatim in scope note. APQC 'Define objectives' is a WEAK generic match. Step 3d naming pass (2026-09-21): renamed from 'Define KPI Framework' to 'Define Channel Measurement Framework' — critical semantic-collision resolution. Prior label retired from ontology aliases (a shared generic altLabel would recreate the collision); scoped historical alias 'Define KPI Framework (Channel)' recorded in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19521"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the measurement framework for the channel system — coverage, throughput, economics, and engagement measures with their definitions, baselines, targets, and measurement responsibilities — as evidence-layer measures with governed routing toward enterprise KPIs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.3.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Channel Measurement Framework"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers channel measurement design. Defines domain-level measures, baselines, targets, measurement responsibilities, data sources, and review cadence needed to evaluate offer, pricing, or channel design outcomes. The framework may nominate measures as candidate KPIs but does not approve, publish, version, calculate, certify, or govern enterprise KPIs. Those activities follow the Enterprise Measurement Catalog, Candidate KPI Register, Enterprise KPI Catalog, and KPI Store governance process. Channel measures span coverage, volume and share by segment, channel economics and cost-to-serve trends, and engagement and partner health, aligned with the metrics stewarded at CM-1-3-1-6 and the diagnostics at CM-1-3-2-4-1. Excludes enterprise KPI definition and KPI Store governance (KPI workstream); measurement execution (CM-1-3-5-5, CM-1-3-6-1); metrics stewardship (CM-1-3-1-6).\nIn scope: Define channel measures, baselines, targets, responsibilities, data sources, and review cadence | align with stewarded metrics and channel diagnostics | nominate candidate KPIs into KPI Store governance\nOut of scope: Enterprise KPI approval, publication, and governance (KPI Store workstream) | measurement execution (CM-1-3-5-5, CM-1-3-6-1) | metrics stewardship (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Channel design outputs (CM-1-3-3-3-1/-2/-4)"
   },
   {
    "@language": "en",
    "@value": "KPI Store classification rules"
   },
   {
    "@language": "en",
    "@value": "stewarded metric definitions (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The channel measurement framework (evidence-layer, KPI Store-routed)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The channel system measured against its design intent."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Define KPI Framework (Channel)"
   },
   {
    "@language": "en",
    "@value": "Define KPI Framework"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10344"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop and maintain the approved retail-network design—operating-model alternatives, target footprint, outlet formats, market coverage, and location criteria—within approved channel strategy and investment constraints, so site investment and network-development processes act against an evidence-based network blueprint."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Concept-type: process — one network-design lifecycle; tactical. Review definition adopted verbatim: a blueprint/target-setting process, never investment execution (no-capex scope statement verbatim in scope note). Lifecycle per review: Evaluate network operating alternatives → Define provisional target size and formats ↔ Define and prioritize location criteria/targets → Define network measurement framework → feed evidence back into the next design cycle; size and location iterate — the recorded precedes relation is a logical dependency, not a one-way sequence. PMPA fact-dependent per the batch 22 statement. APQC 'Design logistics network' STRONG, no validator — adjacent match (logistics network, not retail network); comparative only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Network Design (Retail)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the retail network-design lifecycle: formulating and evaluating network strategic operating alternatives (CM-1-3-3-4-2), defining target network size and formats (CM-1-3-3-4-3), defining target locations (CM-1-3-3-4-1), and defining the network measurement framework (CM-1-3-3-4-4), with size and location iterating within a cycle and evidence feeding back into the next cycle. Network Design recommends and maintains approved footprint direction, target size, outlet formats, trade-area criteria, and prioritized location targets. It does not authorize capital expenditure, acquire or divest sites, negotiate leases, execute dealer conversions, approve project business cases, or operate retail locations. Designs within the approved channel strategy (CM-1-3-2-4) and channel design (CM-1-3-3-3); changes affecting existing branded dealer arrangements inherit the batch 22 fact-dependent PMPA statement, with franchise legal analysis reserved to Legal & Corporate Communications. Excludes site acquisition, divestment, lease negotiation, and project approval (Investment, Real Estate, Legal, Finance, delegated authorities); dealer conversion execution (channel management, Legal); site engineering, construction, maintenance, and EHS standards (their owners, batch 20 architecture); retail operations (designated operating functions); channel strategy and mix (CM-1-3-2-4); terminal and distribution networks (CM-1-1, locked rules).\nIn scope: Run the recurring network-design cycle | design the network operating model, target size, outlet formats, and location criteria within approved strategy | recommend and maintain approved footprint direction | define network measurement with KPI Store routing\nOut of scope: Capital expenditure authorization, site acquisition/divestment, and leases (Investment, Real Estate, Finance, delegated authorities) | dealer conversion execution (channel management, Legal) | site engineering/EHS standards (their owners) | retail operations (operating functions) | channel strategy and mix (CM-1-3-2-4) | terminal/distribution networks (CM-1-1, locked rules)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved channel strategy (CM-1-3-2-4)"
   },
   {
    "@language": "en",
    "@value": "channel design outputs (CM-1-3-3-3)"
   },
   {
    "@language": "en",
    "@value": "market and consumer findings (CM-1-3-1-1/-3)"
   },
   {
    "@language": "en",
    "@value": "network performance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The approved retail-network design: operating model, target size, formats, and location criteria"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A retail footprint that was designed on evidence before it was funded."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10160"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the target locations for the retail network — trade-area criteria, location profiles, and prioritized location targets — from consumer, market, and network evidence, producing the location targets the investment and real-estate processes execute against."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Location step of the network-design lifecycle; review safeguard verbatim in scope note — targets are hypotheses for diligence, never acquisition decisions; iterates with Define Target Network Size per review. APQC 'Define target audience' STRONG, no validator — false-direction lexical match (audience targeting, not location targeting); comparative only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.4.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Target Location"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers location targeting: defining trade-area and site-selection criteria (demand, traffic, competition, format fit, supply logistics); profiling and prioritizing target locations against the network operating model and target size; and maintaining the location target list with rationale. Location targets are hypotheses and priority criteria for investment/real-estate diligence, not approved acquisition decisions or guarantees of site availability, profitability, permitting, zoning, environmental suitability, or construction feasibility. Location evidence feeds back into size and format assumptions (iterative with CM-1-3-3-4-3). Uses consumer and market findings under their batch 21 controls. Excludes site acquisition/divestment execution and diligence decisions (investment and real-estate processes); site development and engineering (their owners); network size decisions (CM-1-3-3-4-3).\nIn scope: Define trade-area and site-selection criteria | profile and prioritize target locations | maintain the location target list with rationale | feed location evidence back into size and format assumptions\nOut of scope: Site transactions, diligence decisions, and approvals (investment/real-estate processes) | site development/engineering (their owners) | network sizing (CM-1-3-3-4-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Network size and model (CM-1-3-3-4-3/-2)"
   },
   {
    "@language": "en",
    "@value": "consumer and market findings (CM-1-3-1-1/-3)"
   },
   {
    "@language": "en",
    "@value": "trade-area data (with source limitations)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Prioritized location targets with criteria and rationale, as diligence hypotheses"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The next site chosen by criteria, not by accident."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10058"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Formulate and Evaluate Strategic Operating Alternatives (Network)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Formulate the strategic operating alternatives for the retail network — company-operated, dealer-operated, and mixed network models within the approved channel mix — and evaluate them against network objectives, economics, and constraints."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). First step of the network-design lifecycle; capitalization of '(network Strategy)' normalized in the queued label. APQC 'Evaluate strategic initiatives' is a WEAK generic match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.4.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Formulate And Evaluate Strategic Operating Alternatives (network Strategy)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers network-alternative formulation and evaluation: defining candidate network operating models consistent with the approved channel-of-trade mix (CM-1-3-2-4); evaluating against network objectives, retail economics, capability requirements, and — where arrangements meet the franchise criteria — the applicable franchise constraints (batch 22 PMPA statement); recommending the preferred model with evidence. Evaluation within the approved mix — it does not re-open channel strategy. Excludes channel strategy and mix (CM-1-3-2-4); the network decisions (L4 with its approvals); franchise legal assessment (Legal); operating model design beyond the network (CM-1-3-3-6).\nIn scope: Define candidate network operating models within the approved mix | evaluate against objectives, economics, and applicable constraints | recommend with evidence\nOut of scope: Channel strategy/mix (CM-1-3-2-4) | network decisions and approvals (L4) | franchise legal assessment (Legal) | wider operating model design (CM-1-3-3-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved channel mix (CM-1-3-2-4)"
   },
   {
    "@language": "en",
    "@value": "network performance evidence"
   },
   {
    "@language": "en",
    "@value": "retail economics"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Evaluated network operating alternatives with a recommendation"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The network model chosen from real alternatives, not inherited."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10160"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the target size of the retail network — outlet counts or ranges, formats, and coverage by market and segment — consistent with the chosen network model, the approved channel mix, and validated capacity and economics."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Sizing step of the network-design lifecycle; review addition verbatim — ranges, formats, coverage objectives, or scenario-based capacity, not a single fixed count; iterates with Define Target Location per review; capacity validation per the batch 23 discipline. APQC 'Define target audience' is a WEAK false-direction match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.4.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Target Network Size"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers network sizing: translating the chosen network operating model and approved channel mix into target outlet counts, formats, and market coverage; validating size targets against demand evidence, retail economics, and supply, logistics, and service capacity through the accountable operating processes (batch 23 capacity-validation discipline); and maintaining size targets with rationale. Target size may be expressed as ranges, formats, coverage objectives, or scenario-based capacity rather than a single fixed outlet count. Size targets iterate with location evidence (CM-1-3-3-4-1) and are recommendations into the applicable investment approvals — never acquisition commitments. Excludes investment commitment and approval (delegated approvals); location targeting (CM-1-3-3-4-1); channel mix (CM-1-3-2-4).\nIn scope: Set target outlet counts or ranges, formats, and coverage | validate against demand, economics, and operating capacity | maintain size targets with rationale, iterating with location evidence\nOut of scope: Investment commitments and approvals (delegated approvals) | location targeting (CM-1-3-3-4-1) | channel mix (CM-1-3-2-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Network model (CM-1-3-3-4-2)"
   },
   {
    "@language": "en",
    "@value": "capacity validation inputs"
   },
   {
    "@language": "en",
    "@value": "demand and market evidence"
   },
   {
    "@language": "en",
    "@value": "location evidence (CM-1-3-3-4-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Target network size, formats, and coverage with rationale"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A network sized to evidence, capacity, and economics."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Template row (batch 23 treatment); preferred label 'Define Network Measurement Framework' queued prominently; full measurement-framework routing statement in scope note per review. APQC 'Define objectives' is a WEAK generic match. Step 3d naming pass (2026-09-21): renamed from 'Define KPI Framework' to 'Define Network Measurement Framework' — critical semantic-collision resolution. Prior label retired from ontology aliases (a shared generic altLabel would recreate the collision); scoped historical alias 'Define KPI Framework (Network)' recorded in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19521"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the measurement framework for the retail network — coverage, throughput, unit economics, and network-health measures with their definitions, baselines, targets, and measurement responsibilities — as evidence-layer measures with governed routing toward enterprise KPIs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.4.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Network Measurement Framework"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers network measurement design. Defines domain-level measures, baselines, targets, measurement responsibilities, data sources, and review cadence needed to evaluate retail-network design outcomes. The framework may nominate measures as candidate KPIs but does not approve, publish, version, calculate, certify, or govern enterprise KPIs. Those activities follow the Enterprise Measurement Catalog, Candidate KPI Register, Enterprise KPI Catalog, and KPI Store governance process. Network measures span coverage against targets, per-site and network unit economics, format performance, and network health, aligned with the metrics stewarded at CM-1-3-1-6. Excludes enterprise KPI definition and KPI Store governance (KPI workstream); measurement execution (CM-1-3-5-5, operating processes); metrics stewardship (CM-1-3-1-6).\nIn scope: Define network measures, baselines, targets, responsibilities, data sources, and review cadence | align with stewarded metrics | nominate candidate KPIs into KPI Store governance\nOut of scope: Enterprise KPI approval, publication, and governance (KPI Store workstream) | measurement execution (CM-1-3-5-5, operating processes) | metrics stewardship (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "KPI Store classification rules"
   },
   {
    "@language": "en",
    "@value": "Network design outputs (CM-1-3-3-4-1/-2/-3)"
   },
   {
    "@language": "en",
    "@value": "stewarded metric definitions (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The network measurement framework (evidence-layer, KPI Store-routed)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The network measured against its design intent."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Define KPI Framework (Network)"
   },
   {
    "@language": "en",
    "@value": "Define KPI Framework"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10102"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the marketing communications strategy that carries the approved brand and value propositions to their audiences — integrating the media, direct, advertising, point-of-sale, digital, and internal communication strategies into one coherent direction — within advertising and marketing law, so communications planning and execution deliver one coherent, lawful voice."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Concept-type: process; tactical. Cluster shape: parallel variant set (batch 08/21 pattern) with the integration performed at this L4 per review — no precedes chain among the children. Review control statement verbatim in scope note: sets direction, approves nothing that Legal, Compliance, Privacy, Technology, Procurement, Planning, and Execution control. CM-1-3-3-5-6 approved earlier via APQC adoption, untouched. Legal guardrails via SRC-FTC-ADM-001; Legal owns interpretation. APQC 'Develop marketing strategy' STRONG, no validator — comparative anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing Communications Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the communications-strategy set: media strategy (CM-1-3-3-5-1), direct marketing strategy (CM-1-3-3-5-2), advertising strategy (CM-1-3-3-5-3), point-of-sale communication strategy (CM-1-3-3-5-4), digital marketing strategy (CM-1-3-3-5-5), and internal marketing communications strategy (CM-1-3-3-5-6, previously approved), with this L4 performing the integration: consistency checks, prioritization, and conflict resolution across the parallel channel strategies into one integrated communications strategy implementing the approved brand strategy (CM-1-3-2-1). Marketing Communications Strategy may set strategic communication roles, audience principles, claims territory, channel priorities, and measurement expectations. It does not approve specific claims, substantiation, disclaimers, endorsements, disclosures, contact lists, consent status, channel executions, media buys, or campaign releases; those activities follow the applicable Legal, Compliance, Privacy, Technology, Procurement, Planning, and Execution controls. Communications strategy operates within truth-in-advertising and substantiation requirements, disclosure and endorsement standards, CAN-SPAM, the Telemarketing Sales Rule, and applicable state, FCC, and non-US regimes — fact- and jurisdiction-dependent, with interpretation owned by Legal & Corporate Communications and the compliance framework; personal data is used only within the batch 21 shared governance statement. Excludes brand strategy (CM-1-3-2-1); campaign and communications planning (CM-1-3-5-2/-3); marketing execution (CM-1-3-6-5); brand standard management (CM-1-3-6-7); consent, preference, and suppression operations (their owners); advertising legal review (Legal); enterprise KPI definition (KPI workstream). Marketing Communications Planning (CM-1-3-5-3) plans communications that deliver the strategy defined by Marketing Communications Strategy (CM-1-3-3-5).\nIn scope: Define and integrate the parallel channel-communication strategies with consistency checks, prioritization, and conflict resolution | implement the approved brand strategy in communications terms | operate within advertising and marketing law | issue the integrated communications strategy to planning and execution\nOut of scope: Brand strategy (CM-1-3-2-1) | campaign/communications planning (CM-1-3-5-2/-3) | execution, media buys, and campaign releases (CM-1-3-6-5, execution controls) | brand standards (CM-1-3-6-7) | consent/suppression operations (their owners) | claim and disclosure approval (Legal, Compliance) | enterprise KPI definition (KPI workstream)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved brand strategy (CM-1-3-2-1)"
   },
   {
    "@language": "en",
    "@value": "audience findings (CM-1-3-1-3/-4)"
   },
   {
    "@language": "en",
    "@value": "communications performance evidence"
   },
   {
    "@language": "en",
    "@value": "value propositions (CM-1-3-2-2/-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The integrated marketing communications strategy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One coherent, lawful voice across every channel the brand speaks through."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16854"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the media strategy — which paid, owned, and earned media channels carry the communications strategy, with what roles, weights, and principles — so media planning buys against deliberate strategic direction."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Parallel variant, media instance; review media-role coverage verbatim in scope note. APQC 'Define new media communication strategy' 0.75 STRONG — genuine comparative anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Media Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers media strategy: setting media channel roles and mix principles across broadcast, print, out-of-home, and digital media in their strategic roles; setting media investment principles and measurement expectations; and maintaining the strategy from performance evidence. Owned media, earned media, paid media, retail media, and partner/channel media roles may be defined here, while paid-media procurement/buying and partner placement execution follow Procurement/Marketing Execution controls. Strategy only: media planning and buying are planning/execution (CM-1-3-5-2, CM-1-3-6-5); media vendor and agency selection follows procurement processes. Excludes media planning and buying (CM-1-3-5-2, CM-1-3-6-5); vendor/agency selection (procurement); digital channel operations (execution). Integrated Marketing Planning (Advertising) (CM-1-3-5-2) builds the integrated plan from the media strategy defined by Define Media Strategy (CM-1-3-3-5-1).\nIn scope: Set media channel roles across owned, earned, paid, retail, and partner media | set mix and investment principles | set measurement expectations | maintain the strategy from evidence\nOut of scope: Media planning/buying (CM-1-3-5-2, CM-1-3-6-5) | vendor/agency selection (procurement) | channel operations (execution)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Integrated communications direction (CM-1-3-3-5)"
   },
   {
    "@language": "en",
    "@value": "audience findings"
   },
   {
    "@language": "en",
    "@value": "media performance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The media strategy: roles, mix, and investment principles"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Media money spent against a strategy, not a habit."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16851"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the direct marketing strategy — how the company contacts identified customers and prospects one-to-one across mail, email, phone, and messaging — within consent, privacy, and marketing-communication law, so direct outreach is deliberate, targeted, and lawful."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Parallel variant, direct instance; review contactability rule verbatim in scope note — consumes, never creates, overrides, or retains consent status; b21 privacy statement and b23 targeting controls inherited; CAN-SPAM/TSR context via SRC-FTC-ADM-001, Legal owns interpretation. APQC 'Define direct marketing strategy' scored 1.0 — the tree's first perfect APQC match; comparative anchor (description not copied)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Direct Marketing Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers direct marketing strategy: setting the role, audiences, contact channels, and frequency/consent principles for one-to-one outreach; requiring lawful contactability (consent/opt-out status, suppression lists, CAN-SPAM for email, the Telemarketing Sales Rule and related consent regimes for calls and texts — fact- and jurisdiction-dependent, Legal owns interpretation); and setting measurement expectations. This process consumes approved consent, lawful-basis, preference, suppression, identity, and contactability data from accountable systems/processes. It does not create, override, or retain consent status. Personal, loyalty, account, and behavioral data are used only within the batch 21 shared governance statement and the batch 23 targeting controls (privacy, consent, suppression, fairness, non-discrimination). Strategy only: campaign design and execution sit at CM-1-3-5/6. Excludes campaign planning and execution (CM-1-3-5, CM-1-3-6-5); consent, preference, and suppression data creation and management (accountable systems and processes); privacy framework ownership (governance owners); legal interpretation (Legal). Define Direct Marketing Strategy (CM-1-3-3-5-2) supplies approved direct-marketing channel roles, audiences, and contact-frequency principles that Marketing Communications Planning (CM-1-3-5-3) consumes in its defined work.\nIn scope: Set direct marketing roles, audiences, channels, and frequency/consent principles | require lawful contactability and suppression discipline | consume approved contactability data without creating or overriding it | set measurement expectations within privacy controls\nOut of scope: Campaign planning/execution (CM-1-3-5, CM-1-3-6-5) | consent/preference/suppression data ownership (accountable systems) | privacy framework ownership (governance owners) | legal interpretation (Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Audience findings (CM-1-3-1-3/-4)"
   },
   {
    "@language": "en",
    "@value": "approved consent and suppression status (accountable systems)"
   },
   {
    "@language": "en",
    "@value": "direct performance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The direct marketing strategy with consent and contactability principles"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One-to-one outreach that is purpose-limited, permissioned or otherwise legally authorized, appropriately targeted, and compliant with applicable contact-preference and suppression controls."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10123"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the advertising strategy — the strategic role, audiences, claims territory, and creative principles of paid advertising — within truth-in-advertising and substantiation requirements, so advertising builds the brand on claims the company can prove."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Parallel variant, advertising instance; review substantiation rule verbatim in scope note — Legal/Compliance determines evidentiary adequacy per claim, audience, medium, jurisdiction, and disclosure context; fuel-claim examples non-exhaustive, ownership stays with Legal/regulatory functions. APQC candidate 'Define pricing strategy' is a FALSE mapping (wrong process entirely); comparative value nil."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Advertising Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers advertising strategy: setting advertising's strategic role and audiences; defining the claims territory (what the company will say about products and offers) with the substantiation discipline — claims must be truthful, non-deceptive, and evidence-backed, with clear-and-conspicuous disclosures and endorsement-relationship disclosure where used. Claims must be supported before dissemination under the applicable substantiation standard; Legal/Compliance determines whether evidence is adequate for the specific claim, audience, medium, jurisdiction, and disclosure context. Fuel-related claims carry their own regulatory regimes and are flagged for Legal per campaign — non-exhaustive examples: fuel quality/specification, octane/cetane, additives, performance/economy, environmental/carbon, renewable-content, and loyalty and price claims; this process does not own those regulatory interpretations. Sets creative and brand-consistency principles under the brand strategy and measurement expectations. Excludes campaign creative development and execution (CM-1-3-5/6); claim and disclosure approval (Legal, Compliance); brand standards enforcement (CM-1-3-6-7). Define Advertising Strategy (CM-1-3-3-5-3) supplies the approved advertising strategy, audience direction, and creative principles that Integrated Marketing Planning (Advertising) (CM-1-3-5-2) consumes in its defined work.\nIn scope: Set advertising roles, audiences, and claims territory with substantiation discipline | set creative and brand-consistency principles | flag regulated fuel claims for Legal | set measurement expectations\nOut of scope: Creative development/execution (CM-1-3-5/6) | claim and disclosure approval (Legal, Compliance) | fuel-claim regulatory interpretation (Legal, regulatory owners) | brand standards enforcement (CM-1-3-6-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand strategy (CM-1-3-2-1)"
   },
   {
    "@language": "en",
    "@value": "advertising performance evidence"
   },
   {
    "@language": "en",
    "@value": "claims substantiation evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The advertising strategy: role, audiences, claims territory, and principles"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Advertising that can prove what it promises."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16855"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the point-of-sale communication strategy — how the brand and offers are communicated at forecourts, stores, and other points of sale — coordinating brand, offer, and pricing communication where the customer actually decides."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Parallel variant, POS instance; review exclusion verbatim in scope note — pump, pole-sign, shelf, foodservice, and forecourt displays carry product, price, tax, labeling, and safety implications owned by their processes. APQC 'Define point of sale (POS) communication strategy' 0.8 STRONG — genuine comparative anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define POS Communication Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers POS communication strategy: setting the strategic framework for on-site communications (signage roles, offer and price communication principles, promotional display principles) consistent with brand standards direction and the consumer proposition; coordinating with pricing display and regulatory signage requirements (jurisdiction-dependent); and setting measurement expectations. Excludes fuel-price setting, pump-sign configuration, legal metrology, product labeling, and price-display execution, which belong to the applicable pricing, site-operations, EHS/regulatory, and execution processes. Strategy only: site execution and merchandising are execution (CM-1-3-6-5/-7). Excludes site execution and merchandising (CM-1-3-6-5/-7); fuel-price setting and price-display execution (pricing and site-operations processes); pump-sign configuration, legal metrology, and product labeling (site-operations, EHS/regulatory processes).\nIn scope: Set POS communication frameworks for signage, offers, and promotional display | keep POS communication consistent with brand and proposition | set measurement expectations\nOut of scope: Site execution/merchandising (CM-1-3-6-5/-7) | fuel-price setting and price-display execution (pricing, site operations) | pump-sign configuration, metrology, and labeling (site operations, EHS/regulatory)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand and proposition direction"
   },
   {
    "@language": "en",
    "@value": "offer definitions (CM-1-3-3-1)"
   },
   {
    "@language": "en",
    "@value": "site communication performance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The POS communication strategy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The message at the pump and shelf chosen as deliberately as the media buy."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16851"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the digital marketing strategy — the strategic role of digital channels, platforms, and data-driven techniques across the communications mix — within privacy and online-advertising requirements, so digital investment follows deliberate direction rather than platform momentum."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Parallel variant, digital instance; review three-way distinction recorded in scope note — strategy here, digital product/experience and technology operation with their owners; b21 privacy statement and b23 targeting controls inherited; online-disclosure context via SRC-FTC-ADM-001. APQC 'Define direct marketing strategy' 0.75 is an adjacent match (digital, not direct)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Digital Marketing Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers digital marketing strategy: setting the strategic role of digital channels (search, social, programmatic, apps, retail media) and their relationship to media, direct, and POS strategies; setting principles for data-driven targeting and personalization within the batch 21 shared governance statement and batch 23 targeting controls; requiring online-disclosure discipline (clear-and-conspicuous, native-advertising and endorsement disclosure) with Legal owning interpretation; and setting measurement expectations. Three domains are distinguished per review: digital marketing strategy (channel roles, audience principles, personalization standards, measurement — this row); digital product and customer experience (apps, web, portals, commerce, loyalty systems, product roadmaps — their owners); and technology operation (platform selection, data pipelines, ad-tech, identity resolution, security — technology and procurement processes). This row must not become an application or product-management domain. Excludes digital campaign planning and execution (CM-1-3-5, CM-1-3-6-5); digital product/experience ownership (their owners); platform and ad-tech selection/operation (technology, procurement); consent operations (their owners); legal interpretation (Legal). Define Digital Marketing Strategy (CM-1-3-3-5-5) supplies approved digital-channel roles, targeting principles, and measurement expectations that Marketing Communications Planning (CM-1-3-5-3) consumes in its defined work.\nIn scope: Set digital channel roles and their relationship to the other communication strategies | set data-driven targeting and personalization principles within privacy controls | require online-disclosure discipline | set measurement expectations\nOut of scope: Digital planning/execution (CM-1-3-5, CM-1-3-6-5) | digital product/experience ownership (their owners) | platform and ad-tech selection/operation (technology, procurement) | consent operations (their owners) | legal interpretation (Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Communications direction (CM-1-3-3-5)"
   },
   {
    "@language": "en",
    "@value": "audience findings within controls"
   },
   {
    "@language": "en",
    "@value": "digital performance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The digital marketing strategy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Digital spend directed by strategy, disciplined by privacy."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16852"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Developing a program to promote the objectives, values, products and services of the company to its employees by treating them as potential customers, in order to extend company client base, increase employee engagement or to foster brand advocacy."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18), bundled fix. Row was approved in the #29 pre-intake pass with an empty scope_note and has been the single BLOCKING finding of step3c-workbook-validate.py since #30. Only the missing scope_note was added; the approved definition, status, and all other fields are unchanged. Boundaries asserted here are drawn from existing taxonomy siblings and the locked Legal & Corp Comm decision, not from new research. Phase 1 fields remain empty, consistent with this row staying on the PRE_INTAKE_APPROVED allowlist for the later backfill pass."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Internal Marketing Communications Strategy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers setting the strategy for communicating brand, offer, and marketing messages to the organization's own employees as an internal audience: audience and channel choice, message and tone direction, and the intended engagement or advocacy outcome. Strategy only. Excludes executing internal communications, owned by Implement Internal Communications (CM-1-3-5-3-9), and excludes campaign-level planning, owned by Marketing Communications Planning (CM-1-3-5-3). Excludes external, media, public, investor, and government communications, which the locked Legal & Corp Comm boundary places outside this branch. Excludes employee relations, terms of employment, and HR policy communication."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/adopted"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 24 (2026-09-20). Template row (batch 23 treatment); preferred label queued prominently; full measurement-framework routing statement in scope note per review. APQC 'Define objectives' is a WEAK generic match. Step 3d naming pass (2026-09-21): renamed from 'Define KPI Framework' to 'Define Marketing Communications Measurement Framework' — sixth and final 'Define KPI Framework' collision resolved (the decision owner's follow-up decision, discovered after the 8-rename Phase 1 execution). Prior label retired from ontology aliases (a shared generic altLabel would recreate the collision); scoped historical alias 'Define KPI Framework (Marketing Communications)' recorded in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19521"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the measurement framework for marketing communications — reach, engagement, effectiveness, and efficiency measures across the communication channels with their definitions, baselines, targets, and measurement responsibilities — as evidence-layer measures with governed routing toward enterprise KPIs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.3.5.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Marketing Communications Measurement Framework"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers communications measurement design. Defines domain-level measures, baselines, targets, measurement responsibilities, data sources, and review cadence needed to evaluate marketing-communications outcomes. The framework may nominate measures as candidate KPIs but does not approve, publish, version, calculate, certify, or govern enterprise KPIs. Those activities follow the Enterprise Measurement Catalog, Candidate KPI Register, Enterprise KPI Catalog, and KPI Store governance process. Communications measures span reach and audience delivery, engagement, message effectiveness, and cost-efficiency by channel, aligned with the metrics stewarded at CM-1-3-1-6 and consumed by Marketing Performance Analysis (CM-1-3-5-5). Excludes enterprise KPI definition and KPI Store governance (KPI workstream); measurement execution (CM-1-3-5-5); metrics stewardship (CM-1-3-1-6).\nIn scope: Define communications measures, baselines, targets, responsibilities, data sources, and review cadence | align with stewarded metrics | nominate candidate KPIs into KPI Store governance\nOut of scope: Enterprise KPI approval, publication, and governance (KPI Store workstream) | measurement execution (CM-1-3-5-5) | metrics stewardship (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-1-6"
   }
  ],
