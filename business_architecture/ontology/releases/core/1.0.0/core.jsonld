 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-10",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Historical note: the label retained the “Decision” suffix pending the naming pass, but the concept was always authored as the recurring allocation process, not the decision record or its output. The naming pass considered “Allocate Crude & Feedstock” for verb consistency with sibling labels; the executed label is “Allocate Crude and Feedstock”. The boundary against Supply And Trading follows the locked SCM/Commercial rule: this concept places already-secured supply and does not choose counterparty, price, or contract. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Crude Allocation Decision' to 'Allocate Crude and Feedstock'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20688"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-cmu-refplan-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Crude & Feedstock Allocation"
   },
   {
    "@language": "en",
    "@value": "Crude Allocation Decision"
   },
   {
    "@language": "en",
    "@value": "Crude Allocation"
   },
   {
    "@language": "en",
    "@value": "Feedstock Allocation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Assign available crude and feedstock cargoes, grades, and volumes to specific refineries and receipt windows so each site's approved production plan can be met at the best delivered economics across the region."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.2.10"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Allocate Crude and Feedstock"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring allocation of secured or available crude and feedstock supply across competing refinery destinations, including grade-to-site matching, volume splits, timing of receipt windows, and reallocation when supply or plan assumptions change. Excludes crude purchase, negotiation, and trade execution, owned by Supply And Trading; excludes vessel, pipeline, and terminal movement execution, owned by Midstream; excludes the refinery's internal decision on which tanks and units process an allocated grade, owned by Refining.\nIn scope: Grade-to-refinery assignment | volume split across sites | receipt-window timing | reallocation on supply disruption or plan change | allocation of term and spot volumes against planned refinery slates\nOut of scope: Crude purchasing and trade execution (Supply And Trading) | physical movement, berth and pipeline scheduling (Midstream) | unit-level crude processing decisions (Refining) | refinery slate economics selection (Refinery Planning and Optimization)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved refinery production plan"
   },
   {
    "@language": "en",
    "@value": "crude and feedstock quality assays"
   },
   {
    "@language": "en",
    "@value": "delivered-cost and freight economics"
   },
   {
    "@language": "en",
    "@value": "refinery receipt and storage constraints"
   },
   {
    "@language": "en",
    "@value": "secured and available crude supply position"
   }
  ],
