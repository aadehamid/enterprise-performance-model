   {
    "@value": "CM 1.1.3.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Process Business Renewal Request"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20022"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-doe-rppl-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Movement Scheduling & Administration"
   },
   {
    "@language": "en",
    "@value": "Primary Distribution Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Schedule and administer the primary distribution movements that execute the product schedule — nominating volumes to pipelines, vessels, rail, and terminals, administering load and discharge events, and tracking movements to closure — so scheduled product arrives where the plan requires, fully documented."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). 'Physical' in the label refers to the movements being scheduled, not to this process performing them — the locked Midstream rule holds. Nomination-cycle and batching practice per the DOE refined-product pipeline backgrounder. APQC: no meaningful candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Physical Distribution Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers mode-level movement scheduling and administration from planned movement to closed load: nominations and confirmations with carriers and terminal operators, load authorization and documentation, in-transit tracking, and discharge confirmation with per-load reconciliation. Midstream, carriers, and terminal operators perform the physical loading, transport, and discharge; this process owns the schedule, the shipper-side administration, and the movement record, per the locked Midstream rule and the owner-versus-executor pattern. Excludes deciding what moves where and when, owned by Product Scheduling (CM-1-1-3-5); excludes secondary deliveries (CM-1-1-3-8). Physical Distribution Scheduling (CM-1-1-3-6) supplies closed primary-movement records, load/discharge confirmations, and execution status that Distribution Backcasting (CM-1-1-6) consumes in its defined work.\nIn scope: Nominate and confirm movements with carriers and terminals | authorize and administer load and discharge events | track movements to closure | maintain the movement record\nOut of scope: Short-term schedule decisions (Product Scheduling, CM-1-1-3-5) | physical loading, transport, and discharge operation (Midstream, carriers, terminal operators) | secondary delivery scheduling (CM-1-1-3-8)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "carrier and terminal capacities and cycles"
   },
   {
    "@language": "en",
    "@value": "movement documentation"
   },
   {
    "@language": "en",
    "@value": "short-term network schedule"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "nominated, administered, and closed primary distribution movements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Turn the product schedule into nominated, tracked, closed movements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20851"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-doe-rppl-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Nominations Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Prepare, submit, and manage volume nominations to pipelines, vessels, rail, and terminal operators — matching the short-term schedule to each carrier's cycles, batch specifications, and deadlines, and managing confirmations, revisions, and allocations through the cycle."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Nomination practice per the DOE backgrounder: shippers nominate to common carriers roughly monthly, movements schedule in multi-day cycles, batches are segregated or fungible per tariff specification; revision and allocation management is intra-cycle. Evidence is contextual — nomination frequency, tariffs, and cycle structures vary by carrier and are not asserted as this organization's model. 'Execute' is read as executing the nomination process, not the physical movement. APQC 20851 is an unrelated IT candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.6.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Plan & Execute Nominations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the shipper-side nomination process: translating planned movements into nominations per carrier tariff and cycle rules, including segregated versus fungible batch specifications and cycle deadlines; submitting, confirming, and revising nominations; managing carrier allocation and prorationing effects; and keeping the schedule aligned with confirmed nominations. Excludes the carrier's own pipeline scheduling and batching operation; excludes movement quantity decisions, owned by Product Scheduling (CM-1-1-3-5); excludes physical transport, owned by Midstream and carriers.\nIn scope: Prepare nominations per carrier cycles and specifications | submit, confirm, and revise nominations | manage carrier allocations and prorationing effects | align the schedule with confirmed nominations\nOut of scope: Carrier pipeline scheduling and batching operation (carriers, Midstream) | movement quantity decisions (CM-1-1-3-5) | physical transport (Midstream, carriers)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-2-9"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-9"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "batch specifications"
   },
   {
    "@language": "en",
    "@value": "carrier tariffs, cycles, and deadlines"
   },
   {
    "@language": "en",
    "@value": "confirmed capacity"
   },
   {
    "@language": "en",
    "@value": "planned movements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "confirmed nominations aligned to the schedule"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Secure and maintain the carrier capacity the schedule needs, cycle by cycle."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Owner-versus-executor per the locked Midstream rule, following the batch 04 Measure Inventory precedent; despatch measurement and documentation practice per EI HM 32. Preferred normalized label 'Administer Shipment Loading' queued for the naming pass (the decision owner, batch 05) — the current label reads as an activity in progress rather than a stable process name. APQC: no meaningful candidate. Step 3d naming pass — scope-ambiguity Batch 1 (A+B+C, 2026-09-21): renamed from 'Loading Shipment' to 'Administer Scheduled Shipment Loading'. Prior label(s) retained as altLabel(s): 'Loading Shipment | Load Administration | Shipment Loading Administration'."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10226"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-doe-rppl-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Load Administration"
   },
   {
    "@language": "en",
    "@value": "Loading Shipment"
   },
   {
    "@language": "en",
    "@value": "Shipment Loading Administration"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer the loading of scheduled shipments at refineries and terminals — authorizing the lifting, confirming loaded quantities and quality documentation, and capturing the load into movement and inventory records — so each shipment leaves accounted for and per schedule."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.6.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Administer Scheduled Shipment Loading"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers shipper-side load administration: releasing and authorizing scheduled loads, confirming loaded volumes and documentation (measurement tickets, bills of lading, quality certificates) per despatch practice (EI HM 32), recording the load against movement and stock records, and flagging load exceptions. The physical loading operation is owned by the terminal operator (Midstream or third party) per the locked Midstream rule. Excludes nomination management (CM-1-1-3-6-1) and in-transit tracking (CM-1-1-3-6-3).\nIn scope: Authorize and release scheduled loads | confirm loaded quantities and quality documentation | record loads into movement and inventory records | flag load exceptions\nOut of scope: Physical loading operation (terminal operator: Midstream or third party) | nomination management (CM-1-1-3-6-1) | in-transit tracking (CM-1-1-3-6-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "confirmed schedule and nominations"
   },
   {
    "@language": "en",
    "@value": "measurement tickets and quality certificates"
   },
   {
    "@language": "en",
    "@value": "terminal load confirmations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "documented, recorded loads"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Get each scheduled load authorized, documented, and recorded."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10353"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "In-Transit Inventory Tracking"
   },
   {
    "@language": "en",
    "@value": "Movement Tracking"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Track scheduled movements from load to discharge — monitoring progress against the schedule, maintaining in-transit inventory visibility by movement, and updating scheduling and inventory records as movements progress — so the network always knows what is en route, where, and when it will arrive."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). The label's 'Inventory Management' is bounded to in-transit, movement-linked inventory; stock-point positions belong to CM-1-1-3-7-12 per batch 04. APQC 10353 'Track inventory deployment' is contextual evidence only (review-link)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.6.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Track Movements and Inventory Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers in-transit tracking and its inventory effects: movement status against schedule, arrival estimates and delays, in-transit stock by product and movement, and feeding position updates to inventory and scheduling processes. The label's 'Inventory Management' is bounded to movement-linked in-transit inventory only; stock-point position stewardship is owned by Monitor and Control Inventory Positions (CM-1-1-3-7-12) per batch 04. Excludes carrier transport operation, owned by Midstream and carriers.\nIn scope: Monitor movement status and arrival estimates against schedule | maintain in-transit inventory visibility by movement | update scheduling and inventory records as movements progress | flag movement delays and exceptions\nOut of scope: Stock-point position stewardship (Monitor and Control Inventory Positions, CM-1-1-3-7-12) | carrier transport operation (Midstream, carriers) | discharge administration (CM-1-1-3-6-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "carrier status and arrival estimates"
   },
   {
    "@language": "en",
    "@value": "load records"
   },
   {
    "@language": "en",
    "@value": "movement schedule"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "current in-transit positions and movement status"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep en-route product visible and the schedule honest about arrivals."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12940"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-api-mpms-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Discharge Administration"
   },
   {
    "@language": "en",
    "@value": "Outturn Reconciliation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer the discharge of arriving shipments — confirming received quantities and quality documentation, reconciling discharged against loaded volumes to surface in-transit gains and losses per movement, and closing the movement in scheduling and inventory records."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Boundary to CM-1-1-3-7-5: per-movement outturn reconciliation here; periodic book-to-physical reconciliation there. Receipt measurement and loss-surfacing practice per EI HM 32. APQC 12940 'Reconcile inventories' is a WEAK review-link."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.6.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Discharge & Reconcile Load"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers receipt-side load administration per EI HM 32 receipt practice: confirming outturn quantities and documentation, comparing loaded against discharged volumes per movement, resolving or escalating discrepancies, and closing the movement. The physical discharge operation is owned by the terminal operator (Midstream or third party). Per-movement outturn reconciliation feeds, but does not replace, periodic book-to-physical reconciliation, owned by Perform Inventory Reconciliation (CM-1-1-3-7-5); claims against carriers follow the relevant commercial agreements. Discharge & Reconcile Load (CM-1-1-3-6-4) supplies per-movement outturn quantities, reconciled load/discharge records, and gain/loss evidence that Perform Inventory Reconciliation (CM-1-1-3-7-5) consumes in its defined work.\nIn scope: Confirm outturn quantities and documentation | reconcile discharged against loaded volumes per movement | resolve or escalate per-load discrepancies | close movements in scheduling and inventory records\nOut of scope: Physical discharge operation (terminal operator: Midstream or third party) | periodic book-to-physical reconciliation (CM-1-1-3-7-5) | carrier claims settlement (commercial agreements)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "load records"
   },
   {
    "@language": "en",
    "@value": "movement documentation"
   },
   {
    "@language": "en",
    "@value": "outturn measurement tickets"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "closed, reconciled movements with per-load gain and loss"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Close each movement with received quantities confirmed and losses surfaced."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Q1 decision (the decision owner, Option A): capability, not process — the children are distinct recurring processes that jointly enable inventory stewardship, not stages of one cycle. The bare-noun label can denote the asset/state, a count, or the function; this node denotes the capability. Step 3d naming pass (2026-09-21): renamed to 'Inventory Management' ('Inventory' retained as altLabel); the L4-versus-L5 label collision is resolved — the L5 is now 'Monitor and Control Inventory Positions' ('Manage Inventory' retained as its altLabel). Placement rule: Supply Chain Management answers what should be held, moved, made, or replenished, where and when; this capability answers what inventory exists, under what identity, ownership, and entitlement, in what quantity and location, and whether it is controlled and reconciled; Midstream answers how bulk material is physically received, stored, transferred, and transported. Feedstock boundary constraint (Q3 decision, the decision owner, Option A): Manage Feedstock Inventory (CM-1-2-5-4-2) owns the day-to-day monitoring, control, and operational management of crude and refinery-feedstock inventory positions within Crude/Feed Supply Management; this cluster owns cross-material inventory policy, measurement, reconciliation, and specialized inventory-arrangement controls, and does not own day-to-day feedstock position management. A reciprocal note is recorded on CM-1-2-5-4-2. Hydrocarbon loss-control ownership beyond reconciliation reporting has no home in the current tree; playbook step 7 carries that question — deliberately not resolved here. Step 3d naming pass (2026-09-21): renamed from 'Inventory' to 'Inventory Management' — critical semantic-collision resolution. Prior label 'Inventory' retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12900"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-api-mpms-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Inventory"
   },
   {
    "@language": "en",
    "@value": "Stock Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability to govern, measure, reconcile, control, position, replenish, and account for petroleum feedstocks, intermediates, and refined products across the downstream network, including their quantity, quality, location, ownership, entitlement, identity, and availability."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Inventory Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers development and maintenance of inventory policies by material class; physical inventory measurement and the volumetric inputs to valuation; book-to-physical reconciliation; replenishment management; and stewardship of inventory held under consignment, commingling, third-party-storage, lot/batch, and re-brand arrangements, including controls over ownership, entitlement, product identity, custody, quality, location, and availability. Excludes setting plan-period finished-product inventory targets inside the regional plan, owned by Plan Finished Goods Inventory (CM-1-1-2-13); excludes physical tank, terminal, and pipeline operation, owned by Midstream; excludes inventory valuation, accounting, and financial reporting, owned by Finance; excludes day-to-day crude and refinery-feedstock position management, owned by Manage Feedstock Inventory (CM-1-2-5-4-2) per the batch 04 decision. Inventory Management (CM-1-1-3-7) supplies controlled inventory availability, ownership, entitlement, and location records that Regional Optimization (CM-1-1-2) consumes in its defined work.\nIn scope: Inventory policy by material class | physical inventory measurement and volumetric inputs to valuation | book-to-physical reconciliation | replenishment management | consignment, commingled, re-brand, lot/batch, and third-party storage stewardship\nOut of scope: Plan-period inventory targets in the regional plan (Plan Finished Goods Inventory, CM-1-1-2-13) | physical storage and movement operation (Midstream) | inventory valuation, accounting, and financial reporting (Finance) | day-to-day feedstock position management (Manage Feedstock Inventory, CM-1-2-5-4-2) | trading inventory risk management (Supply And Trading)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved regional and distribution plans"
   },
   {
    "@language": "en",
    "@value": "measured tank and meter data"
   },
   {
    "@language": "en",
    "@value": "movement and transaction records"
   },
   {
    "@language": "en",
    "@value": "storage and consignment agreements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "governed, reconciled inventory positions and policies for the distribution network"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Ensure the network's stock positions are governed by policy, measured accurately, reconciled, and managed across ownership and storage arrangements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10346"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm31-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Crude & Feedstock Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish and maintain the policy governing crude and feedstock inventories — target and minimum operating levels, safety and strategic stock requirements, tankage and segregation rules, and review triggers — so feedstock supply to refineries is protected at an efficient working-capital cost."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). One of three sibling policy nodes split by material class; the split follows the physical flow (feedstock → intermediates → finished product), and each policy binds the processes managing that class. APQC 10346 is a WEAK delivery-service-policy candidate; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Crude/Feedstock Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring development, approval, and review of crude and feedstock inventory policy across refinery and terminal storage, including minimum operating and safety stock levels, quality-segregation requirements by grade, and the conditions that trigger policy review. Excludes day-to-day management of feedstock positions against the policy, which sits with Supply And Trading (Manage Feedstock Inventory, CM-1-2-5-4-2) per the batch 04 decision; excludes plan-period inventory choices, owned by Regional Optimization (CM-1-1-2); excludes physical tank operation, owned by Midstream and Refining.\nIn scope: Set target, minimum operating, and safety stock levels for crude and feedstock | define segregation and tankage policy by grade | define policy review triggers and cadence | approve policy exceptions\nOut of scope: Day-to-day feedstock position management (Manage Feedstock Inventory, CM-1-2-5-4-2) | plan-period inventory positioning (Regional Optimization, CM-1-1-2) | crude purchasing (Supply And Trading) | physical storage operation (Midstream, Refining)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "refinery feedstock requirements"
   },
   {
    "@language": "en",
    "@value": "supply lead times and variability"
   },
   {
    "@language": "en",
    "@value": "tankage and segregation constraints"
   },
   {
    "@language": "en",
    "@value": "working-capital guidance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "approved crude and feedstock inventory policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Set the binding policy for how much crude and feedstock is held, where, and under what rules."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-10",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12942"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Batch-Tracked Inventory Management"
   },
   {
    "@language": "en",
    "@value": "Lot Traceability Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage inventory that must be tracked by lot or batch identity — such as specialty products, additives, and quality-certified stock — preserving batch identity, certificates, and traceability from receipt through storage to issue."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). The lot/batch-versus-fungible split is the organizing boundary with CM-1-1-3-7-7: identity-preserved stock here, entitlement-tracked fungible stock there — modeled as arrangements or control requirements, not permanent asset classifications. Relevant to specialty and additive lines where certificates and recall traceability are required."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.10"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Lot/Batch Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers lot- and batch-level stock control where identity must survive storage and movement: assigning and preserving batch identity in stock records, holding certificates of analysis and quality status against each lot, applying lot-selection rules at issue, and supporting recall and claims traceability. Distinct from fungible bulk stock managed as commingled entitlements (CM-1-1-3-7-7), where batch identity is deliberately not preserved. Excludes laboratory testing and certificate generation, owned by the operating asset's quality function; excludes batch production and blending execution, owned by Refining. Manage Lot/Batch Inventory (CM-1-1-3-7-10) supplies lot/batch stock records, identities, and quality status that Perform Inventory Reconciliation (CM-1-1-3-7-5) consumes in its defined work.\nIn scope: Assign and preserve lot/batch identity in stock records | hold quality certificates and status by lot | apply lot-selection rules at issue | maintain lot traceability for recall and claims\nOut of scope: Laboratory testing and certification (operating asset quality function) | batch production and blending execution (Refining) | fungible bulk entitlement tracking (CM-1-1-3-7-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "batch and lot identifiers from production and receipt"
   },
   {
    "@language": "en",
    "@value": "certificates of analysis"
   },
   {
    "@language": "en",
    "@value": "lot-selection rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "traceable lot/batch stock records with quality status"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Preserve batch identity, quality status, and traceability for stock that must not be treated as fungible."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-11",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12944"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Leased Storage Management"
   },
   {
    "@language": "en",
    "@value": "Third-Party Terminal Storage Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage company inventory held in third-party storage facilities — leased tankage, throughput agreements, and commercial storage — administering capacity entitlements, monitoring stock positions and operator statements, and managing performance against the storage agreements."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). APQC 12944 'Manage third party bulk storage' scored 0.889 STRONG with no validator source; used as supporting comparative evidence, with the local definition bounded to inventory administration rather than facility operation. Governing distinction is the facility/custody boundary: company-owned stock in someone else's facility. Orthogonal to consignment (ownership boundary, CM-1-1-3-7-6) — both can apply simultaneously — and to commingled (entitlement in shared fungible stock, CM-1-1-3-7-7)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.11"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Third Party Storage"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the inventory-side administration of third-party storage: tracking company stock by facility and agreement, reconciling operator stock statements, monitoring utilization of leased capacity and throughput commitments, and flagging agreement performance issues. Excludes negotiating storage and terminalling agreements, owned by the commercial owner (Supply And Trading); excludes the operator's physical facility operation; excludes commingled entitlement mechanics, owned by Manage Commingled Inventory (CM-1-1-3-7-7) where stock in a third-party facility is fungible and shared. Manage Third Party Storage (CM-1-1-3-7-11) supplies company stock positions and operator statements for third-party storage that Perform Inventory Reconciliation (CM-1-1-3-7-5) consumes in its defined work.\nIn scope: Track company stock by third-party facility and agreement | reconcile operator stock statements | monitor leased capacity and throughput utilization | flag storage-agreement performance issues\nOut of scope: Storage agreement negotiation (Supply And Trading) | physical facility operation (third-party operator) | commingled entitlement tracking (CM-1-1-3-7-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-2-10"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "company movement records"
   },
   {
    "@language": "en",
    "@value": "operator stock statements"
   },
   {
    "@language": "en",
    "@value": "storage and throughput agreements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "reconciled third-party storage positions and utilization status"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep company stock in third-party facilities visible, reconciled, and within agreement entitlements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-12",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Q2 decision (the decision owner, Option A, tightened): approved in place as a distinct operational process — position stewardship and exception response, which no sibling owns — with material scope limited to finished products and intermediates so it cannot silently reclaim feedstock (Q3). Preferred normalized label 'Monitor and Control Inventory Positions' recorded for the consolidated naming pass; current label retained for traceability, and the collision with the L4 label is queued with it. Decision right: this process identifies and escalates replenishment needs; Manage Inventory Replenishment (CM-1-1-3-7-9) owns the replenishment decision. Daily stock control as distinct from periodic reconciliation follows EI HM 32 practice. APQC 12942 'Manage bulk inventory' STRONG with no validator; comparative evidence only. Step 3d naming pass (2026-09-21): renamed from 'Manage Inventory' to 'Monitor and Control Inventory Positions' — critical semantic-collision resolution. Prior label 'Manage Inventory' retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12942"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Inventory Position Management"
   },
   {
    "@language": "en",
    "@value": "Manage Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Monitor and control actual and projected inventory positions for finished products and intermediates: identify operating-limit, availability, ownership, quality, location, and balance exceptions, coordinate timely response, and provide reliable current-position information to planning and operational stakeholders."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.12"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Monitor and Control Inventory Positions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring review of physical and book inventory positions, movements, and commitments; minimum, maximum, safety-stock, and operating-limit exceptions; short-term availability and imbalance risks; escalation and coordination of corrective actions; and maintenance of the operational inventory-position view that planning and execution consume — a recurring operational control rhythm that complements planning cycles. Excludes inventory-policy design (CM-1-1-3-7-1/-2/-3), formal measurement methodology (CM-1-1-3-7-4), reconciliation and adjustment governance (CM-1-1-3-7-5), and replenishment planning (CM-1-1-3-7-9); excludes the specialized consignment, commingled, re-brand, lot/batch, and third-party-storage arrangements (CM-1-1-3-7-6/-7/-8/-10/-11), except where those arrangements create an operational position exception requiring response; excludes day-to-day crude and feedstock position management, owned by Manage Feedstock Inventory (CM-1-2-5-4-2). When Monitor and Control Inventory Positions (CM-1-1-3-7-12) identifies an actual or projected inventory shortfall against the applicable replenishment threshold, or another inventory exception assessed as requiring corrective resupply, it raises a replenishment referral to Manage Inventory Replenishment (CM-1-1-3-7-9). Upper-limit breaches and other exceptions that do not require resupply do not trigger this handoff. Monitor and Control Inventory Positions (CM-1-1-3-7-12) monitors positions against the target and minimum operating levels, safety stocks and review triggers set by Develop Finished Product Inventory Policy (CM-1-1-3-7-3).\nIn scope: Review physical and book positions, movements, and commitments by location | detect operating-limit, availability, and balance exceptions | escalate and coordinate corrective actions | maintain the operational position view for planning and execution\nOut of scope: Inventory policy design (CM-1-1-3-7-1/-2/-3) | measurement methodology (CM-1-1-3-7-4) | reconciliation governance (CM-1-1-3-7-5) | replenishment planning and decisions (CM-1-1-3-7-9) | specialized arrangement controls (CM-1-1-3-7-6/-7/-8/-10/-11) | feedstock position management (CM-1-2-5-4-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-5"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-8"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "demand offtake"
   },
   {
    "@language": "en",
    "@value": "movement schedules"
   },
   {
    "@language": "en",
    "@value": "official measured positions"
   },
   {
    "@language": "en",
    "@value": "policy operating limits"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "current position picture and excursion responses"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep day-to-day finished-product and intermediates positions inside operating limits and make the current position visible."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10346"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm31-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Intermediates & Blendstock Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish and maintain the policy governing intermediate and blendstock inventories held between process units and blending — target working levels, segregation and quality-protection rules, and review triggers — so conversion and blending operations are decoupled without trapping excess working capital."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). 'Intermediates' read as unfinished refinery streams and blend components held between processing and blending. Middle node of the three material-class policy siblings. Operational accountability for intermediates (Refining versus planning domains) is a follow-up noted in the batch 04 PR; it does not affect this node's placement or definition."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Intermediates Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers policy for unfinished streams held between refinery processing stages and blending, including working-level ranges that buffer unit outages and campaign changes, segregation rules that protect intermediate quality, and policy review cadence tied to unit campaigns and turnarounds. Excludes intermediate tank and transfer operation, owned by Refining; excludes the production decisions that generate intermediates, owned by Refinery Planning and Optimization (CM-1-1-4) and Refining; excludes finished-product policy, owned by Develop Finished Product Inventory Policy (CM-1-1-3-7-3).\nIn scope: Set working-level ranges for intermediates and blendstocks | define segregation and quality-protection rules | define review triggers tied to campaigns and turnarounds | approve policy exceptions\nOut of scope: Intermediate tank and transfer operation (Refining) | production planning of intermediates (Refinery Planning and Optimization, CM-1-1-4) | finished-product policy (CM-1-1-3-7-3) | crude and feedstock policy (CM-1-1-3-7-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "blending requirements"
   },
   {
    "@language": "en",
    "@value": "intermediate tankage constraints"
   },
   {
    "@language": "en",
    "@value": "quality-segregation requirements"
   },
   {
    "@language": "en",
    "@value": "unit campaign and turnaround plans"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "approved intermediates inventory policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Set the binding policy for intermediate and blendstock holdings between processing and blending."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16801"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Finished Goods Inventory Policy"
   },
   {
    "@language": "en",
    "@value": "Product Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish and maintain the policy governing finished-product inventories across refineries and the distribution network — target and minimum operating levels, safety stock by product and location, brand and quality segregation rules, and review triggers — so customer supply reliability is protected at an efficient working-capital cost."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Boundary to CM-1-1-2-13 was fixed in batch 01 (the decision owner, 2026-09-18): policy here, plan-period target decision there. 'Finished product' preferred in text; the batch-01 sibling retains 'finished goods' in its label, with both carried as alt labels there."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Finished Product Inventory Policy"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers policy for saleable products at refinery rack, terminal, and depot level, including service-level-driven safety stocks, seasonal and regulatory grade-transition stock rules, and segregation of branded versus unbranded stock. Sets the policy that Plan Finished Goods Inventory (CM-1-1-2-13) plans within — the plan-period target decision itself is owned there per its approved boundary. Excludes replenishment management, owned by Manage Inventory Replenishment (CM-1-1-3-7-9); excludes physical terminal operation, owned by Midstream. Develop Finished Product Inventory Policy (CM-1-1-3-7-3) maintains finished-product operating levels, safety-stock, segregation, and review-trigger policy within which Manage Inventory Replenishment (CM-1-1-3-7-9) operates; the recipient retains its other decisions and authorities.\nIn scope: Set target, minimum operating, and safety stock levels by product and location | define brand and grade segregation policy | set seasonal and grade-transition stock rules | define review triggers and cadence\nOut of scope: Plan-period inventory targets (Plan Finished Goods Inventory, CM-1-1-2-13) | replenishment management (CM-1-1-3-7-9) | physical storage operation (Midstream) | sales and offer decisions (Marketing)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1"
   }
  ],
