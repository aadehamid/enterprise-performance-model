   {
    "@language": "en",
    "@value": "Concept kind"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "What kind of thing a process-taxonomy concept is (Q8)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/EvidenceBases",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How firm the evidence for a relationship is."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Evidence bases"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/GovernanceStatus",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "Governance status"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How far a concept has moved through governance (Q9 revision)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/HoldStatus",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
