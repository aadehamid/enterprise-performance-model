    "@value": "The communications measurement framework (evidence-layer, KPI Store-routed)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every channel's voice measured on the same evidence terms."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Define KPI Framework (Marketing Communications)"
   },
