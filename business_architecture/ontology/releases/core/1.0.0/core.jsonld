   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "step4-decisions.md, Q8 (approved 2026-09-22)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "concept kind"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "What kind of thing the concept is, taken from the concept kind list. Consumers asking for all processes leave out structural anchors."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/constrainedBy",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "step4-decisions.md, constrained-by definition (2026-09-26)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "constrained by"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The subject activity, decision or outcome is bounded by the object, its binding constraint source. Advice, broad association, ownership, sequencing and optional considerations are excluded."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "verb-predicate-mapping-v2.md, Answer 1 (approved 2026-09-26)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "depends on output of"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The subject process consumes an output of the object process. A process is not an input; its output is. Stored from consumer to producer."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/earlierProcess",
  "@type": [
   "http://www.w3.org/2002/07/owl#FunctionalProperty",
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "earlier process"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process whose stated part happens first in the scoped sequence."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/enabledBy",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "verb-predicate-mapping-v2.md, Answer 3 and Enablement definition (approved 2026-09-26)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "enabled by"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The object process supplies a maintained, governed or operationally necessary capability or input base that makes the subject process able to perform its stated function. Advice, information passed along, ordinary sequence and the parent-child hierarchy are not enablement."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The source author adopted the relationship as a reference-model position informed by downstream business context and industry practice. No verified MPC procedure supports it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/EvidenceBases"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Reference-model assumption"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The source author confirmed the relationship for the process model without marking it as an assumption."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/EvidenceBases"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Source-confirmed"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/evidenceBasis",
  "@type": [
   "http://www.w3.org/2002/07/owl#FunctionalProperty",
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "evidence basis"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How firm the evidence for a relationship is, taken from the evidence-basis list."
   }
  ]
 },
