   {
    "@language": "en",
    "@value": "Proposed exchange utilization plans communicated to the owning processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Exchange entitlements pulled at the right place and time — never wasted, never overdrawn."
   }
  ],
