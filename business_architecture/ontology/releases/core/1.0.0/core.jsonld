   {
    "@language": "en",
    "@value": "demand forecast and service-level requirements"
   },
   {
    "@language": "en",
    "@value": "seasonal and regulatory grade calendars"
   },
   {
    "@language": "en",
    "@value": "terminal tankage constraints"
   },
   {
    "@language": "en",
    "@value": "working-capital guidance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "approved finished-product inventory policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Set the binding policy for finished-product holdings across the network."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16436"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-api-mpms-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Physical Inventory Measurement"
   },
   {
    "@language": "en",
    "@value": "Stock Measurement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish the measured physical quantity of crude, intermediate, and product inventory across the network — from tank gauging, metering, and vessel and pipeline measurements converted to standard conditions — so book stock, reconciliation, and planning rest on accurate physical positions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Measurement practice follows API MPMS (Chapter 3 tank gauging and related chapters) as the reference standard set. Ownership-versus-execution split follows the locked EHS pattern: asset owners execute readings on assets they operate; this process owns the measurement basis and the official measured position. APQC 16436 'Measure and benchmark' is a WEAK organizational-performance candidate; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Measure Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring determination of physical inventory quantities: setting the measurement basis and standards applied (per API MPMS practice), collecting gauge, meter, temperature, and density data, converting observed to standard volumes, and establishing the official measured position by tank, terminal, and location. Asset operators — Midstream and Refining — operate the tanks and instruments and take the physical readings; this process owns the standards applied and the official measured position, consistent with the owner-versus-executor pattern in the locked rules. Excludes reconciling measured against book stock, owned by Perform Inventory Reconciliation (CM-1-1-3-7-5); excludes custody-transfer measurement disputes, which follow the relevant commercial agreements.\nIn scope: Define the measurement basis and applicable standards | collect gauging, metering, temperature, and density data | convert observed to standard volumes | establish the official measured position by location\nOut of scope: Book-versus-physical reconciliation (CM-1-1-3-7-5) | operating tanks, meters, and instruments (Midstream, Refining) | inventory valuation (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "measurement standards and procedures"
   },
   {
    "@language": "en",
    "@value": "tank gauge and meter readings"
   },
   {
    "@language": "en",
    "@value": "temperature and density observations"
   },
   {
    "@language": "en",
    "@value": "vessel and pipeline measurement tickets"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "official measured inventory position by tank, terminal, and location"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Produce the accurate, standards-based physical inventory position the network runs on."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10507"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-api-mpms-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Book-to-Physical Reconciliation"
   },
   {
    "@language": "en",
    "@value": "Stock Reconciliation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile book inventory against measured physical inventory by location and material, quantify and classify gains and losses, investigate variances beyond tolerance, and post agreed corrections so stock records remain accurate and losses are made visible."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). APQC 10507 'Perform benefit reconciliation' was REJECTED at the Step 3b human gate as a false lexical match (HR benefits); authored independently, honoring that rejection. Apparent-versus-physical loss classification follows EI HM 32. Loss-control ownership beyond reconciliation reporting is deliberately left open per playbook step 7 — naming an owner here would silently resolve a cross-model question."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Inventory Reconciliation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring book-to-physical comparison across tanks, terminals, and in-transit stock: computing over/short by material and location, separating apparent loss (measurement and accounting effects) from physical loss, investigating out-of-tolerance variances, and agreeing corrections to book stock, following hydrocarbon-management good practice (EI HM 32). Excludes taking the physical measurements, owned by Measure Inventory (CM-1-1-3-7-4); excludes financial write-off approval and valuation entries, owned by Finance under the locked Finance rule. A standing loss-control capability that would own systemic loss-reduction programs has no home in the current tree — an open cross-model question carried in the playbook (step 7), deliberately not resolved here. Perform Inventory Reconciliation (CM-1-1-3-7-5) supplies reconciled stock balances, inventory corrections, and variance explanations that Distribution Backcasting (CM-1-1-6) consumes in its defined work.\nIn scope: Compare book with measured stock by material and location | quantify and classify gains and losses (apparent versus physical) | investigate out-of-tolerance variances | agree and post book corrections\nOut of scope: Physical measurement (CM-1-1-3-7-4) | financial write-offs and valuation entries (Finance) | systemic loss-control programs (no established owner; playbook step 7 open question) | custody-transfer dispute settlement (commercial agreements)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/rejected"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-10"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-11"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-7"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "book stock and movement transactions"
   },
   {
    "@language": "en",
    "@value": "measurement tolerances"
   },
   {
    "@language": "en",
    "@value": "official measured positions"
   },
   {
    "@language": "en",
    "@value": "prior variance history"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "reconciled stock records with classified, investigated gain/loss"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep book stock true to physical stock and make gains and losses visible and explained."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12942"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Consignment Stock Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage product held under consignment arrangements — stock positioned at a customer's or partner's site, or held for a third party at company sites, that remains the consignor's property until drawn — tracking positions, draws, and settlement triggers so ownership and stock records stay correct on both sides."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Consignment is defined by ownership: stock remains the consignor's property until a defined drawdown, sale, or title-transfer event — the ownership boundary, not the storage location, distinguishes this node from Manage Third Party Storage (CM-1-1-3-7-11), which covers company-owned stock in third-party facilities. The two are orthogonal arrangements that can apply simultaneously (consignment stock at a third-party terminal); they remain peer processes because the control activities differ, and a future data model should not force them into exclusive subclasses."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Consignment Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers administering consignment stock over its lifecycle: recording consignment positions by agreement, tracking draws and returns, triggering settlement per the agreement, and keeping consignment stock distinct from owned stock in positions and reconciliation. Excludes negotiating the consignment agreement, owned by the commercial owner of the customer or supplier relationship; excludes invoicing and settlement postings, owned by Finance; excludes physical storage operation, owned by the site operator (Midstream or third party). Manage Consignment Inventory (CM-1-1-3-7-6) supplies consignment positions, draws, returns, and ownership classifications that Perform Inventory Reconciliation (CM-1-1-3-7-5) consumes in its defined work.\nIn scope: Record and track consignment positions by agreement | track draws, returns, and settlement triggers | keep consignment stock segregated from owned stock in records | support consignment reconciliation\nOut of scope: Consignment agreement negotiation (commercial relationship owner) | billing and settlement postings (Finance) | physical site storage operation (site operator)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "consignment agreements"
   },
   {
    "@language": "en",
    "@value": "draw and return transactions"
   },
   {
    "@language": "en",
    "@value": "site stock reports"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "accurate consignment stock positions and settlement triggers"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep consignment stock, its ownership, and its settlement triggers correctly tracked."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12942"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Commingled Stock Management"
   },
   {
    "@language": "en",
    "@value": "Fungible Inventory Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage company stock held commingled with other owners' fungible product in shared tanks, pipelines, and terminals — tracking each party's ownership share, quality basis, and allocated gains and losses under the operative agreements — so the company's entitlement in shared stock is always known and defensible."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). 'Commingled' read in the downstream fungible-product sense: multiple owners' product physically mixed in shared tankage or pipeline systems, with each party's position represented as a measured or contractual entitlement rather than physically segregated stock. Commingled and lot/batch are arrangements, not permanent asset classifications — one facility can support both for different tanks, products, or periods. APQC 12942 'Manage bulk inventory' STRONG with no validator; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Commingled Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers stewardship of ownership entitlements in fungible, jointly stored product: recording ownership shares by facility and product, applying the allocation rules of terminalling, exchange, and pipeline agreements to receipts, deliveries, and losses, and reconciling entitlement statements from facility operators. Excludes operating the shared facility, owned by Midstream or the third-party operator; excludes negotiating exchange and terminalling agreements, owned by Supply And Trading; excludes the physical measurement itself, owned by Measure Inventory (CM-1-1-3-7-4). Manage Commingled Inventory (CM-1-1-3-7-7) supplies commingled ownership shares, entitlements, and allocated gains and losses that Perform Inventory Reconciliation (CM-1-1-3-7-5) consumes in its defined work.\nIn scope: Track ownership shares in commingled stock by facility | apply agreement allocation rules to receipts, deliveries, and losses | reconcile operator entitlement statements | keep entitlement records audit-ready\nOut of scope: Shared facility operation (Midstream or third-party operator) | exchange and terminalling agreement negotiation (Supply And Trading) | physical measurement (CM-1-1-3-7-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "operator entitlement statements"
   },
   {
    "@language": "en",
    "@value": "receipt and delivery transactions"
   },
   {
    "@language": "en",
    "@value": "terminalling, exchange, and pipeline agreements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "verified ownership entitlements in commingled stock"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep the company's ownership entitlement in shared, fungible stock known and defensible."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12410"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Inventory Reclassification"
   },
   {
    "@language": "en",
    "@value": "Product Re-designation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the re-designation of existing inventory between brand, grade, or specification categories — such as converting unbranded stock to branded through additive treatment, or regrading product that qualifies against a different specification — so stock records, quality status, and documentation reflect what the product now is."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). 'Re-brand' read in the fuels-inventory sense — controlled re-designation of existing stock between branded/unbranded, grade, commercial identity, or market designation categories — not consumer brand management. The node governs the redesignation decision and records; approved physical blending or additive work is execution by the operating asset. APQC 12410 'Develop and manage brands' scored STRONG lexically but is marketing brand management; treated as a false match, comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Inventory Re-brands"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the decision and record-keeping process of re-designating stock: verifying the product qualifies for the target designation, authorizing the re-brand, updating inventory and quality records, and tracking re-brand volumes and reasons, subject to specification, contractual, tax, and inventory-accounting rules. The physical work — additive injection, blending, laboratory testing — is executed by the operating asset (Midstream terminals or Refining). Excludes brand strategy and consumer brand management, owned by Marketing; excludes off-spec and contaminated-product incident handling, which is an event-driven quality matter, not routine re-branding.\nIn scope: Verify stock qualifies for the target designation | authorize and record re-brands | update inventory, quality, and documentation records | track re-brand volumes and reasons\nOut of scope: Physical additive injection, blending, and testing (Midstream, Refining) | brand strategy and brand management (Marketing) | off-spec and contaminated-product incident handling (event-driven quality process, not routine re-branding)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "brand and grade specifications"
   },
   {
    "@language": "en",
    "@value": "re-brand authorizations"
   },
   {
    "@language": "en",
    "@value": "stock quality certificates and test results"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "authorized, recorded inventory re-designations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Ensure re-designated stock is qualified, authorized, and correctly reflected in records."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-9",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12942"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Replenishment Management"
   },
   {
    "@language": "en",
    "@value": "Stock Replenishment Planning"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Plan and trigger the replenishment of finished-product stock points across the distribution network — determining when and how much to resupply each terminal and depot within inventory policy and the approved plan — so locations stay between minimum and maximum operating levels without emergency movements."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 04 (2026-09-19). Batch 01 already carved 'replenishment execution' out of Plan Finished Goods Inventory to this node; authored to receive that boundary. Scope is finished-product network replenishment; crude and feedstock resupply sits with Supply And Trading per the Q3 decision. Decision right confirmed in batch 04: this node owns the replenishment decision (when and how much); Monitor and Control Inventory Positions (CM-1-1-3-7-12) detects and escalates exceptions but does not own the decision; movement scheduling and physical execution remain excluded."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.7.9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Inventory Replenishment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the recurring replenishment decision for network stock points: monitoring projected positions against policy levels, determining replenishment quantities and timing, issuing requirements to the scheduling processes, and managing replenishment exceptions and shortfall risk. Works within the approved regional and distribution plans and the policies set by the policy siblings. Excludes plan-period inventory positioning, owned by Plan Finished Goods Inventory (CM-1-1-2-13); excludes scheduling the physical movements, owned by Physical Distribution Scheduling (CM-1-1-3-6) and Secondary Distribution Management (CM-1-1-3-8); excludes transport and terminal execution, owned by Midstream; excludes feedstock resupply, which sits with Supply And Trading per the batch 04 boundary. For each replenishment requirement or approved revision, Manage Inventory Replenishment (CM-1-1-3-7-9) establishes and releases the required product, quantity, destination, and timing before Physical Distribution Scheduling (CM-1-1-3-6) schedules the corresponding movement. Scheduling constraints may feed back into a revised replenishment requirement. Manage Inventory Replenishment (CM-1-1-3-7-9) plans replenishment within the operating levels and safety stocks set by Develop Finished Product Inventory Policy (CM-1-1-3-7-3).\nIn scope: Monitor projected stock against policy levels by location | determine replenishment quantities and timing | issue replenishment requirements to scheduling | manage replenishment exceptions and shortfall risk\nOut of scope: Plan-period inventory targets (CM-1-1-2-13) | movement scheduling (CM-1-1-3-6, CM-1-1-3-8) | transport and terminal execution (Midstream) | feedstock replenishment (Supply And Trading, per the batch 04 boundary)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved distribution plan"
   },
   {
    "@language": "en",
    "@value": "demand offtake at stock points"
   },
   {
    "@language": "en",
    "@value": "inventory policy levels"
   },
   {
    "@language": "en",
    "@value": "projected stock positions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "replenishment requirements by location and timing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Decide when and how much each network stock point is resupplied within policy and plan."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-12"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17042"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ei-hm32-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Secondary Distribution"
   },
   {
    "@language": "en",
    "@value": "Terminal-to-Site Delivery Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the delivery of products from terminals and depots to retail sites, commercial customers, and other end-delivery points — generating delivery orders for managed sites, scheduling vehicles and routes, and monitoring delivery performance — so site and customer demand is met reliably at efficient delivery cost."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). 'Secondary distribution' per downstream practice: terminal and depot to station and customer deliveries, short-notice demand at many points — Mota et al. 2017 (the Galp case) is the direct evidence. Executor wording per the decision owner's batch 05 edit: physical haulage execution is performed by the designated distribution operator, carrier, or logistics provider — the taxonomy stays operating-model neutral and does not hard-code Midstream as the secondary-delivery executor. The locked Distribution Backcasting rule is honored: CM-1-1-6 explains variance against the approved plan; this L4's monitoring child watches execution against the issued schedule. Accountable ownership of delivery-performance improvement when fleet execution is outsourced is a follow-up noted in the batch 05 PR."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Secondary Distribution Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the secondary distribution leg: order generation for managed sites, daily vehicle and route scheduling within fleet, site, and product constraints, maintenance of the scheduling basis, and delivery-performance monitoring. Excludes primary bulk movements, owned by Physical Distribution Scheduling (CM-1-1-3-6); excludes customer-initiated order capture and fulfillment, owned by Order Management (CM-1-3-7); excludes physical haulage execution, performed by the designated distribution operator, carrier, or logistics provider — outside the scope of this scheduling process; excludes plan-variance analysis, owned by Distribution Backcasting (CM-1-1-6) under its locked rule. Secondary Distribution Management (CM-1-1-3-8) supplies secondary-distribution delivery, schedule, and operational-performance actuals that Distribution Backcasting (CM-1-1-6) consumes in its defined work.\nIn scope: Generate delivery orders for managed sites | schedule vehicles, routes, and delivery windows | maintain the scheduling basis | monitor delivery performance\nOut of scope: Primary distribution movements (CM-1-1-3-6) | customer-initiated order capture (Order Management, CM-1-3-7) | physical haulage execution (designated distribution operator, carrier, or logistics provider) | plan-variance backcasting (Distribution Backcasting, CM-1-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-7-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-7-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-7-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "fleet and route constraints"
   },
   {
    "@language": "en",
    "@value": "site demand and stock signals"
   },
   {
    "@language": "en",
    "@value": "terminal availability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "scheduled, monitored secondary deliveries"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Run the terminal-to-site delivery operation to demand, within cost and constraints."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10136"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Automatic Order Generation"
   },
   {
    "@language": "en",
    "@value": "Managed Replenishment Orders"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create the delivery orders that feed secondary distribution scheduling — deriving replenishment needs for managed retail sites and customer tanks from stock readings, consumption forecasts, and agreed service levels, and converting them into deliverable orders with quantities and windows."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Three order/replenishment boundaries hold together: customer-initiated orders (CM-1-3-7), network stock-point replenishment (CM-1-1-3-7-9, batch 04), and managed-site delivery orders (here). APQC 10136 'Generate sales forecast' is an unrelated candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.8.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Generate Orders"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers forecast-driven order generation for managed sites: monitoring site tank levels and consumption, computing run-out risk, and generating and sizing orders within site and vehicle constraints. Excludes customer-initiated orders, owned by Order Management (CM-1-3-7); excludes network terminal replenishment, owned by Manage Inventory Replenishment (CM-1-1-3-7-9); excludes scheduling the deliveries, owned by Schedule Secondary Distribution (CM-1-1-3-8-2).\nIn scope: Monitor site tank levels and consumption | compute run-out risk and replenishment need | generate and size delivery orders within constraints | set required delivery windows\nOut of scope: Customer-initiated order capture (Order Management, CM-1-3-7) | terminal and depot replenishment (CM-1-1-3-7-9) | delivery scheduling (CM-1-1-3-8-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "service-level agreements"
   },
   {
    "@language": "en",
    "@value": "site tank levels and consumption forecasts"
   },
   {
    "@language": "en",
    "@value": "vehicle and site constraints"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "delivery orders with quantities and windows"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Turn site stock and consumption signals into deliverable orders before run-outs."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10303"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Route and Load Scheduling"
   },
   {
    "@language": "en",
    "@value": "Secondary Delivery Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Build and maintain the daily secondary delivery schedule — assigning orders to vehicles, compartments, routes, and time windows within fleet, driver, site-access, and product-segregation constraints — to meet required delivery windows at efficient fleet utilization and cost."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Mota et al. 2017 documents exactly this process at Galp (tank-to-station scheduling under normal and disrupted operations). Executor wording per the decision owner's batch 05 edit: operating-model neutral. APQC 10303 'Schedule production' is a lexical near-match to a different domain; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.8.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Schedule Secondary Distribution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the daily routing and loading schedule: assigning orders to vehicles and compartments, sequencing routes, respecting driver, access, and product-compatibility constraints, and rescheduling on disruption. Excludes creating the orders, owned by Generate Orders (CM-1-1-3-8-1); excludes physical haulage execution, performed by the designated distribution operator, carrier, or logistics provider — outside the scope of this scheduling process; excludes primary movements (CM-1-1-3-6).\nIn scope: Assign orders to vehicles and compartments | sequence routes and delivery windows | respect fleet, driver, access, and segregation constraints | reschedule on disruption\nOut of scope: Order generation (CM-1-1-3-8-1) | physical haulage execution (designated distribution operator, carrier, or logistics provider) | primary distribution scheduling (CM-1-1-3-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "delivery orders"
   },
   {
    "@language": "en",
    "@value": "fleet, driver, and compartment constraints"
   },
   {
    "@language": "en",
    "@value": "site access windows"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "daily delivery schedule with vehicle and route assignments"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Get every order onto the right vehicle, route, and window at least cost."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Q2 decision (the decision owner, Option A): a recurring process — maintenance of the secondary-distribution scheduling basis — not system implementation, consistent with the master-data precedent (CM-1-1-2-12, CM-1-1-1-1-1, CM-1-1-7-2-1). 'Tanks' added at the decision owner's direction as essential to managed-site ordering and run-out prevention; definition opens with 'Maintain' to avoid the one-time-implementation reading. Preferred normalized label 'Maintain Secondary Distribution Scheduling Basis' queued for the naming pass; current label retained for traceability. The parked master-data consolidation question (CM-1-1-2-12, 2026-09-18) applies to this node as well. APQC 10198 is an unrelated sales-order candidate. Step 3d naming pass — scope-ambiguity Batch 1 (A+B+C, 2026-09-21): renamed from 'Setup Scheduling System' to 'Maintain Secondary Distribution Scheduling Basis'. Prior label(s) retained as altLabel(s): 'Setup Scheduling System'."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10198"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Setup Scheduling System"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain the reference data, constraints, and operating parameters used for secondary-distribution scheduling — including sites, tanks, vehicles, compartments, drivers, routes, access windows, product-compatibility rules, and scheduling parameters — so generated orders and delivery schedules reflect the current operating network."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.8.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Secondary Distribution Scheduling Basis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers stewardship and controlled maintenance of the secondary-distribution scheduling basis: onboarding, changing, validating, and retiring sites, tanks, vehicles, compartments, drivers, routes, constraints, and scheduling parameters; validating the impact of material changes; and confirming that generated schedules remain operationally feasible. Excludes selection, implementation, configuration, enhancement, integration, technical support, infrastructure operation, and cybersecurity of the scheduling application or platform, which belong to Process Excellence & IT. Excludes enterprise master-data policy, canonical-data-model design, and platform integration architecture, governed through the applicable enterprise data-governance and Process Excellence & IT capabilities. Excludes commercial customer and site onboarding, and the scheduling decisions made in Schedule Secondary Distribution (CM-1-1-3-8-2). Maintain Secondary Distribution Scheduling Basis (CM-1-1-3-8-3) maintains the site, tank, vehicle, product-compatibility, and operating-constraint basis that Generate Orders (CM-1-1-3-8-1) needs to operate its defined process path.\nIn scope: Onboard, change, validate, and retire sites, tanks, vehicles, compartments, and drivers in the scheduling basis | maintain constraints, compatibility rules, and scheduling parameters | validate the impact of material changes | confirm schedules remain operationally feasible after changes\nOut of scope: Scheduling application implementation, support, and platform operation (Process Excellence & IT) | enterprise master-data policy and canonical-data-model design (enterprise data governance) | delivery scheduling decisions (CM-1-1-3-8-2) | commercial customer and site onboarding (Marketing)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "constraint and parameter definitions"
   },
   {
    "@language": "en",
    "@value": "schedule feedback after changes"
   },
   {
    "@language": "en",
    "@value": "site, tank, and vehicle onboarding and change requests"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "validated scheduling basis and parameters"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep the scheduling basis true to the real fleet, sites, tanks, and constraints."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16574"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Delivery Performance Monitoring"
   },
   {
    "@language": "en",
    "@value": "Secondary Distribution Performance Monitoring"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Measure and report secondary distribution execution against the issued delivery schedule — delivery reliability, fleet utilization, and cost efficiency at agreed levels — investigating recurring shortfalls and feeding improvements back into order generation, scheduling, and the scheduling basis."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Bounded against the locked Distribution Backcasting rule: CM-1-1-6 explains variance against the approved distribution plan; this node monitors execution against the issued delivery schedule. Horizon set to 'continuous' per the decision owner's batch 05 edit — continuous operational monitoring with periodic reporting and review; the controlled vocabulary takes a single value, so the reporting cadence is recorded here. Specific metrics deliberately not named (KPI workstream). APQC 16574 is a marketing-channel candidate; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.8.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Monitor Secondary Distribution Performance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers operational execution monitoring: schedule adherence and delivery completion, run-out and retained-delivery incidents, utilization and cost signals, recurring-issue analysis, and improvement recommendations. Actuals are compared with the schedule as issued, keeping the contemporaneous-baseline discipline. Excludes plan-versus-actual distribution variance analysis, owned by Distribution Backcasting (CM-1-1-6) under its locked rule; excludes defining enterprise KPIs, which belongs to the KPI workstream; excludes haulier contract management. Monitor Secondary Distribution Performance (CM-1-1-3-8-4) supplies secondary delivery-completion, reliability, utilization, and cost-performance records that Distribution Backcasting (CM-1-1-6) consumes in its defined work.\nIn scope: Track schedule adherence and delivery completion | monitor run-out and retained-delivery incidents | analyze utilization and delivery cost signals | recommend improvements to orders, scheduling, and the basis\nOut of scope: Plan-versus-actual backcasting (Distribution Backcasting, CM-1-1-6) | enterprise KPI definition (KPI workstream) | haulier contract management (commercial owner)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "delivery completion records"
   },
   {
    "@language": "en",
    "@value": "fleet utilization and cost data"
   },
   {
    "@language": "en",
    "@value": "issued delivery schedules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "delivery performance report with improvement recommendations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Establish whether secondary delivery execution is reliable and efficient, and why not when it is not."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19243"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L1-refining"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop the commercially optimal refinery production plan — selecting crude and feedstock intake, refinery operating modes, unit-throughput targets, product yield and quality targets, and production horizons — to fulfill commercial commitments and maximize margin within feasible refinery, supply, inventory, product-specification, and contractual constraints."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refinery Planning and Optimization"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Refinery Planning and Optimization owns the commercial and economic production-plan targets supplied to the refinery, including feedstock and crude-slate choices, target throughput and operating modes, target product yields and specifications, planned production availability, and economically preferred production alternatives. It does not own detailed unit-operation scheduling, tank and transfer line-ups, blend execution, process control, operating procedures, maintenance, turnaround execution, or the operational decision to depart from plan for safety, reliability, or immediate process conditions; those belong to Refining and its operating functions. It distinguishes the plan premise (input assumptions, CM-1-1-4-1), the approved plan (the decision this concept owns), and the plan of record (the versioned registered case, CM-1-1-4-7-7)."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
