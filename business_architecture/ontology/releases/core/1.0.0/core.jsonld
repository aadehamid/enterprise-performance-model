    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L1-refining"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Refinery scheduling covering daily execution planning, production scheduling, and energy & utility management."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refinery Production Planning and Scheduling"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Refinery Scheduling"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 2
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19243"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Daily Refinery Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Translate the current production schedule into each day's refinery execution basis — updating the day's scheduling instructions and commitments, confirming the schedule-level resources the day depends on, and closing the daily production accounting balance — so the refinery works each day from a current, feasible, accounted-for scheduling basis."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 06 (2026-09-19). Q1 decision (the decision owner, 2026-09-19): the refinery planning-scheduling-operations hierarchy is approved. CM-1-1-7 owns the refinery production-scheduling layer: translating approved refinery plans into dated, feasible campaign, production, movement, and resource schedules; managing schedule exceptions and cross-functional interfaces; and maintaining schedule-level performance visibility. Refining owns detailed unit-operation scheduling and all operational execution, including process-control decisions, line-ups, transfers, blend execution, utility operation, and immediate safety/reliability departures from the schedule. This L4 is the daily rhythm of that scheduling layer. APQC: no meaningful candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.7.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Daily Execution Planning"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the daily schedule-to-execution cycle: issuing and updating the day's schedule-level instructions and commitments, assigning the schedule-level resources the day's plan assumes, and closing the daily production balance with actualized yields. Under the approved planning-scheduling-operations hierarchy, Refining owns unit-operation scheduling, tank and transfer line-ups, blend and process execution, and safe operational departures from the schedule; this process owns the daily schedule basis and its accounting. Excludes building the dated schedule itself, owned by Production Scheduling (CM-1-1-7-2); excludes the monthly plan (Refinery Planning and Optimization, CM-1-1-4).\nIn scope: Issue and update daily schedule-level instructions and commitments | assign schedule-level resources for the day | close the daily production accounting balance | confirm daily feasibility of the issued basis\nOut of scope: Unit-operation scheduling, line-ups, and execution (Refining) | dated schedule construction (CM-1-1-7-2) | monthly plan targets (CM-1-1-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "current production schedule"
   },
   {
    "@language": "en",
    "@value": "execution feedback and measured actuals"
   },
   {
    "@language": "en",
    "@value": "resource availability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "issued daily scheduling basis with closed production balance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Give the refinery a current, feasible, accounted-for daily scheduling basis."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-1-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20954"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Issue Production-Schedule Instructions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain and issue the approved daily production-schedule instructions — dated campaign commitments, production and movement requirements, product priorities, planning assumptions, and approved schedule changes — so the refinery's operating teams receive a current, traceable scheduling basis."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 06 (2026-09-19). Rewritten at the decision owner's direction before approval: the original draft named feed rates, operating modes, unit targets, and blend targets, which collide with the locked Refining boundary — instructions here are schedule-level commitments and requirements, never unit-level operating parameters. 'Execution instructions' in the label is read as the scheduling instruction set that provides the approved basis for refinery execution. APQC: no meaningful candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.7.1.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Update Refinery Execution Instructions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers consolidation, versioning, communication, and controlled revision of the approved scheduling instruction set. It may communicate schedule-level requirements and constraints to refinery operations, but does not prescribe unit feed rates, operating modes, operating procedures, tank or transfer line-ups, blend execution, process-control settings, or other detailed execution methods — those remain within Refining. Excludes changing the monthly plan, owned by Refinery Planning and Optimization (CM-1-1-4); material schedule deviations flow through Manage Production Schedule Exceptions (CM-1-1-7-2-4).\nIn scope: Consolidate approved schedule decisions into the instruction set | version and communicate instruction updates | control revisions on approved schedule changes | confirm instructions reflect the current approved schedule\nOut of scope: Unit feed rates, operating modes, and process-control settings (Refining) | operating procedures, line-ups, and blend execution (Refining) | monthly plan changes (CM-1-1-4) | schedule exception decisions (CM-1-1-7-2-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
