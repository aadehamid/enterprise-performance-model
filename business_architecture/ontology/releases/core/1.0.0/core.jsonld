 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17042"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile actual distribution inventory availability, movements, deliveries, transportation costs, and customer fulfillment outcomes against the approved distribution plan and its contemporaneous assumptions and constraints; quantify and explain variances; and use validated lessons to improve subsequent distribution planning and optimization cycles."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Distribution Backcasting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Distribution Backcasting preserves and compares the approved distribution baseline, actual inventory availability and deployment, shipments, deliveries, transportation performance and cost, service outcomes, material constraints, decisions, and variance explanations for a completed period. It identifies commercially meaningful drivers — such as demand, supply availability, allocation, inventory, route or mode, freight, carrier capacity, terminal/rack availability, delivery reliability, and customer-service effects — and feeds validated findings into subsequent distribution planning. It does not dispatch equipment, operate terminals or transportation assets, conduct product movements, perform delivery, or replace Finance's freight-payment and financial-close processes."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-5"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-8-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
