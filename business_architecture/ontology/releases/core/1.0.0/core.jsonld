   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16820"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-orp-dpsc-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Network Product Scheduling"
   },
   {
    "@language": "en",
    "@value": "Short-Term Product Supply Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop and maintain the short-term product supply schedule for the primary distribution network — deciding which products move between refineries, terminals, and supply points, in what quantities and sequence over the coming days and weeks — so the approved regional plan is translated into an executable movement program."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Sits between the approved monthly regional plan (CM-1-1-2) and movement administration (CM-1-1-3-6): this L4 decides the short-term schedule; its sibling administers the movements it creates. APQC 16820 'Design for product servicing' is an unrelated lexical match; no meaningful candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Product Scheduling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers short-term network scheduling within the approved regional plan: consolidating demand, stock, and supply projections into a rolling network schedule, sequencing bulk product movements, coordinating the trades needed to balance the schedule, and adjusting to disruptions. Excludes plan-period supply and disposition decisions, owned by Regional Optimization (CM-1-1-2); excludes mode-level nomination, load, and movement administration, owned by Physical Distribution Scheduling (CM-1-1-3-6); excludes secondary deliveries, owned by Secondary Distribution Management (CM-1-1-3-8); excludes trade negotiation and execution, owned by Supply And Trading.\nIn scope: Consolidate short-term demand, stock, and supply projections | develop and maintain the rolling network product schedule | sequence and adjust bulk movements within plan and policy | initiate schedule-balancing trade requests\nOut of scope: Plan-period supply and disposition optimization (Regional Optimization, CM-1-1-2) | nomination, load, and movement administration (CM-1-1-3-6) | secondary delivery scheduling (CM-1-1-3-8) | trade negotiation and execution (Supply And Trading)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/weekly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-12"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved regional plan"
   },
   {
    "@language": "en",
    "@value": "short-term demand and lifting forecasts"
   },
   {
    "@language": "en",
    "@value": "stock positions and projections"
   },
   {
    "@language": "en",
    "@value": "transport and terminal availability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "rolling short-term network product schedule"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Decide the short-term product movement schedule the primary network runs on."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16501"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-lnl-t2s-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-orp-dpsc-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Rolling Network Plan"
   },
   {
    "@language": "en",
    "@value": "Short-Term Supply Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Produce the rolling days-to-weeks network supply plan that bridges the approved regional plan and daily execution — projecting stock, demand, production, and movements by location and product, and setting the movement quantities and timings the schedule will execute."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Bridges the monthly regional plan and daily movement administration; the replenishment decision right stays with CM-1-1-3-7-9 per batch 04 — this plan consumes those requirements. APQC 16501 is an unrelated channel-improvement candidate; comparative evidence only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.5.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Short-Term Network Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers building and refreshing the short-term network plan: netting projected supply, demand, and stock by location and product; identifying surpluses, shortfalls, and timing constraints; setting planned movements and their windows; reconciling to the regional plan and flagging material deviations back to planning. Excludes plan-period optimization, owned by Regional Optimization (CM-1-1-2); excludes issuing nominations and movement administration (CM-1-1-3-6); consumes replenishment requirements from Manage Inventory Replenishment (CM-1-1-3-7-9) rather than re-deciding them, per the batch 04 decision-right rule.\nIn scope: Project supply, demand, and stock by location and product | net surpluses and shortfalls and set planned movements | reconcile the short-term plan to the regional plan | flag material deviations to planning\nOut of scope: Plan-period optimization (Regional Optimization, CM-1-1-2) | nomination and movement administration (CM-1-1-3-6) | stock-point replenishment decisions (Manage Inventory Replenishment, CM-1-1-3-7-9), whose requirements this plan consumes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/weekly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-9"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved regional plan"
   },
   {
    "@language": "en",
    "@value": "production and receipt forecasts"
   },
   {
    "@language": "en",
    "@value": "replenishment requirements"
   },
   {
    "@language": "en",
    "@value": "stock projections"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "rolling short-term network plan with planned movements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Set the executable days-to-weeks network movement plan within the approved regional plan."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16820"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-orp-dpsc-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Schedule-Balancing Trade Coordination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Identify schedule imbalances that cannot be resolved with the company's own supply — surpluses to place or shortfalls to cover — and coordinate with Supply And Trading to request, evaluate, and incorporate the purchases, sales, or exchanges that balance the short-term schedule."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 05 (2026-09-19). Read as the scheduling-side interface to trading, mirroring Coordinate Feedstock Trading (CM-1-2-5-2-1) on the feedstock side and the established decide-versus-advise pattern: this node specifies what the schedule needs and consumes the result; Supply And Trading owns the trade. Whether this coordination is consistently owned by Commercial & Marketing across operating regions is a follow-up noted in the batch 05 PR. No APQC candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.3.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Coordinate Product Trading"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the scheduling-side interface to trading: quantifying the imbalance and its product, quantity, timing, location, and quality requirements; requesting trading action; evaluating proposed trades for schedulability; and incorporating agreed volumes into the schedule. Excludes trade negotiation and execution, owned by Supply And Trading; excludes plan-period supply sourcing, owned by Regional Optimization (CM-1-1-2); excludes exchange agreement management, owned by Supply And Trading. Trading decides the deal; scheduling decides the schedule.\nIn scope: Quantify schedule surpluses and shortfalls needing trade action | request and specify trading requirements | evaluate proposed trades for schedulability | incorporate agreed trade volumes into the schedule\nOut of scope: Trade negotiation and execution (Supply And Trading) | plan-period supply sourcing (Regional Optimization, CM-1-1-2) | exchange agreement management (Supply And Trading)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-6-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "product quality and location requirements"
   },
   {
    "@language": "en",
    "@value": "short-term network plan imbalances"
   },
   {
    "@language": "en",
    "@value": "trading availability and proposals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "trade requests and schedulable trade volumes incorporated into the schedule"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Get schedule imbalances covered through trading without owning the trade."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
