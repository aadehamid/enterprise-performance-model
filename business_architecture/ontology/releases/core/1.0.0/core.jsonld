   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12900"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Capture Inventory Position"
   },
   {
    "@language": "en",
    "@value": "Establish Opening Inventory"
   },
   {
    "@language": "en",
    "@value": "Inventory Basis Capture"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish the inventory position the optimization case starts from and the closing position it must deliver — crude, intermediate, and finished-product volumes by location and grade — including any volume that is unavailable to the plan."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node establishes one input of the optimization case, it does not own the underlying business decision or the source data. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. Three inventory nodes are now distinct and must stay that way: this node states the position as a case boundary condition, Plan Finished Goods Inventory (CM-1-1-2-13, approved) sets the plan-period target, and the Inventory cluster (CM-1-1-3-7) owns policy, measurement, reconciliation, and replenishment. The bare taxonomy label “Capture Inventory” is the weakest of the eight and “Capture Inventory Position” is recorded as the preferred alternate label."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers stating inventory as a planning boundary condition: taking the opening position from the system of record, adjusting for in-transit and committed volume, separating working stock from unavailable volume such as tank bottoms, minimum operating stock, and consignment or commingled volume, and carrying in the required closing target. Excludes measuring and reconciling inventory, owned by Measure Inventory (CM-1-1-3-7-4) and Perform Inventory Reconciliation (CM-1-1-3-7-5). Excludes inventory policy, owned by the Inventory cluster (CM-1-1-3-7). Excludes setting the plan-period finished-goods target, owned by Plan Finished Goods Inventory (CM-1-1-2-13).\nIn scope: Take the opening inventory position from the system of record | adjust for in-transit and already-committed volume | separate working stock from unavailable volume | carry in the required closing inventory target | state inventory assumptions and qualifications for the case\nOut of scope: Measuring, counting, and reconciling inventory, owned by Measure Inventory (CM-1-1-3-7-4) and Perform Inventory Reconciliation (CM-1-1-3-7-5) | setting inventory policy, owned by the Inventory cluster (CM-1-1-3-7) | setting the plan-period finished-goods target and position, owned by Plan Finished Goods Inventory (CM-1-1-2-13) | day-to-day stock and replenishment management, owned by Manage Inventory Replenishment (CM-1-1-3-7-9) | inventory valuation and accounting, owned by Finance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "in-transit and committed volumes"
   },
   {
    "@language": "en",
    "@value": "inventory system of record position"
   },
   {
    "@language": "en",
    "@value": "minimum operating and unavailable stock levels"
   },
   {
    "@language": "en",
    "@value": "plan-period finished-goods inventory target"
   },
   {
    "@language": "en",
    "@value": "tankage and segregation constraints"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "opening and required closing inventory basis for the optimization case"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Establish the opening and required closing inventory position bounding the optimization case."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10943"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-cmu-refplan-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Issue Monthly Operating Plan"
   },
   {
    "@language": "en",
    "@value": "MOP Issue"
   },
   {
    "@language": "en",
    "@value": "Publish Plan of Record"
   },
   {
    "@language": "en",
    "@value": "Register Monthly Operating Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Issue the agreed refinery production plan for the coming month as the plan of record — confirming the selected case, registering it with its assumptions and version, and handing it to Refining as the basis for detailed scheduling."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Resolved 2026-09-18, the decision owner accepted Option 1 of the question raised in batch 02. The taxonomy label says “Capture”, but the monthly operating plan is the output of this cycle, not an input to it — SRC-BJCE-REFPS-001 describes monthly rolling plans as the product of tactical refinery planning, and SRC-SNF-REFPS-001 and SRC-CMU-REFPLAN-001 both place the plan as the planning-to-scheduling handover. Read as issuing and registering the plan, the node is a real process, needs no tree change, and gives the cycle the explicit handover to Refining that the locked Refining boundary implies but no other node carried. “Issue Monthly Operating Plan” is recorded as the preferred alternate label; if the label is ever corrected in the tree, that is a cosmetic Step 3d item, not a re-definition. The registered assumption set is also what the locked backcasting rule requires, since backcasting compares actuals to the approved plan and its contemporaneous assumptions, never a later reforecast."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Monthly Operating Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers closing the optimization cycle: confirming which case was selected, registering the plan with its price, constraint, and inventory assumptions and a version identifier, publishing it to Refining and the affected commercial functions, and recording it as the baseline that later backcasting compares against. Excludes selecting and approving the plan, which is the Refinery Planning and Optimization (CM-1-1-4) decision this step records. Excludes detailed scheduling, line-ups, and blend execution against the plan, owned by Refining. Excludes reforecasting or revising the plan mid-period.\nIn scope: Confirm the selected production case and its approval | register the plan with its assumption set and version identifier | publish the plan of record to Refining and affected commercial functions | record the plan as the backcasting baseline | log in-period changes as versioned restatements\nOut of scope: Selecting and approving the production plan, owned by Refinery Planning and Optimization (CM-1-1-4) | running and comparing the cases, owned by Perform Scenario Analysis (CM-1-1-4-7-8) | detailed scheduling and execution against the plan, owned by Refining | comparing actuals to the plan, owned by Regional Backcasting (CM-1-1-5) and Distribution Backcasting (CM-1-1-6) | mid-period reforecasting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "case assumption set and scenario results"
   },
   {
    "@language": "en",
    "@value": "distribution list for the plan of record"
   },
   {
    "@language": "en",
    "@value": "plan versioning and numbering convention"
   },
   {
    "@language": "en",
    "@value": "selected and approved production case"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "issued and versioned monthly operating plan of record with its assumption set"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Issue and register the approved monthly production plan as the plan of record."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11783"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-cmu-refplan-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Case Comparison"
   },
   {
    "@language": "en",
    "@value": "Perform Case & Sensitivity Analysis"
   },
   {
    "@language": "en",
    "@value": "Run Optimization Scenarios"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Compare alternative production cases by varying crude slate, run rates, product mix, price, or constraint assumptions, and quantify the margin and feasibility consequences of each, so the preferred case and its sensitivities are understood before the plan is approved."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node is the analysis step rather than a case-basis input. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. Scenario analysis here is forward-looking case comparison within a planning period. It is distinct from backcasting, which is retrospective, and from trading risk scenarios, which test market exposure rather than production alternatives. The APQC candidate “Perform competitive analysis” scored STRONG but is about comparing bidder proposals and was rejected as a false lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Scenario Analysis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers case-based analysis inside the optimization cycle: defining the scenarios worth testing, running them against the case basis, reading marginal values and binding constraints, quantifying margin and feasibility differences, and documenting the comparison that supports the recommended case. Excludes selecting and approving the production plan, owned by Refinery Planning and Optimization (CM-1-1-4). Excludes trading and market risk scenarios, owned by Manage And Run Risk Scenarios (CM-1-2-2-3-11). Excludes comparing actual performance to the approved plan, owned by Regional Backcasting (CM-1-1-5) and Distribution Backcasting (CM-1-1-6). For each plan-selection decision that uses scenario analysis, Perform Scenario Analysis (CM-1-1-4-7-8) provides the relevant evaluated alternatives before the corresponding production plan is selected and approved within Refinery Planning and Optimization (CM-1-1-4). This is an internal step-level sequence, not a sequence preceding the start of the parent process.\nIn scope: Define the scenarios and sensitivities worth testing | run alternative cases against the case basis | read marginal values and identify binding constraints | quantify margin, yield, and feasibility differences | document the case comparison supporting the recommendation\nOut of scope: Selecting and approving the production plan, owned by Refinery Planning and Optimization (CM-1-1-4) | trading and market risk scenarios, owned by Manage And Run Risk Scenarios (CM-1-2-2-3-11) | comparing actuals to the approved plan, owned by Regional Backcasting (CM-1-1-5) and Distribution Backcasting (CM-1-1-6) | investment and strategic configuration studies | optimization model and application administration, owned by Process Excellence & IT"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
