   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Whether work on a concept is held, and why in kind (Q9 revision)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/LifecycleStatus",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "Lifecycle status"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Where a concept is in its life (Q9 revision)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/OperatingMode",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "Operating mode"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "How a process is set off (Q6)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/PlanningLevel",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "Planning level"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The planning horizon a process works at (Q6)."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/ScopeUnits",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The kinds of business object a scoped sequence repeats for. A value names a kind of object, never a particular trade or claim (EPM-DEC-001-0005). A new value is added only when no existing value fits."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Scope units"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/ScopedSequence",
  "@type": [
   "http://www.w3.org/2002/07/owl#Class"
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "Scoped sequence"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A scoped sequence states that, for each instance of a named scope unit, a stated part of an earlier process happens before a stated part of a later process. Neither process needs to complete."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "A qualified-relation node. It is separate from core:precedes, which means the whole earlier process completes before the later process begins; neither relation implies the other. Its skos:definition is the source author's approved scope-note sentence, which names the parts of each process."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/adopted",
