  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11222"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Integrate the advertising and media plans across campaigns, brands, and channels into one coherent plan — a single calendar, budget envelope, and priority set implementing the approved media and advertising strategies — so buying and execution work from one integrated plan rather than competing campaign plans."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Concept-type: process — an integration process (childless L4; the b24 integration pattern applied to plans); tactical. Review funding-authority statement verbatim — prioritizes within the envelope, creates no funding, approves no commitments beyond authority, overrides no Legal/Compliance approvals. APQC returned NONE — no meaningful candidate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Integrated Marketing Planning (Advertising)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers integrated advertising planning: consolidating campaign-level advertising and media needs (from CM-1-3-5-3) into one integrated plan; maintaining the integrated advertising calendar and budget envelope under the applicable delegation of authority; prioritizing and resolving conflicts across campaigns, brands, and channels; and issuing the integrated plan to media buying and execution through the procurement and execution controls (b24 media boundary — buying and placement follow Procurement/Marketing Execution controls). The integrated plan may prioritize campaigns within an approved envelope but cannot create new funding, approve media commitments beyond authority, or override Legal/Compliance claim/disclosure approval. Implements the approved media strategy (CM-1-3-3-5-1) and advertising strategy (CM-1-3-3-5-3); claims and creative approvals follow the b24 substantiation controls. Excludes media and advertising strategy (CM-1-3-3-5-1/-3); campaign development (CM-1-3-5-3-4); media buying and placement execution (Procurement, CM-1-3-6-5); claim approval (Legal, Compliance); budget approval and new funding (Finance, management authorities).\nIn scope: Consolidate campaign advertising and media needs into one integrated plan | maintain the integrated calendar and budget envelope under delegated authority | prioritize and resolve cross-campaign conflicts within the approved envelope | issue the plan through procurement and execution controls\nOut of scope: Media/advertising strategy (CM-1-3-3-5-1/-3) | campaign development (CM-1-3-5-3-4) | buying/placement execution (Procurement, CM-1-3-6-5) | claim approval (Legal, Compliance) | budget approval/new funding (Finance, management)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved media and advertising strategies (CM-1-3-3-5-1/-3)"
   },
   {
    "@language": "en",
    "@value": "budget envelope (delegated authority)"
   },
   {
    "@language": "en",
    "@value": "campaign plans and needs (CM-1-3-5-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The integrated advertising plan, calendar, and budget envelope"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One advertising plan, one calendar, one envelope — not a bidding war between campaigns."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10102"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Plan the marketing communications that deliver the approved communications strategy — from needs and target groups through mix models, budgets, and campaign development to the preparation and controlled release of communications deliverables — handing in-channel program execution to Marketing Plan Execution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Concept-type: process — planning-through-deliverable-readiness cluster; tactical. Lifecycle with feedback (review): needs → target groups → mix model → budgets → plan → campaigns → prepare/release deliverables → Marketing Plan Execution → Performance Analysis → next cycle; Manage Use Of Brand continuous overlay. Review narrowing verbatim in scope note — prepare/release/handoff, never placement, delivery, channel execution, customer contact, marketing-automation execution, or release approval. Control gates recorded as the review's conditional list. APQC returned NONE at the L4."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing Communications Planning"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the communications-planning cluster: identifying marketing needs (CM-1-3-5-3-1) and target groups (CM-1-3-5-3-2), developing the marketing mix model (CM-1-3-5-3-3), defining resource allocation and budgets (CM-1-3-5-3-5), defining the communications plan (CM-1-3-5-3-6), developing campaigns (CM-1-3-5-3-4), and coordinating production, approval readiness, controlled release, and handoff of promotional advertising (CM-1-3-5-3-8), internal marketing communications (CM-1-3-5-3-9), and brand advertising/communications deliverables (CM-1-3-5-3-10), with brand-use management (CM-1-3-5-3-7) as a continuous overlay. The split (review): this cluster owns planning, deliverable production/readiness, approval routing, and release coordination; Marketing Plan Execution (CM-1-3-6-5) owns in-channel, in-site, and program activation; media buying and placement commitments follow Procurement and the authorized media-buying process; the accountable approvers authorize releases. Control gates at campaign planning and release (review): claims/substantiation approval where applicable; disclosure/endorsement approval where applicable; brand standards confirmation; privacy/contactability confirmation for direct and digital channels; media/procurement authority confirmation; channel/site readiness confirmation; promotion/supply/inventory alignment; measurement hooks, data sources, and rollback/escalation plan. The b24 control set governs throughout: claims, substantiation, disclosures, and endorsements approved by Legal/Compliance; consent/contactability data consumed, never created; brand use per the CM-1-3-6-7 standards; personal data per the batch 21 statement and batch 23 targeting controls. Performance findings (CM-1-3-5-5) feed the next needs/mix/budget/plan cycle. Excludes communications strategy (CM-1-3-3-5); in-channel program execution and activation (CM-1-3-6-5); media buying/placement commitment (Procurement, authorized buying process); claim/disclosure approval (Legal, Compliance); release authorization (accountable approvers); brand standards ownership (CM-1-3-6-7); corporate and HR communications (Legal & Corporate Communications locked rule, HR). Marketing Communications Planning (CM-1-3-5-3) plans communications that deliver the strategy defined by Marketing Communications Strategy (CM-1-3-3-5). Integrated Marketing Planning (Advertising) (CM-1-3-5-2) integrates the marketing communications plans produced by Marketing Communications Planning (CM-1-3-5-3).\nIn scope: Run the communications-planning cluster from needs to campaigns | coordinate deliverable production, approval readiness, and controlled release under the accountable approvers | manage brand use per the owned standards | hand program activation to Marketing Plan Execution\nOut of scope: Communications strategy (CM-1-3-3-5) | program execution/activation (CM-1-3-6-5) | media buying commitment (Procurement, authorized process) | claim/disclosure approval (Legal, Compliance) | release authorization (accountable approvers) | brand standards ownership (CM-1-3-6-7) | corporate/HR communications (locked rule, HR)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-4-6-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Integrated communications strategy (CM-1-3-3-5)"
   },
   {
    "@language": "en",
    "@value": "audience findings (CM-1-3-1)"
   },
   {
    "@language": "en",
    "@value": "offers and propositions (CM-1-3-3-1, CM-1-3-2)"
   },
   {
    "@language": "en",
    "@value": "performance findings (CM-1-3-5-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The communications plan, campaign packages, and release-ready deliverables"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Campaigns that arrive at execution planned, funded, approved, and on-brand."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10418"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Identify the marketing communications needs each planning cycle must serve — which offers, propositions, launches, and channel priorities need communications support, with what urgency and evidence."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Needs step; performance findings feed this step (lifecycle feedback per review). APQC 'Identify strategic HR needs' is a FALSE lexical match (HR)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Identify Marketing Needs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers needs identification: reading the approved strategies, offer pipeline (CM-1-3-3-1), innovation timing (CM-1-3-4-6-4 interface), channel priorities, and performance findings (CM-1-3-5-5) for communications needs; framing and prioritizing needs with evidence for the mix model and plan. Excludes strategy (CM-1-3-3-5); the mix and plan decisions (CM-1-3-5-3-3/-6); campaign development (CM-1-3-5-3-4).\nIn scope: Read strategies, offers, launches, and performance evidence for communications needs | frame and prioritize needs with evidence\nOut of scope: Strategy (CM-1-3-3-5) | mix and plan decisions (CM-1-3-5-3-3/-6) | campaign development (CM-1-3-5-3-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved strategies and offers"
   },
   {
    "@language": "en",
    "@value": "innovation and launch timing"
   },
   {
    "@language": "en",
    "@value": "performance findings (CM-1-3-5-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Prioritized communications needs per cycle"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Communications money pointed at the needs that exist."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-10",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11136"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Prepare and Release Brand Advertising and Communications Deliverables"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate production, approval readiness, controlled release, and handoff of brand advertising and communications deliverables — brand-building campaign materials from approved packages to execution — recording readiness while the accountable approvers authorize release."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Release-preparation child per the review narrowing; release-authority statement verbatim; b24 substantiation and fuel-claim disciplines inherited; preferred label queued. APQC returned NONE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.10"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Implement Brand Advertising / Communications"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers brand-deliverable preparation and release coordination: coordinating production of brand campaign materials from campaign packages (CM-1-3-5-3-4), consistent with the brand strategy (CM-1-3-2-1) and standards (via CM-1-3-5-3-7); confirming approval readiness across the control gates, including environmental and brand claims per the b24 fuel-claim discipline; coordinating placement scheduling through the media-buying and procurement controls; and handing released deliverables to execution (CM-1-3-6-5). Release coordination confirms that required Legal, Compliance, Brand, Privacy, Procurement, channel/site, and delegated commercial approvals are complete. The accountable approver authorizes release; this process records readiness and coordinates the handoff. Excludes in-channel execution (CM-1-3-6-5); release authorization (accountable approvers); claim approval (Legal, Compliance); media buying commitments (Procurement); brand strategy and standards (CM-1-3-2-1, CM-1-3-6-7).\nIn scope: Coordinate production of brand deliverables | confirm approval readiness including claims and brand gates | coordinate placement scheduling through buying controls | record readiness and hand off to execution\nOut of scope: Execution (CM-1-3-6-5) | release authorization (accountable approvers) | claim approval (Legal, Compliance) | buying commitments (Procurement) | brand strategy/standards (CM-1-3-2-1, CM-1-3-6-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Campaign packages (CM-1-3-5-3-4)"
   },
   {
    "@language": "en",
    "@value": "approval status (accountable approvers)"
   },
   {
    "@language": "en",
    "@value": "brand direction and standards (CM-1-3-2-1, via -3-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Release-ready brand deliverables handed to execution with recorded readiness"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The brand's voice produced and released exactly as approved."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20143"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Identify the target groups each communications need addresses — selecting audiences from the governed segmentation and targeting evidence within the privacy, fairness, and contactability controls."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Targeting step; b23 targeting controls and b24 contactability rule inherited. APQC 'Identify impacted groups' is a FALSE lexical match (risk management)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Identify Target Groups"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers communications targeting: selecting audiences per need from the marketing-lens segmentation evidence (CM-1-3-1-3/-4) and the offer target groups (CM-1-3-3-1-1); applying the batch 23 targeting controls (approved purposes, privacy, consent, suppression, fairness, non-discrimination) and the b24 contactability discipline for direct channels (consume, never create consent status); and recording targeting rationale for the plan. Excludes the segmentation analyses (CM-1-3-1); consent/suppression data ownership (accountable systems); offer targeting decisions (CM-1-3-3-1-1); the plan (CM-1-3-5-3-6).\nIn scope: Select audiences per need from governed evidence | apply privacy, fairness, and contactability controls | record targeting rationale\nOut of scope: The analyses (CM-1-3-1) | consent/suppression ownership (accountable systems) | offer targeting (CM-1-3-3-1-1) | the plan (CM-1-3-5-3-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Communications needs (CM-1-3-5-3-1)"
   },
   {
    "@language": "en",
    "@value": "contactability status (accountable systems)"
   },
   {
    "@language": "en",
    "@value": "segmentation evidence (CM-1-3-1-3/-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Target groups per communications need with rationale"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The right audiences, chosen lawfully, documented."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10102"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Develop and Update Marketing Mix Model"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop and update the marketing mix model — how communications effort and spend distribute across channels, campaigns, and audiences for best effect — using performance evidence and the strategy's channel roles."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Mix step; normalized label queued. APQC 'Develop marketing strategy' is a WEAK broad match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop / Update Marketing Mix Model"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers mix modeling: allocating communications effort across the channel roles set by strategy (media, direct, POS, digital, internal — CM-1-3-3-5) per need and target group; using performance evidence (CM-1-3-5-5) and measurement-framework metrics (b24) to update the mix; and stating assumptions and confidence (b21 discipline). The mix model informs budgets and the plan; channel-role strategy stays with CM-1-3-3-5. Excludes channel-role strategy (CM-1-3-3-5); budget approval (delegated authority); analytic model/technology ownership (technology owners); the plan (CM-1-3-5-3-6).\nIn scope: Allocate effort across strategy-set channel roles per need and audience | update the mix from performance evidence | state assumptions and confidence\nOut of scope: Channel-role strategy (CM-1-3-3-5) | budget approval (delegated authority) | model/technology ownership (technology owners) | the plan (CM-1-3-5-3-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Needs and target groups (CM-1-3-5-3-1/-2)"
   },
   {
    "@language": "en",
    "@value": "performance evidence (CM-1-3-5-5)"
   },
   {
    "@language": "en",
    "@value": "strategy channel roles (CM-1-3-3-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The current marketing mix model with assumptions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Spend distributed by evidence, not by last year's split."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10428"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Develop and Update Campaigns"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop and update campaigns — objectives, audiences, messages, channel plans, creative briefs, and measurement hooks per campaign — within the communications plan and the claims and brand controls, assembled as approval-routed campaign packages."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Campaign step; review output correction — approval-routed campaign packages with creative, channel, measurement, compliance, brand, and execution-readiness artifacts; b24 substantiation-before-dissemination inherited; normalized label queued. APQC 'Develop other HR programs' is a FALSE lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop / Update Campaigns"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers campaign development: building each campaign from the plan (objectives, target groups, messages within the approved claims territory, channel plan from the mix model, budget from the allocation, measurement hooks from the communications measurement framework — b24); developing creative briefs and coordinating creative development; and routing claims, disclosures, and brand use through their approvals (Legal/Compliance for substantiation; CM-1-3-6-7 standards via CM-1-3-5-3-7) before release preparation. A campaign is ready for release preparation only when its approval and readiness artifacts are complete — a creative brief alone is not readiness (review). Excludes claim/disclosure approval (Legal, Compliance); brand standards (CM-1-3-6-7); release preparation and handoff (CM-1-3-5-3-8/-9/-10); in-channel execution (CM-1-3-6-5); media buying (Procurement, execution).\nIn scope: Build campaigns from the plan with measurement hooks | develop creative briefs and coordinate creative | route claims and brand use through the accountable approvals | assemble approval-routed campaign packages\nOut of scope: Claim approval (Legal, Compliance) | brand standards (CM-1-3-6-7) | release preparation (CM-1-3-5-3-8/-9/-10) | execution (CM-1-3-6-5) | media buying (Procurement)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/assuredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "The communications plan (CM-1-3-5-3-6)"
   },
   {
    "@language": "en",
    "@value": "claims territory (CM-1-3-3-5-3)"
   },
   {
    "@language": "en",
    "@value": "measurement framework (b24)"
   },
   {
    "@language": "en",
    "@value": "mix and budgets (CM-1-3-5-3-3/-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-10"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-8"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-9"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Approval-routed campaign packages with creative, channel, measurement, compliance, brand, and execution-readiness artifacts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Campaigns built approved, measurable, and on-brief."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20688"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Define Resource Allocation and Budgets"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the communications resource allocation and budgets — distributing the approved envelope across needs, campaigns, and channels per the mix model — as allocations under the applicable delegation of authority."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Allocation step; normalized label queued. APQC 'Optimize IT resource allocation' is a FALSE lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Resource Allocation / Budgets"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers allocation: distributing the approved communications budget envelope across needs, campaigns, and channels per the mix model; maintaining allocations as plans change; and tracking committed versus available within the planning cycle. Allocations operate under the applicable delegation of authority; budget approval and financial control are Finance's and the management authorities'; procurement commitments follow Procurement. Excludes budget approval (Finance, management authorities); financial accounting and control (Finance); procurement commitments (Procurement); spend-effectiveness analysis (CM-1-3-5-5-1).\nIn scope: Distribute the approved envelope per the mix model | maintain allocations as plans change | track committed versus available\nOut of scope: Budget approval (Finance, management) | financial control (Finance) | procurement commitments (Procurement) | spend analysis (CM-1-3-5-5-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved envelope (delegated authority)"
   },
   {
    "@language": "en",
    "@value": "campaign needs"
   },
   {
    "@language": "en",
    "@value": "mix model (CM-1-3-5-3-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Communications allocations under delegated authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every campaign funded on purpose from one envelope."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17477"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the communications plan — the consolidated plan of campaigns, channels, audiences, timings, budgets, and responsibilities for the cycle — the single planning artifact the release preparation and execution work from."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Plan step. APQC 'Define sampling plan' is a FALSE lexical match (quality sampling)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Communications Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers plan definition: consolidating needs, target groups, mix, and allocations into the communications plan with campaign list, channel plans, timings, responsibilities, and measurement expectations; synchronizing with the integrated advertising plan (CM-1-3-5-2), promotions calendars (CM-1-3-5-4), and launch timings (innovation interface); and maintaining the plan through the cycle. Excludes the campaign builds (CM-1-3-5-3-4); release preparation (CM-1-3-5-3-8/-9/-10); execution (CM-1-3-6-5); strategy (CM-1-3-3-5).\nIn scope: Consolidate the cycle's communications plan with timings and responsibilities | synchronize with advertising, promotions, and launch calendars | maintain the plan through the cycle\nOut of scope: Campaign builds (CM-1-3-5-3-4) | release preparation (CM-1-3-5-3-8/-9/-10) | execution (CM-1-3-6-5) | strategy (CM-1-3-3-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Needs, groups, mix, allocations (CM-1-3-5-3-1/-2/-3/-5)"
   },
   {
    "@language": "en",
    "@value": "calendars (CM-1-3-5-2/-4)"
   },
   {
    "@language": "en",
    "@value": "launch timings"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The maintained communications plan"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One plan everyone implements from."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the use of the brand in communications — a planning and material-review control applying the standards owned by Brand Standards Management within planned communications materials, release packages, and placements — escalating deviations to the accountable owners."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Continuous planning/material-review control; review wording — applies and coordinates, obtains decisions from the accountable owners, grants nothing itself. APQC 'Manage routings' is a FALSE match (third occurrence)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Use Of Brand"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers brand-use management in communications: applying and coordinating use of standards owned by Brand Standards Management (CM-1-3-6-7) within planned communications materials, release packages, and placements; maintaining usage guidance for the planning and release-preparation children; and escalating deviations, exceptions, and trademark/legal questions to the accountable standards and Legal owners. This process coordinates review and obtains the required approval or exception decision from the accountable Brand Standards Management and Legal owners; it does not itself grant exceptions. Trademark legal questions go to Legal (b26 IP architecture); licensed brand use follows the licensing arrangements (CM-1-3-4-4-5). Excludes brand standards ownership and exception granting (CM-1-3-6-7); brand strategy (CM-1-3-2-1); trademark legal work (Legal); licensing arrangements (CM-1-3-4-4-5).\nIn scope: Apply the owned standards to materials, release packages, and placements | maintain usage guidance | coordinate review and obtain approval or exception decisions from the accountable owners | escalate deviations and legal questions\nOut of scope: Standards ownership and exception granting (CM-1-3-6-7) | brand strategy (CM-1-3-2-1) | trademark legal work (Legal) | licensing (CM-1-3-4-4-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand standards (CM-1-3-6-7)"
   },
   {
    "@language": "en",
    "@value": "campaign materials and release packages (CM-1-3-5-3-4/-8/-10)"
   },
   {
    "@language": "en",
    "@value": "licensing terms where applicable"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Standards-conformant brand use across communications, with owner-decided exceptions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The brand used right in everything the plan produces."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11495"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Prepare and Release Promotional Advertising Deliverables"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate production, approval readiness, controlled release, and handoff of promotional advertising deliverables — from approved campaign packages to execution — recording readiness while the accountable approvers authorize release."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Release-preparation child per the review narrowing — coordinate production, approval readiness, controlled release, and handoff; never placement, delivery, channel execution, customer contact, or release approval. Release-authority statement verbatim in scope note; preferred label queued prominently. APQC 'Implement promotional pricing programs' is a false-direction match (pricing)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Implement Promotional Advertising"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers promotional-deliverable preparation and release coordination: coordinating production of promotional campaign materials from campaign packages (CM-1-3-5-3-4); confirming approval readiness across the control gates; coordinating placement scheduling through the media-buying and procurement controls (commitments are Procurement's and the authorized buying process's); and handing released deliverables to in-channel and in-site execution (CM-1-3-6-5) synchronized with the promotions calendars (CM-1-3-5-4). Release coordination confirms that required Legal, Compliance, Brand, Privacy, Procurement, channel/site, and delegated commercial approvals are complete. The accountable approver authorizes release; this process records readiness and coordinates the handoff. Promotional pricing content follows the pricing processes (b23/24 boundaries). Excludes in-channel/in-site execution and activation (CM-1-3-6-5); release authorization (accountable approvers); claim approval (Legal, Compliance); media buying commitments (Procurement, authorized process); promotional pricing (pricing processes); promotions planning (CM-1-3-5-4).\nIn scope: Coordinate production of promotional deliverables | confirm approval readiness across the control gates | coordinate placement scheduling through buying controls | record readiness and hand off to execution on calendar\nOut of scope: Execution/activation (CM-1-3-6-5) | release authorization (accountable approvers) | claim approval (Legal, Compliance) | buying commitments (Procurement) | promotional pricing (pricing processes) | promotions planning (CM-1-3-5-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Campaign packages (CM-1-3-5-3-4)"
   },
   {
    "@language": "en",
    "@value": "approval status (accountable approvers)"
   },
   {
    "@language": "en",
    "@value": "promotions calendars (CM-1-3-5-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Release-ready promotional deliverables handed to execution with recorded readiness"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Promotional creative that ships approved, scheduled, and on time."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-9",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11136"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Prepare and Release Internal Marketing Communications"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate production, approval readiness, controlled release, and handoff of internal marketing communications — the campaigns and materials that promote the company's products, objectives, and marketing programs to employees — within the internal-communications boundary shared with Corporate Communications and HR."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Release-preparation child per the review narrowing; release-authority statement and internal-communications prohibition verbatim in scope note — never corporate policy, regulatory instructions, safety notices, employment terms, labor-relations, or crisis communications without the accountable owner owning the message; preferred label queued. APQC 'Implement change' is a WEAK generic match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.3.9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Implement Internal Communications"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers internal marketing communications preparation and release per the approved internal strategy (CM-1-3-3-5-6): coordinating production of internal campaign materials (product launches, program awareness, sales enablement, employee brand engagement); confirming approval readiness and brand use (CM-1-3-5-3-7); coordinating channels with the owners of internal communication platforms; and handing released materials to delivery. Release coordination confirms that required Legal, Compliance, Brand, Privacy, Procurement, channel/site, and delegated commercial approvals are complete. The accountable approver authorizes release; this process records readiness and coordinates the handoff. Internal marketing communications must not be used to issue corporate policy, regulatory instructions, safety notices, employment terms, labor-relations communications, or official crisis communications unless the accountable Corporate Communications, HR, Legal, EHS, or Compliance owner has approved and owns the message. Excludes corporate communications (Legal & Corporate Communications, locked rule); HR/employee-relations communications (HR); platform ownership (their owners); release authorization (accountable approvers); the internal strategy (CM-1-3-3-5-6).\nIn scope: Coordinate production of internal marketing materials per the approved strategy | confirm approval readiness and brand use | coordinate channels with platform owners | record readiness and hand off for delivery\nOut of scope: Corporate communications (locked rule) | HR communications (HR) | platform ownership (owners) | release authorization (accountable approvers) | internal strategy (CM-1-3-3-5-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Internal strategy (CM-1-3-3-5-6)"
   },
   {
    "@language": "en",
    "@value": "campaigns and launches"
   },
   {
    "@language": "en",
    "@value": "internal channels (platform owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Release-ready internal marketing communications with recorded readiness"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Employees hearing about the products before the customers do."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19243"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Plan the promotions program — the promotional plan and the event, point-of-purchase, and site-level marketing calendars — within the pricing, claims, and POS boundaries and the conditional readiness framework, so promotion execution runs from one governed promotional calendar set."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Concept-type: process — plan plus three parallel calendars with iterative readiness synchronization (review); tactical. Conditional readiness framework recorded once at this L4 per review — not repeated in every child definition. APQC 'Conduct resource planning' is a WEAK generic match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Promotions Planning"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers promotions planning: defining the promotional plan (CM-1-3-5-4-1) and maintaining the promotional event calendar (CM-1-3-5-4-2), the point-of-purchase promotional calendar (CM-1-3-5-4-3), and the site-level marketing calendar (CM-1-3-5-4-4), with the calendars synchronizing iteratively against supply, inventory, site, and execution readiness. Conditional readiness framework (review): before a promotion enters a calendar or execution handoff, the plan confirms the applicable readiness — offer and eligibility defined; pricing rule and price-execution path approved; rebate/coupon/loyalty mechanics controlled; claims and disclosures approved; supply and inventory readiness validated; channel, site, and terminal readiness confirmed; POS, digital, and communications deliverables approved; tax, legal, privacy, and regulatory impacts assessed where applicable; measurement and rollback conditions defined. Guardrails: promotional pricing follows the pricing processes — architecture and guardrails at CM-1-3-3-2, execution at CM-1-3-6-3; rebates at CM-1-3-6-4; POP and site calendars inherit the batch 24 POS exclusions (no fuel-price setting, pump-sign configuration, legal metrology, product labeling, or price-display execution); promotional claims follow the b24 substantiation controls; promotion execution is CM-1-3-6-5's. Calendars synchronize with the communications plan (CM-1-3-5-3-6) and feed the forecast-input process (CM-1-3-5-1-2). Excludes promotional pricing (CM-1-3-3-2, CM-1-3-6-3); rebates (CM-1-3-6-4); promotion execution (CM-1-3-6-5); POS regulatory display execution (site operations, b24); claim approval (Legal, Compliance). Promotions Planning (CM-1-3-5-4) supplies approved promotional calendars as agreed sales-side forecast inputs under Develop & Agree Demand Forecasting Process (CM-1-3-5-1-2).\nIn scope: Define the promotional plan | maintain the event, POP, and site-level calendars synchronized against readiness | confirm the conditional readiness framework before calendar entry and execution handoff | operate within pricing, claims, and POS boundaries\nOut of scope: Promotional pricing (CM-1-3-3-2, CM-1-3-6-3) | rebates (CM-1-3-6-4) | execution (CM-1-3-6-5) | POS display execution (site operations, b24) | claim approval (Legal, Compliance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Offers and campaigns (CM-1-3-3-1, CM-1-3-5-3)"
   },
   {
    "@language": "en",
    "@value": "pricing guardrails (CM-1-3-3-2)"
   },
   {
    "@language": "en",
    "@value": "supply, site, and execution readiness inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The promotional plan and governed, readiness-confirmed calendar set"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Promotions that land on calendar, on price policy, and on claim."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17477"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the promotional plan — which promotions run, for which offers, audiences, channels, and periods, with what mechanics, budgets, and success measures — within the pricing and claims guardrails."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Plan step; pricing-guardrail discipline per b23; L4 readiness framework applies. APQC 'Define sampling plan' is a FALSE lexical match (second occurrence)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.4.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Promotional Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers promotional-plan definition: selecting and scheduling promotions against offers (CM-1-3-3-1), audiences, and channel priorities; defining promotion mechanics within the pricing guardrails (promotional price content designed with and governed by the pricing processes — b23 discipline); setting budgets within the allocation (CM-1-3-5-3-5 coordination) and success measures from the measurement frameworks; and routing claims through their approvals. The L4's conditional readiness framework applies before any promotion enters a calendar. Excludes promotional price setting (pricing processes); rebate design (CM-1-3-6-4); claim approval (Legal); the calendars (CM-1-3-5-4-2/-3/-4); execution (CM-1-3-6-5).\nIn scope: Select and schedule promotions with mechanics inside the pricing guardrails | set budgets and success measures | route claims through approvals\nOut of scope: Promotional prices (pricing processes) | rebates (CM-1-3-6-4) | claim approval (Legal) | calendars (CM-1-3-5-4-2/-3/-4) | execution (CM-1-3-6-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Offers (CM-1-3-3-1)"
   },
   {
    "@language": "en",
    "@value": "budgets and measures"
   },
   {
    "@language": "en",
    "@value": "pricing guardrails (CM-1-3-3-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The promotional plan with mechanics, budgets, and measures"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Promotions chosen for effect, priced by the price system."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10147"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create and maintain the promotional event calendar — the scheduled promotional events across channels and periods — synchronized with the communications plan, supply and inventory readiness, and the forecast-input process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Calendar child; promotions feed the forecast as inputs (b03); iterative readiness synchronization per review. APQC returned NONE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.4.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create Promotional Event Calendar"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the event calendar: scheduling promotional events from the plan once the L4 readiness framework is confirmed; synchronizing iteratively with the communications plan (CM-1-3-5-3-6), advertising calendar (CM-1-3-5-2), supply and inventory readiness (through the accountable operating processes), and the forecast-input process (CM-1-3-5-1-2 — promotions are a forecast input, per the batch 03 architecture); and maintaining the calendar as events change. Excludes event execution (CM-1-3-6-5); supply commitments (operating processes); the plan decisions (CM-1-3-5-4-1). Create Promotional Event Calendar (CM-1-3-5-4-2) supplies the promotional-event calendar as an agreed sales-side forecast input under Develop & Agree Demand Forecasting Process (CM-1-3-5-1-2), which defines its form, cadence and quality for Produce Demand Forecast (CM-1-1-1-1).\nIn scope: Schedule readiness-confirmed promotional events | synchronize iteratively with communications, advertising, supply, and forecast inputs | maintain the calendar\nOut of scope: Event execution (CM-1-3-6-5) | supply commitments (operating processes) | plan decisions (CM-1-3-5-4-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Promotional plan (CM-1-3-5-4-1)"
   },
   {
    "@language": "en",
    "@value": "communications and advertising calendars"
   },
   {
    "@language": "en",
    "@value": "supply and inventory readiness inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The maintained promotional event calendar"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every promotion on a calendar supply can see coming."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10295"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Create Point-of-Purchase (POP) Promotional Calendar"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create and maintain the point-of-purchase promotional calendar — the scheduled POP promotional activity at forecourts, stores, and other points of sale — within the POS communication and regulatory-display boundaries."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Calendar child; b24 POS exclusions inherited by reference; '(Pop)' casing in the locked name — normalized label queued. APQC 'Create/Distribute purchase orders' is a FALSE lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.4.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create Point Of Purchase (Pop) Promotional Calendar"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the POP calendar: scheduling POP promotional activity per site cluster and period from the promotional plan, consistent with the POS communication strategy (CM-1-3-3-5-4); coordinating material and display readiness with release preparation (CM-1-3-5-3-8) and execution (CM-1-3-6-5); and maintaining the calendar. The batch 24 POS exclusions apply verbatim by reference: no fuel-price setting, pump-sign configuration, legal metrology, product labeling, or price-display execution — those belong to pricing, site-operations, and EHS/regulatory processes. Excludes POS execution and merchandising (CM-1-3-6-5/-7); price display and regulatory signage (b24 owners); the plan decisions (CM-1-3-5-4-1).\nIn scope: Schedule POP promotional activity by site cluster and period | coordinate material and display readiness | maintain the calendar within the POS boundaries\nOut of scope: POS execution/merchandising (CM-1-3-6-5/-7) | price display and regulatory signage (b24 owners) | plan decisions (CM-1-3-5-4-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "POS strategy (CM-1-3-3-5-4)"
   },
   {
    "@language": "en",
    "@value": "Promotional plan (CM-1-3-5-4-1)"
   },
   {
    "@language": "en",
    "@value": "site readiness inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The maintained POP promotional calendar"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The right promotion at the right pump and shelf, on schedule."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10157"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create and maintain the site-level marketing calendar — the consolidated marketing activity view per site or site cluster — so sites see one coherent calendar instead of competing programs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Calendar child; site operating constraints owned by operations (b20/24). APQC 'Create marketing budget' is a WEAK adjacent match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.4.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create Site Level Marketing Calendar"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the site calendar: consolidating promotional events, POP activity, campaign touchpoints, and program activity into per-site/cluster calendars; deconflicting overlapping activity; coordinating with site operations for feasibility (site operating constraints owned by the operating functions, b20/24 architecture); and maintaining the calendar for execution (CM-1-3-6-5). Excludes site operations and execution (operating functions, CM-1-3-6-5); network design (CM-1-3-3-4); the underlying plans (CM-1-3-5-3/-4).\nIn scope: Consolidate marketing activity into per-site calendars | deconflict overlapping activity | coordinate feasibility with site operations | maintain for execution\nOut of scope: Site operations/execution (operating functions, CM-1-3-6-5) | network design (CM-1-3-3-4) | underlying plans (CM-1-3-5-3/-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Event and POP calendars (CM-1-3-5-4-2/-3)"
   },
   {
    "@language": "en",
    "@value": "campaign plans (CM-1-3-5-3)"
   },
   {
    "@language": "en",
    "@value": "site feasibility inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The maintained site-level marketing calendar"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One calendar per site, not five programs colliding at the till."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16500"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze marketing performance — spend, campaign returns, and customer programs — executing approved measurement methods against the governed measurement frameworks and stewarded metrics, producing the evidence-layer findings that planning and strategy correct from."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Concept-type: process — the measurement-execution cluster batches 21–24 pointed at; periodic; three parallel children converging into planning, promotions, and strategy/design refresh cycles. Review role statement verbatim in scope note — executes measurement, decides nothing that belongs to planning, Finance, KPI Store, or Legal. APQC 'Analyze performance' is a WEAK match at this L4."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing Performance Analysis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers marketing performance analysis: marketing spend analysis (CM-1-3-5-5-1), campaign ROI analysis (CM-1-3-5-5-2), and customer program analysis (CM-1-3-5-5-3) — three parallel analyses whose findings converge to inform sales planning, communications planning, promotions planning, and the strategy and design refresh cycles. Marketing Performance Analysis executes approved measurement methods and analyzes observed performance against the relevant domain measurement frameworks. It produces evidence-layer findings, attribution assessments, variance explanations, and improvement recommendations. It does not set target changes, approve budget reallocations, publish enterprise KPIs, produce official financial reporting, or make legal determinations. Measures against the domain measurement frameworks (offer, pricing, channel, network, communications, operating model — batches 23/24) and the metric definitions stewarded at CM-1-3-1-6; findings are evidence-layer measures that may inform candidate KPIs but do not become enterprise KPIs unless separately classified, governed, approved, and published through the KPI Store. Uses governed spend and financial data from Finance (consumed, never produced); findings with potential legal, competition, or pricing-law implications escalate to Legal/Compliance (b23 pattern); personal data per the batch 21 controls. Excludes measurement-framework definition (b23/24 rows); metrics stewardship (CM-1-3-1-6); enterprise KPI governance (KPI Store workstream); financial reporting (Finance); the subject analyses (CM-1-3-1); loyalty operation (CM-1-3-6-6); target changes and budget reallocations (their planning owners with approvals). Marketing Performance Analysis (CM-1-3-5-5) provides spend, ROI, customer-program, attribution, and improvement findings to inform Sales Planning (CM-1-3-5-1); the recipient retains its own decisions. Marketing Performance Analysis (CM-1-3-5-5) provides marketing spend, ROI, program findings, and improvement recommendations to inform Marketing Communications Planning (CM-1-3-5-3); the recipient retains its own decisions.\nIn scope: Execute approved measurement methods against the governed frameworks and stewarded metrics | analyze spend, campaign returns, and customer programs | produce evidence-layer findings, attribution assessments, variance explanations, and improvement recommendations | feed planning and strategy corrections\nOut of scope: Framework definition (b23/24 rows) | metrics stewardship (CM-1-3-1-6) | enterprise KPI governance (KPI Store) | financial reporting (Finance) | the analyses (CM-1-3-1) | loyalty operation (CM-1-3-6-6) | target changes/budget reallocations (planning owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-1-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-7"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Measurement frameworks (b23/24)"
   },
   {
    "@language": "en",
    "@value": "governed spend and outcome data (Finance, execution processes)"
   },
   {
    "@language": "en",
    "@value": "stewarded metrics (CM-1-3-1-6)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Evidence-layer marketing performance findings, attribution assessments, and improvement recommendations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Marketing measured against its own frameworks, honestly."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10102"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze marketing spend — where the money went versus the allocations, with what efficiency across channels, campaigns, and programs — from governed financial data on a stated cost basis, as evidence for allocation and mix decisions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Spend child; review cost-basis note — the analysis states its basis (committed/invoiced/paid/accrued) and cost types and reconciles to Finance-controlled records without defining Finance's taxonomy. APQC returned NONE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.5.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing Spend Analysis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers spend analysis: analyzing actual marketing spend against allocations (CM-1-3-5-3-5) and the integrated advertising envelope (CM-1-3-5-2) from governed Finance and procurement data (consumed, never produced); stating the cost basis used (committed, invoiced, paid, or accrued) and the cost types covered (media, production, agency, trade marketing, promotion, loyalty/program) and reconciling to Finance-controlled records — this process does not define Finance's accounting taxonomy; computing efficiency measures per the communications measurement framework (b24); identifying leakage, timing, and mix variances; and feeding findings to allocation, mix-model, and planning updates. Excludes financial accounting and reporting (Finance); accounting taxonomy definition (Finance); procurement performance management (Procurement); allocation decisions (CM-1-3-5-3-5); ROI attribution (CM-1-3-5-5-2). Marketing Spend Analysis (CM-1-3-5-5-1) provides spend-efficiency findings, allocation variances, and proposed improvement evidence to inform Define Resource Allocation / Budgets (CM-1-3-5-3-5); the recipient retains its own decisions.\nIn scope: Analyze actual spend versus allocations from governed data on a stated, reconciled cost basis | compute efficiency per the measurement framework | identify variances and feed planning updates\nOut of scope: Financial accounting/reporting and taxonomy (Finance) | procurement management (Procurement) | allocation decisions (CM-1-3-5-3-5) | ROI attribution (CM-1-3-5-5-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed spend data (Finance, Procurement)"
   },
   {
    "@language": "en",
    "@value": "allocations (CM-1-3-5-3-5)"
   },
   {
    "@language": "en",
    "@value": "measurement framework (b24)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Spend findings with stated cost basis, variances, and efficiency evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Knowing where the money actually went before allocating more."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/13169"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze campaign returns — outcomes against the measurement hooks each campaign carried, attribution within stated methodological limits, and return on spend — producing campaign-level evidence with assumptions and confidence stated."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). ROI child; review methodology and no-causality-overclaim rules verbatim in scope note — without experimental or control-group methods, findings are association, contribution, or directional evidence, never proven causal incremental return (b21 evidence discipline extended). APQC returned NONE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Campaign ROI Analysis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers campaign ROI analysis: measuring campaign outcomes against the measurement hooks defined at development (CM-1-3-5-3-4) and the communications measurement framework (b24); performing attribution within stated methodological limits; computing return on spend using governed cost data. ROI and attribution findings should identify the methodology, attribution window, control/baseline approach, data completeness, assumptions, uncertainty, incremental-versus-correlated effects, and known limitations. Where experimental, quasi-experimental, or control-group methods are unavailable, findings must be described as association, contribution, or directional evidence—not as proven causal incremental return. Feeds findings to mix, plan, and strategy updates. Excludes campaign execution (CM-1-3-6-5); financial reporting (Finance); mix and plan decisions (CM-1-3-5-3-3/-6); enterprise KPI publication (KPI Store). Campaign ROI Analysis (CM-1-3-5-5-2) provides campaign-return and attribution findings with methodological limits and confidence to inform Develop / Update Marketing Mix Model (CM-1-3-5-3-3); the recipient retains its own decisions.\nIn scope: Measure outcomes against campaign measurement hooks | attribute within stated limits, identifying methodology, window, baseline, completeness, and uncertainty | compute return on spend from governed data | feed mix, plan, and strategy updates\nOut of scope: Execution (CM-1-3-6-5) | financial reporting (Finance) | mix/plan decisions (CM-1-3-5-3-3/-6) | KPI publication (KPI Store)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Campaign measurement hooks (CM-1-3-5-3-4)"
   },
   {
    "@language": "en",
    "@value": "governed cost data"
   },
   {
    "@language": "en",
    "@value": "outcome data (execution processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Campaign ROI findings with methodology, assumptions, and confidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Campaign returns stated with the honesty the attribution deserves."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20007"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze customer programs — loyalty, card, and customer program performance against their design intents — within the privacy controls, as evidence for program design and planning decisions, never as program operation."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 27 (2026-09-20). Program child; review boundaries verbatim — analysis never drifts into operation, customer-service, fraud, privacy, or credit scope, and never redefines propositions, offers, mechanics, or experience strategy; b21 privacy statement and publication default inherited. APQC 'Define customer loyalty program' is a false-direction match (program design)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.5.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Customer Program Analysis"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers customer program analysis: analyzing loyalty and cards programs (operated at CM-1-3-6-6), offers-in-program performance, and customer program economics against their design intents and the measurement frameworks. Customer Program Analysis may analyze program performance using authorized, privacy-controlled, aggregate or de-identified data. It does not make customer eligibility, reward, account, credit, fraud, consent, or loyalty-operational decisions. Findings may inform program, offer, proposition, and experience decisions, but the process does not redefine the value proposition, offer, loyalty mechanics, or customer experience strategy. Uses personal, loyalty, and transaction data only under the batch 21 shared governance statement and the aggregate/de-identified publication default. Excludes loyalty and cards operation (CM-1-3-6-6); customer eligibility, reward, account, credit, fraud, and consent decisions (their accountable processes); program, offer, proposition, and experience redefinition (their owners); the consumer analyses (CM-1-3-1-3); privacy framework ownership (governance owners).\nIn scope: Analyze program performance and economics against design intent from authorized, privacy-controlled data | operate within the publication default | feed program, offer, and planning decisions without making them\nOut of scope: Loyalty/cards operation (CM-1-3-6-6) | eligibility, reward, account, credit, fraud, consent decisions (accountable processes) | program/offer/proposition/experience redefinition (their owners) | consumer analyses (CM-1-3-1-3) | privacy frameworks (governance owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-15"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Program data within consent (CM-1-3-6-6)"
   },
   {
    "@language": "en",
    "@value": "design intents"
   },
   {
    "@language": "en",
    "@value": "measurement frameworks"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Customer program findings within privacy controls"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Programs judged by evidence, run by their operators."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Marketing & Sales Operations Management covers channel & partner management, sales execution, pricing, rebates, loyalty/cards, brand standards, compliance, and marketing plan execution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing & Sales Operations Management"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10141"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the company's channel partner relationships — franchisees, licensed-brand providers, dealers, jobbers, and marketers — executing the designed engagement models, coordinating partner qualification and activation through the accountable control owners, reporting partner performance, and developing partner capability."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Concept-type: process — the partner-relationship execution cluster; tactical, with parallel relationship, reporting, and training children (no strict lifecycle, per review). Review onboarding correction: batch 23 excluded individual partner selection from Channel Design without assigning all onboarding here — this process coordinates the commercial side while Credit, Compliance, Legal, Contract Management, Master Data, training, and operating-readiness controls stay with their owners, and the delegated authority grants final onboarding approval. PMPA fact-dependence per the review wording verbatim. APQC 'Develop partner and alliance management strategies' is a WEAK strategy-side match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Channel & Partner Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers channel partner relationship execution: managing franchisee relationships under their franchise agreements (CM-1-3-6-1-1), managing licensed-brand provider relationships (CM-1-3-6-1-2), reporting franchise performance (CM-1-3-6-1-3), and training and certifying franchise site managers (CM-1-3-6-1-4). Executes the engagement models designed at CM-1-3-3-3-4 and the channel offerings created at CM-1-3-3-3-1. Onboarding model (review): this process owns the commercial side — coordinate commercial partner qualification, selection recommendation, onboarding readiness, and relationship activation through the applicable delegated approvals, Credit, Compliance, Legal, Contract Management, Master Data, training, and operating-readiness processes — while each control retains its owner: credit review and limits with the credit process (b11); compliance/KYC/sanctions with Compliance, Legal, and the counterparty process; contract drafting, review, and execution with Legal; contract record administration with Contract Management where applicable; master-data setup with Manage Commercial Master Data Stewardship (CM-1-3-7-1); brand/operator training via CM-1-3-6-1-4; site and operating readiness with the operating functions; final onboarding approval with the delegated authority. Where an arrangement meets the applicable statutory and contractual criteria for a motor-fuel franchise, changes involving trademark, supply, lease, renewal, termination, or non-renewal may be subject to PMPA and state-law constraints. Legal & Corporate Communications determines applicability, notice requirements, legal analysis, documentation, and formal legal action. Brand standards are owned at CM-1-3-6-7 (applied and reinforced here); rebates at CM-1-3-6-4. Excludes channel strategy and design (CM-1-3-2-4, CM-1-3-3-3); franchise and licensing legal work (Legal, locked rule); credit decisions (b11 boundary); compliance/KYC ownership (Compliance, Legal); master-data setup (CM-1-3-7-1); brand standards ownership (CM-1-3-6-7); rebate administration (CM-1-3-6-4); pricing (CM-1-3-6-3); site operations (operating functions). Channel & Partner Management (CM-1-3-6-1) executes the engagement models designed by Sales & Distribution Channel Design (CM-1-3-3-3).\nIn scope: Execute the designed partner engagement models | manage franchisee and licensed-brand relationships within their legal frameworks | coordinate commercial partner qualification, selection recommendation, onboarding readiness, and relationship activation through the accountable control owners | report partner performance and develop partner capability\nOut of scope: Channel strategy/design (CM-1-3-2-4, CM-1-3-3-3) | franchise/licensing legal work (Legal, locked rule) | credit decisions (b11) | compliance/KYC ownership (Compliance, Legal) | master-data setup (CM-1-3-7-1) | brand standards ownership (CM-1-3-6-7) | rebates (CM-1-3-6-4) | pricing (CM-1-3-6-3) | site operations (operating functions)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-2-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Engagement models and channel offerings (CM-1-3-3-3)"
   },
   {
    "@language": "en",
    "@value": "Legal-executed agreements"
   },
   {
    "@language": "en",
    "@value": "account plans (CM-1-3-5-1-3)"
   },
   {
    "@language": "en",
    "@value": "partner performance data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Managed partner relationships with coordinated activation, performance reporting, and capability development"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Partner relationships run the way the channel design intended."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Franchisee Relationships Under Franchise Agreements"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the ongoing relationships with franchisees under their franchise agreements — engagement, support, performance dialogue, and issue resolution within the agreement's terms — with every change to the legal relationship handled through Legal."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Continuous relationship channel; relationship management, not agreement administration or legal franchise control — the review referral rule verbatim in scope note; preferred label per review queued (the locked name reads as a relationship with an agreement). APQC 'Manage routings' is a FALSE match (fourth occurrence)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.1.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Relationship with Franchise agreement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers franchisee relationship management: running the engagement cadence per the designed model; supporting franchisees with programs, offers, and standards guidance (standards owned at CM-1-3-6-7); conducting performance dialogue from the reported evidence (CM-1-3-6-1-3); resolving operational issues within the agreement's terms; and preparing business input for agreement changes. Commercial relationship issues that may alter a legal agreement, franchise right, supply obligation, lease relationship, or statutory notice must be referred to Legal and the appropriate approval authority. Where an arrangement meets the applicable statutory and contractual criteria for a motor-fuel franchise, changes involving trademark, supply, lease, renewal, termination, or non-renewal may be subject to PMPA and state-law constraints. Legal & Corporate Communications determines applicability, notice requirements, legal analysis, documentation, and formal legal action. This process never issues franchise notices, alters legal terms, or makes franchise classification decisions. Excludes franchise legal work of every kind (Legal, locked rule); agreement drafting/amendment execution (Legal); brand standards ownership (CM-1-3-6-7); rebates and program funds administration (CM-1-3-6-4); site operations (operating functions).\nIn scope: Run the franchisee engagement cadence | support with programs and standards guidance | conduct performance dialogue | resolve operational issues within agreement terms | refer legal-touching issues to Legal and the approval authority\nOut of scope: Franchise legal work, notices, and determinations (Legal, locked rule) | agreement changes (Legal) | brand standards ownership (CM-1-3-6-7) | rebates (CM-1-3-6-4) | site operations (operating functions)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Franchise agreements (Legal-executed)"
   },
   {
    "@language": "en",
    "@value": "engagement model (CM-1-3-3-3-4)"
   },
   {
    "@language": "en",
    "@value": "performance reporting (CM-1-3-6-1-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Managed franchisee relationships within agreement terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Franchisees supported and held to the deal, with Legal holding the law."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/14209"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the ongoing relationships with licensed-brand providers — the parties whose brands the company licenses in, or to whom it licenses out — operating the commercial relationship within the Legal-executed licensing arrangements."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Continuous relationship channel; review non-determination rule verbatim — commercial performance and operating coordination only; b26 exploitation architecture governs. APQC returned NONE."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.1.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Relationship with License Brand Providers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers licensed-brand relationship management: operating the commercial relationship under the licensing arrangements shaped at CM-1-3-4-4-5 and executed by Legal; coordinating brand-use obligations both ways (standards owned at CM-1-3-6-7 for own brands; the licensor's requirements per the agreement for licensed brands); monitoring relationship performance against the arrangement; and preparing business input for renewals and changes (negotiated per CM-1-3-4-4-5, executed by Legal). The process manages commercial relationship performance and operating coordination. It does not determine trademark validity, trademark-use legal sufficiency, licensing legal terms, royalty accounting, or brand-standard policy. Royalty accounting and payments follow Finance and settlement processes (b26 boundary). Excludes licensing negotiation and structuring (CM-1-3-4-4-5); agreement drafting/execution and licensing legal terms (Legal); trademark validity and use-sufficiency determinations (Legal); royalty accounting/payment (Finance, settlements); brand-standard policy (CM-1-3-6-7).\nIn scope: Operate licensed-brand relationships under executed arrangements | coordinate brand-use obligations both ways | monitor relationship performance | prepare business input for renewals and changes\nOut of scope: Licensing negotiation/structuring (CM-1-3-4-4-5) | agreement execution and licensing legal terms (Legal) | trademark determinations (Legal) | royalty accounting/payment (Finance, settlements) | brand-standard policy (CM-1-3-6-7)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-4-4-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Licensing arrangements (CM-1-3-4-4-5, Legal-executed)"
   },
   {
    "@language": "en",
    "@value": "brand standards and licensor requirements"
   },
   {
    "@language": "en",
    "@value": "relationship performance data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Managed licensed-brand relationships within their arrangements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Licensed brands working as the arrangements intended, both directions."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16574"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Report franchise and partner performance — volumes, standards conformance, program participation, and relationship health against the measurement frameworks — producing the evidence the relationship management and planning processes act from."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Reporting child; review consumed-not-certified rule verbatim; evidence-layer with KPI Store routing. APQC 'Monitor and report performance' STRONG, no validator — genuine comparative anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.1.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Report Franchise Performance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers partner performance reporting: assembling franchisee and partner performance evidence (volumes and mix from governed sources, standards conformance, program participation, service levels) against the channel measurement framework (CM-1-3-3-3-5) and stewarded metrics; producing per-partner and network views for relationship dialogue (CM-1-3-6-1-1), planning (CM-1-3-5), and performance analysis (CM-1-3-5-5); and maintaining reporting cadence. Standards-conformance results are consumed from Brand Standards Management and relevant operating/EHS processes; this process reports them in the partner-performance view without independently certifying standards compliance. Evidence-layer reporting with KPI Store routing (b21/23 rule); commercially sensitive partner data handled per classification (b21); financial reporting is Finance's; relationship health is an analytical signal (b21 discipline). Excludes standards assessment and certification (CM-1-3-6-7, operating/EHS processes); measurement-framework definition (CM-1-3-3-3-5); financial reporting (Finance); performance dialogue and interventions (CM-1-3-6-1-1); enterprise KPI publication (KPI Store).\nIn scope: Assemble partner performance evidence against the channel measurement framework | consume standards-conformance results without certifying them | produce per-partner and network views for dialogue, planning, and analysis | maintain reporting cadence within data classifications\nOut of scope: Standards assessment/certification (CM-1-3-6-7, operating/EHS) | framework definition (CM-1-3-3-3-5) | financial reporting (Finance) | interventions (CM-1-3-6-1-1) | KPI publication (KPI Store)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-1-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed volume and program data"
   },
   {
    "@language": "en",
    "@value": "channel measurement framework (CM-1-3-3-3-5)"
   },
   {
    "@language": "en",
    "@value": "standards conformance (CM-1-3-6-7, operating/EHS)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Per-partner and network performance reporting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every partner conversation starting from the same evidence."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10289"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Train and Certify Franchise Site Managers"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Train and certify franchise site managers against the brand and operating standards — the structured training and certification program that qualifies partner site management to run branded operations — with the standards and mandatory-training regimes owned by their accountable processes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Review decision: brand-specific 'AMPM' in the locked name — defined generically; brand origin recorded; preferred label 'Train and Certify Franchise Site Managers' is a HIGH-PRIORITY naming-normalization item (the taxonomy should not hard-code one brand). Review boundary verbatim — a commercial/brand certification program, never a substitute for mandatory training owned elsewhere. APQC 'Certify and validate suppliers' is a FALSE match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Train and Certify AMPM Manager"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers franchise-manager training and certification. Operate the commercial/brand/operating-standard training and certification program for franchise or branded-site managers. It does not replace legally required, EHS, food-safety, hazardous-materials, employment, transportation, regulatory, or technical training owned by the relevant accountable function. Operates the training program for partner site managers against the brand standards (CM-1-3-6-7), the applicable operating procedures (CM-1-3-3-6-4 framework), and program requirements; administers certification and recertification with records (validity, expiry, suspension, and transfer conditions per the program's rules); and coordinates training obligations that arise from franchise agreements (obligations set in the Legal-executed agreements). Generic reading (review): the locked name carries a specific franchise brand ('ampm'); the row is defined generically as franchise site-manager training and certification, with the brand-specific origin recorded here and the preferred label a high-priority naming-normalization item. Excludes legally required, EHS, food-safety, hazardous-materials, employment, transportation, regulatory, and technical training (accountable owners); standards ownership (CM-1-3-6-7, procedure owners); company-staff HR training (HR); agreement training obligations' legal terms (Legal).\nIn scope: Operate franchise site-manager training against the owned standards | administer certification and recertification with records | coordinate agreement-driven training obligations\nOut of scope: Mandatory EHS/safety/regulatory/technical training (accountable owners) | standards ownership (CM-1-3-6-7, procedure owners) | company-staff HR training (HR) | legal terms of training obligations (Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand and operating standards (CM-1-3-6-7, CM-1-3-3-6-4)"
   },
   {
    "@language": "en",
    "@value": "agreement training obligations"
   },
   {
    "@language": "en",
    "@value": "certification records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Trained, certified franchise site managers with maintained records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every branded site run by someone certified to run it."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10103"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute the sales effort against the plans — pipeline, opportunities, key accounts, quotes, contracts and orders, and non-retail customer serving — as the commercial pursuit whose qualified outcomes are handed to the controlled transaction processes, measured against its own plan."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Concept-type: process — the standing commercial-pursuit cluster; continuous. Lifecycle: Pipeline → Opportunity → Quote → Commercial Contract and Order Relationship → Serve, with Key Accounts a continuous overlay across the full lifecycle and Measure & report the periodic feedback loop to planning, pipeline, account plans, offers, and pricing strategy — not a strict line (review). Controlled-handoff wording per review: won business exists only after quote acceptance, credit clearance, contract/legal readiness, and order acceptance in the accountable processes. APQC 'Develop sales strategy' is a WEAK strategy-side match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Sales Execution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the sales-execution cluster: managing the sales pipeline (CM-1-3-6-2-1) and opportunities (CM-1-3-6-2-3), managing key accounts as a continuous overlay (CM-1-3-6-2-2), developing quotes (CM-1-3-6-2-4), managing the commercial contract and order relationship (CM-1-3-6-2-5), serving non-retail customers (CM-1-3-6-2-6), and measuring and reporting sales performance (CM-1-3-6-2-7). The commercial-pursuit/transaction partition governs: this cluster owns the pursuit; the O2C branch owns the transaction — quote/sale processing and contract pricing configuration at CM-1-3-7-2, order capture and fulfillment management at CM-1-3-7-3, credit at CM-1-3-7-4 (b11 boundary), invoicing and A/R at CM-1-3-8. Commercially qualified opportunities are handed to the appropriate quote, contract, credit, and order-to-cash processes for controlled transaction completion. Prices are applied from Sales Pricing Management (CM-1-3-6-3) within the approved architecture; contract legal drafting and execution are Legal's (locked rule); physical delivery is Secondary Distribution's (CM-1-1-3-8, locked rule); service delivery is Service & Support's (CM-1-3-9). Executes against targets and account plans (CM-1-3-5-1), never re-planning them. Excludes quote/sale and contract-pricing transaction processing (CM-1-3-7-2); order capture/fulfillment (CM-1-3-7-3); credit (CM-1-3-7-4, b11); invoicing/A/R (CM-1-3-8); price determination (CM-1-3-6-3); contract legal work (Legal, locked rule); physical delivery (CM-1-1-3-8, locked rule); service delivery (CM-1-3-9); sales planning (CM-1-3-5-1). When a qualified sales outcome is handed to the target for controlled quote or commercial-terms processing, Sales Execution (CM-1-3-6-2) supplies qualified commercial quote packages and approved customer-arrangement requests that Manage Commercial Terms, Quoting, and Customer Commercial Services (CM-1-3-7-2) consumes in its defined work.\nIn scope: Run the commercial pursuit from pipeline to serving | manage key accounts continuously | develop quotes and steward contract-and-order relationships commercially | measure and report against the plan | hand qualified outcomes to the controlled transaction processes\nOut of scope: O2C transaction processing (CM-1-3-7-2/-3, CM-1-3-8) | credit (CM-1-3-7-4, b11) | price determination (CM-1-3-6-3) | contract legal work (Legal) | physical delivery (CM-1-1-3-8, locked) | service delivery (CM-1-3-9) | sales planning (CM-1-3-5-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-1-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Targets and account plans (CM-1-3-5-1)"
   },
   {
    "@language": "en",
    "@value": "applied prices (CM-1-3-6-3)"
   },
   {
    "@language": "en",
    "@value": "offers (CM-1-3-3-1)"
   },
   {
    "@language": "en",
    "@value": "partner relationships (CM-1-3-6-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Commercially qualified opportunities handed to the quote, contract, credit, and order-to-cash processes for controlled transaction completion"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The plan turned into orders, one pursued opportunity at a time."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20011"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the sales pipeline — the maintained, staged view of prospects and opportunities across segments and channels — keeping pipeline evidence honest, current, and feeding the forecast-input process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Pipeline overlay of the pursuit lifecycle; review forecast-integrity safeguard verbatim — pipeline optimism never substitutes for the governed forecast (b27 reinforced). APQC 'Manage opportunity pipeline' STRONG, no validator — genuine anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Sales Pipeline"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers pipeline management: maintaining the staged pipeline with entry/exit discipline and evidence standards; balancing pipeline against targets and coverage; feeding pipeline evidence into the forecast-input process (CM-1-3-5-1-2, b27 agreement) and planning; and reviewing pipeline health. Pipeline stage, probability, value, timing, and close-date assumptions must be evidence-based, versioned where material, and governed by the agreed sales-input process. Pipeline optimism must not be substituted for the enterprise demand forecast. Pipeline data uses customer information under approved access and privacy controls (b27 account-data restriction). Excludes opportunity pursuit (CM-1-3-6-2-3); target setting (CM-1-3-5-1-1); the forecast (CM-1-1-1-1, locked); CRM platform ownership (technology owners). Manage Sales Pipeline (CM-1-3-6-2-1) supplies evidence-based pipeline records as an agreed sales-side forecast input under Develop & Agree Demand Forecasting Process (CM-1-3-5-1-2), which defines their form, cadence and quality for Produce Demand Forecast (CM-1-1-1-1).\nIn scope: Maintain the staged pipeline with evidence-based, versioned assumptions | balance pipeline against targets and coverage | feed pipeline evidence to the forecast-input process | review pipeline health\nOut of scope: Opportunity pursuit (CM-1-3-6-2-3) | targets (CM-1-3-5-1-1) | the forecast (CM-1-1-1-1) | CRM ownership (technology owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Opportunities (CM-1-3-6-2-3)"
   },
   {
    "@language": "en",
    "@value": "account plans (CM-1-3-5-1-3)"
   },
   {
    "@language": "en",
    "@value": "targets (CM-1-3-5-1-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The maintained, evidence-disciplined sales pipeline"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A pipeline you can plan from because it tells the truth."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10183"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the key account relationships — executing the account plans for the accounts that matter most, coordinating the company's face to each account, and keeping relationship commitments within the approved commercial frameworks."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Continuous overlay across the full pursuit and relationship lifecycle (review); data boundary verbatim — coordination never overrides master data, credit hierarchy, contract records, consent, service cases, or assignment controls. APQC 'Manage customers and accounts' STRONG, no validator — genuine anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Key Accounts"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers key-account management: executing account plans (CM-1-3-5-1-3) for designated key accounts and marketer relationships; coordinating cross-functional touchpoints (service, credit, supply, technical) so the account experiences one company; conducting account reviews from governed evidence; and maintaining relationship commitments within the approved offer, pricing, and contract frameworks. Key-account coordination may use approved account information, but must not override customer master data, credit hierarchy, contract records, consent status, service-case records, or delegated account assignment controls. Account designation and assignments follow the management processes (b23/27 boundary); commitments requiring new terms route through quotes/contracts and their approvals; credit is the credit process's (b11); relationship health remains an analytical signal (b21). Excludes account-plan creation (CM-1-3-5-1-3); account assignments (management processes); new-term approvals (quote/contract, delegated authorities); credit (b11 boundary); service delivery (CM-1-3-9); master data, consent, and case-record overrides (their accountable owners).\nIn scope: Execute account plans for key accounts | coordinate the cross-functional account experience | conduct account reviews from governed evidence | keep commitments within approved frameworks and data controls\nOut of scope: Account-plan creation (CM-1-3-5-1-3) | assignments (management processes) | new-term approvals (quote/contract, delegated authorities) | credit (b11) | service delivery (CM-1-3-9) | master data/consent/case-record overrides (accountable owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Account plans (CM-1-3-5-1-3)"
   },
   {
    "@language": "en",
    "@value": "cross-functional touchpoint inputs"
   },
   {
    "@language": "en",
    "@value": "governed account evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Executed account plans and coordinated key-account relationships"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Key accounts experiencing one company, on plan."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20011"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage each sales opportunity from qualification through pursuit — pursuit strategy, stakeholder engagement, and solution shaping within the approved offers — driving the commercial pursuit to a qualified proceed/no-proceed or handoff outcome."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Per-opportunity pursuit step; review outcome wording — a qualified proceed/no-proceed or handoff outcome, never a unilateral close (transactions complete in the controlled processes). APQC 'Manage opportunity pipeline' 0.8 STRONG — genuine anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Opportunity"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers opportunity management: qualifying opportunities into pursuit with evidence; running pursuit strategy and stakeholder engagement per the account plan; shaping the proposed solution within the approved offers (CM-1-3-3-1) and channel offerings (CM-1-3-3-3-1) — never inventing unapproved products, terms, or claims; and driving the commercial pursuit to a qualified proceed/no-proceed or handoff outcome, with proceeding opportunities handed to quote development (CM-1-3-6-2-4). Competitive intelligence in pursuit follows the b21 legitimate-sources prohibition; pricing content comes from Sales Pricing (CM-1-3-6-3) within the approved architecture. Excludes offer definition (CM-1-3-3-1); price determination (CM-1-3-6-3); quote development (CM-1-3-6-2-4); contract terms and transaction closing (quote/contract processes, Legal, delegated authorities); improper competitive intelligence (prohibited, b21).\nIn scope: Qualify opportunities with evidence | run pursuit strategy and engagement per the account plan | shape solutions within approved offers | drive to a qualified proceed/no-proceed or handoff outcome\nOut of scope: Offer definition (CM-1-3-3-1) | price determination (CM-1-3-6-3) | quote development (CM-1-3-6-2-4) | contract terms and closing (quote/contract, Legal, authorities) | improper competitive intelligence (prohibited)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Qualified pipeline (CM-1-3-6-2-1)"
   },
   {
    "@language": "en",
    "@value": "account plans and key-account coordination"
   },
   {
    "@language": "en",
    "@value": "approved offers (CM-1-3-3-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Qualified proceed/no-proceed outcomes with proceeding opportunities handed to quoting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Opportunities pursued on strategy and handed off on approved terms."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10428"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop the commercial quote for a proceeding opportunity — assembling the offer, volume, service, and price content within the approved frameworks — for processing through the quote-and-sale transaction process, creating no binding commitment itself."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Commercial quote step of the partition — content here, transaction at CM-1-3-7-2; review non-binding statement and content specification verbatim in scope note. APQC 'Develop other HR programs' is a FALSE lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Quote"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers quote development on the commercial side: assembling quote content from the approved offers (CM-1-3-3-1), channel offerings, and applied pricing (CM-1-3-6-3, within the approved architecture, corridors, and delegated authority — exceptions per the b23 criteria); validating deliverability with the affected operating processes; and submitting the quote through the quote-and-sale transaction process (CM-1-3-7-2). The commercial quote content must identify the intended offer, product/service, quantity, location, delivery basis, price basis, validity period, conditions, and required approvals. It is submitted for controlled transactional processing; it does not itself create an executed agreement. A commercial quote package is not a binding offer, contract, price commitment, credit approval, or order until it has completed the applicable transaction, pricing, Legal, Credit, Contract, and delegated-authority controls. The partition: commercial quote content here; transactional processing, configuration, and the controlled quote/contract record in O2C. Contract legal terms are Legal's; credit clearance the credit process's (b11). Excludes quote/sale transaction processing (CM-1-3-7-2); price determination and exceptions beyond delegated authority (CM-1-3-6-3, approvals); contract legal terms (Legal); credit clearance (b11 boundary); order capture (CM-1-3-7-3). When the target processes a quote version composed by the source, Develop Quote (CM-1-3-6-2-4) supplies the approved commercial quote-content package and its authorization evidence that Manage Commercial Terms, Quoting, and Customer Commercial Services (CM-1-3-7-2) consumes in its defined work.\nIn scope: Assemble quote content identifying offer, product, quantity, location, delivery basis, price basis, validity, conditions, and required approvals | validate deliverability with operating processes | submit through the quote-and-sale transaction process\nOut of scope: Transaction processing (CM-1-3-7-2) | price determination/exceptions beyond authority (CM-1-3-6-3, approvals) | contract legal terms (Legal) | credit (b11) | order capture (CM-1-3-7-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Proceeding opportunities (CM-1-3-6-2-3)"
   },
   {
    "@language": "en",
    "@value": "applied prices (CM-1-3-6-3)"
   },
   {
    "@language": "en",
    "@value": "approved offers (CM-1-3-3-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Complete commercial quote content submitted to the transaction process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Quotes that are sellable, priceable, and deliverable before they are sent — and binding only after the controls."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Commercial Contract and Order Relationship"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the customer's contract-and-order relationship commercially — from accepted quote through contract setup coordination and ongoing order-relationship stewardship — with the transactional contract, order, and fulfillment records owned by the order-to-cash processes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Commercial stewardship step of the partition; review preferred label queued — makes the commercial-stewardship role explicit against O2C transactional ownership. APQC 'Manage service order fulfillment' is an adjacent O2C-side match (fulfillment is CM-1-3-7-3's)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Contract & Order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers commercial contract-and-order relationship management: coordinating contract setup from accepted quotes (legal drafting and execution Legal's; transactional contract pricing and records at CM-1-3-7-2); stewarding the ongoing order relationship commercially (volume performance against commitments, issue resolution routing, change coordination); and keeping account plans and pipeline current from contract-and-order reality. The partition: commercial stewardship here; order capture, fulfillment management, and the transactional records at CM-1-3-7-3; invoicing and disputes at CM-1-3-8 (five-quadrant dispute architecture, b10/17); physical delivery locked to CM-1-1-3-8. Excludes contract legal work (Legal, locked rule); transactional contract/pricing records (CM-1-3-7-2); order capture and fulfillment (CM-1-3-7-3); invoicing and disputes (CM-1-3-8, b10/17 architecture); physical delivery (CM-1-1-3-8, locked).\nIn scope: Coordinate contract setup from accepted quotes | steward the order relationship commercially | route issues to their owning processes | keep plans current from contract reality\nOut of scope: Contract legal work (Legal) | transactional records (CM-1-3-7-2/-3) | invoicing/disputes (CM-1-3-8) | physical delivery (CM-1-1-3-8, locked)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Accepted quotes (via CM-1-3-7-2)"
   },
   {
    "@language": "en",
    "@value": "contract commitments"
   },
   {
    "@language": "en",
    "@value": "order and fulfillment status (CM-1-3-7-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Commercially stewarded contract-and-order relationships"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The commercial relationship behind every contract kept alive and honest."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Serve non-retail customers commercially — the standing commercial serving relationship for commercial, industrial, and wholesale customers — maintaining relationship cadence and coordinating resolution while the owning processes execute delivery, service, cases, and billing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Continuous serving relationship; review referral wording verbatim — cadence, monitoring, coordination, and referral; no shadow service desk (case handling is CM-1-3-7-5's). APQC returned NONE — 'Invoice customer' is a false match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Serve to Customer (Non-Retail)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers commercial serving of non-retail customers. Maintain a commercial relationship cadence; monitor commitments and satisfaction; coordinate cross-functional resolution; and refer specific requests, incidents, service cases, billing issues, delivery exceptions, or technical inquiries to the processes that own case handling and execution. Coordinates across the executing processes — physical delivery by Secondary Distribution (CM-1-1-3-8, locked rule), terminal loading per the terminal processes, service and support by CM-1-3-9, case handling by CM-1-3-7-5, invoicing by CM-1-3-8-1 — so the customer's experience matches the commitments, and feeds serving evidence to account management and performance reporting. Coordinates and refers, never executes or duplicates case handling: the b19/20 fulfillment-coordination discipline applies and this process is not a shadow service desk. Excludes physical delivery and scheduling (CM-1-1-3-8, locked); terminal operations (their processes); service delivery (CM-1-3-9); case handling (CM-1-3-7-5); invoicing (CM-1-3-8-1); retail site serving (retail operations).\nIn scope: Maintain the commercial relationship cadence for non-retail customers | monitor commitments and satisfaction | coordinate cross-functional resolution | refer requests, incidents, cases, billing, delivery, and technical matters to their owning processes\nOut of scope: Physical delivery/scheduling (CM-1-1-3-8, locked) | terminal operations (their processes) | service delivery (CM-1-3-9) | case handling (CM-1-3-7-5) | invoicing (CM-1-3-8-1) | retail serving (retail operations)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Contract commitments (CM-1-3-6-2-5)"
   },
   {
    "@language": "en",
    "@value": "customer communications"
   },
   {
    "@language": "en",
    "@value": "delivery and service status (owning processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Coordinated commercial serving against commitments, with referred cases in their owning processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Non-retail customers served as promised, by the processes that own the work."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16395"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Measure and Report Sales Performance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Measure and report sales-execution performance — executing approved sales-performance measures under the relevant measurement frameworks, producing evidence-layer views and variance findings for the planning feedback loops."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Periodic feedback loop to planning, pipeline, account plans, offers, and pricing strategy; review metric qualifier verbatim; lowercase locked name — expanded normalized label queued. APQC 'Measure and report process performance' STRONG, no validator — genuine anchor."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.2.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Measure & report"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers sales measurement and reporting. Execute approved sales-performance measures under the relevant measurement frameworks; produce evidence-layer views and variance findings; and route candidate KPI proposals through the KPI Store rather than publishing enterprise KPIs. Measures execution against targets, account plans, and the relevant measurement frameworks; produces pursuit, conversion, account, and serving views for sales management, planning (CM-1-3-5-1-4 margin-gap analysis), and Marketing Performance Analysis (CM-1-3-5-5); and maintains reporting cadence. Governed actuals from Finance consumed, never produced (b27); quota and incentive measurement belong to the performance-management processes (b27 glossary). Excludes measurement-framework definition (b23/24 rows); financial reporting (Finance); quota/incentive administration (HR, performance management); plan corrections (CM-1-3-5-1 with approvals); enterprise KPI publication (KPI Store). Measure & report (CM-1-3-6-2-7) supplies sales-execution performance views, variance findings, and governed actual references that Analyze Gaps Between Forecast & Actual Margins (CM-1-3-5-1-4) consumes in its defined work. Measure & report (CM-1-3-6-2-7) supplies sales-execution performance views and variance findings that Marketing Performance Analysis (CM-1-3-5-5) consumes in its defined work.\nIn scope: Execute approved sales-performance measures under the frameworks | produce evidence-layer pursuit, conversion, account, and serving views with variance findings | route candidate KPI proposals through the KPI Store\nOut of scope: Framework definition (b23/24) | financial reporting (Finance) | quota/incentive administration (HR) | plan corrections (CM-1-3-5-1) | KPI publication (KPI Store)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed actuals (Finance)"
   },
   {
    "@language": "en",
    "@value": "pipeline and account evidence"
   },
   {
    "@language": "en",
    "@value": "targets and plans (CM-1-3-5-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Evidence-layer sales performance views and variance findings"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Sales execution seeing its own scoreboard weekly, honestly."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10123"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-rp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Apply the approved pricing architecture in the market — determining posted and transaction sales prices within the approved parameters, corridors, rules, and eligibility, and coordinating their deployment through the accountable master-data and system processes — on the daily and intraday cycles downstream fuel pricing runs on, never modifying the architecture itself."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Concept-type: process — the daily pricing-execution cycle; horizon daily (execution runs daily and intraday; daily is the controlled taxonomy value, per review). Cycle: Determine Sales Price → coordinate price deployment → verify deployment/audit trail → feed realization evidence to Pricing Strategy Management. Applies, never modifies, the b23 architecture; RP and competition-information rules inherited verbatim by reference. APQC returned NONE at this L4."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Sales Pricing Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers sales pricing execution: determining sales prices (CM-1-3-6-3-1) and implementing them (CM-1-3-6-3-2), recurring daily and intraday, feeding realization and performance evidence to Pricing Strategy Management's feedback loop. The receiving side of the batch 23 pricing governance: applies the approved price architecture, effective-dated price rules, differentials, index linkages, corridors, floors, ceilings, customer/channel eligibility, and delegated exception criteria developed at CM-1-3-3-2 under its commercial, Finance, Legal, Compliance, and delegation-of-authority approvals; exceptions follow the approved criteria and authorities; architecture feedback flows to CM-1-3-3-2, never changed here. The legal guardrails apply in execution: the batch 23 fact-dependent Robinson-Patman statement and the standardized competition-information rule verbatim by reference — pricing situations with discrimination, below-cost, or unfair-sales risk escalate to Legal/Compliance, who determine applicability and sufficiency. Quote and contract pricing configuration is CM-1-3-7-2's, applying the same architecture transactionally; rebates at CM-1-3-6-4; price master data with the accountable Price Master Data process (CM-1-3-7-1); physical price display, pump-sign configuration, and legal metrology with site operations and EHS/regulatory processes (b24). Excludes pricing architecture, parameters, and rules (CM-1-3-3-2); quote/contract pricing configuration (CM-1-3-7-2); rebates (CM-1-3-6-4); price master-data ownership (CM-1-3-7-1); price display execution (site operations, b24); legal determinations (Legal, Compliance); trading/supply pricing (CM-1-2). Analyze Pricing Performance (CM-1-3-3-2-3) analyzes the posted and transaction prices determined by Sales Pricing Management (CM-1-3-6-3).\nIn scope: Determine posted and transaction prices within the approved architecture, eligibility, and delegated authority | coordinate deployment through the accountable master-data and system processes | route exceptions per the approved criteria | escalate legal-risk situations and feed realization evidence back\nOut of scope: Pricing architecture/parameters/rules (CM-1-3-3-2) | quote/contract pricing (CM-1-3-7-2) | rebates (CM-1-3-6-4) | price master-data ownership (CM-1-3-7-1) | price display execution (site operations, b24) | legal determinations (Legal, Compliance) | trading/supply pricing (CM-1-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved architecture, rules, and eligibility (CM-1-3-3-2)"
   },
   {
    "@language": "en",
    "@value": "exception criteria and authorities"
   },
   {
    "@language": "en",
    "@value": "permitted market and cost inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Determined, deployed sales prices within the approved architecture"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every posted and transaction price inside the approved system, every day."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10209"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-rp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Determine posted and transaction prices by applying approved price architecture, effective-dated price rules, differentials, indices, corridors, floors, ceilings, customer/channel eligibility, and delegated exception criteria to current permitted inputs."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Determination step of the daily cycle; review wording adopted verbatim as the definition; the five distinctions (calculation, override, exception, escalation, effectivity) recorded; no-self-exception rule verbatim; lowercase locked name — capitalization queued. APQC 'Determine sales resource allocation' is a FALSE lexical match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.3.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Determine sales price"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers price determination, distinguishing (review): rule-driven price calculation; delegated price override within authority; price exception request beyond authority; legal-risk escalation; and price-effectivity timing. Computes posted and transaction prices per the approved architecture from current permitted inputs; keeps determinations within the approved corridors, floors, ceilings, and eligibility; and records determinations with effectivity for deployment (CM-1-3-6-3-2) and realization analysis (CM-1-3-3-2-3). Determinations outside approved authority, corridor, eligibility, or legal-risk thresholds are routed for approval; the process does not approve its own exception beyond delegated authority. Pricing decisions with price-discrimination, below-cost, or unfair-sales risk escalate per the b23 fact-dependent statement — Legal and Compliance determine applicability and sufficiency; competitor price inputs only from legitimate sources (b23 rule). Excludes architecture, corridor, and eligibility changes (CM-1-3-3-2); exception approval beyond delegated authority (the authorities); quote/contract price configuration (CM-1-3-7-2); legal determinations (Legal, Compliance).\nIn scope: Compute prices per the approved architecture and effective-dated rules from permitted inputs | keep within corridors, ceilings, floors, and eligibility | route overrides and exceptions per delegated criteria with rationale | escalate legal-risk situations | record determinations with effectivity\nOut of scope: Architecture/corridor/eligibility changes (CM-1-3-3-2) | exception approval beyond authority (authorities) | quote/contract configuration (CM-1-3-7-2) | legal determinations (Legal, Compliance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved architecture and effective-dated rules (CM-1-3-3-2)"
   },
   {
    "@language": "en",
    "@value": "exception criteria"
   },
   {
    "@language": "en",
    "@value": "permitted market and cost inputs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Determined prices with effectivity, within the architecture, exceptions documented"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Today's prices computed from the approved system, not improvised."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11497"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Implement determined sales prices — submitting approved price changes to the accountable Price Master Data process and coordinating deployment to approved pricing systems, channels, customer communications, and downstream consumers — verifying effective-date, completeness, and audit-trail status."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 28 (2026-09-20). Implementation step of the daily cycle; review master-data correction adopted verbatim as the operative wording — submits to, never deploys into, the accountable Price Master Data process; the b24 price-display split maintained; lowercase locked name — capitalization queued. APQC 'Communicate and implement price changes' is a genuine adjacent match."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.3.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Implement sales price"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers price implementation. Submit approved price changes to the accountable Price Master Data process; coordinate deployment to approved pricing systems, channels, customer communications, and downstream consumers; verify effective-date, completeness, and audit-trail status. Coordinates channel and site price data (physical price display, pump-sign configuration, and legal metrology remain with site operations and EHS/regulatory processes, b24), customer price communications per contractual notice terms, and the downstream consumers (quotes CM-1-3-7-2, invoicing CM-1-3-8-1); maintains the price-change audit trail for realization analysis (CM-1-3-3-2-3). Excludes price determination (CM-1-3-6-3-1); price master-data ownership and record changes (CM-1-3-7-1, the accountable process); physical display and metrology (site operations, EHS/regulatory, b24); invoicing (CM-1-3-8-1); customer contract notice terms (contracts, Legal).\nIn scope: Submit approved price changes to the Price Master Data process | coordinate deployment to approved systems, channels, and communications per notice terms | verify effective-date, completeness, and audit-trail status\nOut of scope: Price determination (CM-1-3-6-3-1) | price master-data ownership (CM-1-3-7-1) | physical display/metrology (site operations, b24) | invoicing (CM-1-3-8-1) | notice terms (contracts, Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Determined prices with effectivity (CM-1-3-6-3-1)"
   },
   {
    "@language": "en",
    "@value": "Price Master Data process (CM-1-3-7-1)"
   },
   {
    "@language": "en",
    "@value": "deployment channels and notice terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Deployed prices with verified effectivity and a complete audit trail"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The determined price live everywhere it should be, provably."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20682"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-rp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of administering customer and channel-partner rebate arrangements through their operational lifecycle: negotiating individual rebate terms within the approved discount and rebate architecture, implementing agreed arrangements in the systems and procedures that administer them, and settling earned rebates accurately against verified performance."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Administer-not-design boundary under the b23 rebate guardrail (design at CM-1-3-3-2); review no-new-structure rule and refined Robinson-Patman statement adopted verbatim; settlement request wording per review replaces generic 'settlement instructions'; b14 payment-authority rule applies."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Rebate Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This process administers rebates; it does not design them. Rebate and discount architecture — which rebate structures exist, their forms, and the guardrails they operate within — is developed and approved under Pricing Strategy Management (CM-1-3-3-2) and the applicable delegations of authority; Rebate Management negotiates, implements, and settles individual arrangements inside that approved architecture. No individual arrangement may create a rebate structure, treatment, eligibility rule, payment term, customer classification, or price effect outside the approved architecture and delegation. Settlement follows the payment-authority rule: this process prepares the appropriate authorized credit, offset, accrual-release, or payment request through the accountable accounting/treasury processes; it never moves funds. Fact-dependent statement: where a rebate, discount, promotional allowance, or service/payment arrangement differs among purchasers that may compete, US price-discrimination or promotional-allowance requirements may be implicated depending on commodity comparability, purchaser status, competitive effect, available defenses, and other facts. Legal/Compliance determines applicability and sufficiency.\nIn scope: Negotiate individual rebate arrangements within the approved architecture, eligibility, and delegations of authority | implement agreed arrangements in rebate-administration systems | coordinate rebate accruals with Finance | validate earned-rebate calculations against verified sales performance | prepare authorized settlement requests | track arrangement performance and expiry\nOut of scope: Rebate/discount architecture design and approval (CM-1-3-3-2) | sales price setting (CM-1-3-6-3) | payment execution and funds movement (Finance/Treasury) | accrual accounting policy and write-off decisions (Finance) | legal review of rebate terms and competition-law determinations (Legal/Compliance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved discount and rebate architecture and guardrails (CM-1-3-3-2)"
   },
   {
    "@language": "en",
    "@value": "Legal/Compliance guidance"
   },
   {
    "@language": "en",
    "@value": "customer and partner agreements"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "verified sales and volume data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurately settled rebate arrangements with a complete administration record"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Rebate arrangements administered accurately and transparently from negotiation through settlement within approved pricing governance."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10464"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-rp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Negotiate the terms of an individual rebate arrangement with a customer or channel partner — eligibility, performance conditions, rates or tiers, measurement basis, period, and settlement method — within the approved rebate architecture and delegations of authority, obtaining the approvals required before commitment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review negotiation-constraint list and no-new-structure rule adopted verbatim; refined Robinson-Patman statement per review; contract formalization routed to contract management."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.4.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Negotiate Rebate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Negotiation operates only within: the approved rebate architecture; approved customer/channel eligibility; delegated commercial authority; Legal/Compliance guardrails; pricing corridors and exception criteria; and contract and master-data controls. No individual arrangement may create a rebate structure, treatment, eligibility rule, payment term, customer classification, or price effect outside the approved architecture and delegation. Terms outside approved structures or thresholds require approval through Pricing Strategy Management governance and the applicable delegations before any commitment. Fact-dependent statement: where a rebate, discount, promotional allowance, or service/payment arrangement differs among purchasers that may compete, US price-discrimination or promotional-allowance requirements may be implicated depending on commodity comparability, purchaser status, competitive effect, available defenses, and other facts. Legal/Compliance determines applicability and sufficiency. Contractual formalization of agreed terms executes through the contract-management processes, not within this process.\nIn scope: Prepare negotiation positions from approved structures and verified customer data | negotiate terms within architecture, eligibility, and delegation | secure required approvals | document agreed terms for implementation\nOut of scope: Creating rebate structures, treatments, eligibility rules, payment terms, customer classifications, or price effects outside the approved architecture | contract execution (Manage Contract & Order; Establish Commercial Terms & Contracts) | legal determinations (Legal/Compliance) | settlement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved architecture and pricing corridors"
   },
   {
    "@language": "en",
    "@value": "Legal/Compliance guidance"
   },
   {
    "@language": "en",
    "@value": "customer performance data"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Approved, documented rebate terms ready for implementation"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Approvable rebate terms reached inside the governed architecture and delegation."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11136"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Set up an agreed rebate arrangement in the systems and procedures that administer it — configuring terms, measurement and accrual rules, and validation controls — so earned rebates accrue and calculate accurately from the arrangement's effective date."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Master-data submission rule carried from the b28 Implement sales price correction: submits to, never deploys into, governed master data."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.4.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Implement Rebate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Implements agreed terms exactly as approved; discrepancies discovered during setup route back through Negotiate Rebate and its approvals rather than being resolved by configuration. Where rebate conditions reside in governed pricing or discount master data, this process submits validated changes through Maintain Price & Discount Master Data and its controls — it never writes directly into governed master data. Accrual setup coordinates with Finance (Analyze and Calculate Accruals).\nIn scope: Configure agreed terms in rebate-administration systems | set up measurement and accrual rules | validate and test calculation logic | effective-dating | implementation records\nOut of scope: Changing agreed terms (Negotiate Rebate) | master-data writes outside governed submission (CM-1-3-7-1) | accrual accounting policy (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved documented terms (Negotiate Rebate)"
   },
   {
    "@language": "en",
    "@value": "Price & Discount Master Data submission controls (CM-1-3-7-1)"
   },
   {
    "@language": "en",
    "@value": "accrual rules from Finance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Operational rebate arrangement accruing correctly from its effective date"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Agreed rebate arrangements operational, accurate, and effective on time."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/18641"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Calculate, validate, and settle earned rebates at agreed settlement points: verify performance against the arrangement's conditions, compute amounts due, resolve calculation discrepancies with the customer or partner, and prepare the appropriate authorized settlement request in the agreed form."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review settlement-request wording adopted verbatim (authorized credit, offset, accrual-release, or payment request through accountable accounting/treasury processes); b14 payment-authority rule; settlement forms enumerated per review."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.4.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Settle Rebate"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Settlement distinguishes rebate calculation, rebate validation, accrual coordination, credit memo request, cash payment request, and offset/netting request from accounting and funds movement, which remain with Finance/Treasury. Prepare the appropriate authorized credit, offset, accrual-release, or payment request through the accountable accounting/treasury processes. Credit-memo settlements execute through Manage Customer Invoicing and Billing controls (Create Credit Memo); accrual releases coordinate with Analyze and Calculate Accruals. Discrepancies over earned amounts under an arrangement are resolved here; disputes and collection of unrelated receivables remain with Manage Receivables Resolution.\nIn scope: Settlement calculations against verified performance | customer/partner validation and discrepancy resolution on earned amounts | accrual coordination | preparation of authorized credit, offset, accrual-release, or payment requests | settlement records\nOut of scope: Funds movement and payment execution (Finance/Treasury) | invoice and credit-memo issuance outside CM-1-3-8-1 controls | collection strategy (CM-1-3-8-3) | write-offs and accounting treatment (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Operational arrangement terms"
   },
   {
    "@language": "en",
    "@value": "accrual balances (Finance)"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "verified sales performance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Settled rebates with validated calculations and a complete settlement record"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Earned rebates settled accurately, on time, through authorized instruments."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20622"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of executing approved marketing plans in market: coordinating and monitoring advertising, promotion and event, and direct-marketing activity according to the released plans, calendars, budgets, and creative deliverables produced by marketing planning, and returning execution and spend actuals for measurement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Receiving end of the b27 prepare-and-release handoff; review coordination wording adopted verbatim — coordinates and monitors execution by agencies, vendors, partners, channel operators, and sites rather than owning all placement; b24 contactability rule applies."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Marketing Plan Execution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This process is the receiving end of the marketing release handoff: Marketing Communications Planning and related planning processes prepare and release approved deliverables under the release-authority statement; Marketing Plan Execution executes what has been released and does not itself approve strategy, creative, claims, budgets, prices, or releases. Coordinate and monitor in-market execution by internal teams, agencies, vendors, partners, channel operators, and sites under approved commitments; capture execution, delivery, and spend actuals. Execution results and spend actuals flow to Marketing Performance Analysis for measurement — this process executes and records; it does not evaluate effectiveness. Consumer contact in execution honors the contactability rule: permissioned contactability data is consumed under the enterprise consent framework; execution never creates or presumes consent. Marketing Plan Execution (CM-1-3-6-5) supplies marketing execution, delivery, and spend actuals that Marketing Performance Analysis (CM-1-3-5-5) consumes in its defined work.\nIn scope: Coordinate and monitor in-market execution by internal teams, agencies, vendors, partners, channel operators, and sites under approved commitments | verify release and approval status before activation | in-market quality control against released specifications | capture execution, delivery, and spend actuals\nOut of scope: Developing or approving plans, creative, claims, budgets, or releases (planning processes) | effectiveness measurement (Marketing Performance Analysis) | fuel price setting or price-display execution (b24 POS exclusion) | media strategy | agency and vendor contracting terms (Procurement/Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-3-5-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-10"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-3-8"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-5-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Released plans, calendars, budgets, and creative deliverables (CM-1-3-5-3)"
   },
   {
    "@language": "en",
    "@value": "approved media and vendor commitments"
   },
   {
    "@language": "en",
    "@value": "brand standards"
   },
   {
    "@language": "en",
    "@value": "permissioned contactability data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Executed marketing activity with complete execution, delivery, and spend actuals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Released marketing plans delivered in market faithfully, on schedule, and within approved commitments."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute released advertising: traffic approved creative to booked media, coordinate and monitor agency and vendor execution within approved media commitments, monitor placement quality and delivery, and capture spend and delivery actuals."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Coordinate-and-monitor reading per review — agency/vendor placement responsibility preserved; substantiation-before-dissemination inherited from b24 advertising controls."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.5.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Advertising"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Substantiation before dissemination, inherited from communications planning: only creative that has completed the claim-substantiation and approval controls in planning is trafficked; execution verifies release status and never approves claims. Media placement may be executed by agencies or procurement-managed vendors; this process coordinates and monitors that execution under approved commitments entered through procurement and contract controls. Manage Advertising (CM-1-3-6-5-1) supplies advertising execution, delivery, and spend actuals that Campaign ROI Analysis (CM-1-3-5-5-2) consumes in its defined work.\nIn scope: Creative trafficking of released assets | coordination and monitoring of agency/vendor execution | placement and delivery monitoring | makegoods and delivery exception handling within commitments | spend and delivery actuals\nOut of scope: Creative development or approval | claim substantiation (planning; SRC-FTC-ADM-001 controls) | media strategy and budget approval | new media commitments beyond approvals (Procurement)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Released creative and media plans"
   },
   {
    "@language": "en",
    "@value": "approved media commitments"
   },
   {
    "@language": "en",
    "@value": "brand standards"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Delivered advertising with verified placement, delivery, and spend actuals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Released advertising delivered accurately across booked media."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review readiness-owner list adopted verbatim; coordinates-but-does-not-certify qualifier per review; b27 promotion-readiness framework and b28 pricing rules inherited. Normalized label 'Manage Promotions and Events Execution' recorded as alt label and queued for the naming pass. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Manage Promotions/Events Execution' to 'Manage Promotions and Events Execution'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16408"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Promotions/Events Execution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute released promotions and events: coordinate site and channel readiness, deploy promotional materials, deliver events, coordinate participating partners, and close out each promotion or event with captured actuals."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Promotions and Events Execution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The promotion-readiness conditional framework applies. Site, supply, inventory, price, promotional mechanics, legal terms, partner, EHS, POS, staffing, technology, and measurement readiness are confirmed by their accountable owners before activation. Marketing Plan Execution coordinates these confirmations; it does not certify the conditions itself. Price-affecting promotional mechanics are implemented only through Sales Pricing Management and governed Price & Discount Master Data submission; execution never configures prices or price displays directly (b24 POS price-display exclusion; b28 no-self-exception rule). Partner participation operates under executed agreements only.\nIn scope: Coordinate readiness confirmation with accountable owners | promotional material deployment | event delivery and staffing coordination | partner execution coordination under executed agreements | teardown, closeout, and actuals capture\nOut of scope: Promotion design and approval (planning) | certifying readiness conditions (their accountable owners) | price setting or POS price configuration (CM-1-3-6-3; site operations) | legal terms drafting (Legal) | inventory ownership"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Released promotion plans and calendars"
   },
   {
    "@language": "en",
    "@value": "executed partner agreements"
   },
   {
    "@language": "en",
    "@value": "promotional materials"
   },
   {
    "@language": "en",
    "@value": "readiness confirmations from accountable owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Executed promotions and events with closeout records and actuals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Released promotions and events delivered completely and compliantly."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16851"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ftc-adm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute released direct-marketing activity: build audience executions from permissioned contactability data, dispatch messages through approved channels, honor preferences and opt-outs, and capture responses for measurement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review suppression wording adopted verbatim — 'without undue delay through the accountable consent/preference system' replaces 'immediately' to avoid an unvalidated SLA promise; b24 contactability rule and b21 personal-data governance statement apply."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Direct Marketing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Contactability rule: this process consumes permissioned contactability data under the enterprise consent framework and never creates or presumes consent. Opt-out/suppression updates must be processed without undue delay through the accountable consent/preference system, and execution must stop or suppress future contact as required by the applicable channel, law, and system control. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Response data flows to Marketing Performance Analysis and Customer Program Analysis for evaluation. Manage Direct Marketing (CM-1-3-6-5-3) supplies permission-controlled direct-marketing response and execution records that Customer Program Analysis (CM-1-3-5-5-3) consumes in its defined work.\nIn scope: Audience execution from permissioned data | message dispatch through approved channels | preference and opt-out honoring with suppression processed without undue delay through the accountable consent/preference system | response capture and handoff to measurement\nOut of scope: Consent creation or consent-framework ownership | creative and offer approval (planning) | audience strategy | effectiveness evaluation (CM-1-3-5-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Released campaigns"
   },
   {
    "@language": "en",
    "@value": "approved channel capabilities"
   },
   {
    "@language": "en",
    "@value": "permissioned contactability data"
   },
   {
    "@language": "en",
    "@value": "suppression lists"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Dispatched direct-marketing activity with response and suppression records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Released direct marketing executed lawfully to permissioned audiences."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Capability per the heterogeneous-concurrent-control test (b21/b26 precedent); review-required loyalty-versus-card internal split stated; revised fact-dependent PCI DSS scope statement adopted verbatim (data handling and payment architecture, not branding alone); Security boundary statement adopted verbatim. Normalized label 'Loyalty and Cards Management (Marketing)' is a case/punctuation-only change — queued for the naming pass, not recorded as an alt label. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Loyalty And Cards Management - Marketing' to 'Loyalty and Cards Management (Marketing)'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11522"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Loyalty And Cards Management - Marketing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "A capability that operates loyalty, proprietary-fuel-card, fleet-card, and, where applicable, network-payment-card programs through coordinated but distinct member-program and card-program processes: administering members and cardholders from prospect setup through issuance, servicing, transaction processing, billing coordination, and program benefits, across concurrently running controls for administration, financial coordination, fraud response, compliance, card logistics, and loyalty operation."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Loyalty and Cards Management (Marketing)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Classified as a capability because its children are not lifecycle stages of one process but heterogeneous controls operating concurrently over ongoing programs. Internal conceptual split: the loyalty-program scope covers member accounts and tiers, earn/redemption mechanics, rewards fulfillment, loyalty communications under consent, program partner benefits, and loyalty operational records; the card-program scope covers cardholder/customer accounts, card issuance/activation/replacement, card limits and purchase restrictions, transaction authorization and processing coordination, billing and reimbursement coordination, fraud and service response, and secure card production and handling. Program-coordination statement: the programs coordinate member-facing financial touchpoints, but each enterprise control retains its owner — invoicing and billing execute under Manage Customer Invoicing and Billing; customer credit limits under Manage Credit & Risk; collection, disputes, and bad-debt allowance under Manage Receivables Resolution and Finance; payment execution under the payment-authority rule. Where the card program stores, processes, transmits, or can affect the security of payment-card account data within an applicable PCI payment-card environment, PCI DSS and related card-scheme obligations may apply. Closed-loop proprietary fuel-card programs may have different or no PCI DSS scope depending on the payment architecture, payment-card data handled, service providers, and applicable scheme arrangements. Security, with the accountable business, technology, processor, acquirer, and Treasury owners, determines scope and required controls. The program applies Security-defined card-data, authentication, access, encryption, tokenization, retention, vendor, incident-response, and secure-media controls. It does not define PCI scope, security architecture, security control standards, forensic investigation, or breach notification obligations. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Customer Program Analysis (CM-1-3-5-5-3) analyzes the performance of the loyalty and card programs operated by Loyalty and Cards Management (Marketing) (CM-1-3-6-6).\nIn scope: Operate loyalty and card programs through distinct member-program and card-program processes | member/cardholder account administration | program-level financial coordination within owning-process controls | program fraud response and escalation | card logistics and production coordination | loyalty program operation\nOut of scope: Enterprise invoicing, credit, collections, and payment execution (their owning processes) | PCI scope determination, security architecture, and forensic investigation (Security) | card scheme rule-setting (external networks) | acquirer/banking relationships (Treasury) | program performance evaluation (Marketing Performance Analysis) | brand standards setting (Brand Standards Management)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Program terms and rules"
   },
   {
    "@language": "en",
    "@value": "Security-defined card-data controls"
   },
   {
    "@language": "en",
    "@value": "card scheme specifications where applicable"
   },
   {
    "@language": "en",
    "@value": "enterprise credit, invoicing, and consent frameworks"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Operating card and loyalty programs with governed member, transaction, and program records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Card and loyalty programs operated reliably and compliantly as an ongoing commercial capability."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review onboarding wording adopted verbatim; records are requested through governed controls, never owned here. Normalized label 'Set Up Prospect' recorded as alt label and queued for the naming pass. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Setup Prospect' to 'Set Up Prospect'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/18641"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Setup Prospect"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate prospective program-member/cardholder onboarding by capturing applications, validating completeness, and initiating required Credit, KYC, Compliance, Master Data, contract, and program-eligibility controls. Request establishment of governed customer, member, and card-account records through their owning master-data controls, and confirm activation readiness."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Set Up Prospect"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Onboarding coordination model (b28 precedent): setup coordinates commercial qualification and activation readiness through the owning controls — credit through Establish Credit Limit & Risk Code, identity through Perform KYC Due Diligence, customer records through Maintain Customer and Commercial Account Master Data — and each control retains its owner. Setup never grants credit, bypasses KYC, or writes directly into governed master data: it requests governed record creation and consumes the outcomes. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit.\nIn scope: Application capture and completeness validation | initiation of Credit, KYC, Compliance, Master Data, contract, and program-eligibility controls | requests for governed record creation | activation readiness confirmation\nOut of scope: Credit decisions and limit setting (CM-1-3-7-4) | identity/KYC determinations (their owners) | master-data record ownership and writes outside governed submission (CM-1-3-7-1) | marketing acquisition campaigns"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Applications"
   },
   {
    "@language": "en",
    "@value": "credit and KYC outcomes (CM-1-3-7-4)"
   },
   {
    "@language": "en",
    "@value": "customer master-data controls (CM-1-3-7-1)"
   },
   {
    "@language": "en",
    "@value": "program terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Activation-ready member/cardholder records established through governed controls"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Qualified applicants converted into activation-ready members/cardholders through the owning controls."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/requires": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-10",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10954"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Handle cards securely through issuance: coordinate personalization and fulfillment, hold cards in secure custody, deliver cards to customers, and manage return, destruction, and exceptions. Coordinate and evidence quality acceptance, secure custody, delivery, return, destruction, and exception handling according to Security-defined and vendor/scheme requirements."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review coordinate-and-evidence wording adopted verbatim — vendor quality inspection responsibility preserved."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.10"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Physical Card Handling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Chain-of-custody and secure-handling controls are defined by Security and applied without exception. Quality checks may be performed by the card manufacturer or personalization vendor; this process coordinates and evidences quality acceptance rather than necessarily performing inspection itself. Card-data security follows the fact-dependent PCI DSS scope statement and Security-defined controls stated at Loyalty and Cards Management (Marketing) (CM-1-3-6-6). Delivery exceptions route back through card administration.\nIn scope: Personalization and fulfillment coordination | quality acceptance coordination and evidence | secure storage and chain of custody | distribution and delivery | return, destruction, and exception handling with records\nOut of scope: Security control definition (Security) | card production runs (CM-1-3-6-6-13) | design compliance (CM-1-3-6-6-8) | vendor contracting (Procurement)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-8"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Produced cards (CM-1-3-6-6-13)"
   },
   {
    "@language": "en",
    "@value": "Security handling controls"
   },
   {
    "@language": "en",
    "@value": "delivery instructions"
   },
   {
    "@language": "en",
    "@value": "vendor/scheme requirements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Delivered (or destroyed) cards with complete custody and acceptance records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every card moved from production to customer — or to destruction — under unbroken, evidenced secure custody."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-11",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10768"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Detect and respond to suspected fraudulent card activity at program level: monitor transaction alerts, investigate suspected misuse within program authority, block cards and accounts, initiate dispute and chargeback workflows where applicable, and escalate per the enterprise fraud framework."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review chargeback-boundary statement adopted verbatim; program-servicing-versus-Security/Legal escalation split maintained."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.11"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Fraudulent Transactions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Escalation boundary: enterprise fraud investigation, forensics, and law-enforcement engagement are owned by Security and Legal; this process's authority is program-level detection, immediate servicing response — block, hold, customer contact — and escalation with complete evidence. It makes no legal determinations. Chargeback boundary: Initiates and coordinates card-program disputes, fraud claims, and chargeback requests through the applicable acquirer, issuer, processor, O2C, or legal processes; it does not determine scheme adjudication or execute financial recovery. Customer credits follow the billing-coordination and reimbursement controls.\nIn scope: Fraud alert monitoring and triage | program-level investigation and customer verification | immediate card/account response | dispute, fraud-claim, and chargeback initiation and coordination through the applicable acquirer, issuer, processor, O2C, or legal processes | escalation to Security/Legal with evidence | fraud-pattern feedback to transaction analysis\nOut of scope: Enterprise investigation and forensics (Security) | legal determinations and law-enforcement engagement (Legal) | scheme adjudication and financial recovery execution (acquirer/issuer/processor; O2C; Finance) | write-offs (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Security fraud framework"
   },
   {
    "@language": "en",
    "@value": "Transaction alerts and anomaly reports (CM-1-3-6-6-7)"
   },
   {
    "@language": "en",
    "@value": "customer verification data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Contained fraud incidents with servicing actions, initiated dispute/chargeback workflows, and escalation records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Fraud losses stopped fast at program level with clean escalation and initiated recovery workflows."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-7"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-12",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). b26 no-implied-obligations rule applied to service partners. Normalized label 'Manage Additional Card Services' recorded as alt label and queued — parenthetical examples belong in the definition. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Manage Additional Card Services (On Road Services)' to 'Manage Additional Card Services'. Prior label NOT retained as skos:altLabel per the migration-map-only disposition (generic-alias precedent): the old label would falsely narrow scope / is not a useful synonym; preserved as prior_name in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10003"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage supplementary services offered through the card program, such as on-road services (breakdown assistance, tolls, parking) and partner services: administer service enrollments, coordinate service-partner delivery, and handle service transactions within the program."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.12"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Additional Card Services"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Service-partner arrangements are contracted through the contract-management controls and create no obligations beyond executed agreements (b26 rule). Service transactions bill through the same program billing-coordination boundary as card transactions. Service scope offered to customers follows approved program terms; new service types are approved through program governance before offering.\nIn scope: Service enrollment administration | partner delivery coordination under executed agreements | service transaction capture and routing to billing coordination | service-level issue resolution at program level\nOut of scope: Partner contracting terms (contract management; Legal) | invoicing execution (CM-1-3-8-1) | new service approval (program governance) | the partner's own service delivery"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved program service terms"
   },
   {
    "@language": "en",
    "@value": "enrollments"
   },
   {
    "@language": "en",
    "@value": "executed partner agreements"
   },
   {
    "@language": "en",
    "@value": "service transaction data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Administered service enrollments and transactions delivered per agreement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Reliable supplementary services adding card-program value under executed agreements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Manage Additional Card Services (On Road Services)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-13",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10224"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage card production runs and periodic reissue cycles: schedule production and personalization with vendors, manage the monthly reissue of expiring cards, and hand produced cards to physical handling for distribution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Secure-production requirements per Security and applicable schemes; compliant-design gate from CM-1-3-6-6-8."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.13"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Card Production & Monthly Reissue"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Production and personalization vendors operate under procurement and contract controls and under the applicable Security-defined and scheme secure-production requirements. Card-data security follows the fact-dependent PCI DSS scope statement and Security-defined controls stated at Loyalty and Cards Management (Marketing) (CM-1-3-6-6). Production releases only designs verified by Ensure Card Design Compliance. Reissue scheduling coordinates with card-media inventory monitoring so cycles are supplied.\nIn scope: Production and personalization scheduling | monthly reissue cycle management | vendor run coordination within contracts | handoff to physical handling | production records\nOut of scope: Vendor contracting (Procurement) | design compliance (CM-1-3-6-6-8) | physical distribution and custody (CM-1-3-6-6-10) | card-media purchasing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-9"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Compliance-verified card designs (CM-1-3-6-6-8)"
   },
   {
    "@language": "en",
    "@value": "card media (CM-1-3-6-6-9)"
   },
   {
    "@language": "en",
    "@value": "card orders and expiry schedules"
   },
   {
    "@language": "en",
    "@value": "vendor contracts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-10"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Produced and reissued cards handed to secure physical handling"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Cards produced and reissued on schedule from compliant designs and supplied media."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-4"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-14",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20933"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage acceptance-side payment-card transaction operations where assigned: monitor approved processor/acquirer transaction flows, reconcile transaction submissions and settlement files, prepare exceptions, and coordinate resolution with Treasury, processors, O2C, and Security."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review payment-architecture wording adopted verbatim — 'where assigned' coordination role covers both centralized and outsourced processing models; second use of the daily horizon (after b28 Sales Pricing) for daily submission/settlement cycles."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.14"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Credit Card Transactions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Coordinate, monitor, and reconcile acceptance-side transaction processing, including submission or transmission through approved processors/acquirers where that activity is assigned to the program. Submission to acquirers may be performed automatically by processors, gateways, POS systems, or merchant-services platforms; this process coordinates, monitors, and reconciles rather than assuming it performs acquiring, transmission, or settlement in every architecture. Acquirer, processor, issuer, gateway, and banking relationships are owned by Finance/Treasury; funds movement is never performed here — reconciliation and exception preparation only, coordinating with Perform Cash, Acquirer, and Receivables Reconciliations. Card-data security follows the fact-dependent PCI DSS scope statement and Security-defined controls stated at Loyalty and Cards Management (Marketing) (CM-1-3-6-6).\nIn scope: Monitoring of approved processor/acquirer transaction flows | reconciliation of transaction submissions and settlement files | exception identification, preparation, and routing | coordination of resolution with Treasury, processors, O2C, and Security | processing records\nOut of scope: Acquirer/processor/issuer/gateway/banking relationships (Treasury) | funds movement and settlement execution | interchange and scheme fee terms (Treasury; networks) | cash application (CM-1-3-8-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Processor/acquirer transaction and settlement files"
   },
   {
    "@language": "en",
    "@value": "Security-defined controls"
   },
   {
    "@language": "en",
    "@value": "approved processing arrangements (Treasury)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Reconciled daily transaction cycles with prepared, routed exceptions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Card acceptance operations monitored and reconciled accurately every day."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-15",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16405"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Operate the company's brand loyalty programs: administer member accounts and tiers, operate earn and redemption mechanics according to approved program rules, manage rewards fulfillment and partner benefits, and service member inquiries at program level."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review loyalty-liability distinction adopted verbatim (operational records here; accounting determinations with Finance); b21 privacy statement and b24 contactability consumption apply."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.15"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Brand Loyalty Programs"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Operation-versus-analysis boundary: program performance evaluation and member analytics are performed by Customer Program Analysis under the marketing analysis durable rule — this process operates and records; it does not evaluate effectiveness or redesign the program, and rule changes are approved through program governance before implementation. The program maintains operational earn, burn, expiration, adjustment, partner-benefit, and fulfillment records. Finance determines loyalty liability accounting, accrual method, breakage assumptions, financial reporting, and impairment/valuation treatment. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Program communications consume permissioned contactability data and never create consent. Manage Brand Loyalty Programs (CM-1-3-6-6-15) supplies authorized loyalty earn, redemption, expiration, adjustment, and fulfillment records that Customer Program Analysis (CM-1-3-5-5-3) consumes in its defined work.\nIn scope: Member account and tier administration | earn/redemption operation per approved rules | rewards fulfillment and partner benefit coordination under executed agreements | member servicing at program level | operational earn, burn, expiration, adjustment, partner-benefit, and fulfillment records for Finance and analysis\nOut of scope: Program design and rule approval (governance/planning) | performance evaluation (CM-1-3-5-5-3) | loyalty liability accounting, accrual method, breakage assumptions, financial reporting, and impairment/valuation treatment (Finance) | consent creation | partner contracting terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved program rules"
   },
   {
    "@language": "en",
    "@value": "executed partner agreements"
   },
   {
    "@language": "en",
    "@value": "member activity data"
   },
   {
    "@language": "en",
    "@value": "permissioned contactability data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Operating loyalty programs with complete member, earn/redemption, and fulfillment records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Loyalty programs run faithfully to approved rules with governed member data and complete records."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review billing-coordination wording adopted verbatim; preferred label 'Manage Card Program Billing Coordination' recorded as alt label and queued for the naming pass — the locked name 'Manage Invoicing' understates the coordination-only role and collides semantically with CM-1-3-8-1. Step 3d naming pass — scope-ambiguity Batch 1 (A+B+C, 2026-09-21): renamed from 'Manage Invoicing' to 'Manage Card Program Billing Coordination'. Prior label(s) retained as altLabel(s): 'Manage Invoicing'."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Invoicing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate card-program billing readiness and program-specific statement requirements; provide validated transaction, account, and presentation data to enterprise invoicing. Manage program-specific presentation such as consolidated statements and itemization, and resolve program-level invoice inquiries."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Card Program Billing Coordination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Boundary statement: invoice creation, taxability determination, distribution, corrections, reversals, and credit memos execute under Manage Customer Invoicing and Billing (CM-1-3-8-1) and its controls; this process supplies validated transaction, account, and presentation data and program statement requirements and never issues, corrects, or reverses invoices outside those controls. Receivables, cash application, collections, and payment execution remain with their O2C, Finance, and Treasury owners. Transaction completeness for each cycle is confirmed by Analyze, Report, and Confirm Card Transactions. Manage Card Program Billing Coordination (CM-1-3-6-6-2) supplies validated card transaction, account, presentation data, and statement requirements that Manage Customer Invoicing and Billing (CM-1-3-8-1) consumes in its defined work.\nIn scope: Billing-cycle readiness coordination | validated transaction, account, and presentation data to enterprise invoicing | program statement and itemization requirements | program-level inquiry resolution and routing\nOut of scope: Invoice creation, distribution, correction, reversal, credit memos (CM-1-3-8-1) | taxability (its owners) | cash application and A/R (CM-1-3-8-2) | collections and disputes (CM-1-3-8-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-12"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Confirmed transaction data (CM-1-3-6-6-7)"
   },
   {
    "@language": "en",
    "@value": "enterprise invoicing calendar (CM-1-3-8-1)"
   },
   {
    "@language": "en",
    "@value": "program billing terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Validated billing-cycle data and statement requirements delivered to enterprise invoicing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Accurate, complete card-program billing delivered through enterprise invoicing controls."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer reimbursements owed under the card program — such as to accepting sites and partners for card transactions or to customers for program credits — validating claims against program terms. Prepare, validate, and submit authorized reimbursement requests or settlement instructions; track status and reconcile program records."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review reimbursement wording adopted verbatim — prepares/validates/submits requests and reconciles records; the program never 'settles' or 'pays'; b14 payment-authority rule."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Reimbursement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Payment-authority rule: this process prepares, validates, and submits authorized instructions; it never moves funds, which remains with Finance/Treasury execution. Prepare, validate, and submit authorized reimbursement requests or settlement instructions; track status and reconcile program records. Customer credits that take invoice form execute through Manage Customer Invoicing and Billing controls. Claim disputes are resolved at program level against program terms; unresolved disputes escalate per the applicable agreements.\nIn scope: Claim receipt and validation against program terms | reimbursement calculation | preparation, validation, and submission of authorized reimbursement requests or settlement instructions | status tracking and reconciliation of program records\nOut of scope: Funds movement and payment execution (Finance/Treasury) | invoice and credit-memo issuance outside CM-1-3-8-1 controls | program term setting | partner agreement terms (contract management)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Claims"
   },
   {
    "@language": "en",
    "@value": "confirmed transaction data (CM-1-3-6-6-7)"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "program terms and executed agreements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Validated, submitted reimbursement requests with tracked status and reconciled program records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Valid program claims reimbursed accurately through authorized instruments."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review authentication/authorization/audit rule adopted verbatim. Normalized label 'Manage Card Administration' recorded as alt label and queued — parenthetical examples belong in the definition, not the label. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Manage Cards Administration (Order New Cards, Change Card Data)' to 'Manage Card Administration'. Prior label NOT retained as skos:altLabel per the migration-map-only disposition (generic-alias precedent): the old label would falsely narrow scope / is not a useful synonym; preserved as prior_name in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11074"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer card accounts day to day: process new-card orders, changes to card data such as vehicles, drivers, and purchase restrictions, renewals and replacements, and activations and blocks on customer instruction."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Card Administration"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Changes to card, driver, vehicle, contact, product restriction, and delivery data require authenticated instructions, authorization checks, audit logging, effective-dating, and applicable master-data synchronization. Changes to data held in governed master data are submitted through the owning master-data controls. Card-data security follows the fact-dependent PCI DSS scope statement and Security-defined controls stated at Loyalty and Cards Management (Marketing) (CM-1-3-6-6). When Manage Card Administration (CM-1-3-6-6-4) releases an authorized instruction requiring production of a new, replacement, or reissued card, it invokes Manage Card Production & Monthly Reissue (CM-1-3-6-6-13). Administrative changes that do not require card production do not trigger this handoff.\nIn scope: New-card order processing | card data changes on authenticated, authorized instruction with audit logging and effective-dating | renewals, replacements, activations, blocks | master-data synchronization through governed submission | administration records\nOut of scope: Credit and limit decisions (CM-1-3-7-4; Handle Card Limits within envelope) | physical production and logistics (CM-1-3-6-6-10/-13) | master-data writes outside governed submission | security control definition (Security)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Authenticated customer instructions"
   },
   {
    "@language": "en",
    "@value": "master-data controls (CM-1-3-7-1)"
   },
   {
    "@language": "en",
    "@value": "program rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurately administered card accounts and orders with complete audit records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Card accounts kept accurate and serviced on authenticated customer instruction."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Manage Cards Administration (Order New Cards, Change Card Data)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20930"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer card-level spending and product controls within a customer's approved credit envelope: set and adjust card, driver, or vehicle-level limits and purchase restrictions at customer request or per program rules."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review restriction-granularity sentence adopted verbatim; within-envelope rule — card-level limits never increase the credit envelope."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Handle Card Limits"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Credit boundary (b11 precedent): customer-level credit limits and risk codes are established by Establish Credit Limit & Risk Code and monitored by Monitor Credit Against Limit under Manage Credit & Risk. Card, driver, vehicle, product, transaction, merchant-category, geographic, time-of-day, and velocity restrictions may be administered here only within the approved customer credit envelope and program rules. Requests that would exceed the approved envelope route to Credit for decision; this process implements the outcome.\nIn scope: Card, driver, vehicle, product, transaction, merchant-category, geographic, time-of-day, and velocity restrictions within the approved envelope and program rules | limit-change processing on authenticated instruction | routing envelope-exceeding requests to Credit\nOut of scope: Customer credit limits and risk codes (CM-1-3-7-4) | credit monitoring | collections responses (CM-1-3-8-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved credit envelope and risk codes (CM-1-3-7-4)"
   },
   {
    "@language": "en",
    "@value": "authenticated customer requests"
   },
   {
    "@language": "en",
    "@value": "program rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Card-level limits and restrictions consistent with the approved credit envelope"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Granular card-level control for customers without breaching credit governance."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Finance valuation/write-off lock continued; review program-action list (block/suspend/hold/notify/refer/reinstate) adopted. Normalized label 'Manage Card Delinquency and Collections Referral' recorded as alt label and queued — the locked name 'Manage Bad Debt' misleadingly implies bad-debt accounting ownership. Step 3d naming pass — scope-ambiguity Batch 1 (A+B+C, 2026-09-21): renamed from 'Manage Bad Debt' to 'Manage Card Delinquency and Collections Referral'. Prior label(s) retained as altLabel(s): 'Manage Bad Debt'."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10761"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Bad Debt"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the card program's exposure to non-paying accounts at program level: monitor delinquency signals on card accounts, apply program-level servicing responses such as card blocking, transaction holds, and limit suspension, refer delinquent accounts to collections, and supply program data for bad-debt assessment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Card Delinquency and Collections Referral"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Boundary statement: bad-debt allowance, impairment, write-off decisions, and their financial treatment remain with Finance (Determine Bad Debt Allowance); collection strategy, disputed debt, and recovery operations remain with Manage Receivables Resolution. This process's authority is program-level servicing action — block, suspend, hold, notify, refer, and reinstate after resolution — and data supply; it never decides write-offs, sets allowances, or conducts collections. Manage Card Delinquency and Collections Referral (CM-1-3-6-6-6) is informed by the credit exposure signals of Monitor Credit Against Limit (CM-1-3-7-4-3). Manage Card Delinquency and Collections Referral (CM-1-3-6-6-6) supplies card-program delinquency, servicing-status, and collection-referral evidence that Determine Bad Debt Allowance (CM-1-3-8-3-3) consumes in its defined work.\nIn scope: Delinquency-signal monitoring on card accounts | program-level blocks, holds, and suspensions per policy | referral to collections with complete account data | program data for bad-debt assessment | reinstatement servicing after resolution\nOut of scope: Bad-debt allowance, impairment, write-offs, and financial treatment (Finance; CM-1-3-8-3) | collection strategy and recovery operations (CM-1-3-8-3) | credit limit decisions (CM-1-3-7-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Delinquency and payment data"
   },
   {
    "@language": "en",
    "@value": "credit monitoring outputs (CM-1-3-7-4)"
   },
   {
    "@language": "en",
    "@value": "program policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Contained exposure with referred accounts and complete referral records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Program credit exposure contained through timely servicing action and clean referral."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). b21/b23 measurement-framework rule applied — evidence-layer metrics, candidate KPIs only via the KPI Store. Normalized label 'Analyze and Confirm Card Transactions' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Perform Transaction Analysis Reporting & Confirmation' to 'Analyze, Report, and Confirm Card Transactions'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11783"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Analyze and Confirm Card Transactions"
   },
   {
    "@language": "en",
    "@value": "Perform Transaction Analysis Reporting & Confirmation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze, report, and confirm card transaction activity: validate captured transactions for completeness and accuracy against expected patterns and program terms, confirm transaction sets for billing cycles, and produce transaction reports for customers and internal stakeholders."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Analyze, Report, and Confirm Card Transactions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Measurement qualifier: metrics produced here are evidence-layer transaction measures; any nomination toward enterprise KPIs routes through the KPI Store per the enterprise measurement framework — this process approves and publishes no KPIs. Anomalies suggesting fraud route to Manage Fraudulent Transactions; confirmed transaction sets feed billing coordination and reimbursement.\nIn scope: Transaction validation and completeness confirmation | billing-cycle transaction confirmation | customer and internal transaction reporting | anomaly identification and routing\nOut of scope: Fraud investigation (CM-1-3-6-6-11; Security) | invoicing execution (CM-1-3-8-1) | KPI approval or publication (enterprise measurement governance) | pricing analysis"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-14"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Captured transaction data"
   },
   {
    "@language": "en",
    "@value": "expected-pattern baselines"
   },
   {
    "@language": "en",
    "@value": "program terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Confirmed transaction sets and transaction reports"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Transaction completeness and accuracy assured as the evidence base for billing, reimbursement, and fraud response."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11047"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pci-dss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Ensure physical and digital card designs comply with applicable requirements: card scheme and network specifications where applicable, enterprise brand standards, and Security-defined technical and card-media specifications."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review design-compliance distinction adopted verbatim; b26 obtains-never-grants brand-rights pattern applied."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Ensure Card Design Compliance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This process applies standards; it sets none. Brand standards are governed by Brand Standards Management (CM-1-3-6-7); card scheme specifications are external constraints from the applicable networks; security features and card-media requirements are defined by Security. Design compliance includes visual brand use, scheme/card-media requirements, and Security-defined technical requirements. It does not approve product claims, customer communications, price display, or physical production. Use of brand assets in card designs operates under the enterprise brand governance framework — rights are obtained through it, never granted by this process.\nIn scope: Design compliance review against scheme, brand, and Security-defined technical requirements | compliance sign-off before production release | specification-change monitoring and design updates\nOut of scope: Brand standards setting (CM-1-3-6-7) | scheme rule-making (networks) | security specification setting (Security) | product claims, customer communications, and price display approval | physical production (CM-1-3-6-6-13)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand standards (CM-1-3-6-7)"
   },
   {
    "@language": "en",
    "@value": "Security requirements"
   },
   {
    "@language": "en",
    "@value": "proposed designs"
   },
   {
    "@language": "en",
    "@value": "scheme specifications"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-13"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Compliance-verified card designs released for production"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Only compliant card designs released into production."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-9",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 29 (2026-09-20). Review secure-inventory terminology adopted verbatim; explicit disambiguation from petroleum 'stock'. Normalized label 'Plan Card Stock Consumption and Monitor Inventory' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Analyze Consumption Planning & Monitor Stock' to 'Plan Card Stock Consumption and Monitor Inventory'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20685"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Analyze Consumption Planning & Monitor Stock"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Plan consumption of card issuance materials and monitor their inventory. Manage inventory of blank cards, secure card media, carriers, mailers, and issuance materials according to Security-defined inventory and custody controls. Keep production and issuance runs continuously supplied without excess or insecure holdings."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.6.9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Plan Card Stock Consumption and Monitor Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "'Stock' here means card media and issuance materials — blank cards, secure card media, carriers, mailers — not petroleum inventory; secure-inventory terminology used to avoid collision with hydrocarbon stock concepts elsewhere in the taxonomy. Consumption forecasts are operating forecasts of material usage, not commitments; replenishment purchasing executes through procurement and its contracts. Card media are held under the Security-defined inventory and custody controls.\nIn scope: Consumption analysis and card-media forecasting | inventory monitoring and replenishment triggering through procurement | card-media reconciliation | Security-defined inventory and custody control compliance\nOut of scope: Purchasing and vendor contracting (Procurement) | production scheduling (CM-1-3-6-6-13) | security requirement setting (Security) | petroleum/product inventory management"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Issuance and reissue volumes (CM-1-3-6-6-13)"
   },
   {
    "@language": "en",
    "@value": "Security custody controls"
   },
   {
    "@language": "en",
    "@value": "card-media inventory records"
   },
   {
    "@language": "en",
    "@value": "production schedules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Card-media plans and replenishment triggers keeping issuance supplied"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Card issuance continuously supplied under secure custody, without excess or shortage."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 30 (2026-09-20). Review conformance wording adopted verbatim — 'defines, applies, monitors, and coordinates conformance' replaces 'enforces'; technical-standards exclusion and imaging/investment operating-model statements adopted verbatim; b26 standards-vs-rights and b28 licensed-brand rules inherited. Normalized label 'Brand Standards Management' recorded as alt label and queued for the naming pass. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Brand Standard Management' to 'Brand Standards Management'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20682"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Brand Standard Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of governing brand standards across the branded network: defining and maintaining the standards that govern brand presentation and customer experience at branded sites and channels, verifying conformance through inspection programs, and managing the brand imaging of sites and assets to those standards."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Brand Standards Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Standards-versus-rights boundary: brand assets — trademarks, trade dress, visual identity — are owned, registered, and legally protected under Manage Licensing & IP and the enterprise brand governance framework; this process defines, applies, monitors, and coordinates conformance to usage and presentation standards, makes no legal determinations, and grants no rights. Standards may cover visual identity, trade dress, site appearance, forecourt/store experience, signage principles, digital brand use, uniforms, collateral, partner use, and approved customer-experience manifestations. They do not establish safety, engineering, metrology, pricing, product-quality, regulatory-labeling, or legal requirements unless those requirements are incorporated by reference from their accountable owners. For licensed brands, the provider's standards are external constraints received through Manage Relationship with License Brand Providers and applied per the executed license agreements. Where standards conflict or appear ambiguous, the process escalates interpretation to the licensor and Legal; it does not certify provider-standard compliance or modify provider standards. Conformance follow-through against franchisees and dealers operates through the relationship processes and their agreements. Fact-dependent statement: where a remedy would affect a franchise relationship governed by the Petroleum Marketing Practices Act, the determination is reserved to Legal. Brand imaging plans may identify capital, maintenance, signage, reimage, equipment, digital-display, and site-work requirements. Investment authorities approve funding; Engineering/site operations/EHS execute physical work; Procurement contracts suppliers; Brand Standards verifies conformance. Downstream consumers of these standards include Ensure Card Design Compliance and marketing execution. When the card-design check applies enterprise brand usage or presentation standards, Brand Standards Management (CM-1-3-6-7) maintains published enterprise brand presentation and usage standards within which Ensure Card Design Compliance (CM-1-3-6-6-8) operates; the recipient retains its other decisions and authorities.\nIn scope: Define, maintain, and publish brand standards with change control | brand inspection programs | brand imaging governance | conformance monitoring and corrective-action coordination | conformance reporting to relationship owners\nOut of scope: IP ownership, registration, legal protection, and rights enforcement (CM-1-3-4-4; Legal) | licensed-brand provider standards setting (providers; CM-1-3-6-1-2) | enforcement remedies under agreements (relationship management; Legal) | safety, engineering, metrology, pricing, product-quality, and regulatory-labeling requirements (their accountable owners) | site capital investment approval (investment authorities, b24) | advertising claim approval (b24 controls)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand governance framework and IP guidance (CM-1-3-4-4)"
   },
   {
    "@language": "en",
    "@value": "inspection findings"
   },
   {
    "@language": "en",
    "@value": "license agreements and provider standards"
   },
   {
    "@language": "en",
    "@value": "network and site data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed brand standards with verified network conformance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Consistent, protected brand presentation across the branded network."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 30 (2026-09-20). Review inspection-authority caveat and does-not-do list adopted verbatim; standards governance is continuous with periodic inspection cycles within it. Normalized label 'Manage Brand Standards and Inspections' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Manage Brand Standards and Perform Inspection' to 'Manage Brand Standards and Inspections'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10530"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Brand Standards and Perform Inspection"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define, maintain, and publish the brand standards that govern brand presentation and customer experience at branded sites and channels, and verify conformance through inspection programs: plan and conduct inspections where authorized, document findings, agree and track corrective-action plans with the accountable relationship owners, and escalate unresolved or material issues."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.7.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Brand Standards and Inspections"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Standards change through governed change control, with Legal/IP review where standards touch protected marks. Inspection access, scope, records access, site-entry rules, and corrective-action requirements must follow the applicable agreement, operating authority, security rules, and safety requirements. Inspections produce findings and corrective-action coordination; remedies under franchise, dealer, and license agreements route through the relationship processes. Fact-dependent statement: where a remedy would affect a franchise relationship governed by the Petroleum Marketing Practices Act, the determination is reserved to Legal. Inspection evidence feeds Report Franchise Performance. Licensed-brand providers' own inspections of their standards are the provider's right under the license agreements; this process coordinates and consumes their outcomes. Where standards conflict or appear ambiguous, the process escalates interpretation to the licensor and Legal; it does not certify provider-standard compliance or modify provider standards. Manage Brand Standards and Inspections (CM-1-3-6-7-1) supplies brand inspection findings, conformance results, and corrective-action status that Report Franchise Performance (CM-1-3-6-1-3) consumes in its defined work.\nIn scope: Standards definition, maintenance, publication, and change control | inspection planning and conduct where authorized | findings documentation | corrective-action plans agreed and tracked with relationship owners | escalation of unresolved or material issues | conformance reporting\nOut of scope: Statutory or legal notices, material-breach determinations, termination or nonrenewal, financial penalties, and litigation/arbitration (relationship management; Legal) | overriding operating or EHS authority | provider standards certification | imaging execution (CM-1-3-6-7-2) | training delivery (CM-1-3-6-1-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand governance framework"
   },
   {
    "@language": "en",
    "@value": "license agreements and operating authorities"
   },
   {
    "@language": "en",
    "@value": "prior findings"
   },
   {
    "@language": "en",
    "@value": "site/network data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Published standards and inspection findings with agreed, tracked corrective actions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Standards that are current, published, and verifiably met across the network."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the brand imaging of sites and assets to approved brand standards: receive standards and network/site pipeline inputs, define and review imaging scope and specifications, coordinate business-case and supplier activity, verify approved work against brand standards, and record conformance and defects."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 30 (2026-09-20). Review imaging lifecycle and boundary list adopted verbatim — coordinates and verifies brand conformance; investment, engineering, EHS, procurement, and physical work remain with their owners."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.7.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Brand Imaging"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Brand imaging plans may identify capital, maintenance, signage, reimage, equipment, digital-display, and site-work requirements. Investment authorities approve funding; Engineering/site operations/EHS execute physical work; Procurement contracts suppliers; Brand Standards verifies conformance. This process does not own physical work, capital authorization, permit applications, site shutdowns, safety planning, engineering design, or construction acceptance beyond brand-conformance verification. Trademark and trade-dress usage in imaging operates under the enterprise brand governance framework.\nIn scope: Imaging and reimaging program planning and coordination | imaging scope and specifications | business-case and supplier activity coordination within procurement contracts | brand-conformance verification of approved work at new, converted, and reimaged sites | conformance and defect records\nOut of scope: Capital and funding approval (investment authorities, b24) | physical site works, permits, shutdowns, safety planning, engineering design, and construction acceptance (Engineering; site operations; EHS) | supplier contracting terms (Procurement) | standards definition (CM-1-3-6-7-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-7-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Brand standards (CM-1-3-6-7-1)"
   },
   {
    "@language": "en",
    "@value": "imaging specifications"
   },
   {
    "@language": "en",
    "@value": "network plans and site pipeline"
   },
   {
    "@language": "en",
    "@value": "procurement contracts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Sites imaged and verified to brand standard with conformance and defect records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every branded site imaged and verified to brand standard, on program."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 30 (2026-09-20). Review canonical definition, narrow-scope statement, and agreement-rights conditions adopted verbatim — commercial-agreement compliance only, never an enterprise compliance catch-all. Preferred label 'Commercial Agreement Compliance Management' recorded as alt label and queued as the priority rename: it encodes the approved narrow scope. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Compliance Management' to 'Commercial Agreement Compliance Management'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17467"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Compliance Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage compliance with commercial obligations in branded sales-network agreements by planning and conducting agreement-based reviews, validating reported sales and other obligation inputs, reporting discrepancies, and routing findings to the accountable relationship, Finance, O2C, Legal, and compliance owners for resolution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Commercial Agreement Compliance Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Narrow-scope statement: Applies only to contractual/commercial obligations that partners, franchisees, dealers, licensees, marketers, or other network participants report under executed agreements — for example sales-based royalties, brand fees, rebates, promotional-fund contributions, volume commitments, reporting duties, and agreed standards evidence where audit rights exist. Reviews cover only obligations that are defined in an executed agreement, subject to review/audit rights, within a valid review period, and supported by agreed record-access rights. Enterprise regulatory compliance (fuels, environmental, safety, trade), corporate Internal Audit, financial-statement audit, and tax audit remain with their accountable functions. Findings route to their owners: financial adjustments and collections through the accountable Finance/O2C processes, including Administer Royalty, Brand Fee, and Contribution Streams; enforcement under agreements through relationship management and Legal. Fact-dependent statement: where a remedy would affect a franchise relationship governed by the Petroleum Marketing Practices Act, the determination is reserved to Legal.\nIn scope: Agreement-based compliance review planning within audit rights and review periods | validation of reported sales and other obligation inputs | discrepancy reporting | findings routing to accountable relationship, Finance, O2C, Legal, and compliance owners | compliance status reporting\nOut of scope: Regulatory compliance programs (EHS, fuels, trade — their functions) | Internal Audit, financial-statement audit, and tax audit | collections and financial adjustment execution (Finance/O2C) | enforcement remedies (relationship management; Legal) | obligations outside executed agreements or valid review periods"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Executed agreements, audit rights, and review periods"
   },
   {
    "@language": "en",
    "@value": "reported sales and obligations data"
   },
   {
    "@language": "en",
    "@value": "royalty/fee/rebate bases"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Validated commercial compliance with routed findings"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Commercial obligations across the network verifiably reported and settled on an accurate basis."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-8-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 30 (2026-09-20). Review canonical commercial-audit definition, Internal Audit distinction, corrective-verification wording, and confidentiality rule adopted verbatim. Preferred label 'Conduct Commercial Audit to Validate Reported Sales' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 1 (A+B+C, 2026-09-21): renamed from 'Conduct Audit To Validate Reported Sales' to 'Conduct Commercial Audit to Validate Reported Sales'. Prior label(s) retained as altLabel(s): 'Conduct Audit To Validate Reported Sales'."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10194"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Conduct Audit To Validate Reported Sales"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Conduct agreement-based commercial reviews of sales reported by franchisees, dealers, licensees, marketers, and partners; examine supporting records within contractual audit rights; quantify discrepancies affecting contract-based fees, royalties, rebates, contributions, or commitments; and route findings for financial, relationship, legal, or corrective resolution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.6.8.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Conduct Commercial Audit to Validate Reported Sales"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Audit rights and records access are exercised only as the executed agreements provide, within valid review periods. This is an agreement-rights commercial audit, not Internal Audit: it exercises specific rights under partner, franchise, and license agreements to validate the inputs to royalties, fees, rebates, and contract obligations, and routes discrepancies to Finance/O2C, relationship management, and Legal. Independent enterprise assurance under an audit charter, control-effectiveness assessment, and Audit Committee reporting remain with Internal Audit. Verify evidence of agreed corrective actions or corrected reporting, while Finance/O2C, Relationship Management, and Legal own financial adjustment, collection, remedy, and legal action. Sales and supporting records obtained during the review are commercially sensitive and must be accessed, retained, shared, and disposed of only in accordance with the agreement, confidentiality terms, legal holds, records-retention requirements, privacy obligations where applicable, and delegated audit protocols. Fact-dependent statement: where a remedy would affect a franchise relationship governed by the Petroleum Marketing Practices Act, the determination is reserved to Legal. Distinct from Report Franchise Performance, which reports operational performance: this process validates the accuracy of reported sales and reported obligation bases under the agreement's audit rights — a partner can perform well while reporting inaccurately, or report accurately while performing poorly.\nIn scope: Audit program planning within agreement rights and review periods | examination of reported sales against supporting records | discrepancy quantification for contract-based fees, royalties, rebates, contributions, and commitments | findings reports routed for financial, relationship, legal, or corrective resolution | verification of evidence of agreed corrective actions or corrected reporting\nOut of scope: Financial adjustment, collection, remedy, and legal action (Finance/O2C; relationship management; Legal) | accounting determinations (CM-1-3-8-4) | Internal Audit and statutory audit | records access beyond agreement rights"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Executed agreements, audit rights, and review periods"
   },
   {
    "@language": "en",
    "@value": "reported sales data"
   },
   {
    "@language": "en",
    "@value": "royalty/fee bases (CM-1-3-8-4-7)"
   },
   {
    "@language": "en",
    "@value": "supporting records per agreement access rights"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Audit findings with quantified discrepancies routed for resolution"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Royalties, fees, rebates, and contributions computed from validated reported sales."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Order Management is the end-to-end process that addresses all aspects of collecting cash - from initial order receipt & credit authorization to collections & revenue assurance activities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Order Management"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Capability per the heterogeneous-concurrent-control test; review cross-functional operating-model statement adopted verbatim and responsible_domain set cross-functional (b26 precedent); canonical Governed Submission and Stewardship Rule adopted verbatim as a durable decision. OPEN TAXONOMY ISSUE (logged, no PTC): the locked taxonomy lacks a dedicated 'Maintain Location and Site Master Data' child although the L4 name lists Location — location/site stewardship carried at capability level pending taxonomy normalization. Preferred label 'Manage Commercial Master Data Stewardship' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Manage Master Data (Customer, Price, Product, Tax, Location)' to 'Manage Commercial Master Data Stewardship'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/14208"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Master Data (Customer, Price, Product, Tax, Location)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that stewards the governed commercial master data on which sales, pricing, fulfillment, billing, and service transactions depend — customer, price and discount, product and service, tax, and location/site records, together with the workflow configurations and commercial policy content that control how they change — maintaining each domain as validated, effective-dated, auditable records through concurrent stewardship processes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Responsible domain detail: Cross-functional (Commercial & Marketing / Data Governance / Sales / Pricing / Product / Tax / Finance / Legal / Credit / Compliance / Operations / Security / IT)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Commercial Master Data Stewardship"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Governed Submission and Stewardship Rule: accountable business processes decide the business content of a governed record — such as a price, rebate term, credit status, tax position, product definition, policy, workflow authority, or customer qualification outcome. Master-data stewardship validates submission completeness and authority, applies only approved changes through controlled workflows, effective-dates and versions the record, preserves lineage and audit evidence, monitors quality, and distributes the governed record to consumers. Submitting processes do not write directly to governed master data. Master-data processes do not create, alter, waive, or self-authorize the business decision encoded in the record. This capability is cross-functional. Commercial, Sales, Pricing, Product, Tax, Finance, Legal, Credit, Compliance, Operations, Data Governance, Security, and IT own different business decisions, controls, systems, and policies represented in commercial master data. The master-data stewardship capability governs controlled application, effective dating, quality, lineage, access, and distribution of approved records; taxonomy placement does not assign a single organizational owner. Location/site master stewardship is in scope at the capability level pending taxonomy normalization. It includes governed commercial location references needed for transactions — terminal, depot, rack, station, customer site, ship-to, delivery point, airport, port, route/service point, and related location-role mappings — applied from authorized submissions under location/governance controls. The capability operates within the enterprise data governance framework and Security-defined access controls. Customer personal data is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Manage Commercial Master Data Stewardship (CM-1-3-7-1) maintains validated, effective-dated commercial account, price, product, tax, and terms records that Manage Customer Invoicing and Billing (CM-1-3-8-1) needs to operate its defined process path.\nIn scope: Customer, price/discount, product and service, tax, and location/site master data stewardship | governed change validation and application | data quality monitoring and remediation | effective-dating, versioning, lineage, and audit trails | workflow configuration and commercial policy content administration | access-controlled distribution to consuming processes\nOut of scope: The business decisions records encode (pricing, credit, KYC, tax positions, product definitions, policy approvals — their accountable processes) | direct writes by submitting processes | data platform/tooling ownership (IT) | enterprise data governance framework setting (Data Governance) | consent creation (consent/preference framework owner)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Security access controls"
   },
   {
    "@language": "en",
    "@value": "Validated submissions from accountable processes"
   },
   {
    "@language": "en",
    "@value": "delegations of authority and approved workflows"
   },
   {
    "@language": "en",
    "@value": "enterprise data governance standards"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed commercial master data consumed reliably by sales, fulfillment, billing, and service processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every commercial transaction computed from governed, current, auditable records."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Cross-functional"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-4-3-3"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Review Party/Customer Account/role wording adopted verbatim — never collapses Sold-To, Bill-To, Payer, Ship-To, Loading-Authorized Party, dealer, distributor, or marketer meanings; strengthened consent separation adopted verbatim. Preferred label 'Maintain Customer and Commercial Account Master Data' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Maintain Customer Master Data' to 'Maintain Customer and Commercial Account Master Data'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10252"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Maintain Customer Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain governed Party, Customer Account, account-role, hierarchy, address/location-reference, contact, commercial attribute, and relationship records as defined by the approved customer domain model. A customer master record may represent a party, account, role, relationship, or system-specific record according to the governed model; it must not collapse Sold-To, Bill-To, Payer, Ship-To, Loading-Authorized Party, dealer, distributor, or marketer meanings. Create, validate, update, deduplicate, and retire these records on authorized submissions, keeping them accurate, unique within the governed model, and consumable by sales, fulfillment, billing, credit, and service processes."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Customer and Commercial Account Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Who decides: commercial qualification, credit standing, and KYC outcomes are decided by their owning processes (prospect onboarding coordination, Manage Credit & Risk, Perform KYC Due Diligence); this process records and maintains the governed result and never grants status. Record creation is requested through governed submission (the Set Up Prospect rule, owner's side). Customer personal data is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Contact details, communication preferences, suppression indicators, and consent/lawful-basis records may be linked to commercial master data where authorized, but the existence of an email, phone number, address, account relationship, or contactability attribute never creates marketing permission. The consent/preference framework remains separately governed. Maintain Customer and Commercial Account Master Data (CM-1-3-7-1-1) maintains maintained authorized customer, payer, bill-to, account-role, and address records that Manage Customer Invoicing and Billing (CM-1-3-8-1) needs to operate its defined process path.\nIn scope: Party, account, role, hierarchy, and relationship record creation on authorized request | validation, enrichment, deduplication within the governed customer domain model | change application with audit trails | quality monitoring and remediation | controlled retirement/closure recording per Perform Credit-Driven Customer Closure and Reinstatement decisions\nOut of scope: Credit, KYC, and qualification decisions (their owners) | consent creation or consent/preference framework ownership | customer relationship management | customer domain model definition (Data Governance) | privacy framework setting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Authorized creation/change requests"
   },
   {
    "@language": "en",
    "@value": "KYC and credit outcomes"
   },
   {
    "@language": "en",
    "@value": "approved customer domain model"
   },
   {
    "@language": "en",
    "@value": "data quality standards"
   },
   {
    "@language": "en",
    "@value": "privacy framework"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurate, governed party/account/role records with complete audit trails"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Accurate, governed party and account records, distinct by role, consumable everywhere needed."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10252"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain governed price and discount records: validate and apply authorized price, discount, and rebate-condition submissions with correct effective-dating, maintain price structures and condition records, and assure the completeness, consistency, and auditability of the pricing data consumed by quoting, ordering, and billing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Owner's side of the b28/b29 submission rules; review validation-completeness sentence adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Price & Discount Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Receiving end of locked submission rules: Implement sales price and Implement Rebate submit validated, approved changes to this process — it validates authorization and content, applies with effective-dating, and returns confirmation; submitters never write directly, and this process never determines a price, discount, or rebate (Sales Pricing Management, pricing governance, and Rebate Management own those decisions under their approvals). Master-data validation must confirm source decision, approver, effective dates, eligibility scope, legal/commercial constraints, data completeness, and conflict with existing price/discount/rebate conditions before publication. Discrepancies between a submission and its approval route back to the submitting process — never resolved by master-data edit (the no-self-exception rule, owner's side).\nIn scope: Validation of source decision, approver, effective dates, eligibility scope, legal/commercial constraints, completeness, and condition conflicts before publication | effective-dated application | price structure and condition record maintenance | consistency and completeness assurance | audit trails and submission confirmations\nOut of scope: Price, discount, and rebate determination (CM-1-3-6-3, CM-1-3-3-2, CM-1-3-6-4) | direct writes by any process | price deployment to displays (b24 POS exclusion) | invoicing (CM-1-3-8-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Validated submissions (Implement sales price; Implement Rebate)"
   },
   {
    "@language": "en",
    "@value": "approval references and delegations"
   },
   {
    "@language": "en",
    "@value": "pricing structures"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed price and discount records with verified authorization lineage"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every price and condition consumed downstream is the approved one, effective-dated and provable."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Review specification distinction adopted verbatim — catalog representation here, authoritative technical/quality/regulatory sources with their owners (material for fuels, additives, lubricants, and regulated products). Preferred label 'Maintain Product and Service Master Data' recorded as alt label and queued — scope includes services. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Maintain Product Master Data' to 'Maintain Product and Service Master Data'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10252"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Maintain Product Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain governed product and service master records: create and update records, attributes, units of measure, classifications, and hierarchies on authorized submissions from the accountable product owners, keeping the catalog accurate and consumable by pricing, ordering, fulfillment, and billing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Product and Service Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Product master data maintains the approved commercial/product catalog representation, including identifiers, product hierarchy, UoM, commercial attributes, tax/handling classifications, lifecycle status, and approved specification references. The authoritative technical specification, quality, regulatory, formulation, and manufacturing sources remain with their accountable owners. Who decides: product and service definitions, specifications, formulations, and lifecycle decisions (introduce, change, discontinue) belong to the accountable product management and innovation processes; this process records the decided catalog content with effective-dating and never defines, approves, or discontinues an offer. Maintain Product and Service Master Data (CM-1-3-7-1-3) maintains the approved product/service catalog, identifiers, classifications, and units that Capture & Validate Order (CM-1-3-7-3-1) needs to operate its defined process path.\nIn scope: Product and service record creation and maintenance on authorized submission | identifiers, hierarchy, UoM, commercial attributes, tax/handling classifications | effective-dated lifecycle status recording | approved specification references | quality monitoring and remediation | audit trails\nOut of scope: Product/service definition, specification, and lifecycle decisions (product management/innovation) | authoritative technical specification, quality, regulatory, formulation, and manufacturing sources (their owners) | pricing (CM-1-3-7-1-2) | inventory (supply chain)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Authorized product/service submissions from accountable owners"
   },
   {
    "@language": "en",
    "@value": "approved specification references"
   },
   {
    "@language": "en",
    "@value": "classification standards"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed product and service master records consumed by commercial processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "An accurate governed catalog behind every quote, order, and invoice."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10929"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain governed tax master records as directed by the accountable tax owners, with effective-dating aligned to legal effectivity, so that taxability determination and tax calculation in transactions consume current, authorized tax data."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Review tax-content sentence adopted verbatim; APQC 'Maintain tax master data' (score 1.0) supports the maintenance reading."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Tax Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Tax master data may include tax jurisdiction, tax code, product tax class, exemption treatment reference, rate version, effective date, filing/registration attributes where authorized, and certificate references. It does not determine legal taxability, interpret law, validate a customer's legal entitlement beyond Tax-owned controls, or make tax remittance/accounting decisions. Who decides: tax positions, taxability determinations, interpretations, and responses to law changes are made by the accountable Tax function and the Determine Taxability processes; this process maintains the records that encode those determinations. Statutory rate and rule changes are applied on the Tax function's direction; exemption certificates are recorded and tracked per Tax's validation.\nIn scope: Tax jurisdiction, code, product tax class, exemption treatment reference, rate version, and certificate reference maintenance on Tax direction | filing/registration attributes where authorized | effective-dating aligned to legal effectivity | certificate expiry tracking | audit trails | quality monitoring\nOut of scope: Tax positions, determinations, interpretations, and legal-entitlement validation beyond Tax-owned controls (Tax function; Determine Taxability) | tax remittance and accounting decisions (CM-1-3-8-4; Finance) | tax policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Tax function directions"
   },
   {
    "@language": "en",
    "@value": "exemption certificates"
   },
   {
    "@language": "en",
    "@value": "statutory changes as interpreted by Tax"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed tax master records with legal-effectivity-aligned dating"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every transaction taxed from current, authorized tax records."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Review technical-controls distinction adopted verbatim — business configuration here, platform controls with IT (low-code/ERP/CRM ambiguity resolved). Preferred label 'Maintain Commercial Workflow Configuration' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Maintain Workflows' to 'Maintain Commercial Workflow Configuration'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20950"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Maintain Workflows"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain the governed workflow configurations that control commercial transactions and master-data changes — approval chains, routing rules, thresholds, and escalation paths — keeping them aligned with approved delegations of authority and process designs, tested, versioned, and auditable."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Commercial Workflow Configuration"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Workflow configurations implement approved delegations of authority and process designs; they never create authority. A workflow that routes an approval differently from the approved delegation is a defect to correct, not a decision to make — changes to authority itself are approved through the delegation governance owners before any configuration change. The process owns business configuration requirements and validation of workflow behavior against approved authorities. IT owns platform administration, application security, code/configuration deployment controls, integration operation, monitoring, recovery, and technical change management.\nIn scope: Business configuration requirements and workflow-behavior validation against approved authorities | threshold, routing, and escalation rule administration | configuration testing and version control | periodic reconciliation of configurations against approved delegations | audit trails\nOut of scope: Delegation of authority approval (DoA governance owners) | process design approval (accountable process owners) | platform administration, application security, deployment controls, integration operation, monitoring, recovery, and technical change management (IT / Process Excellence) | the approvals the workflows route (their accountable processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved delegations of authority"
   },
   {
    "@language": "en",
    "@value": "approved process designs"
   },
   {
    "@language": "en",
    "@value": "change requests from accountable owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Tested, versioned workflow configurations faithful to approved authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every approval routed exactly as the approved authority prescribes."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 31 (2026-09-20). Review controlled-document distinction adopted verbatim — reference content and parameters here, enterprise policy-document authority with governance/document-management owners. Preferred label 'Maintain Commercial Policy Content and Parameters' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Maintain Commercial Policies' to 'Maintain Commercial Policy Content and Approved Parameters'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10771"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Maintain Commercial Policies"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain commercial policy content and system-consumable policy parameters as governed reference content. Formal policy approval, legal review, corporate publication, retention schedule, and enterprise document-management controls remain with the accountable governance and document-management owners. Administer, publish, version, and distribute the commercial policy content and parameters that transactions and workflows reference — terms frameworks, condition catalogs, policy parameters — keeping the published version identical to the approved one."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.1.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Commercial Policy Content and Approved Parameters"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Who decides: policy approval authority remains with the accountable governance owners — commercial leadership, Finance, Legal, and the applicable delegations; this process administers and publishes approved policy content and never approves, amends, or waives a policy. Policy parameters consumed by systems are maintained on the owners' approved direction with effective-dating; waivers and exceptions are decisions of the policy owners under the delegations of authority, recorded — not granted — here. Formal enterprise policy documents remain under the accountable governance and document-management controls; this process holds the commercial reference content and system-consumable parameters, not enterprise document-management authority.\nIn scope: Commercial policy content administration, publication, versioning, distribution | system-consumable policy parameter maintenance on approved direction | effective-dating | retirement of superseded versions | audit trails\nOut of scope: Policy approval, amendment, waiver, and exception decisions (governance owners; delegations of authority) | legal review (Legal) | corporate publication, retention schedules, and enterprise document-management controls (their owners) | the commercial decisions policies govern"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved policies and parameters from governance owners"
   },
   {
    "@language": "en",
    "@value": "change directions"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Published, versioned commercial policy content and parameters identical to approved content"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The policy content everyone consumes is exactly the content that was approved."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Capability per the heterogeneous-concurrent-control test; review Contract Management (batch 09) distinction adopted verbatim; 'Pricing' in the locked name is a misnomer — pricing authority is deliberately elsewhere. Preferred label 'Manage Commercial Terms, Quoting, and Customer Commercial Services' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Manage Pricing & Contracting (Manage Quote & Sale)' to 'Manage Commercial Terms, Quoting, and Customer Commercial Services'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20593"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Pricing & Contracting (Manage Quote & Sale)"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that turns approved prices, policies, and credit decisions into governed customer commercial arrangements: establishing commercial terms and customer-facing frameworks, issuing quotes and renewals, planning and monitoring commercial revenue, defining offered financing and payment methods, analyzing customer profitability, and operating the customer self-service portal — concurrent commercial controls in O2C operations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Commercial Terms, Quoting, and Customer Commercial Services"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This capability operationalizes decisions made elsewhere and decides none of them: prices are determined under Sales Pricing Management and pricing governance; policies are approved by their governance owners and consumed from governed policy content; credit terms and exposure are Credit's; payment instruments and banking arrangements are Treasury's; legal terms are Legal's. This capability establishes O2C commercial terms and customer-facing commercial frameworks. Enterprise/trading contract lifecycle administration, legal document control, counterparty-contract records, novation, termination, and master-agreement administration remain with Contract Management and Legal where applicable. Its rows are the operational counterparts of the sales-motion rows in Sales Execution: Establish Commercial Terms & Contracts sets up the durable terms framework within which Manage Contract & Order transacts deal-by-deal, and Issue Quotes & Renewals formally issues and lifecycle-manages what Develop Quote composes. All records flow through the Governed Submission and Stewardship Rule — terms, conditions, and methods take effect only as governed master data and policy content. When the customer order uses commercial arrangements administered within the source capability, Manage Commercial Terms, Quoting, and Customer Commercial Services (CM-1-3-7-2) supplies governed customer terms, approved quote outcomes, and applicable commercial-arrangement records that Capture And Manage Order Fulfillment (CM-1-3-7-3) consumes in its defined work.\nIn scope: Commercial terms and customer-facing framework establishment | quote issuance and renewal management | commercial revenue planning and monitoring | definition of offered financing and payment methods within approved instruments | customer profitability analysis | customer portal channel operation\nOut of scope: Price and discount determination (CM-1-3-6-3; CM-1-3-3-2) | credit decisions (CM-1-3-7-4) | payment instruments and banking arrangements (Treasury) | enterprise/trading contract lifecycle, legal document control, and counterparty-contract records (Contract Management; Legal) | order capture and fulfillment (CM-1-3-7-3) | invoicing (CM-1-3-8-1) | targets and quotas (their owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed price/policy/customer master data"
   },
   {
    "@language": "en",
    "@value": "Treasury-approved instruments"
   },
   {
    "@language": "en",
    "@value": "credit decisions and terms"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed commercial arrangements — terms, quotes, plans, methods, portal services — consumed by order-to-cash execution"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every customer relationship transacts on governed, current, approved commercial arrangements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10290"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish the durable commercial arrangements under which customers transact: negotiate and establish master agreements, terms frameworks, and customer-specific commercial terms within approved policies and delegations, coordinate legal review and execution, and have executed terms recorded into governed systems so downstream transactions apply them automatically."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review framework-vs-deal split confirmed (Establish here; Manage Contract & Order transacts within it); Legal/Contract Management/Master Data role split adopted verbatim; commercial-vs-legal lifecycle wording adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Establish Commercial Terms & Contracts"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The process coordinates commercial negotiation and approved customer-specific term setup. Legal drafts/reviews legal terms and manages signature formalities; Contract Management maintains legal contract records where applicable; Master Data/Policy content maintains system-consumable terms and conditions. Operates within the approved commercial policy content, pricing governance outputs, Credit-approved terms, and delegations of authority; terms outside approved frameworks require approval through the accountable governance owners before commitment. Deal-level contract and order handling within an established framework belongs to Manage Contract & Order (Sales Execution); rebate arrangements formalize here per the batch 29 routing. This capability establishes O2C commercial terms and customer-facing commercial frameworks. Enterprise/trading contract lifecycle administration, legal document control, counterparty-contract records, novation, termination, and master-agreement administration remain with Contract Management and Legal where applicable. Executed terms are submitted to governed master data and policy content under the Governed Submission and Stewardship Rule — never applied informally. Establish Commercial Terms & Contracts (CM-1-3-7-2-1) supplies executed commercial terms, quote conditions, and contract renewal provisions that Issue Quotes & Renewals (CM-1-3-7-2-2) consumes in its defined work.\nIn scope: Master agreement and terms-framework negotiation within approved policies | customer-specific terms establishment | legal review and execution coordination | submission of executed terms to governed systems | coordinate commercial lifecycle changes, expiry/renewal review, and authorized amendments; Legal and Contract Management execute legal/document lifecycle actions\nOut of scope: Policy approval (governance owners) | price determination (CM-1-3-6-3) | legal drafting, review standards, signature formalities, and legal contract records (Legal; Contract Management) | deal-level contracting and orders (CM-1-3-6-2-5) | credit terms decisions (CM-1-3-7-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved policy content and pricing outputs"
   },
   {
    "@language": "en",
    "@value": "Legal and Contract Management support"
   },
   {
    "@language": "en",
    "@value": "credit decisions"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Executed commercial terms and frameworks recorded in governed systems"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Durable customer arrangements that downstream transactions apply without renegotiation."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20098"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Formally issue customer quotes and manage renewals through governed systems: produce quotes from approved prices, established terms, and the approved quote content requirements; manage validity periods, revisions, and versioning; and run contract-anchored renewal cycles so expiring arrangements are re-quoted and re-executed on time."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review quote-status wording adopted verbatim, replacing the absolute non-binding phrasing — binding/non-binding treatment is determined by the applicable legal, contract, and commercial framework (b28 rule qualified, not weakened); develop-vs-issue split confirmed."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Issue Quotes & Renewals"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Quotes are issued with their approved legal status, validity period, conditions, disclaimers, and binding/non-binding treatment as determined by the applicable legal, contract, and commercial framework. A quote does not create a binding commitment unless the applicable approval, acceptance, and contract/order controls establish one. Quotes price exclusively from governed price and discount master data and established terms — never from ad-hoc values (no-self-exception). Quote composition for a specific opportunity is Develop Quote's (Sales Execution); this process issues the controlled document and owns its lifecycle evidence. Renewals follow the contract's renewal terms; changed terms route through Establish Commercial Terms & Contracts. For each customer quote or renewal version whose composition is owned by Develop Quote (CM-1-3-6-2-4), that version is developed and receives the required authorization before Issue Quotes & Renewals (CM-1-3-7-2-2) issues it to the customer. Preparatory issuance activities may proceed in parallel; revised versions repeat the applicable development and authorization steps.\nIn scope: Quote production from governed prices and terms per approved content requirements | approved legal status, validity, conditions, and disclaimers applied per the legal/contract framework | revision and version management | renewal cycle management against contract terms | quote and renewal lifecycle records\nOut of scope: Quote content composition in the sales motion (CM-1-3-6-2-4) | price determination (CM-1-3-6-3) | terms changes (CM-1-3-7-2-1) | contract execution and binding-status determination (Legal; delegations; contract/order controls) | order capture (CM-1-3-7-3-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed price/discount data"
   },
   {
    "@language": "en",
    "@value": "approved quote content requirements"
   },
   {
    "@language": "en",
    "@value": "contract renewal schedules"
   },
   {
    "@language": "en",
    "@value": "established terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Issued quotes and completed renewals with full version and status records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every issued quote and renewal is current, governed, and carries its approved legal status."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review calculation statement and variance-routing sentence adopted verbatim under the b27 forecast/target/plan glossary. Review requested relations 'informs: Sales Planning' and 'informs: Pricing Strategy Management' — 'informs' is not in the relationship vocabulary (b10/b23 precedent): recorded here verbatim; nearest-vocabulary relations applied instead and receiving rows are already approved, so no informed-by could be added there. Preferred label 'Develop and Monitor Commercial Revenue Plan' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Develop & Monitor Revenue Plan' to 'Develop and Monitor Commercial Revenue Plan'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16501"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Develop & Monitor Revenue Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Develop the commercial revenue plan — the monetized operating outlook of the agreed sales plan by customer, channel, product, and period — and monitor actual revenue against it, analyzing deviations and routing findings to the accountable owners according to cause."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop and Monitor Commercial Revenue Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The plan uses approved sales plans, governed demand forecasts as inputs, commercial terms, price architecture, planned volume/mix, discount/rebate assumptions, and Finance-approved revenue-recognition assumptions where relevant. It does not establish the enterprise forecast, target/quota, statutory revenue forecast, financial budget, accounting revenue, or revenue-recognition policy. The forecast-versus-targets rule applies: a commercial revenue plan is neither a forecast (the unbiased expectation, owned by the forecasting processes), nor a target or quota (leadership's performance commitments), nor the financial budget (Finance's); it is the monetized operating plan used for monitoring and corrective conversation. Variance findings are routed to Sales Planning, Pricing, Offer, Channel, Supply, Finance, and other accountable owners according to cause; this process does not make price, target, forecast, supply, or accounting corrections. It is not a source of official financial reporting. Metrics produced are evidence-layer; candidate KPIs route via the KPI Store. Develop and Monitor Commercial Revenue Plan (CM-1-3-7-2-3) provides the revenue plan and deviation analysis that inform Analyze Customer Profitability (CM-1-3-7-2-5).\nIn scope: Commercial revenue plan development from approved sales plans, governed demand forecasts, terms, price architecture, volume/mix, and discount/rebate assumptions | periodic re-planning | actuals monitoring against plan | deviation analysis and cause-based routing to accountable owners\nOut of scope: Enterprise demand forecasting (forecasting processes) | targets and quotas (leadership) | financial budgeting, accounting revenue, and revenue-recognition policy (Finance; CM-1-3-8-2-6) | price, target, forecast, supply, and accounting corrections (their owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved sales plans and governed demand forecasts"
   },
   {
    "@language": "en",
    "@value": "Finance revenue actuals (Perform Revenue Accounting)"
   },
   {
    "@language": "en",
    "@value": "Finance-approved revenue-recognition assumptions where relevant"
   },
   {
    "@language": "en",
    "@value": "governed price, discount, and rebate data (CM-1-3-7-1-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Current commercial revenue plan with monitored deviations routed for action"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A monetized operating plan the business can steer commercial revenue against."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19521"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define the approved financing options, payment methods, payment-term menus, eligibility conditions, and customer-facing commercial rules that may be offered within Treasury-approved instruments, Credit-approved exposure rules, Tax/Legal requirements, and delegated authorities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review commercial-offering definition, method inclusion list, exclusion list, and customer-specific credit distinction adopted verbatim; b14 payment-authority and b29 card-program boundaries inherited."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Financing & Payment Methods"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Methods considered where applicable include invoice/bank transfer, ACH/direct debit, card, fleet/fuel-card billing, prepayment, deposit, credit terms, financing programs, electronic payment, cash where relevant, currency and cross-border constraints where applicable, and surcharges, discounts, fees, incentives, or payment-method conditions subject to law and policy. This process does not open bank accounts, select acquirers, manage merchant IDs, execute payment, extend credit, determine legal tax treatment, create financial products, or override card/network rules. A customer's eligibility for a method may depend on approved credit status, risk profile, contract, geography, tax, channel, and product rules; this process defines the menu and conditions, while Credit decides customer-specific exposure and terms. Defined methods take effect only as governed policy content and master data under the Governed Submission and Stewardship Rule; card acceptance operates under the Treasury/acquirer arrangements and card-program rules. Define Financing & Payment Methods (CM-1-3-7-2-4) defines the financing options and payment terms offered within the credit standards and terms-eligibility rules set by Maintain Credit Policies (CM-1-3-7-4-1). Define Financing & Payment Methods (CM-1-3-7-2-4) supplies the approved payment/financing menu and eligibility conditions recorded through governed content that Establish Commercial Terms & Contracts (CM-1-3-7-2-1) consumes in its defined work.\nIn scope: Definition of offered payment methods, financing options, payment-term menus, eligibility conditions, and customer-facing commercial rules | coordination of Treasury, Credit, Legal, and Tax review | submission of defined methods to governed policy content and master data | periodic review of method availability, performance, and cost\nOut of scope: Bank accounts, acquirer selection, merchant IDs, and banking arrangements (Treasury) | customer-specific credit exposure and terms (CM-1-3-7-4) | payment execution and funds movement | legal tax treatment (Tax) | financial product creation | card/network rules (schemes; Treasury)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Credit-approved eligibility and exposure rules"
   },
   {
    "@language": "en",
    "@value": "Legal/Tax review requirements"
   },
   {
    "@language": "en",
    "@value": "Treasury-approved instruments and arrangements"
   },
   {
    "@language": "en",
    "@value": "commercial requirements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed payment and financing method definitions consumed by contracting, quoting, and billing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A governed, approved menu of payment and financing methods customers can actually be offered."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10176"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze the profitability of customers, accounts, channels, and segments: apply Finance-approved costing and allocation methods to revenue, cost-to-serve, terms, rebate, and credit data to produce profitability views and insights that inform pricing strategy, terms decisions, credit reviews, and account management."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review method/assumption statement and confidentiality/competition-law classification statement adopted verbatim; consumes Assess Cost-to-Serve Performance per review; b21 analysis rule and KPI Store boundary inherited."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Analyze Customer Profitability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Profitability analysis must use Finance-approved revenue, cost, allocation, discount, rebate, credit-loss, service, channel, and cost-to-serve methods. Results should state attribution assumptions, allocation basis, exclusions, data-quality limitations, and confidence. They are commercial decision support, not financial reporting, transfer pricing, tax valuation, or customer-credit decisions. Customer profitability outputs are classified and distributed according to commercial-confidentiality, privacy, competition-law, and access-control requirements. Analysis may identify patterns but does not authorize differential treatment, pricing, credit, terms, or customer action. The analysis-and-inform durable rule applies: insights inform the accountable owners, who decide. Cost-to-serve calculations are consumed from Assess Cost-to-Serve Performance, not recreated here. Metrics produced are evidence-layer; candidate KPIs route only via the KPI Store. Customer personal data is governed under the enterprise personal-data governance framework. Analyze Customer Profitability (CM-1-3-7-2-5) provides customer/account profitability views, allocation assumptions, and margin insights to inform Analyze Pricing Performance (CM-1-3-3-2-3); the recipient retains its own decisions.\nIn scope: Profitability analysis by customer, account, channel, segment using Finance-approved methods | consumption of approved cost-to-serve results | terms and rebate impact analysis | stated assumptions, allocation basis, exclusions, and confidence in all results | classified, access-controlled insight delivery to accountable owners\nOut of scope: Pricing, terms, credit, and customer-action decisions (their owners) | costing method and allocation definition (Finance) | cost-to-serve calculation (CM-1-2-6-1-3) | financial reporting, transfer pricing, and tax valuation (Finance; Tax) | KPI approval/publication"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance revenue and margin actuals"
   },
   {
    "@language": "en",
    "@value": "Finance-approved costing and allocation methods"
   },
   {
    "@language": "en",
    "@value": "cost-to-serve results (CM-1-2-6-1-3)"
   },
   {
    "@language": "en",
    "@value": "terms, rebate, and credit data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Classified profitability analyses and insights informing accountable owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Decision-makers see which customers and terms actually make money, and why — with stated assumptions."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20085"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Operate the customer self-service portal as a governed commercial channel: manage portal content and functions, coordinate customer access and business entitlements through Security-defined services, and route every portal transaction and inquiry into its accountable process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 32 (2026-09-20). Review identity/access wording, portal-transaction validity rule (the O2C no-self-exception equivalent), service-case routing boundary, and communications sentence adopted verbatim; b28 no-shadow-service-desk rule inherited."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.2.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Customer Portal"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Channel-not-process rule: the portal presents governed data and routes transactions — prices from governed price master data, invoices and statements from Manage Customer Invoicing and Billing, orders into Capture & Validate Order, account changes through governed master-data submission — and is never an alternate path around any control. A portal transaction is valid only after the receiving process has completed its own validation, pricing, credit, compliance, terms, order, tax, and workflow controls. Portal submission is a channel entry point, not transaction approval. Coordinate customer-facing portal access and business entitlements through Security-defined identity, authentication, authorization, and access-control services. The portal process administers approved business-role/access requests and routes changes to the accountable identity, customer-master, credit, contract, and consent processes. Portal-submitted requests, complaints, disputes, or inquiries are captured and routed to the corresponding customer-request, billing, collections, credit, order, service, or technical-support process. The portal does not resolve them merely by displaying status. The portal may present service notices, transaction notices, and preference-management links under applicable rules; marketing communications require the separate consent/contactability framework. Platform administration, application security, deployment, integration operation, monitoring, and recovery are IT's (the batch 31 technical-controls distinction).\nIn scope: Portal content and function management | administration of approved business-role/access requests through Security-defined identity and access-control services | transaction and inquiry capture and routing to accountable processes | portal service quality monitoring | channel feedback to owning processes\nOut of scope: The transactions themselves and their approval (owning processes) | identity, authentication, authorization, and access-control standards and services (Security) | platform administration and technical operations (IT) | consent creation (consent/contactability framework) | request and dispute resolution (CM-1-3-7-5; billing, collections, credit, order, service owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed master data and documents from owning processes"
   },
   {
    "@language": "en",
    "@value": "IT platform services"
   },
   {
    "@language": "en",
    "@value": "Security identity and access-control services"
   },
   {
    "@language": "en",
    "@value": "consent framework"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "An operating portal channel with all transactions and inquiries routed through governed processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Customers self-serve safely against governed data, with every action landing in the accountable process."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of managing customer orders through their commercial lifecycle: capturing and validating orders against governed controls, allocating and releasing them per approved rules, coordinating fulfillment through the accountable physical operations, handling changes, cancellations, and returns, and tracking the order book through to completed, evidenced fulfillment ready for invoicing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review wording adopted verbatim: governed commercial order lifecycle and commercial fulfillment coordination; the order/fulfillment/inventory/custody/title/billing/payment status distinction; and the commercial-exception model. Evidence is received, linked, validated, and retained — never created — by O2C."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture And Manage Order Fulfillment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Commercial/physical split: this process owns the governed commercial order lifecycle and commercial fulfillment coordination; scheduling and dispatch, terminal loading, transport, delivery, and custody transfer belong to the accountable supply chain, terminal, and logistics processes — fulfillment coordinates with them and never directs equipment, drivers, or terminal operations. Custody-transfer quantities and documents (bills of lading, delivery tickets, meter records) are measurement evidence produced by the physical processes; the order processes receive, link, validate for commercial completeness, and retain fulfillment evidence supplied by physical processes as the fulfillment record and the invoicing basis, and never restate measured quantities. Order status, fulfillment status, inventory status, custody status, title-transfer status, billing status, and payment status are distinct states. This process coordinates the commercial order and fulfillment record; physical operators establish custody/measurement evidence, contract terms determine title/risk transfer, invoicing consumes billable fulfillment evidence, and payment processes establish financial settlement. Commercial exceptions include substitution, partial fulfillment, shortage, non-delivery, backorder, hold, cancellation, return, quality exception, and delivery discrepancy. The process applies approved commercial rules and routes physical/quality/safety decisions to their owners. All validation applies governed master data, credit, tax, and terms controls under the no-self-exception rule. Capture And Manage Order Fulfillment (CM-1-3-7-3) applies the credit controls — credit limits, holds and release rules — maintained by Manage Credit & Risk (CM-1-3-7-4) when it validates and releases orders. When the contractually billable fulfillment event and required evidence are available, Capture And Manage Order Fulfillment (CM-1-3-7-3) supplies confirmed, linked fulfillment evidence and completed commercial order records that Manage Customer Invoicing and Billing (CM-1-3-8-1) consumes in its defined work.\nIn scope: Order capture and validation | allocation and release per approved rules | commercial fulfillment coordination and exception management | change, cancellation, and return authorization handling | order tracking and the operational order-book forecast | fulfillment evidence receipt, linkage, validation, and retention for billing\nOut of scope: Physical scheduling, dispatch, loading, transport, delivery, and custody transfer (supply chain/terminal/logistics processes) | measurement and quantity determination (measurement processes) | price, credit, tax, and terms decisions (their owners) | invoicing (CM-1-3-8-1) | allocation policy setting (commercial/supply leadership) | inventory ownership (supply chain)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed customer, product, price, tax master data"
   },
   {
    "@language": "en",
    "@value": "approved allocation rules"
   },
   {
    "@language": "en",
    "@value": "credit decisions"
   },
   {
    "@language": "en",
    "@value": "fulfillment evidence from physical operations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Completed, evidenced fulfillments ready for invoicing, with a governed order record end to end"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every order flows from capture to evidenced fulfillment under governed controls, ready to bill."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Capture customer orders from all approved channels — portal, EDI, phone, direct entry — and validate each against governed controls: resolve the correct party and account roles, confirm product, price, terms, and tax from governed master data, apply credit checks, verify loading and delivery authorizations, and accept, hold, or reject the order accordingly."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review Party/Account/Role resolution sentence, applicable-eligibility-controls sentence, and duplicate-detection control adopted verbatim; b31 Party model and b32 portal rule receiving end."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture & Validate Order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Order validation applies the governed controls; it never waives, overrides, or substitutes any of them (no-self-exception at order level). The order process resolves applicable Party, Customer Account, account-role, location, contractual, and authorization relationships according to the approved customer-domain model. It does not collapse a location into a party role or treat one legal entity as automatically authorized for every commercial or physical action. Applies all applicable contract, product, channel, location, tax, credit, compliance, authorization, and operational eligibility controls for the transaction type. Detects duplicate, repeated, superseded, or conflicting submissions according to channel/order controls before accepting a valid order. A portal or EDI submission becomes a valid order only when this validation completes (the batch 32 portal-transaction rule's receiving end). Credit checks apply Credit's rules via Monitor Credit Against Limit; a credit hold is Credit's rule firing and its release is Credit's decision. Prices, terms, and tax resolve exclusively from governed master data; an order that cannot resolve them fails validation and routes for correction.\nIn scope: Multi-channel order capture with duplicate and conflict detection | party/account role resolution per the governed customer-domain model | product, price, terms, tax validation from governed data | credit check application and hold routing | loading/delivery and operational eligibility verification for the transaction type | accept/hold/reject with reasons and audit trail\nOut of scope: Credit decisions and hold releases (CM-1-3-7-4) | price/terms/tax determination (their owners) | master data correction (governed submission) | allocation (CM-1-3-7-3-2) | customer-domain model definition (Data Governance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Channel submissions"
   },
   {
    "@language": "en",
    "@value": "authorization records"
   },
   {
    "@language": "en",
    "@value": "credit rules and statuses"
   },
   {
    "@language": "en",
    "@value": "governed master data and customer-domain model"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Validated orders accepted into allocation, with holds and rejects routed with reasons"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Only valid, authorized, creditworthy orders enter the fulfillment pipeline."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20081"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Allocate available product and supply capacity to validated orders and release allocated orders to the physical scheduling and fulfillment processes. Apply approved allocation rules, including contractual commitments, approved priority classes, fairness rules, regulatory/safety obligations, and authorized shortage/disruption procedures."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Horizon set event-driven per review, with the daily/intraday cycle statement recorded verbatim; review allocation-rule wording (regulatory/safety obligations and authorized shortage/disruption procedures replace an absolute contract-first ordering), release-condition rule, and customer-communication sentence adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Allocate & Release Order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Allocation rules are applied, not made: allocation policies, including shortage and disruption procedures, are approved by the accountable commercial and supply leadership under their own approvals, with Legal review where allocation touches contractual or regulatory obligations; this process applies the approved rules, documents allocation decisions, and escalates conflicts it cannot resolve within them. Allocation and release operate in daily/intraday operating cycles and may be re-run on supply, credit, order, contract, or disruption events. Release requires the applicable validation, allocation, credit, compliance, product-availability, authorization, and operational-readiness conditions to be satisfied. Where a condition is not met, the order remains held, partially released, substituted, or escalated under approved rules. Communicates hold, allocation, partial-release, substitution, or release status through the appropriate customer/service channel under approved communication rules. Release hands the order to the accountable scheduling/logistics processes — it does not schedule trucks, terminals, or deliveries.\nIn scope: Allocation of supply and capacity to validated orders per approved rules, including regulatory/safety obligations and authorized shortage/disruption procedures | release on satisfied conditions, with hold, partial release, substitution, or escalation under approved rules otherwise | allocation documentation and conflict escalation | reallocation on supply, credit, order, contract, or disruption events | status communication through approved channels\nOut of scope: Allocation policy setting (commercial/supply leadership; Legal review) | physical scheduling and dispatch (logistics) | supply planning and inventory ownership (supply chain) | credit release decisions (CM-1-3-7-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Validated orders"
   },
   {
    "@language": "en",
    "@value": "approved allocation rules and shortage/disruption procedures"
   },
   {
    "@language": "en",
    "@value": "credit/compliance statuses"
   },
   {
    "@language": "en",
    "@value": "supply and capacity availability from supply chain"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Allocated, released orders in the physical fulfillment pipeline with documented allocation decisions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Available supply goes to the right orders, by the approved rules, provably."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review history-preservation rule adopted verbatim. Normalized label 'Change or Cancel Order' recorded as alt label and queued. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Change / Cancel Order' to 'Change or Cancel Order'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Change / Cancel Order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Process authenticated order change and cancellation requests: validate the request against the order's status and the applicable cutoff rules, re-run affected validations (price, credit, allocation, tax) for changes, apply approved change and cancellation fees per policy, and propagate the outcome to allocation, fulfillment, billing, and the customer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Change or Cancel Order"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Physical-status constraints govern feasibility: an order in loading or transit follows the physical processes' cutoff and return rules — this process never overrides a physical status. Changes re-validate through the same governed controls as capture (no-self-exception); repricing on change follows the applicable terms and governed price data. Fees apply per approved policy; waivers are decisions of the policy owners under the delegations of authority, recorded here. Change and cancellation handling preserves original order, revision, effective timestamp, approval, fee, allocation, credit, tax, and fulfillment evidence. It does not delete history. Cancellations after fulfillment route to returns authorization or billing correction, not deletion.\nIn scope: Authenticated change/cancel request processing | cutoff and status validation | re-validation of affected controls | approved fee application | propagation to allocation, fulfillment, billing, and the customer | complete preserved change history\nOut of scope: Overriding physical status or logistics cutoffs (physical processes) | fee policy and waiver decisions (policy owners; DoA) | returns execution (CM-1-3-7-3-6) | invoicing corrections (CM-1-3-8-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Authenticated requests"
   },
   {
    "@language": "en",
    "@value": "cutoff rules"
   },
   {
    "@language": "en",
    "@value": "fee policies"
   },
   {
    "@language": "en",
    "@value": "order and physical status"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Correctly changed or cancelled orders with complete preserved history and propagation"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Order changes happen only when valid, priced right, fully propagated, and fully evidenced."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-api-mpms-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Coordinate released orders through physical fulfillment to evidenced completion: hand orders to the accountable scheduling and logistics processes, monitor fulfillment progress, manage commercial exceptions — shortages, substitutions, partial deliveries — per approved rules, receive, link, validate for commercial completeness, and retain fulfillment evidence supplied by physical processes, and confirm completed fulfillments to billing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review evidence wording adopted verbatim — received, linked, validated for commercial completeness, retained; never created or restated. API MPMS retained as contextual measurement/custody evidence only, with the review's qualifying note: the governing contract, operating procedure, applicable standard, and legal/regulatory regime determine transaction-specific evidence and quantity basis."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Fulfillment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Coordination, not execution: scheduling, dispatch, terminal loading, transport, delivery, and custody transfer are executed by the accountable supply chain, terminal, and logistics processes; this process monitors and coordinates commercially and never directs equipment, drivers, or terminal operations. Custody-transfer evidence is produced under the applicable measurement, terminal, and logistics controls. API MPMS provides industry measurement context; the governing contract, operating procedure, applicable standard, and legal/regulatory regime determine the transaction-specific evidence and quantity basis. This process consumes that evidence as the fulfillment record and invoicing basis and never restates measured quantities. Commercial exceptions include substitution, partial fulfillment, shortage, non-delivery, backorder, hold, cancellation, return, quality exception, and delivery discrepancy. The process applies approved commercial rules and routes physical/quality/safety decisions to their owners. It coordinates customer-facing fulfillment-status communication through the appropriate commercial or service channels.\nIn scope: Fulfillment handoff and monitoring | commercial exception management per approved rules with routing of physical/quality/safety decisions to their owners | receipt, linkage, commercial-completeness validation, and retention of fulfillment evidence (BOL, delivery tickets, meter records) | completion confirmation to billing | coordination of customer-facing status communication through commercial/service channels\nOut of scope: Physical execution and custody transfer (supply chain/terminal/logistics) | measurement and quantity determination (measurement processes under applicable standards) | invoicing (CM-1-3-8-1) | exception rules setting (their owners) | service resolution (CM-1-3-7-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Released orders"
   },
   {
    "@language": "en",
    "@value": "approved exception rules"
   },
   {
    "@language": "en",
    "@value": "custody-transfer evidence"
   },
   {
    "@language": "en",
    "@value": "fulfillment status from physical processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Confirmed fulfillments with validated, linked evidence handed to invoicing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every released order reaches evidenced completion, with billing-grade evidence, or a managed exception."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review non-committal signal statement and event-refresh sentence adopted verbatim under the b27/b32 forecast/target/plan glossary. Normalized label 'Track Orders and Forecast Order Book' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Track & Forecast Order' to 'Track Order Book and Forecast Order Volumes'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10332"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Track & Forecast Order"
   },
   {
    "@language": "en",
    "@value": "Track Orders and Forecast Order Book"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Track the order book end to end — status, aging, exceptions, and completion across all open orders — and maintain the rolling short-horizon operational forecast of expected order volumes and timing that scheduling and supply processes plan against."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Track Order Book and Forecast Order Volumes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The operational order-book forecast is a short-horizon operational signal, not a supply commitment or forecast override; it does not automatically alter the enterprise demand forecast or approved allocation/replenishment decisions. Refreshes daily and on material order, supply, credit, allocation, fulfillment, or disruption events. It is none of the b27 glossary's other concepts: not the enterprise demand forecast (forecasting processes), not a target or quota (leadership), not the commercial revenue plan (CM-1-3-7-2-3). It may feed supply planning, terminal/rack planning, transportation scheduling, inventory awareness, and customer status communication. Order-status data is the governed record from the order processes; customer-facing presentation flows through the portal and service channels. Metrics produced are evidence-layer; candidate KPIs route via the KPI Store. Track Order Book and Forecast Order Volumes (CM-1-3-7-3-5) supplies governed customer order-status and completion records that Manage Customer Portal (CM-1-3-7-2-6) consumes in its defined work.\nIn scope: Order-book tracking, aging, and exception surfacing | daily operational order forecast, refreshed also on material order, supply, credit, allocation, fulfillment, or disruption events | status data provision to portal and service channels | evidence-layer order metrics\nOut of scope: Enterprise demand forecasting, targets, and revenue planning (their owners) | supply commitments and allocation/replenishment decisions (their owners) | order status changes (owning order processes) | customer service resolution (CM-1-3-7-5) | KPI approval/publication"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Order and fulfillment status data"
   },
   {
    "@language": "en",
    "@value": "historical order patterns"
   },
   {
    "@language": "en",
    "@value": "supply calendars"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "A current order book and operational forecast consumed by scheduling and supply"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Operations always know what's in the pipeline and what's coming — without the signal becoming a commitment."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 33 (2026-09-20). Review authorization-and-coordination wording and return-category taxonomy adopted verbatim; FMCSA retained as transport-safety context only per review. Preferred label 'Manage Commercial Returns Authorization and Coordination' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Manage Returns' to 'Manage Commercial Returns Authorization and Coordination'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-fmcsa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Returns"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage commercial return authorization and coordination; it does not determine product disposition, direct hazardous-product transport, issue a credit memo, or authorize a refund. Validate return requests against policy and the original order, coordinate authorized physical return through the accountable logistics and quality processes, route product disposition to its owners, and hand financial credit to the billing controls."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.3.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Commercial Returns Authorization and Coordination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Downstream return taxonomy: bulk fuel/product returns are exceptional — off-spec, contamination, delivery error, tank-integrity concern, custody/quality dispute, or safety/EHS incident — with disposition (return to stock, downgrade, reprocess, dispose) a Quality/EHS/Operations determination; packaged lubricants/consumables return per commercial policy with warehouse/logistics and quality; damaged/defective and misdelivery/wrong-product recovery combine quality, logistics, and commercial coordination; containers, totes, cylinders, and similar assets follow the asset/container processes; cancellation before dispatch is Change or Cancel Order's; billing adjustment without physical return is the invoicing/credit-memo/dispute processes'. Return transport of hazardous product follows the applicable transport safety regulations and company procedures (FMCSA cited as transport-safety context only — PHMSA/HMR, state, maritime/rail, and site rules may also apply). Financial credit flows exclusively through Manage Customer Invoicing and Billing controls; the payment-authority rule applies to any refund instruction. Root causes feed quality and order-process improvement.\nIn scope: Return request validation against policy and original order | commercial return authorization | coordination of authorized physical return with logistics and quality owners | disposition routing to Quality/EHS/Operations owners | credit handoff to billing controls | return records and root-cause routing\nOut of scope: Product disposition decisions (Quality/EHS/Operations) | physical return transport execution (logistics; applicable transport regulations) | container/asset recovery processes (their owners) | credit memo issuance (CM-1-3-8-1) | refund execution (Finance; payment-authority rule) | return policy setting (policy owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Return requests"
   },
   {
    "@language": "en",
    "@value": "original order and fulfillment evidence"
   },
   {
    "@language": "en",
    "@value": "quality/EHS determinations"
   },
   {
    "@language": "en",
    "@value": "return policies"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Completed authorized returns with correct disposition routing and credited outcomes through governed controls"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every return is authorized, safely handled by its owners, dispositioned correctly, and credited through governed controls."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11211"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that owns customer credit and counterparty risk in commercial operations: maintaining credit policies that encode the approved risk appetite, establishing customer credit limits and risk codes, monitoring exposure against limits continuously, analyzing portfolio credit risk, deciding credit-driven closure and reinstatement of commercial eligibility, and executing KYC due diligence — the decision home for every credit control the commercial processes apply."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Capability per the heterogeneous-concurrent-control test; review credit authority rule adopted verbatim, replacing the absolute 'nowhere else' wording with the delegated-governance model; accountability-layer framing and trading-counterparty distinction adopted verbatim; responsible_domain set cross-functional per review (b26/b31 precedent)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Responsible domain detail: Cross-functional — Commercial Operations / Credit / Finance / Compliance / Legal"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Credit & Risk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Credit authority rule: enterprise credit-risk appetite, reserve/impairment methodology, and bad-debt accounting are owned by Finance and designated governance bodies. Credit policies translate approved appetite into decision criteria. Customer credit limits, risk codes, terms eligibility, security requirements, holds, releases, and credit-driven closure/reinstatement are decided by the authorized Credit process under those policies and delegations. Commercial, order, card, terms, payment-method, and fulfillment processes apply those decisions and never waive, override, or substitute them. Exceptions follow the approved delegation and escalation path. Accountability layers: Finance owns enterprise risk appetite, reserves, impairment, and bad-debt accounting; Credit and its delegated governance own credit policy substance, limits, holds/releases, and security requirements; Commercial O2C and Master Data own customer-data and commercial application; Compliance and Legal own the KYC/sanctions/AML frameworks and legal determinations, with designated KYC/Compliance operations executing; O2C Collections, Finance, and Legal own financial collections and disputes as applicable. Taxonomy placement does not assign a single functional owner. This capability covers O2C commercial customer credit; trading counterparty credit risk for trading positions remains with the counterparty credit-risk processes (the batch 11 cluster). KYC and sanctions screening execute the Compliance/Legal-owned frameworks and determine nothing themselves. Decisions take effect through governed master data submission. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. When the order or fulfillment action is subject to an applicable customer-credit control, Manage Credit & Risk (CM-1-3-7-4) maintains approved customer credit policies, exposure limits, hold/release rules, and credit decisions within which Capture And Manage Order Fulfillment (CM-1-3-7-3) operates; the recipient retains its other decisions and authorities.\nIn scope: Credit policy maintenance within approved appetite | customer limit and risk-code decisions under delegated authority | continuous exposure monitoring, holds, and releases | portfolio credit-risk analysis | credit-driven closure and reinstatement of commercial eligibility | KYC due diligence and sanctions-screening execution\nOut of scope: Enterprise risk appetite, reserves, impairment, and bad-debt accounting (Finance; designated governance) | trading counterparty credit risk (the counterparty credit-risk processes) | collections and dispute management (CM-1-3-8-3) | sanctions/AML framework ownership and match adjudication (Compliance; Legal) | the commercial transactions credit controls gate (their processes) | payment execution"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance-approved risk appetite"
   },
   {
    "@language": "en",
    "@value": "KYC outcomes"
   },
   {
    "@language": "en",
    "@value": "customer financial and payment data"
   },
   {
    "@language": "en",
    "@value": "exposure data from orders, fulfillment, cards, and AR"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed credit decisions consumed by every commercial process that extends or services credit"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Commercial growth extended only within known, approved, monitored credit risk."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Cross-functional"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10789"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-reg-b-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain the credit policies that govern customer credit: encode the Finance-approved risk appetite into credit standards, terms eligibility rules, security requirements, hold/release rules, and delegation thresholds; keep policies current with experience and conditions; and publish them through governed policy content for consistent application."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review policy-document distinction adopted verbatim, protecting the b31 policy-content rule."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Credit Policies"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Policies encode an appetite decided above: enterprise credit risk appetite is Finance's, and policy changes are approved through the credit governance owners (credit committee, Finance, delegations of authority) — this process drafts, maintains, and operationalizes, and its changes take effect only after that approval. Credit Policy owns substantive credit criteria and business rules; Maintain Commercial Policy Content and Approved Parameters administers controlled publication and system-consumable policy content. Neither process changes Finance-approved risk appetite without the required governance approval. Fact-dependent legal obligations affecting credit policy (including U.S. ECOA/Regulation B where applicable) are determined by Legal/Compliance and incorporated as they direct. Maintain Credit Policies (CM-1-3-7-4-1) keeps credit policies current informed by the portfolio findings of Analyze Portfolio Credit Risk (CM-1-3-7-4-4).\nIn scope: Credit policy drafting and maintenance within approved appetite | credit standards, terms eligibility, security requirements, hold/release rules, delegation thresholds | policy performance review and revision proposals | publication through governed policy content | incorporation of Legal/Compliance-directed requirements\nOut of scope: Risk appetite setting and policy approval (Finance; credit governance; DoA) | customer-level decisions (CM-1-3-7-4-2) | policy content platform stewardship (CM-1-3-7-1-6) | legal determinations (Legal/Compliance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance-approved risk appetite"
   },
   {
    "@language": "en",
    "@value": "Legal/Compliance directions"
   },
   {
    "@language": "en",
    "@value": "loss experience"
   },
   {
    "@language": "en",
    "@value": "portfolio analysis findings"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Current, approved, published credit policies"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One current, approved credit rulebook every credit decision runs on."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20709"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-reg-b-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Decide customer-level credit: assess creditworthiness from KYC outcomes, financial statements, bureau data, payment history, parent support and credit-support instruments, and industry, geography, product, and channel risk; establish credit limits, risk codes, terms eligibility, and required security (guarantees, letters of credit, prepayment, deposits) per policy and the delegations of authority; and record decisions to governed master data with effective dates and review schedules."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review evidence hierarchy and mandatory-criteria rule adopted verbatim — a favorable financial assessment cannot override a Compliance/Legal restriction; fact-dependent ECOA/Regulation B statement retained with SRC-REG-B-001 registered for traceability per review."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Establish Credit Limit & Risk Code"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Decisions apply policy — a limit outside policy or threshold requires approval through the credit governance owners before commitment. A customer may be approved only after all mandatory eligibility, KYC, sanctions, compliance, and credit criteria have been satisfied. A favorable financial assessment cannot override a Compliance/Legal restriction. Limits and risk codes attach at the level the governed customer-domain model defines and aggregate per the approved Party/Account/credit-group hierarchy — never assigned to a collapsed 'customer'. Fact-dependent statement: where U.S. credit is extended, including commercial credit, the Equal Credit Opportunity Act and Regulation B may impose nondiscrimination and adverse-action notice obligations depending on applicant type and circumstances; applicability and required procedures are Legal/Compliance determinations, and this process operates under the procedures they define. Decisions take effect only through governed master-data submission; consuming processes read the governed record.\nIn scope: Creditworthiness assessment across KYC, financial, bureau, payment-history, credit-support, and sector evidence | limit, risk-code, terms-eligibility, and security decisions per policy and DoA | periodic and event-triggered reviews | recording via governed submission with effective dates | escalation of out-of-policy cases\nOut of scope: Policy setting (CM-1-3-7-4-1) | KYC execution (CM-1-3-7-4-6) | overriding Compliance/Legal restrictions | exposure monitoring (CM-1-3-7-4-3) | legal determinations (Legal/Compliance) | master-data writes outside governed submission"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "KYC outcomes"
   },
   {
    "@language": "en",
    "@value": "credit policies and DoA"
   },
   {
    "@language": "en",
    "@value": "customer-domain hierarchy"
   },
   {
    "@language": "en",
    "@value": "financial statements, bureau data, payment history, credit support"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed customer credit limits, risk codes, and security requirements with review schedules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every customer's credit envelope is decided, evidenced, current, and governed."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11215"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Monitor customer credit exposure against approved limits continuously: calculate exposure per approved policy, aggregate it across the customer's accounts per the governed credit hierarchy, apply and release holds under authorized rules and decisions, and route deterioration signals to limit review, servicing, and collections."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review policy-qualified exposure model adopted verbatim (security/collateral offsets included; disputed balances per policy treatment, not all-in); hold automation/override rule adopted verbatim; sanctions-vs-credit hold distinction noted."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Monitor Credit Against Limit"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Exposure is calculated according to approved policy and may include open orders, allocated/released orders, unbilled fulfillments, unbilled card activity, open receivables, disputed balances, accrued charges, contingent obligations, security/collateral offsets, and other exposure elements specified by the policy. Exposure aggregates at the Party/Customer Account/credit-group level defined by the governed customer domain and approved credit policy. It does not assume each account is independently creditworthy or that all legal entities share exposure automatically. Holds may be automatically applied by approved system rules or manually applied by authorized Credit personnel. Hold release requires a documented authorized Credit decision or an approved automated rule; commercial order, card, billing, or service teams cannot bypass the hold. Holds fire in the consuming processes (order validation, release, card servicing apply them — the batch 33/29 receiving ends); deteriorating-exposure signals route to Establish Credit Limit & Risk Code for limit review and, at delinquency, to the servicing and collections processes. Sanctions holds are distinct from credit holds and follow the Compliance-owned framework. Capture & Validate Order (CM-1-3-7-3-1) validates each order against the credit exposure position maintained by Monitor Credit Against Limit (CM-1-3-7-4-3). Monitor Credit Against Limit (CM-1-3-7-4-3) provides credit exposure signals that inform Manage Card Delinquency and Collections Referral (CM-1-3-6-6-6).\nIn scope: Continuous policy-defined exposure calculation, including security/collateral offsets and policy-qualified disputed balances | aggregation across the governed Party/Account/credit-group hierarchy | limit utilization monitoring and alerting | automatic and authorized manual holds | documented hold-release decisions | deterioration signal routing\nOut of scope: Limit and risk-code decisions (CM-1-3-7-4-2) | exposure policy definition (CM-1-3-7-4-1) | collections (CM-1-3-8-3) | order and card servicing actions (their processes, applying these decisions) | sanctions hold adjudication (Compliance) | AR accounting (CM-1-3-8-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved limits and risk codes"
   },
   {
    "@language": "en",
    "@value": "exposure data from orders, fulfillment, cards, and AR"
   },
   {
    "@language": "en",
    "@value": "governed credit hierarchy"
   },
   {
    "@language": "en",
    "@value": "policy exposure and hold rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Current exposure positions, applied holds, documented releases, and routed deterioration signals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "No customer quietly exceeds the risk the business decided to take."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/14187"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze credit risk at portfolio level: concentration by customer, sector, channel, and geography; aging and risk-code migration; loss experience and expected-loss signals; and stress indicators under changing market conditions — producing insights that inform credit policies, limit strategies, and Finance's reserve and allowance determinations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review expected-loss vs accounting-provisioning distinction adopted verbatim; b21 analysis rule and Finance lock inherited."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Analyze Portfolio Credit Risk"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The process may calculate risk signals, expected-loss indicators, concentration views, migration, and stress results according to Finance-approved methodologies. Finance determines accounting allowance, impairment, reserve, and disclosure treatment. The analysis-and-inform rule applies: policy changes are Maintain Credit Policies' to propose and the governance owners' to approve; limit changes are Establish Credit Limit & Risk Code's; reserve, allowance, impairment, and disclosure determinations are Finance's (the Finance lock, supplied from here with data, never made here). Metrics produced are evidence-layer; candidate KPIs route via the KPI Store. Analyze Portfolio Credit Risk (CM-1-3-7-4-4) provides portfolio credit findings that inform Maintain Credit Policies (CM-1-3-7-4-1).\nIn scope: Portfolio concentration, migration, aging, and loss analysis | expected-loss and stress signals per Finance-approved methodologies | insight delivery to policy, limits, and Finance allowance processes | evidence-layer credit metrics\nOut of scope: Policy, limit, and closure decisions (their processes) | accounting allowance, impairment, reserve, and disclosure treatment (Finance; Determine Bad Debt Allowance) | collections strategy (CM-1-3-8-3) | KPI approval/publication"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Exposure, aging, and loss data"
   },
   {
    "@language": "en",
    "@value": "Finance-approved methodologies"
   },
   {
    "@language": "en",
    "@value": "market and sector indicators"
   },
   {
    "@language": "en",
    "@value": "risk codes and migration history"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Portfolio risk insights informing policies, limits, and Finance determinations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The credit book's shape and drift are visible before they become losses."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review credit-driven recast adopted verbatim — suspension/closure/reinstatement of commercial eligibility only, never entity dissolution, contract termination, debt extinguishment, or data deletion. Preferred label 'Perform Credit-Driven Customer Closure and Reinstatement' recorded as alt label and queued (more than punctuation: prevents conflict with general customer-closure processes). Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Perform Customer Closure & Reinstatement' to 'Perform Credit-Driven Customer Closure and Reinstatement'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10106"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Perform Customer Closure & Reinstatement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Determine and coordinate credit-driven suspension, closure, or reinstatement of commercial eligibility under approved policy. It does not dissolve a legal entity, unilaterally terminate contracts, extinguish debt, delete master data, or prevent Legal/Commercial owners from managing non-credit exits. Coordinate the closure or reinstatement workflow through the owning processes so records, orders, cards, collections, and contracts land consistently."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Credit-Driven Customer Closure and Reinstatement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Decision here, execution through owners: master-data retirement or reactivation records through governed submission (Maintain Customer and Commercial Account Master Data records per this process's decisions); open orders resolve through the order processes; card servicing through the card program; collections continue through Manage Receivables Resolution — closure never extinguishes a debt or a collection; contract termination executes through Legal and Contract Management under the agreements. Commercial exits for non-credit reasons are decisions of the accountable commercial owners; legal-entity closure, account closure, service shutdown, and regulatory deactivation have their own owners. Reinstatement requires the applicable credit reassessment (limits, KYC refresh) before reopening.\nIn scope: Credit-driven suspension, closure, and reinstatement decisions of commercial eligibility per policy and DoA | workflow coordination across master data, orders, cards, collections, and contracts | reinstatement reassessment gating | complete closure records\nOut of scope: Non-credit commercial exits (commercial owners) | legal-entity dissolution, contract termination execution, and regulatory deactivation (Legal; Contract Management; their owners) | debt extinguishment and collections (CM-1-3-8-3) | master-data deletion or writes outside governed submission"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Credit deterioration and delinquency signals"
   },
   {
    "@language": "en",
    "@value": "collections and Legal status"
   },
   {
    "@language": "en",
    "@value": "policies and DoA"
   },
   {
    "@language": "en",
    "@value": "reassessment outcomes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Decided, fully coordinated credit-eligibility closures and reinstatements with consistent records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Credit eligibility closes and reopens deliberately, completely, and on the record."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 34 (2026-09-20). Review beneficial-ownership wording (collect/verify/maintain, never legally 'establish') and match-escalation rule adopted verbatim; refresh-trigger taxonomy per review. Preferred label 'Perform KYC Due Diligence' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'KYC Process' to 'Perform KYC Due Diligence'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20094"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ofac-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "KYC Process"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute know-your-customer due diligence: verify customer identity and legal existence, collect, verify, and maintain beneficial-ownership information where required by applicable policy, law, regulation, customer type, or risk rating, screen customers and counterparties against sanctions and watchlists, assess KYC risk per the enterprise framework, and refresh due diligence on the required cycles and trigger events."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.4.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform KYC Due Diligence"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Execution, not framework ownership: the sanctions compliance and financial-crime frameworks are owned by Compliance and Legal; this process executes them. Potential sanctions, watchlist, PEP, adverse-media, beneficial-ownership, identity, or document discrepancies are escalated for designated Compliance/Legal review. The KYC process does not clear a true/false match, grant exceptions, or determine permissibility of a relationship. Fact-dependent statement: U.S. sanctions administered by OFAC apply broadly to U.S. persons — customer and counterparty screening against the SDN and other OFAC lists is performed per the enterprise sanctions compliance program; anti-money-laundering program obligations are fact-dependent on the entity's regulatory status and activities; applicability and program design are Compliance/Legal determinations. Refresh triggers may be time-based, event-driven, risk-rating driven, ownership/control-change driven, negative-news or sanctions-driven, or transaction/activity-triggered. KYC outcomes gate onboarding (Set Up Prospect requires them; customer master records them) and feed credit assessment. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit.\nIn scope: Identity and legal-existence verification | collection, verification, and maintenance of beneficial-ownership information where required | sanctions and watchlist screening per the enterprise program | KYC risk assessment per framework | refresh on required cycles and trigger events | escalation of potential matches and discrepancies to designated Compliance/Legal review | KYC records\nOut of scope: Sanctions/AML framework ownership, match clearing, exceptions, and relationship-permissibility determinations (Compliance; Legal) | credit decisions (CM-1-3-7-4-2) | onboarding coordination (Set Up Prospect) | privacy framework setting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Customer applications and documents"
   },
   {
    "@language": "en",
    "@value": "enterprise sanctions/AML framework"
   },
   {
    "@language": "en",
    "@value": "refresh triggers"
   },
   {
    "@language": "en",
    "@value": "screening lists per the program"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Completed, current KYC outcomes gating onboarding and credit, with screening and escalation evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The business always knows who it is dealing with, and never deals with who it must not."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10388"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that operates commercial customer service: receiving and prioritizing customer requests, inquiries, and complaints from all channels, resolving directly what governed data and approved documentation can answer, routing the substance of everything else to its owning process, maintaining the case record end to end, following up to confirmed resolution, running the customer service-review cadence, and delivering customer training from approved content."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Capability per the heterogeneous-concurrent-control test; review 'commercial customer-request experience' wording adopted verbatim (never the whole customer service experience — delivery and CX strategy live elsewhere); canonical resolution-routing rule and expanded safety/security escalation with incident-record linkage adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Customer Requests and Inquiries"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This capability owns the commercial customer-request experience: intake, prioritization, case stewardship, routing, status communication, follow-up, and closure coordination. It resolves directly only those requests that can be answered from governed data or approved documentation. Substantive resolution remains with the accountable process owner. Resolution-routing rule: Customer Requests and Inquiries manages one case record and one customer communication loop. It may answer governed status, documentation, and information requests directly. For all matters requiring a business decision, record change, financial adjustment, physical action, legal conclusion, technical assessment, or control override, it routes the case to the owning process, tracks the outcome, communicates the confirmed result, and closes the loop. It does not adjudicate disputes, issue credits, alter orders, modify master data, make credit decisions, apply prices, perform physical operations, or override controls. One case record follows the request wherever it goes. Safety-escalation rule: Any request, complaint, or communication indicating a potential product-quality, safety, environmental, spill/release, contamination, security, or regulatory event is immediately captured and escalated to the accountable Quality, EHS, Security, and Operations processes under their incident protocols. The service capability does not assess severity, determine reportability, investigate the event, delay escalation pending normal prioritization, or close the incident; it tracks the customer-facing case and communications. The service record references the incident/case identifier managed by the accountable process. It does not become the incident system of record. Customer personal data is governed under the enterprise personal-data governance framework; service communications are service notices, with marketing communications under the separate consent/contactability framework. When Manage Customer Requests and Inquiries (CM-1-3-7-5) receives a request disputing a billed amount that requires adjudication, it routes the case to Manage Receivables Disputes (CM-1-3-8-3-1) for assessment while retaining the customer communication loop.\nIn scope: Multi-channel request/inquiry/complaint intake | prioritization and immediate safety/security escalation | direct resolution from governed data and approved documentation | substance routing to owning processes with tracking | case record stewardship | follow-up to confirmed resolution | customer service reviews | customer training delivery from approved content\nOut of scope: Dispute adjudication, credits, order changes, credit decisions, card servicing, pricing, physical operations, and master-data changes (their owning processes) | quality/safety/environmental/security assessment and incident ownership (Quality; EHS; Security; Operations) | customer-experience strategy and service delivery owned elsewhere | commercial negotiations and account strategy (Manage Key Accounts; sales processes) | service platform ownership (IT) | consent creation"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Channel submissions (portal, phone, email, EDI)"
   },
   {
    "@language": "en",
    "@value": "governed status and document data"
   },
   {
    "@language": "en",
    "@value": "owning-process resolutions"
   },
   {
    "@language": "en",
    "@value": "prioritization framework and incident protocols"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Resolved, confirmed, fully recorded customer requests with routed substance and closed loops"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every customer request lands, moves, resolves, and closes — visibly, once, through the right owner."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review priority-taxonomy sentence adopted verbatim (framework-defined, not universally numerical); safety-escalation rule per the L4. Preferred label 'Prioritize Customer Requests and Inquiries' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Establish Priority Assignment of Customer Request/Inquiry' to 'Prioritize Customer Requests and Inquiries'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10324"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Establish Priority Assignment of Customer Request/Inquiry"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Assign priority to each incoming customer request, inquiry, or complaint per the approved prioritization framework, and maintain that framework current with service experience. Priority is assigned using an approved framework that may include safety/regulatory escalation, customer impact, service commitment, financial/commercial impact, vulnerability/criticality, operational impact, recurrence, and required response time."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Prioritize Customer Requests and Inquiries"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Safety first, outside the queue: Any request, complaint, or communication indicating a potential product-quality, safety, environmental, spill/release, contamination, security, or regulatory event is immediately captured and escalated to the accountable Quality, EHS, Security, and Operations processes under their incident protocols. The service capability does not assess severity, determine reportability, investigate the event, delay escalation pending normal prioritization, or close the incident; it tracks the customer-facing case and communications. Priority frameworks, tiers, and service-level commitments are approved through the accountable service governance; per-case assignment applies the approved framework (apply-not-make, the standing pattern). Customer-tier treatment follows approved commercial terms, never ad-hoc preference.\nIn scope: Per-case priority assignment per approved framework | immediate safety/quality/environmental/security escalation under incident protocols | framework maintenance proposals from service experience | priority-queue integrity\nOut of scope: Framework, tier, and service-level approval (service governance) | safety/quality/security assessment and incident ownership (Quality; EHS; Security; Operations) | resolution execution (CM-1-3-7-5-3) | commercial terms decisions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Incoming cases"
   },
   {
    "@language": "en",
    "@value": "approved prioritization framework and service levels"
   },
   {
    "@language": "en",
    "@value": "customer terms"
   },
   {
    "@language": "en",
    "@value": "incident escalation protocols"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Prioritized case queue with safety-relevant matters escalated immediately"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The right cases first — and safety-relevant cases instantly with the right owner."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review refined definition, case-state control list, and merge safeguard adopted verbatim — merge never deletes or obscures complaint/incident evidence (matters for disputes, EHS complaints, regulated issues, legal holds). Preferred label 'Maintain Customer Request and Inquiry Records' recorded as alt label and queued — removes the incorrect 'master' implication. Step 3d naming pass — scope-ambiguity Batch 2 (D, 2026-09-21): renamed from 'Maintain Requests and Inquiries Master Database' to 'Maintain Customer Request and Inquiry Records'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10252"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Maintain Requests and Inquiries Master Database"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain governed operational case and interaction records for customer requests, inquiries, complaints, and service communications, including categorization, ownership, status, timestamps, routing, correspondence, evidence links, resolution outcome, and retention classification."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Customer Request and Inquiry Records"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Case records, not master data: these are operational service records, distinct from the enterprise master-data domains (batch 31) — nothing here creates or changes customer, price, product, or tax master data, which move only through governed submission. Case records carry: unique case identifier; channel/source; customer/account/party reference; request category/subcategory; priority; safety/compliance flag; owning process/queue; status; timestamps; SLA/commitment; escalation history; related order/invoice/contract/card/incident identifiers; resolution code; customer communication evidence; and retention/disposition classification. Case merge preserves original identifiers, source events, communications, audit history, and linked outcomes; it must not delete or obscure complaint/incident evidence. The service record references the incident/case identifier managed by the accountable process. It does not become the incident system of record. Platform administration, application security, and technical operations are IT's (the batch 31 technical-controls distinction). Personal data in case records is governed under the enterprise personal-data governance framework; retention, legal holds, and disposal follow the records-management policy.\nIn scope: Case record stewardship across channels and routed processes | categorization taxonomy maintenance | data quality and status integrity | duplicate merge preserving identifiers, communications, audit history, and linked outcomes | retention, legal-hold, and disposal handling per records policy | case reporting data provision\nOut of scope: Master-data domains and changes (CM-1-3-7-1; governed submission) | incident system of record (accountable incident processes) | platform and technical operations (IT) | case resolution (CM-1-3-7-5-3) | records-management policy setting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Case events from all channels and routed processes"
   },
   {
    "@language": "en",
    "@value": "categorization taxonomy"
   },
   {
    "@language": "en",
    "@value": "records-management policy and legal holds"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed, current, complete case records with categorization, linkage, and retention control"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One trustworthy, auditable record per request, wherever the request goes."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/13482"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Work each customer request or inquiry to resolution: answer directly what governed data and approved content can answer — status, information, and documentation requests — route the substance of everything else to its owning process with the case attached, track routed items to outcome, and communicate resolution to the customer."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review information-source safeguard adopted verbatim — the no-shadow-decision rule's answer-side twin: governed content or confirmed owner outcomes only, no inference or promises."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Process Inquiries and Requests"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The resolution-routing rule operationalized: Direct answers must be drawn from governed records, approved knowledge content, approved documents, or confirmed owner-process outcomes. The service process must not infer, estimate, or promise a price, delivery, credit, tax, quality, safety, legal, or contract outcome. Substance resolution belongs to the owning processes (disputes, billing corrections, credit, orders, cards, technical/site matters route per the L4 rule), and this process tracks each routed item to outcome and owns the customer communication loop — the owning process decides, the service process closes the loop. Commitments to customers reflect owning-process confirmations, never independent promises. Escalation for aging or stuck cases follows the approved escalation paths.\nIn scope: Direct resolution from governed records, approved knowledge content, approved documents, and confirmed owner-process outcomes | substance routing with case linkage | routed-item tracking to outcome | customer resolution communication | aging and escalation management\nOut of scope: Dispute adjudication (CM-1-3-8-3-1) | billing corrections and credits (CM-1-3-8-1) | credit decisions (CM-1-3-7-4) | order changes (CM-1-3-7-3-3) | card servicing (CM-1-3-6-6) | inferred, estimated, or promised price, delivery, credit, tax, quality, safety, legal, or contract outcomes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Prioritized cases"
   },
   {
    "@language": "en",
    "@value": "escalation paths"
   },
   {
    "@language": "en",
    "@value": "governed status/document data and approved knowledge content"
   },
   {
    "@language": "en",
    "@value": "owning-process outcomes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Resolved cases with routed substance, tracked outcomes, and completed customer communication"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every case resolves through the right owner, and the customer always hears back."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review formal-research distinction adopted verbatim — case-level feedback is operational service evidence, never a substitute for governed analysis processes. Normalized label 'Perform Customer Follow-Up' is punctuation-only — queued for the naming pass, no alt label (validator lesson). Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Perform Customer Follow up' to 'Perform Customer Follow-Up'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10106"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Perform Customer Follow up"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Follow up resolved cases with the customer: confirm the resolution held, verify commitments made during resolution were met, capture satisfaction and residual issues, and reopen or re-route where resolution failed."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Customer Follow-Up"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Follow-up communications are service communications tied to the customer's case — conducted through the customer's preferred service channels; marketing content requires the separate consent/contactability framework and never rides a service follow-up. Case-level follow-up feedback is operational service evidence. It does not replace governed Consumer Analysis, Customer/Marketer Analysis, formal survey design, loyalty analytics, or customer-experience measurement. Reopened cases re-enter prioritization; commitments verified are the owning processes' commitments, tracked here. Satisfaction signals and residual-issue patterns feed the service reviews and evidence-layer metrics (candidate KPIs via the KPI Store).\nIn scope: Post-resolution confirmation | commitment verification | satisfaction and residual-issue capture as operational service evidence | reopening and re-routing on failed resolution | signal provision to service reviews\nOut of scope: Marketing communication (Marketing execution; consent/contactability framework) | formal survey design, consumer/customer analysis, loyalty analytics, and customer-experience measurement (Marketing Performance Analysis, CM-1-3-5-5) | re-resolution substance (owning processes) | KPI approval/publication (Enterprise measurement governance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Resolved cases and commitments"
   },
   {
    "@language": "en",
    "@value": "customer channel preferences"
   },
   {
    "@language": "en",
    "@value": "satisfaction responses"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Verified resolutions, reopened exceptions, and satisfaction signals for improvement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Resolution means resolved — verified with the customer, not assumed."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review commercial-referral and cadence sentences adopted verbatim — quarterly is the default cadence, not the concept. Preferred label 'Conduct Customer Service Reviews' recorded as alt label and queued. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Conduct Quarterly Review Meeting' to 'Conduct Customer Service Reviews'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11427"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Conduct Quarterly Review Meeting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Conduct structured periodic service reviews with customers: review service performance against commitments, open items and their paths to closure, complaint and issue trends, and agreed improvement actions, with tracked follow-through. Review cadence may be quarterly by default and adjusted by customer tier, agreement, issue profile, regulatory obligation, or service model."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Conduct Customer Service Reviews"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Service review, not commercial negotiation: Service reviews may identify commercial opportunities, terms issues, pricing concerns, volume changes, contract questions, or strategic account topics, but those are recorded and referred to the appropriate commercial/account process rather than negotiated or decided in the service review. Review commitments entered are service commitments within existing authority; anything beyond routes for approval. Review outputs feed account management, service improvement, and the evidence layer. Conduct Customer Service Reviews (CM-1-3-7-5-5) provides service-review findings, unresolved issues, and agreed improvement actions to inform Manage Key Accounts (CM-1-3-6-2-2); the recipient retains its own decisions.\nIn scope: Periodic service review preparation and conduct, quarterly by default and adjusted per tier, agreement, issue profile, regulatory obligation, or service model | performance-against-commitment review | open-item and trend review | improvement action agreement within authority and tracked follow-through | recording and referral of commercial topics to their owners\nOut of scope: Commercial negotiation, terms, pricing, volumes, and contract decisions (Manage Key Accounts; commercial processes) | commitments beyond existing authority (approval paths) | account strategy (sales processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Service performance data"
   },
   {
    "@language": "en",
    "@value": "account context"
   },
   {
    "@language": "en",
    "@value": "open cases and trends"
   },
   {
    "@language": "en",
    "@value": "prior actions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Conducted reviews with agreed, tracked improvement actions and referred commercial topics"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Service performance reviewed with the customer, on cadence, with actions that actually close."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20754"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Provide customers training on commercial tools, portals, ordering, documentation, card-program administration, and approved product/service interaction procedures. Where the program includes safe-handling orientation, the content is delivered exactly from approved Product Stewardship/EHS materials; it is not safety certification, regulatory training authority, or site-operator training unless a separate accountable framework expressly delegates that role. Develop delivery materials from approved content, deliver through appropriate formats, and track completion where required."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 35 (2026-09-20). Review safety-training qualifier and completion-evidence note adopted verbatim — safe-handling orientation delivers approved Product Stewardship/EHS materials exactly; no certification or regulatory training authority unless expressly delegated."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.7.5.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Provide Customer Training"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Delivery, not content authority: product-safety and regulatory content (safety data sheets, handling requirements) comes from the accountable Product Stewardship and EHS owners; commercial-process content from the accountable process owners; this process develops delivery materials from approved content and never authors safety, regulatory, or policy substance. Training completion evidence may be recorded where required by agreement, program rule, regulatory requirement, or customer request; certification authority remains with the accountable content framework. Distinct from franchise-operations training (Train and Certify AMPM Manager, CM-1-3-6-1-4): this row trains customers on commercial interactions, not franchise site operations.\nIn scope: Customer training needs identification | delivery material development from approved content | training delivery across formats | completion tracking and evidence where required by agreement, program rule, regulatory requirement, or customer request | training feedback to content owners\nOut of scope: Safety, regulatory, and policy content authorship (Product Stewardship; EHS; process owners) | safety certification and regulatory training authority (accountable content frameworks) | franchise operations training (CM-1-3-6-1-4) | training obligations creation (contracts; programs)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved content from accountable owners"
   },
   {
    "@language": "en",
    "@value": "customer needs and program requirements"
   },
   {
    "@language": "en",
    "@value": "delivery channels"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Delivered customer training with completion evidence where required"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Customers use the commercial tools and processes correctly, safely, and confidently."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Operational Accounting includes processes that denotes the ledger like capability leveraged by the users for the ease of auditing and record keeping."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Operational Accounting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20085"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of billing customers for delivered products and services: creating and distributing invoices from confirmed evidence and governed commercial data, determining transaction taxes per the Tax function's determinations, accounting for customer self-billing under executed agreements, and issuing every correction — credit memos, exception invoices, reversals, and rebills — as controlled document events."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Continuous process per review — one billing-document lifecycle with taxability and self-billing as controlled variants, not a capability; canonical Billing Integrity Rule adopted verbatim as a durable decision-log rule (the financial-document counterpart of the order-history and governed-submission rules)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Customer Invoicing and Billing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Billing Integrity Rule: a bill or self-bill is created only from validated, linked, and governed inputs: confirmed fulfillment evidence, applicable commercial terms, effective-dated price/discount conditions, approved tax data and determinations, and authorized customer/account information. Billing does not alter physical quantities, invent prices, override credit/terms/tax rules, or replace missing evidence. Every billing correction is a controlled document event — credit memo, debit/exception invoice, cancellation, reversal, or replacement document — with original-document linkage, reason code, authorization evidence, effective date, and audit trail. Original billing documents are not edited in place or deleted; corrections preserve the complete document chain. This L4 is the executing owner that the locked coordination boundaries point at: card-program billing (b29), rebate and returns credits (b29/b33), portal document presentation (b32), and service-desk billing corrections (b35) all execute here under these controls. Taxability and self-billing operate as controlled variants of the one billing-document lifecycle. Receivables, cash application, collections, and revenue accounting are the adjacent processes' (CM-1-3-8-2/-3/-4); payment execution follows the payment-authority rule.\nIn scope: Invoice creation from confirmed channel evidence and governed data | transaction tax determination application | invoice distribution per customer terms, channels, and Tax/Legal-directed mandates | self-billing accounting under executed agreements | controlled credit memos, exception invoices, reversals, and rebills | billing document records and audit trails\nOut of scope: Price, terms, and rebate determination (their owners) | tax positions and interpretations (Tax function) | fulfillment evidence creation (physical processes) | cash application and AR (CM-1-3-8-2) | collections and disputes (CM-1-3-8-3) | revenue accounting and period close (CM-1-3-8-2-6; CM-1-3-8-4) | payment execution and refunds (Finance/Treasury)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Confirmed channel evidence (b33)"
   },
   {
    "@language": "en",
    "@value": "authorized correction instructions"
   },
   {
    "@language": "en",
    "@value": "established terms"
   },
   {
    "@language": "en",
    "@value": "governed price/discount, tax, and customer master data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurate, distributed invoices and controlled correction documents with complete audit trails"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every delivery becomes an accurate, evidenced bill, correctable only by controlled document events."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Review channel-evidence definition and billing-run control adopted verbatim — evidence basis is contract/channel-dependent, never assumed to be a physical delivery quantity; e-invoicing implementation boundary adopted verbatim; fourth use of the daily horizon. Normalized label 'Create and Distribute Bill' is punctuation-only — queued, no alt label. Step 3d naming pass — normalization-only mechanical Batch 6 (2026-09-21): renamed from 'Create & Distribute Bill' to 'Create and Distribute Bill'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10295"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Create & Distribute Bill"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create customer invoices from confirmed channel evidence and governed commercial data on the customer's billing cadence — per delivery, consolidated, statement, or cycle — and distribute them through the customer's channels in the formats and content the applicable requirements mandate."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create and Distribute Bill"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Billing consumes the contractually applicable fulfillment, custody, service-completion, or transaction evidence for the channel. The evidence source, quantity basis, timing, and billable event are defined by the agreement, applicable operational process, and governing measurement/transaction rules. Channel evidence includes, as applicable: bills of lading, delivery tickets and proof of delivery, rack meter tickets, terminal automation load records, into-plane uplift tickets, bunker delivery notes, pipeline nomination/allocation/statements, retail POS/shift/settlement evidence, service completion or fee events, contractual self-bill statements, and approved manual exception evidence. Billing runs detect duplicate, missing, out-of-period, held, incomplete, or conflicting billable events before invoice creation and route exceptions for correction. Invoices compute from confirmed, linked evidence and governed price, terms, and tax data — never from restated quantities or ad-hoc values (no-self-exception, billing side). Card-program statements assemble per the card-program billing coordination (b29). Tax/Legal determine applicable jurisdictional e-invoicing, invoice-content, digital-signature, clearance, archival, government-platform, and reporting requirements. Billing implements approved format, channel, content, delivery, and evidence rules; it does not determine legal applicability. Portal presentation flows through the portal channel (b32).\nIn scope: Daily billing runs from confirmed channel evidence with duplicate, missing, out-of-period, held, incomplete, and conflict detection | per-delivery, consolidated, statement, and cycle billing per terms | invoice content assembly per governed data and Tax/Legal-directed mandates | multi-channel distribution including e-invoicing where directed | billing-run controls and completeness checks\nOut of scope: Quantity determination (measurement/fulfillment evidence owners) | pricing (governed data) | e-invoicing legal applicability (Tax; Legal) | credit memos and corrections (CM-1-3-8-1-4/-5) | cash application (CM-1-3-8-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-7"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Confirmed channel evidence"
   },
   {
    "@language": "en",
    "@value": "Tax/Legal distribution directions"
   },
   {
    "@language": "en",
    "@value": "customer billing terms and channels"
   },
   {
    "@language": "en",
    "@value": "governed price/terms/tax data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurate invoices distributed on cadence with complete run controls"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every confirmed billable event billed once, accurately, on cadence, in the required form."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Review agreement-content requirement, preserved-original rule, and accounting-model routing adopted verbatim — no single assumed AR path; self-billing covers ERS-style and customer-issued document arrangements per the governing agreement. Preferred label 'Perform Self-Billing Accounting' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Perform Accounting For Self-billing' to 'Perform Self-Billing Accounting'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10774"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Perform Accounting For Self-billing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Account for customer self-billing arrangements: receive customer-issued billing documents under executed self-billing agreements, validate each against confirmed fulfillment evidence and governed prices and terms, record the validated self-bill, and resolve differences with the customer per the agreement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Self-Billing Accounting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Self-billing operates only under executed agreements that meet the applicable tax-law conditions — fact-dependent by jurisdiction, determined by the Tax function; no self-billing without a qualifying agreement. The applicable agreement must specify the parties' billing responsibility, tax/document treatment, acceptance rules, evidence basis, data exchange, correction process, retention obligations, and settlement mechanism. A customer's self-bill never overrides governed evidence or prices: validation compares to confirmed fulfillment evidence and governed data, and differences resolve per the agreement's mechanism — through controlled correction documents, never by adopting the customer's figures unverified. Validated self-bill acceptance must preserve the customer-issued original, internal validation results, agreement reference, fulfillment evidence links, tax treatment, and correction chain. Validated self-bills flow to the accountable receivables, payables, revenue, tax, and accounting processes according to the applicable commercial and accounting model. Perform Self-Billing Accounting (CM-1-3-8-1-2) validates customer self-bills against the self-billing agreements and commercial terms established by Establish Commercial Terms & Contracts (CM-1-3-7-2-1). Perform Self-Billing Accounting (CM-1-3-8-1-2) supplies validated self-bills, agreement references and fulfillment links that Perform Revenue Accounting (CM-1-3-8-2-6) uses as revenue evidence.\nIn scope: Self-bill receipt under executed agreements | validation against confirmed evidence and governed data | recording of validated self-bills with preserved originals, validation results, and linkage | difference resolution per agreement through controlled documents | routing to the accountable accounting processes per the applicable model\nOut of scope: Self-billing agreement terms (contracting processes; Legal) | tax-law qualification of self-billing (Tax function) | evidence and price determination (their owners) | accounting treatment determination (Finance) | cash application (CM-1-3-8-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/governedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Customer self-bills"
   },
   {
    "@language": "en",
    "@value": "confirmed fulfillment evidence"
   },
   {
    "@language": "en",
    "@value": "executed self-billing agreements"
   },
   {
    "@language": "en",
    "@value": "governed price/terms data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Validated, recorded self-bills with preserved originals, resolved differences, and complete records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Customer paper accepted only when it matches governed evidence — and reconciled when it doesn't."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10196"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-irs-p510-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Determine Transaction Taxability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Determine the taxes applicable to each billed transaction. Apply tax determination rules through effective-dated tax master data, transaction attributes, product tax classes, origin/destination or jurisdiction logic, customer tax status, exemption evidence, and other Tax-approved rules. Produce the tax lines the invoice carries, including federal and state fuel excise treatment where applicable."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Review tax-application wording and hold-don't-guess exception rule adopted verbatim; duplicate-name normalization queued per review ('Determine Transaction Taxability' here, recorded as alt label; compliance-side label reserved for CM-1-3-8-4-5); SRC-IRS-P510-001 scoped to federal fuel-excise context only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Determine Taxability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Application, not position-taking (the batch 31 tax rule's receiving end): tax positions, interpretations, exemption-validation rules, and responses to law changes are the Tax function's; this process applies them per governed tax master data. If tax master data, exemption evidence, product classification, jurisdiction, or transaction facts cannot resolve taxability, the transaction is held or routed according to Tax-approved exception procedures; billing does not guess a tax result. Fuel excise context: federal excise and fee treatment for taxable fuels follows the Tax function's determinations (IRS Publication 510 registered as federal fuel-excise context only — not authority for state/local/non-US outcomes). Distinct from the compliance/reporting-side Determine Taxability (CM-1-3-8-4-5), which will carry assessment/reporting/filing/remittance determination — the transaction-time vs compliance-time split, with future normalized labels 'Determine Transaction Taxability' and 'Determine Taxability for Tax Compliance and Reporting' queued. Tax corrections flow through controlled correction documents, never in place. Determine Taxability (CM-1-3-8-1-3) supplies transaction tax lines, effective treatment references, and controlled tax corrections that Reconcile And Report Indirect Tax (CM-1-3-8-4-4) consumes in its defined work.\nIn scope: Per-transaction tax determination through effective-dated tax master data, transaction attributes, product tax classes, origin/destination/jurisdiction logic, customer tax status, and exemption evidence | fuel excise and fee line application per Tax determinations | hold-or-route handling of unresolvable cases per Tax-approved exception procedures | tax line audit trails\nOut of scope: Tax positions, interpretations, and law-change responses (Tax function) | tax master data maintenance (CM-1-3-7-1-4) | certificate validation rules (Tax) | tax remittance, filing, and reporting (CM-1-3-8-4) | guessed tax results"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Governed tax master data (rates, codes, classes, certificates)"
   },
   {
    "@language": "en",
    "@value": "Tax function determinations and exception procedures"
   },
   {
    "@language": "en",
    "@value": "transaction data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Correct transaction tax lines with complete determination audit trails"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every invoice carries exactly the tax the Tax function's determinations require — or holds until it can."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10147"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create controlled credit memos on authorized instruction: validate the instructing process's authorization and documented basis, reference the original invoice, apply the applicable approvals per the delegations of authority, issue the credit memo, and record its complete linkage from instruction to settlement effect."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Review originating-process validation list and governed-data/downstream-process conditions adopted verbatim; credit-memo vs refund vs offset vs write-off distinctions per review. Review preferred an 'informs' relation toward cash application — 'informs' is not in the relationship vocabulary (b10/b23 precedent): recorded here verbatim, nearest vocabulary applied to the locked L4 name."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Create Credit Memo"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The single controlled credit instrument: rebate settlements (b29), returns authorizations (b33), dispute resolutions, tax and pricing corrections, contractual allowances, and approved commercial adjustments all credit customers exclusively through this process. The issuing process validates that an authorized originating process has provided the correct reason code, original-document reference, evidence, approvals, tax treatment, amount, customer/account, and settlement/AR handling instructions. The credit memo uses governed customer, tax, price, and account data; any refund, offset, rebill, or AR application follows its own authorized downstream process. A credit memo is an accounting/billing document: it is not a discount mechanism (pricing and rebate decisions stay with their owners), it does not itself move cash (a refund requires a separate authorized payment request under the payment-authority rule and Finance/Treasury execution), and it does not authorize a write-off (Finance's, via Determine Bad Debt Allowance). It is never self-initiated and never issued on a service-desk request without an owning-process instruction (b35). Originals are preserved and referenced — never altered. Create Credit Memo (CM-1-3-8-1-4) supplies authorized linked credit memos and their receivables/settlement handling references that Manage Cash Application, A/R & Revenue Accounting (CM-1-3-8-2) consumes in its defined work.\nIn scope: Authorization and basis validation per instructing process, including reason code, original-document reference, evidence, approvals, tax treatment, amount, customer/account, and settlement/AR handling instructions | DoA approval application | credit memo issuance with tax treatment from governed data | instruction-to-effect linkage and records\nOut of scope: Credit decisions and instructions (rebates, returns, disputes, corrections — their owners) | discounts and pricing (their owners) | refund execution (Finance/Treasury; payment-authority rule) | write-offs (Finance) | offset, rebill, and AR application execution (their authorized downstream processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-3-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Authorized instructions with documented basis and handling instructions"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "governed customer/tax/price/account data"
   },
   {
    "@language": "en",
    "@value": "original invoices"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Issued credit memos with complete authorization and linkage records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every customer credit is instructed, evidenced, approved, and traceable end to end."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 36 (2026-09-21). Review document-category taxonomy adopted verbatim; preferred label 'Manage Invoice Exceptions, Reversals, and Rebilling' recorded as alt label and queued. Review preferred an 'informs' relation toward receivables/revenue accounting pending batch 37/38 authoring — 'informs' is vocabulary-missing (b10/b23 precedent): recorded here verbatim, nearest vocabulary applied to the locked L4 name. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Create Exception & Reverse Invoice' to 'Manage Invoice Exceptions, Reversals, and Rebilling'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10147"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Create Exception & Reverse Invoice"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Correct billing through controlled document events: validate the correction's basis and authorization, and create the proper controlled document type under approved rules — full cancellation, partial correction, replacement/rebill, debit adjustment, tax-only correction, or exception invoice — with coded reasons and the applicable approvals, preserving the complete original-to-correction chain."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.1.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Invoice Exceptions, Reversals, and Rebilling"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Corrections are controlled events, never edits: an incorrect invoice is corrected by a new controlled document that references and preserves the original — nothing edited in place, nothing deleted (the Billing Integrity Rule's correction arm, parallel to the b33 history rule). The document type follows approved rules for the correction case. Reason codes classify every correction; patterns feed root-cause analysis and, where they suggest control failures or abuse, route to the accountable control owners. Corrections affecting tax follow the determination controls; corrections affecting evidenced quantities route back through the fulfillment evidence owners — billing never fixes an evidence problem by adjusting the bill. Rebilling follows the corrected basis through the standard billing controls. Manage Invoice Exceptions, Reversals, and Rebilling (CM-1-3-8-1-5) supplies controlled cancellation, correction, reversal, and replacement billing documents that Manage Cash Application, A/R & Revenue Accounting (CM-1-3-8-2) consumes in its defined work.\nIn scope: Correction basis and authorization validation | controlled document-type selection per approved rules (cancellation, partial correction, replacement/rebill, debit adjustment, tax-only correction, exception invoice) | issuance with coded reasons and DoA approvals | rebilling through standard billing controls | original-to-correction chain preservation | correction pattern reporting to control owners\nOut of scope: Evidence corrections (fulfillment/measurement owners) | credit memos (CM-1-3-8-1-4) | dispute adjudication (CM-1-3-8-3-1) | root-cause fixes in other processes (their owners) | document deletion or in-place editing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Correction requests with basis"
   },
   {
    "@language": "en",
    "@value": "affected invoices and evidence linkages"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "reason-code taxonomy and document-type rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Issued controlled correction documents with preserved chains, completed rebills, and routed patterns"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Billing errors die by the right controlled correction, with the full history intact."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10759"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of turning billed transactions into accounted revenue and settled receivables: Record and process receipt notifications, bank/lockbox/acquirer settlement information, remittance evidence, and accounting events relating to customer payments received through Treasury-managed arrangements. Capture remittance information, apply receipts against governed receivables, manage unapplied and exception items to resolution, reconcile receivables against bank and processor settlement information and the general ledger, and perform revenue accounting under Finance-approved policy."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Continuous process per review; canonical Cash Application Integrity Rule adopted verbatim as a durable financial-control decision (receipts-side counterpart of the Billing Integrity Rule); responsible_domain set cross-functional per review — control authority is mostly Finance/Treasury/Accounting with an O2C operating home; receipt activity worded as recording/notification processing, never physically receiving funds."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Responsible domain detail: Cross-functional — Finance / Treasury / O2C Operations / Commercial Operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Cash Application, A/R & Revenue Accounting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Cash Application Integrity Rule: a customer receipt is applied only to governed receivables, credit documents, or authorized offsets using remittance evidence and approved application rules. Unidentified, unapplied, partial, disputed, duplicate, overpaid, short-paid, or otherwise exceptional amounts remain visible as owned, aged exception items until resolved through an authorized process. A payment does not alter the underlying bill, fulfillment evidence, price, tax, contract, credit decision, or accounting treatment. Application reversals, offsets, transfers, refunds, write-offs, and reclassifications occur only through controlled, authorized events with complete audit trails. Treasury boundary: bank accounts, lockboxes, merchant and acquirer arrangements, payment rails, and funds movement are Treasury's; this process records, matches, applies, reconciles, and accounts — it opens no accounts, initiates no transfers, and executes no refunds (a refund is a separate authorized payment request under the payment-authority rule). Revenue-recognition policy, method elections, and interpretations are Finance's; this process executes them. Write-offs and allowances remain with Finance via Determine Bad Debt Allowance; collections and dispute actions with Manage Receivables Resolution.\nIn scope: Receipt notification and settlement-information recording across approved methods | remittance capture and normalization | receipt application per approved rules | unapplied/exception management to resolution | daily settlement-information and bank reconciliation and GL reconciliation support | revenue accounting execution under approved policy\nOut of scope: Banking, lockbox, and acquirer arrangements, payment rails, and funds movement (Treasury) | billing and corrections (CM-1-3-8-1) | dispute adjudication and collections (CM-1-3-8-3) | write-offs and allowances (Finance; Determine Bad Debt Allowance) | revenue-recognition policy (Finance) | period-end close ownership (CM-1-3-8-4-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance-approved application and revenue policies"
   },
   {
    "@language": "en",
    "@value": "Invoices and credit memos (CM-1-3-8-1)"
   },
   {
    "@language": "en",
    "@value": "receipt notifications and settlement information via Treasury arrangements"
   },
   {
    "@language": "en",
    "@value": "remittance evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Applied receipts, reconciled receivables, and accounted revenue with complete audit trails"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every billed dollar is received, applied, reconciled, and accounted — or visibly in a managed exception."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Cross-functional"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review recording/notification wording and settlement-finality boundary adopted verbatim. Preferred label 'Record Customer Receipts and Payment Notifications' recorded as alt label and queued — reflects what the process actually does. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Receive Cash Receipts / Payment' to 'Record Customer Receipts and Payment Notifications'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20104"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Receive Cash Receipts / Payment"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Record customer payment receipts daily: capture receipt notifications and settlement information from Treasury-managed banking, lockbox, card-acquirer, and electronic arrangements across the approved payment methods, validate completeness against the receipt-source reports, and stage receipts for application with their identifying data."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Record Customer Receipts and Payment Notifications"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Recording, not moving (the payment-authority rule's receiving side): funds arrive through arrangements Treasury owns; this process records what arrived, where, and from whom — it operates no bank accounts and initiates no movements. Validates completeness against bank, lockbox, card processor, payment gateway, and other approved receipt-source reports. It does not determine whether a payment is final/irrevocable; Treasury/banking arrangements and payment method rules determine settlement finality. Payment methods follow the governed menu (Define Financing & Payment Methods); card-acquirer settlement amounts stage here for the reconciliation process. Receipts recorded but not yet identifiable route immediately to the unapplied-exception process — never held informally.\nIn scope: Daily receipt-notification and settlement-information capture across approved methods and channels | completeness validation against bank, lockbox, processor, and gateway reports | receipt staging with identifying data | immediate routing of unidentifiable receipts to exception management\nOut of scope: Bank, lockbox, and acquirer arrangements and funds movement (Treasury) | settlement finality determination (Treasury; payment method rules) | application (CM-1-3-8-2-3) | payment-method definition (CM-1-3-7-2-4) | refunds (Finance/Treasury; payment-authority rule)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Bank, lockbox, processor, and gateway reports via Treasury arrangements"
   },
   {
    "@language": "en",
    "@value": "governed payment-method definitions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Complete daily receipt records staged for application"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every arriving payment is captured completely, daily, and staged with what's known about it."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10397"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Capture and normalize customer remittance information from all formats — EDI, portal, email, paper, bank addenda — validate it for completeness and consistency, link it to the receipts it explains, and stage the combined evidence for application."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review fraud/security caution adopted verbatim — remittance information never authorizes record changes; payment-redirection and bank-detail-change fraud controls escalate to Security/Treasury/Legal."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Receive Remittance Advice"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Remittance data is application evidence, not instruction to deviate: a remittance that directs application contrary to governed rules or claims deductions routes those elements to their owning processes (disputes, collections, credit instructions) rather than being applied as claimed. Remittance instructions, bank-detail changes, payment redirection requests, or suspicious messages are validated through approved controls and escalated to Security/Treasury/Legal as applicable; remittance information does not authorize change of bank, customer, invoice, or master-data records. Missing or ambiguous remittance triggers customer contact through the service channels and, unresolved, the exception process.\nIn scope: Multi-format remittance capture and normalization | completeness and consistency validation | receipt linkage | validation and Security/Treasury/Legal escalation of bank-detail changes, redirection requests, and suspicious messages | routing of claimed deductions and contrary instructions to owning processes | staging of combined evidence\nOut of scope: Application decisions (CM-1-3-8-2-3) | deduction and dispute adjudication (CM-1-3-8-3) | bank, customer, invoice, or master-data changes (their governed processes) | remittance format mandates (terms; channels)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Remittance advices across formats"
   },
   {
    "@language": "en",
    "@value": "customer terms"
   },
   {
    "@language": "en",
    "@value": "fraud-control procedures"
   },
   {
    "@language": "en",
    "@value": "receipt records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Normalized, linked, validated remittance evidence staged for application"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every receipt arrives at application with the best available, validated evidence of what it pays."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10801"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Apply staged receipts against open governed receivables daily: match on remittance evidence and approved application rules, apply exact matches, resolve tolerable differences per approved tolerance rules, route short-pays, over-pays, and claimed deductions to their owning processes, and post applications with complete linkage."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review account-hierarchy safeguard adopted verbatim — cross-account, cross-entity, cross-currency, and offset applications require approved authority and accounting treatment (material in complex downstream account structures)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Apply Receipts"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The integrity rule operationalized: application follows remittance evidence and approved rules — including approved auto-application and tolerance rules — and never forces, nets, or absorbs differences. Application follows the approved customer/account, payer, bill-to, currency, entity, and remittance rules. Cross-account, cross-entity, cross-currency, or offset application requires approved authority and accounting treatment. A short-pay is a receivable still open plus a routed difference (dispute, collection, or credit-memo instruction per its nature); an over-pay is an exception item or, on instruction, a refund request through the payment-authority process — never netted silently. Credit memos apply per their settlement/AR handling instructions (b36). Application reversals are controlled events with reasons and approvals.\nIn scope: Daily matching and application per remittance evidence and approved rules | approved auto-application and tolerances | application per the approved customer/account, payer, bill-to, currency, and entity rules, with cross-account/entity/currency and offset application only under approved authority and accounting treatment | short-pay/over-pay/deduction routing with open-item integrity | credit-memo application per instructions | controlled application reversals\nOut of scope: Difference adjudication (disputes, collections, credit owners) | tolerance and application rule approval (Finance) | write-offs (Finance) | refund execution (Finance/Treasury) | invoice changes (CM-1-3-8-1 controlled documents)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Staged receipts with remittance evidence"
   },
   {
    "@language": "en",
    "@value": "approved application and tolerance rules"
   },
   {
    "@language": "en",
    "@value": "credit-memo instructions"
   },
   {
    "@language": "en",
    "@value": "open governed receivables and the governed account hierarchy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Posted applications with complete linkage, open differences routed, exceptions escalated"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Cash lands on exactly the receivables it pays — and differences stay visible until their owners resolve them."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review segregation-of-duties condition and the broadened unclaimed-property wording adopted verbatim; per review, jurisdiction-specific unclaimed-property applicability is recorded as an open issue — no source registered until target jurisdictions are defined. Preferred label 'Manage Unapplied Receipts and Exceptions' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Manage Unapplied Receipts / Exceptions' to 'Manage Unapplied Receipts and Exceptions'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20807"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Unapplied Receipts / Exceptions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Own the exception state for cash that cannot be applied: research unidentified and unapplied receipts, contact customers through the service channels, resolve each item within policy time bounds — application, refund request, or other authorized disposition — and maintain aged visibility of everything unresolved."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Unapplied Receipts and Exceptions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "An explicit, aged, owned state: every unapplied or unidentified item carries an owner, aging, and a policy resolution clock — nothing is silently netted, absorbed, or left to age invisibly. Exception resolution, refund request, offset, transfer, or reclassification must preserve segregation of duties between investigation, approval, accounting posting, and Treasury execution. Resolutions follow their authorized paths: application on evidence, refund by authorized payment request under the payment-authority rule, offset per approved rules, or escalation. Unresolved credits, overpayments, uncashed refunds, unapplied customer funds, or other property interests may become subject to unclaimed-property reporting, due-diligence, and remittance obligations after applicable dormancy periods. Legal, Tax, Treasury, and Finance determine applicability, owner identification, dormancy, reporting, and remittance requirements; this process supplies complete, aged, auditable item records. Jurisdiction-specific applicability is an open item, not an assumed fact.\nIn scope: Unidentified and unapplied receipt research | customer contact through service channels | resolution within policy time bounds by authorized disposition, with segregation of duties across investigation, approval, posting, and Treasury execution | aged exception visibility and reporting | complete, aged, auditable item records for Legal/Tax/Treasury/Finance unclaimed-property determinations\nOut of scope: Refund execution (Finance/Treasury) | write-offs (Finance) | unclaimed-property determinations, due diligence, and filings (Legal; Tax; Treasury; Finance) | application rules (Finance) | dispute adjudication (CM-1-3-8-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Legal/Tax/Treasury/Finance directions"
   },
   {
    "@language": "en",
    "@value": "Unapplied and unidentified receipts"
   },
   {
    "@language": "en",
    "@value": "research sources and customer contact channels"
   },
   {
    "@language": "en",
    "@value": "resolution policies and SoD controls"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Resolved exceptions through authorized dispositions, with complete aged records for what remains"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "No dollar sits unexplained — every exception has an owner, an age, and a clock."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review terminology guard adopted verbatim — 'settlement' here means settlement-file and position reconciliation, never Trading Settlement (batch 14), physical commodity settlement, or funds movement. Preferred label 'Perform Cash, Acquirer, and Receivables Reconciliations' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Perform Reconciliations & Settlements' to 'Perform Cash, Acquirer, and Receivables Reconciliations'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10954"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Perform Reconciliations & Settlements"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile the receivables and receipts positions daily: bank and lockbox reporting to recorded receipts, card-acquirer and processor settlement files to recorded transactions and receipts, subledger activity to applications, and provide the reconciled positions that feed general-ledger reconciliation and period-end close."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Cash, Acquirer, and Receivables Reconciliations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Settlement in this node means reconciliation of bank/acquirer settlement files and receivable positions; it does not own Trading Settlement, physical commodity settlement, or funds movement. This row is the named receiving end of the card-program coordination (Manage Credit Card Transactions reconciles its daily cycles with this process, b29); acquirer fees and holdbacks reconcile per the Treasury-owned arrangements. Breaks are exception items with owners and aging (same discipline as unapplied cash); unresolvable breaks escalate per policy. Period-end GL reconciliation and close ownership sit with the accounting processes (CM-1-3-8-4); this row supplies reconciled daily positions.\nIn scope: Daily bank/lockbox-to-receipt reconciliation | acquirer/processor settlement-file reconciliation including the card-program cycles | subledger-to-application integrity checks | break identification, ownership, aging, and escalation | reconciled positions to GL reconciliation and close\nOut of scope: Funds movement and banking arrangements (Treasury) | Trading Settlement and physical commodity settlement (their owning processes) | GL ownership and period-end close (CM-1-3-8-4) | acquirer fee terms (Treasury) | break adjudication outside policy (escalation owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/daily"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-14"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Bank/lockbox reporting"
   },
   {
    "@language": "en",
    "@value": "acquirer and processor settlement files"
   },
   {
    "@language": "en",
    "@value": "card-program transaction cycles"
   },
   {
    "@language": "en",
    "@value": "receipt and application records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Daily reconciled positions with owned, aged breaks"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "What the bank says, what the processors say, and what the books say agree — daily, or the break is owned."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10729"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-fasb-asc606-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute revenue accounting under Finance-approved policy: recognize revenue as performance obligations are satisfied per the approved recognition model, account for deferred and unbilled revenue, coordinate revenue-affecting accruals with the accrual processes, enforce revenue cutoff, and deliver revenue accounting into period-end close."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 37 (2026-09-21). Review revenue-evidence model adopted verbatim — approved unbilled bases are recognizable under Finance policy with audit trails; the earlier 'never-unbilled' phrasing was corrected as too restrictive for accrual accounting; posting-controls sentence adopted verbatim. APQC 'Perform revenue accounting' scored 1.0."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.2.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Revenue Accounting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Execution, not policy: revenue-recognition policy, method elections, contract-assessment judgments, and interpretations under the applicable standards are Finance's — this process applies the approved model. Revenue recognition is supported by the Finance-approved evidence model, which may include billing documents, fulfillment/service evidence, contract terms, satisfaction-of-performance-obligation evidence, accrual support, and other approved accounting evidence. Unbilled revenue requires an approved basis and complete audit trail; it is not recognized merely because an invoice is expected. Revenue-accounting entries, deferrals, unbilled receivables, contract liabilities, variable consideration, and cutoff adjustments are posted under Finance-approved accounting policy and accounting-period controls. The process does not approve the policy, decide accounting elections, or publish financial statements. US GAAP context: revenue from contracts with customers follows the Topic 606 five-step model — contract, performance obligations, transaction price, allocation, recognition on satisfaction — as Finance's approved policy applies it (SRC-FASB-ASC606-001 registered as context only). Variable consideration tied to rebates and allowances coordinates with Analyze and Calculate Accruals; loyalty and similar liabilities per the b29 Finance determinations.\nIn scope: Revenue recognition per the Finance-approved model and evidence framework | deferred revenue, unbilled receivables, and contract asset/liability accounting on approved bases with complete audit trails | variable-consideration coordination with accrual processes | revenue cutoff enforcement under accounting-period controls | revenue delivery into period-end close\nOut of scope: Revenue-recognition policy, elections, judgments, and interpretations (Finance) | accrual calculation ownership (CM-1-3-8-4-3) | period-end close ownership (CM-1-3-8-4-1) | billing (CM-1-3-8-1) | financial statement publication and disclosure (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-1"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Billed and evidenced transactions"
   },
   {
    "@language": "en",
    "@value": "Finance-approved recognition policy and evidence model"
   },
   {
    "@language": "en",
    "@value": "accrual coordination"
   },
   {
    "@language": "en",
    "@value": "contract terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accounted revenue with deferrals, cutoffs, and complete traceability into close"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Revenue on the books exactly when and as the approved model says, traceable to approved evidence."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 38 (2026-09-21). Reclassified to capability per review — dispute adjudication, continuous collection, periodic CECL estimation, and periodic prevention run concurrently with separate authorities (the standing capability test); canonical Receivables Resolution Separation Rule adopted verbatim as a durable financial-control decision; disputed-portion-only hold rule adopted verbatim. Preferred label 'Manage Receivables Resolution' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Manage Collection and Disputes' to 'Manage Receivables Resolution'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Collection and Disputes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that resolves what customers owe but have not paid: adjudicating disputed billed amounts against the evidence chain, collecting undisputed overdue receivables under the approved collection strategy, executing Finance-approved expected-credit-loss estimation and write-off processes, and turning dispute and collection patterns into root-cause action plans with the owning processes — concurrent controls with distinct authorities and cadences."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Responsible domain detail: Cross-functional — Finance / O2C Operations / Credit / Legal"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Receivables Resolution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Receivables Resolution Separation Rule: Manage Receivables Disputes adjudicates the validity of billed amounts using the governed evidence chain and authorized decision rights. Manage Receivables Collections recovers undisputed, due receivables under approved collection strategy and does not adjudicate validity, alter bills, grant credits, or write off debt. Finance determines expected-credit-loss allowances and authorizes/accounting-records write-offs under approved methodology and delegation. A billing correction, credit memo, refund, settlement adjustment, concession, or write-off must be initiated, approved, documented, and executed by its accountable process. No function may silently net, absorb, forgive, or reclassify a receivable outside approved rules and audit trails. Only the disputed component is held from collection where policy requires; undisputed amounts remain subject to collection. Credit exposure, availability, holds, and service treatment follow the applicable Credit policy and customer-specific decision. Cash recovered arrives only through the cash-application controls; payment plans and concessions only within the applicable Credit/Finance/Legal authority; agency and legal action only through Legal and executed agreements.\nIn scope: Dispute intake, investigation, and adjudication | collection strategy execution on undisputed receivables | Finance-approved allowance estimation and write-off execution | root-cause analysis and owner-agreed action plans | complete case and decision records\nOut of scope: Credit-memo and correction issuance (CM-1-3-8-1 controlled documents, on instruction) | cash application (CM-1-3-8-2) | credit limits and credit-driven closure (CM-1-3-7-4) | legal action conduct and debt-forgiveness advice (Legal) | allowance methodology and accounting elections (Finance governance) | service-request handling (CM-1-3-7-5)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance methodology and delegations"
   },
   {
    "@language": "en",
    "@value": "Routed disputes, short-pays, and deductions (b35/b36/b37)"
   },
   {
    "@language": "en",
    "@value": "overdue receivables and aging"
   },
   {
    "@language": "en",
    "@value": "the governed evidence chain (billing, fulfillment, contracts, tax)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Adjudicated disputes, recovered receivables, Finance-determined allowances and write-offs, and owner-agreed corrective actions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every unpaid dollar is either validly disputed, actively collected, or deliberately provided for — never ignored."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Cross-functional"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 38 (2026-09-21). Review commercial-concession routing rule adopted verbatim — concessions are never classified as dispute outcomes; disputed-portion hold rule per the L4. Preferred label 'Manage Receivables Disputes' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Dispute Management' to 'Manage Receivables Disputes'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20682"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Dispute Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Adjudicate disputed billed amounts: capture and classify disputes from all routes, investigate each against the evidence chain — billing documents, fulfillment and custody evidence, contracts and terms, tax determinations, credit memo and adjustment evidence, and applicable commercial policy — decide validity under the delegations of authority, and instruct the outcome: credit-memo or correction instruction for valid disputes, release to collection for invalid ones, with the customer informed through the service communication loop."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.3.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Receivables Disputes"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Adjudication on evidence, not negotiation: validity is decided against the governed evidence chain (the Billing Integrity Rule's records are the dispute record). Where a customer request seeks a goodwill adjustment, commercial concession, price accommodation, fee waiver, settlement compromise, or relationship remedy beyond the evidenced bill, Manage Receivables Disputes routes the request to the applicable Commercial, Credit, Finance, Legal, or delegated authority; it does not classify such concessions as a billing dispute outcome. During investigation the disputed portion is flagged per policy: Only the disputed component is held from collection where policy requires; undisputed amounts remain subject to collection. Credit exposure, availability, holds, and service treatment follow the applicable Credit policy and customer-specific decision. Valid outcomes execute only as instructions to billing's controlled documents (b36 credit-memo controls); this process issues nothing itself. Dispute categories and reason codes feed root-cause analysis; recurring disputes with a customer feed the credit and service reviews. When Manage Receivables Disputes (CM-1-3-8-3-1) adjudicates a dispute as invalid and releases the due amount to collection under applicable policy, it invokes Manage Receivables Collections (CM-1-3-8-3-2) for the released item; undisputed portions may be collected independently.\nIn scope: Dispute capture and classification from all routes | evidence-chain investigation | validity adjudication per DoA | credit-memo/correction instructions with documented basis | invalid-dispute release to collection | routing of concession requests to their authorities | customer communication through the service loop | dispute records and category data\nOut of scope: Credit memo and correction issuance (CM-1-3-8-1) | goodwill adjustments, concessions, and settlement compromises (Commercial; Credit; Finance; Legal; delegated authorities) | collection execution (CM-1-3-8-3-2) | service-request intake (CM-1-3-7-5, which routes here) | evidence creation (their owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Routed disputes and deductions"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "dispute policies"
   },
   {
    "@language": "en",
    "@value": "the governed evidence chain"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Adjudicated disputes with instructed outcomes, routed concessions, and complete decision records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every disputed dollar gets an evidence-based verdict, fast, with a controlled outcome."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 38 (2026-09-21). Review payment-plan vs concession refinement adopted verbatim; consumer-debt statement in the review's general form (no statute named — no source registered, per the unclaimed-property precedent; Legal/Compliance determine applicability). Preferred label 'Manage Receivables Collections' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Collection Management' to 'Manage Receivables Collections'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20682"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Collection Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute the approved collection strategy on undisputed, due receivables: run dunning and contact cycles by segment and aging, secure and track payment commitments, administer payment plans within pre-approved authority, escalate through the approved ladder to third-party agencies or legal referral, and keep the collection record complete."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.3.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Receivables Collections"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Recovery within everyone else's authority: Collection may present, administer, and monitor payment plans or settlement arrangements only within pre-approved Credit/Finance authority, standard terms, and delegated limits. Any concession, extension, interest waiver, fee waiver, reduced settlement, debt compromise, or non-standard plan requires the applicable Credit, Finance, Legal, or delegated approval. Disputed portions are held per policy while Manage Receivables Disputes adjudicates; collected cash arrives only through the cash-application controls — never handled directly; write-offs are Finance's and do not stop collection unless Finance and Legal so decide; agency placement and legal action route through Legal under executed agreements, with agency conduct governed by contract and law. Delinquency signals flow to Credit monitoring, credit-driven closure, and the card program's servicing processes (b29/b34 receiving ends). Where collected accounts involve consumer or individual obligors, applicable consumer debt-collection, privacy, and communication-conduct requirements may apply. Legal/Compliance determine applicability and required procedures.\nIn scope: Segmented dunning and contact cycles | payment commitment tracking | payment plan presentation, administration, and monitoring within pre-approved Credit/Finance authority, standard terms, and delegated limits | escalation ladder execution | agency placement and legal referral through Legal under executed agreements | collection records and performance data\nOut of scope: Dispute adjudication (CM-1-3-8-3-1) | bill adjustment and credits (CM-1-3-8-1, on instruction) | concessions, waivers, reduced settlements, and debt compromises beyond delegated limits (Credit; Finance; Legal; delegated approvals) | write-offs and allowances (CM-1-3-8-3-3; Finance) | cash handling and application (CM-1-3-8-2) | legal action conduct (Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Credit/Finance authority bounds"
   },
   {
    "@language": "en",
    "@value": "Legal procedures and agency agreements"
   },
   {
    "@language": "en",
    "@value": "Overdue undisputed receivables and aging"
   },
   {
    "@language": "en",
    "@value": "approved collection strategy and escalation ladder"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Recovered receivables, tracked commitments, and clean escalations with complete records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Due money comes in — systematically, lawfully, and without anyone's authority being borrowed."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/triggeredBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 38 (2026-09-21). Review Finance-authority definition adopted verbatim — this process executes Finance-approved estimation and write-off processes, it does not own the authority; write-off non-release clarification adopted verbatim. Preferred label 'Determine Bad Debt Allowance' recorded as alt label and queued (verb-led per the taxonomy convention). Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Bad Debt Allowance' to 'Determine Bad Debt Allowance'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10761"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-fasb-asc326-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Bad Debt Allowance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute Finance-approved expected-credit-loss estimation and write-off processes for trade receivables, using approved methodology, portfolio inputs, collection status, and forward-looking assumptions; prepare and record allowance and write-off outcomes under the applicable Finance delegation."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.3.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Determine Bad Debt Allowance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The Finance lock, home side: allowance methodology, estimates, impairment treatment, and write-off authority are Finance's — every earlier boundary that said so points here, and this process executes under that authority and the applicable Finance delegation. US GAAP context: expected credit losses on trade receivables follow the current expected credit loss model (Topic 326) as Finance's approved methodology applies it (SRC-FASB-ASC326-001 registered as context only). Inputs are supplied, not decided, by their owners: portfolio risk signals from Analyze Portfolio Credit Risk, program delinquency data from the card program, collection status from Manage Receivables Collections. A write-off is an accounting event, not debt forgiveness. A write-off does not automatically release collateral, cancel contractual rights, close a customer, stop collections, suspend legal recovery, or forgive debt; those actions require their own authorized decision. Recoveries on written-off amounts record per the approved treatment. Allowance and write-off activity delivers into period-end close.\nIn scope: Expected-credit-loss estimation per Finance-approved methodology with approved forward-looking assumptions | allowance preparation and recording through close | write-off preparation, decision recording, and posting per the Finance delegation | recovery treatment per approved policy | methodology input data assembly from owning processes | audit-ready estimation records\nOut of scope: Methodology setting, segmentation, model governance, and accounting elections (Finance governance) | collection and recovery execution (CM-1-3-8-3-2) | collateral release, contract cancellation, customer closure, collection cessation, and debt forgiveness (their own authorized decisions) | portfolio risk analysis (CM-1-3-7-4-4) | financial statement disclosure (Finance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-6-6"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Aging and loss experience"
   },
   {
    "@language": "en",
    "@value": "Finance-approved methodology and delegations"
   },
   {
    "@language": "en",
    "@value": "collection statuses"
   },
   {
    "@language": "en",
    "@value": "portfolio and program risk data (b34/b29)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Determined allowances and recorded write-offs, delivered through close with complete estimation evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The receivables on the books are worth what the books say — provably, per the approved model."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 38 (2026-09-21). Review action-plan discipline and root-cause category taxonomy adopted verbatim — plans bind only through owners' agreement and close only on owner evidence. Preferred label 'Develop Root-Cause Analyses and Action Plans' recorded as alt label and queued. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Develop Root Cause Analysis/Action Plan' to 'Develop Root-Cause Analyses and Action Plans'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/12046"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Develop Root Cause Analysis/Action Plan"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Turn dispute, deduction, and collection patterns into prevention: analyze the reason-coded evidence the resolution processes produce, identify root causes, develop action plans with the accountable owning processes, and track agreed actions to verified closure."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.3.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Root-Cause Analyses and Action Plans"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The analysis-and-inform rule applied to receivables friction: this process classifies causes from governed reason-code data (billing correction codes, application exception codes, dispute categories, collection outcomes), quantifies impact, and develops action plans with the owners. Root-cause categories include billing/invoice data; master data; price/discount/rebate conditions; tax determination; fulfillment/custody evidence; order validation/allocation; contract/terms; card/payment processing; cash/remittance/application; collections/credit; customer/service communication; and system/integration/data-quality defects. Action plans identify the accountable owner, due date, control/change path, validation evidence, and closure criteria. This process tracks commitments but does not implement changes, waive controls, approve remediation on behalf of owners, or close actions without owner evidence. Billing errors are billing's to fix, evidence gaps fulfillment's, credit-policy gaps Credit's, pricing errors pricing's, service failures the service capability's. Metrics produced are evidence-layer; candidate KPIs route via the KPI Store. Systemic findings suggesting control failures or abuse escalate to the accountable control owners. When the root-cause finding concerns an approved credit-policy criterion or rule, Develop Root-Cause Analyses and Action Plans (CM-1-3-8-3-4) provides credit-policy gap findings, collection patterns, and proposed prevention actions to inform Maintain Credit Policies (CM-1-3-7-4-1); the recipient retains its own decisions.\nIn scope: Cross-process pattern analysis from governed reason-code data | root-cause classification across the approved category taxonomy and impact quantification | owner-agreed action plans with accountable owner, due date, control/change path, validation evidence, and closure criteria | commitment tracking to owner-evidenced closure | systemic-finding escalation | evidence-layer prevention metrics\nOut of scope: Implementing changes, waiving controls, approving remediation on owners' behalf, or closing actions without owner evidence (Owning processes and their change controls) | dispute adjudication and collection execution (Manage Receivables Disputes; Manage Receivables Collections) | KPI approval/publication (Enterprise measurement governance) | control ownership (Accountable control owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-5"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Reason-coded dispute, correction, exception, and collection data"
   },
   {
    "@language": "en",
    "@value": "impact data"
   },
   {
    "@language": "en",
    "@value": "owning-process context"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Root-cause findings and owner-agreed, owner-evidenced, tracked action plans"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The same dispute never happens twice for the same reason — because its owner fixed it."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16463"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that closes and evidences O2C's books and obligations: running period-end processing on the Finance calendar, reconciling receivables to the general ledger with control evidence, analyzing and calculating accruals, reconciling and preparing indirect-tax reporting, preparing taxability-treatment recommendations for Tax approval, executing intercompany invoicing per approved transfer-pricing policies, and administering royalty, brand-fee, and contribution streams under executed agreements."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Capability per the concurrent-control test; canonical Accounting Execution Rule adopted verbatim as a durable rule, with the review's qualified close-exception wording replacing the absolute form; responsible_domain includes Commercial Administration per review (royalty/fee and agreement obligations operationally owned there)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#note": [
   {
    "@language": "en",
    "@value": "Responsible domain detail: Cross-functional — Finance / Tax / O2C Operations / Legal / Commercial Administration"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Accounting, Regulatory Reporting and Compliance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Accounting Execution Rule: O2C accounting, reconciliation, accrual calculation, tax-reporting preparation, intercompany invoicing, and royalty/fee administration execute under Finance- and Tax-approved policies, methodologies, calendars, agreements, delegations, and controlled evidence requirements. Finance and Tax retain policy, accounting/tax interpretation, elections, filing ownership, sign-off authority, and financial-statement responsibility. Period-end close proceeds only with complete, reconciled, evidenced inputs from feeding processes or a documented Finance-approved close exception. Prepared reports, returns, intercompany documents, and administered obligation streams retain evidence lineage to governed transaction, master-data, agreement, billing, cash, and accounting records. No period closes over a missing, unresolved, or unreconciled material feed without a documented Finance-approved exception, compensating control, owner, resolution plan, and aging/true-up requirement. Enterprise financial statements, disclosure, statutory filing ownership, and audit relationships remain with Finance; tax positions and filings with Tax; enterprise regulatory compliance outside commercial-agreement and tax-reporting scope with its accountable functions (the batch 30 narrow-compliance precedent).\nIn scope: Period-end processing on the Finance calendar | AR-to-GL reconciliation with O2C control evidence | accrual analysis and calculation per approved methodologies | indirect-tax reconciliation and reporting preparation | taxability-treatment recommendations under Tax authority | intercompany invoicing per approved policies and agreements | royalty, brand-fee, and contribution stream administration\nOut of scope: Accounting policy, elections, and interpretations (Finance) | tax positions, filings, and interpretations (Tax) | financial statements, disclosure, and audit relationships (Finance) | enterprise regulatory compliance beyond this scope (Accountable functions) | billing, cash application, and collections execution (CM-1-3-8-1/-2/-3) | funds movement (Finance/Treasury; payment-authority rule)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Feeds and evidence from billing, cash application, allowances, and resolution processes"
   },
   {
    "@language": "en",
    "@value": "Finance/Tax policies, calendars, and methodologies"
   },
   {
    "@language": "en",
    "@value": "executed agreements"
   },
   {
    "@language": "en",
    "@value": "governed master data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Closed periods, reconciled and evidenced positions, prepared reports and filings, and administered obligation streams"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "O2C's books close on time, reconciled, evidenced, and compliant — with every exception documented and owned."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Cross-functional"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review close-control artifact list and qualified exception wording adopted verbatim — exceptions need documentation, compensating control, owner, resolution plan, and aging/true-up. Preferred label 'Perform Period-End Processing' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Period End Processing' to 'Perform Period-End Processing'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10822"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Period End Processing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Run O2C period-end close on the Finance-approved calendar: verify completeness and reconciliation evidence from every feeding process, process period-end adjustments under approved authority, enforce cutoff across billing, receipts, accruals, and corrections, and deliver the closed O2C position into Finance's consolidation with its evidence chain."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Period-End Processing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Close on evidence: the close verifies each feed — billing runs complete, applications and reconciliations current, allowances and write-offs recorded, accruals calculated, tax reconciled, intercompany issued. No period closes over a missing, unresolved, or unreconciled material feed without a documented Finance-approved exception, compensating control, owner, resolution plan, and aging/true-up requirement. Close-control artifacts include the close checklist, feed certifications, reconciliation status, the exception log, adjustment journal support, materiality assessment, owner sign-offs, true-up plans, and post-close review. Adjustments are controlled events under the delegations; cutoff enforcement follows the accounting-period controls. The Finance close calendar, formal sign-off, consolidation, and statement production are Finance's; this process delivers O2C's closed, evidenced position into them. When verifying the AR-to-GL reconciliation feed for the applicable period, Perform Period-End Processing (CM-1-3-8-4-1) consumes reconciliation status and control evidence from Perform AR Reconciliation and Compliance (CM-1-3-8-4-2).\nIn scope: Close-calendar execution for O2C | feed completeness and reconciliation verification with certifications | period-end adjustments under approved authority with journal support | cutoff enforcement | documented Finance-approved exceptions with compensating controls, owners, resolution plans, and aging/true-up requirements | delivery of the closed position with evidence into consolidation | post-close review\nOut of scope: Close calendar, policy, and formal sign-off ownership (Finance) | consolidation and statements (Finance) | the feeding processes' own work (Their owners) | undocumented closes over material gaps"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance close calendar and policies"
   },
   {
    "@language": "en",
    "@value": "delegations of authority"
   },
   {
    "@language": "en",
    "@value": "feed evidence and certifications from all O2C financial processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "A closed, evidenced, reconciled O2C period delivered into consolidation with a complete exception log"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The period closes when the evidence says it can — and exceptions are Finance's explicit, controlled choice."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review compliance-label clarification adopted verbatim — 'compliance' here means O2C accounting-control operation evidence only, preventing collision with the enterprise and commercial-agreement compliance clusters. Preferred label 'Perform AR Reconciliation and Compliance' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'AR Reconciliation / Compliance' to 'Perform AR Reconciliation and Compliance'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/17467"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "AR Reconciliation / Compliance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile the receivables subledger to the general ledger each period, resolve reconciling items through their owning processes, maintain the evidence that the O2C financial controls operated as designed, and support internal and external audit with governed records."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform AR Reconciliation and Compliance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Compliance in this process denotes evidence that prescribed O2C accounting controls operated as designed. It does not own enterprise regulatory compliance, Tax compliance, SOX design, Internal Audit assurance, or control-framework policy. Period reconciliation on daily foundations: the daily reconciled positions (b37) roll into period AR-to-GL reconciliation here; reconciling items are exception items with owners and aging (the standing discipline), resolved through their owning processes — never by plug or unexplained adjustment. Control design and the control framework are Finance's; independent assurance is Internal Audit's (the batch 30 distinction). Audit support supplies governed records and evidence; it makes no representations beyond them.\nIn scope: Period AR subledger-to-GL reconciliation | reconciling-item ownership, aging, and resolution routing | O2C financial-control operation evidence assembly | internal/external audit support with governed records\nOut of scope: Enterprise regulatory compliance, Tax compliance, SOX design, and control-framework policy (Finance; Accountable compliance functions) | independent assurance (Internal Audit) | GL ownership (Finance) | reconciling-item fixes in owning processes (Their controls) | unexplained adjustments"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-4"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-2-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Daily reconciled positions (b37)"
   },
   {
    "@language": "en",
    "@value": "GL balances"
   },
   {
    "@language": "en",
    "@value": "audit requests"
   },
   {
    "@language": "en",
    "@value": "control operation records"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Completed period reconciliations with resolved or owned items and assembled control-operation evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The subledger, the ledger, and the control evidence agree — and every difference has an owner."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review accrual scope list and distinction sentence adopted verbatim. Preferred label 'Analyze and Calculate Accruals' recorded as alt label and queued. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Accruals Analysis And Calculation' to 'Analyze and Calculate Accruals'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16463"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Accruals Analysis And Calculation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Analyze and calculate the O2C accruals each period under Finance-approved methodologies: rebate and discount accruals, returns and allowances, loyalty liabilities, unbilled revenue and costs, variable consideration, promotional and brand-fund obligations, royalty and fee liabilities, and freight and service charges where applicable — delivering calculated, evidenced accruals and true-ups into close."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Analyze and Calculate Accruals"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Accrual calculation distinguishes operational estimates, contractual obligations, Finance-approved assumptions, and accounting true-ups. It does not establish methodology, approve estimates, or make revenue-recognition conclusions. Calculation under authority: methodologies, estimates policy, and accounting treatment are Finance's; this process applies them to governed data — rebate arrangements and settlement history, loyalty program records, revenue variable consideration (b37 coordination), billing and fulfillment evidence — and never invents a methodology or books an unapproved estimate. True-ups reconcile accruals to actual settlements through controlled adjustments with full audit trails; systematic true-up bias routes to methodology review with Finance. Every accrual traces to its arrangement, data, and methodology.\nIn scope: Rebate, discount, returns, allowance, loyalty, unbilled, variable-consideration, fund, royalty/fee, and applicable freight/service accrual calculation per approved methodologies | operational-estimate vs contractual-obligation vs true-up distinction | settlement true-ups through controlled adjustments | methodology-input evidence and bias routing | delivery into close\nOut of scope: Methodology and estimates policy, estimate approval, and revenue-recognition conclusions (Finance) | revenue recognition execution (CM-1-3-8-2-6) | rebate and program decisions (Their owners) | settlement execution (Their processes)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Arrangement terms and performance data"
   },
   {
    "@language": "en",
    "@value": "Finance methodologies"
   },
   {
    "@language": "en",
    "@value": "program records"
   },
   {
    "@language": "en",
    "@value": "settlement actuals"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Calculated, evidenced accruals and true-ups delivered into close"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every obligation the business has earned into existence is measured, evidenced, and on the books."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10881"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-irs-p510-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile O2C indirect taxes each period and prepare their reporting: reconcile transaction tax lines and governed tax data to the amounts reportable and remittable by tax type and jurisdiction — excise, sales and use, VAT/GST as applicable — prepare returns and reports per the Tax function's direction, and support remittance through the authorized payment process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review tax amount-category and lineage/approval requirements adopted verbatim; SRC-IRS-P510-001 scoped to federal fuel-excise context only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Reconcile And Report Indirect Tax"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Reconcile and prepare, never file on own authority: filing and remittance obligations, forms, cadences, and positions are jurisdiction-dependent and determined by the Tax function; this process reconciles transaction-level tax data (b36 tax lines, b31 governed tax master data) to reportable amounts, investigates and resolves differences through the owning processes' controlled corrections, and hands remittance to the authorized payment process (payment-authority rule). Tax reconciliation distinguishes tax collected, tax accrued, tax payable, tax recoverable, exempt, refunded, credited, self-billed, and adjusted amounts according to Tax-approved treatment. Prepared tax reports and return support preserve source transaction lineage, jurisdiction/rate version, exemption/certificate evidence, adjustments, reconciliation differences, preparer/reviewer evidence, and Tax-owner approval. Federal fuel-excise context per the registered IRS Publication 510 source — federal scope only. Exemption-certificate and treatment discrepancies route to the compliance-side taxability process and Tax.\nIn scope: Period indirect-tax reconciliation by type and jurisdiction, distinguishing collected, accrued, payable, recoverable, exempt, refunded, credited, self-billed, and adjusted amounts per Tax-approved treatment | difference investigation and routing to controlled corrections | return and report preparation per Tax direction with preserved lineage, evidence, and preparer/reviewer/Tax-owner approvals | remittance support through the authorized payment process | reconciliation records for audit\nOut of scope: Tax positions, filings ownership, rulings, and interpretations (Tax function) | remittance execution (Finance/Treasury; payment-authority rule) | transaction tax determination (CM-1-3-8-1-3) | tax master data changes (Governed submission; CM-1-3-7-1-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Tax function directions and calendars"
   },
   {
    "@language": "en",
    "@value": "Transaction tax lines (b36)"
   },
   {
    "@language": "en",
    "@value": "governed tax master data (b31)"
   },
   {
    "@language": "en",
    "@value": "remittance processes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Reconciled indirect-tax positions and prepared, evidenced, Tax-approved returns and reports"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every tax dollar collected or owed is reconciled, prepared, and evidenced exactly as Tax directs."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10196"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Determine Taxability for Tax Compliance and Reporting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Assess and prepare taxability-treatment recommendations for Tax approval, including new or changed product, channel, jurisdiction, exemption, and exception classes; evaluate reporting/remittance implications; and coordinate approved treatment changes into governed tax data and procedures."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review recast adopted verbatim — this process assesses and prepares recommendations for Tax approval; its output is a Tax-approved treatment record. The batch 36 reserved label 'Determine Taxability for Tax Compliance and Reporting' recorded as alt label, completing the duplicate-name normalization queue. Review preferred an 'informs'/'requires: Tax approval' relation — 'informs' is vocabulary-missing and 'Tax approval' is not a taxonomy concept (b10/b23 precedent): recorded here verbatim, with the scope note carrying the Tax-approval gate and the enables-relation meaning governed submission of Tax-approved changes only."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Determine Taxability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The compliance-side half of the batch 36 split: the transaction-time process (CM-1-3-8-1-3) applies determinations per transaction; this process assesses treatment correctness at class level, resolves exception classes the transaction process holds and routes, and prepares treatment recommendations — its output is a Tax-approved treatment record, never an autonomous determination. Tax positions, law interpretations, rulings requests, and filings are Tax's, and no treatment takes effect except through Tax approval and governed tax master data submission (the batch 31 rule) — the relation to tax master data means exactly that: Tax-approved treatment changes submitted through governed procedures, nothing else. Treatment reviews run on event triggers — new products or channels, law changes as Tax interprets them, exception-class accumulations, audit findings — with periodic class-level reviews within. Maintain Tax Master Data (CM-1-3-7-1-4) records the approved taxability treatments that Determine Taxability (CM-1-3-8-4-5) prepares and Tax approves.\nIn scope: Class-level taxability treatment assessment against Tax positions | treatment recommendations for Tax approval covering new/changed products, channels, jurisdictions, exemption and exception classes | exception-class resolution routed from transaction determination | reporting and remittance implication assessment | coordination of Tax-approved treatment changes into governed tax data and procedures\nOut of scope: Tax positions, interpretations, rulings, and filings (Tax function) | autonomous treatment determinations | per-transaction determination (CM-1-3-8-1-3) | tax master data stewardship (CM-1-3-7-1-4) | treatment effect outside Tax approval and governed submission"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Tax positions and interpretations"
   },
   {
    "@language": "en",
    "@value": "exception classes and audit findings"
   },
   {
    "@language": "en",
    "@value": "governed tax data"
   },
   {
    "@language": "en",
    "@value": "product/channel/jurisdiction changes"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Tax-approved taxability treatment records flowing into governed tax master data with assessment evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The treatments transactions are taxed by are current, correct, and Tax-approved — before the transactions happen."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11743"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Execute intercompany invoicing between legal entities: invoice intercompany product transfers, services, and charges per the approved transfer-pricing policies and executed intercompany agreements, on the approved cycles, with the evidence and documentation the policies require, and support Finance's reconciliation, elimination, and consolidation."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review intercompany invoice-content and dispute-routing statements adopted verbatim; supports consolidation, never performs it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Intercompany Invoicing"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Execution per approved basis: transfer-pricing policy, arm's-length methodology, and the tax positions behind them are Tax's and Finance's; intercompany agreements are executed through the contracting and Legal processes; this process invoices exactly per the approved basis and agreements, prices nothing, and interprets nothing — pricing or treatment questions route to Tax/Finance. Intercompany invoices identify the legal entities, transaction type, product/service, transfer-pricing basis, tax treatment, currency, accounting period, agreement reference, and supporting evidence required by the approved intercompany policy. Intercompany billing differences are reconciled under approved Finance intercompany procedures; material tax, transfer-pricing, agreement, or accounting disagreements escalate to Finance, Tax, Legal, or the designated intercompany governance owner. Fact-dependent statement: arm's-length and intercompany documentation requirements under applicable tax law are jurisdiction-dependent and determined by Tax and Legal; invoicing and documentation follow their direction. Eliminations and consolidation are performed by Finance; this process supports them with reconciled balances and evidence.\nIn scope: Intercompany invoicing per approved transfer-pricing basis and executed agreements, identifying entities, transaction type, product/service, basis, tax treatment, currency, period, agreement reference, and required evidence | required documentation per Tax/Legal direction | bilateral balance reconciliation on approved cadence under Finance intercompany procedures | escalation of material disagreements to Finance, Tax, Legal, or the intercompany governance owner | consolidation and elimination support\nOut of scope: Transfer-pricing policy and arm's-length methodology (Tax; Finance) | intercompany agreement terms (Contracting; Legal) | eliminations and consolidation performance (Finance) | tax positions and documentation standards (Tax; Legal)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Approved transfer-pricing policies"
   },
   {
    "@language": "en",
    "@value": "Finance/Tax direction"
   },
   {
    "@language": "en",
    "@value": "executed intercompany agreements"
   },
   {
    "@language": "en",
    "@value": "intercompany activity data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Issued intercompany invoices with required documentation and reconciled balances"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Entities bill each other exactly per the approved basis, evidenced, reconciled, and ready to eliminate."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4-7",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 39 (2026-09-21). Review administered-funds record distinctions and contested-obligation routing adopted verbatim. Preferred label 'Administer Royalty, Brand Fee, and Contribution Streams' recorded as alt label and queued — removes the ambiguity with the collections process; administration here, collection execution in CM-1-3-8-3. Step 3d naming pass — scope-ambiguity Batch 3 (E+F, 2026-09-21): renamed from 'Manage Collection of Royalty and Fees' to 'Administer Royalty, Brand Fee, and Contribution Streams'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16463"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-pmpa-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Collection of Royalty and Fees"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-8-4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Administer the royalty, brand-fee, and contribution streams owed under franchise, license, and partner agreements: compute amounts due from validated reported sales and agreement terms, invoice them through the billing controls, track and support their collection through the receivables processes, apply audit-finding adjustments, and account for administered funds per the agreements and Finance's treatment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.8.4.7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Administer Royalty, Brand Fee, and Contribution Streams"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The batch 30 audit's receiving end: royalty and fee bases are validated reported sales — computation uses the figures the commercial audit validates, and audit-finding discrepancies adjust through controlled corrections per the batch 30 routing. Royalty, brand-fee, contribution, and fund-administration records distinguish amount earned, billed, collected, credited, disputed, held, due to third parties, and available for approved use. Fund usage and disbursement require agreement-based governance and Finance-authorized treatment. Where royalty, fee, or contribution obligations are contested, the process routes the matter to Commercial Agreement Compliance, Relationship Management, Collections/Disputes, Legal, or Finance according to whether the issue concerns reported-sales integrity, billing, collection, agreement interpretation, remedy, or accounting. Invoicing executes through the billing controls (b36), collection through the receivables machinery (b37/b38) — this process administers the stream and never bills or collects outside those controls; the payment-authority rule applies throughout. Fact-dependent statement: where a remedy would affect a franchise relationship governed by the Petroleum Marketing Practices Act, the determination is reserved to Legal. When an administered royalty, fee, or contribution event is due for invoicing under its agreement, Administer Royalty, Brand Fee, and Contribution Streams (CM-1-3-8-4-7) supplies validated royalty, brand-fee, and contribution amounts with agreement and tax references that Create and Distribute Bill (CM-1-3-8-1-1) consumes in its defined work. When the close includes a royalty, brand-fee, contribution, or administered-fund stream handled by the source, Administer Royalty, Brand Fee, and Contribution Streams (CM-1-3-8-4-7) supplies period accounting, reconciliation, administered-fund, and adjustment evidence that Perform Period-End Processing (CM-1-3-8-4-1) consumes in its defined work.\nIn scope: Royalty, fee, and contribution computation from validated reported sales and agreement terms | invoicing through billing controls | collection tracking and support through receivables processes | audit-finding adjustment application through controlled corrections | stream records distinguishing earned, billed, collected, credited, disputed, held, due-to-third-party, and available-for-approved-use amounts | administered-fund accounting per agreements and Finance-authorized treatment | contested-obligation routing per issue type\nOut of scope: Reported-sales validation (CM-1-3-6-8-1) | agreement terms, interpretation, and enforcement (Relationship management; Legal; PMPA fact-dependence for franchise remedies) | billing and collection execution (CM-1-3-8-1/-2/-3) | fund usage and disbursement decisions (Agreement-based governance; Finance) | funds movement (Finance/Treasury)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-8-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-8"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Finance treatment directions"
   },
   {
    "@language": "en",
    "@value": "Validated reported sales (b30)"
   },
   {
    "@language": "en",
    "@value": "audit findings"
   },
   {
    "@language": "en",
    "@value": "executed agreements and terms"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Computed, invoiced, tracked royalty and fee streams with audit-adjusted, agreement-compliant fund accounting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every royalty and fee the agreements earn is computed from validated figures, billed, collected, and accounted — to the letter of the agreements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Customer service & support consist of processes such as all support & service offerings to consumers & business partners both from a conceptual & operational view. It ranges from defining the methods of interaction (e.g., on site, call center, web), along defining, setting up & operating facilities & technology down to managing service staff."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Customer Service & Support"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20875"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that builds and runs the machinery of commercial service and support: defining the service operating model, managing day-to-day service operations, and managing the workforce, facilities, technology, and contact-center channel the service processes run on."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Capability per the concurrent-control test; canonical four-part request/enable/deliver/measure rule and delivery-model domain note adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Service & Support Enablement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Customer Requests and Inquiries owns the request experience: intake, case record, prioritization, routing, status communication, follow-up, and closure coordination. Service & Support Enablement provides the service machinery: operating model, service operations, workforce, facilities, technology, and contact-center channel. Service & Support Delivery fulfills service events: delivery data, customer interaction during service, entitlement verification, service execution, completion evidence, and return of outcomes to the request case. Service & Support Measurement measures service resources and outcomes: infrastructure, workforce operational data, and service effectiveness. Service and Support spans Commercial, Operations, Technology, Facilities, HR, Security, Quality, EHS, and third-party providers. Taxonomy placement in Commercial & Marketing reflects the commercial service context; it does not establish operational ownership of every service resource or service event. Corporate-function boundaries throughout: HR owns employment frameworks; IT owns platforms and technical operations (the batch 31 distinction); corporate Facilities/Real Estate owns leases, capital works, and building operations; EHS owns safety requirements; Security owns access and verification standards. This capability manages the business/occupant side of each and creates no authority the owners hold.\nIn scope: Service operating model definition and maintenance | service operations management | workforce planning, scheduling, and readiness within HR frameworks | occupant-side facilities management | business ownership of service technology | contact-center channel operation\nOut of scope: The customer-request experience (CM-1-3-7-5) | employment policy, compensation, performance management, discipline (HR; line management under HR authority) | platform and technical operations (IT) | leases, capital works, building operations (Corporate facilities) | safety requirements (EHS) | service delivery and measurement (CM-1-3-9-2/-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-2-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "HR, IT, Facilities, EHS, Security frameworks"
   },
   {
    "@language": "en",
    "@value": "Service demand signals (CM-1-3-7-5; channels)"
   },
   {
    "@language": "en",
    "@value": "approved budgets and plans"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "An operating service organization: model, operations, workforce, facilities, technology, and channel"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The service machinery exists, runs, and stays fit — so requests and events can be served."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19551"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Define and maintain the service operating model. The model defines service scope, channels, operating hours, service tiers, escalation paths, roles, service-level design assumptions, and knowledge/procedure requirements. Contractually committed service levels require commercial-terms approval and cannot be created solely by the operating model. Approved through the accountable governance and published as controlled content."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review model-content and commercial-terms-approval sentences adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Define Operating Model"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Blueprint, not decree (the batch 24 operating-model pattern): the model is developed with the owning functions and approved through the accountable governance; procedures publish as controlled documents. Contractually committed service levels flow only through the commercial-terms processes. Technology implications route to Manage Technology and IT; people implications to HR frameworks. Changes are event-driven with periodic review.\nIn scope: Service scope, channels, hours, tiers, escalation paths, roles, service-level design assumptions, and knowledge/procedure requirements | governance approval coordination | controlled publication | periodic model review\nOut of scope: Contractual service-level commitments (Commercial terms processes) | employment frameworks (HR) | platform decisions (IT) | the operation itself (CM-1-3-9-1-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Service strategy and demand patterns"
   },
   {
    "@language": "en",
    "@value": "governance approvals"
   },
   {
    "@language": "en",
    "@value": "owning-function input (HR, IT, Facilities, EHS)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The approved, published service operating model and its controlled procedures"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One approved, published model the whole service operation runs on."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review incident-escalation sentence adopted verbatim. Preferred label 'Manage Service Operations' recorded as alt label and queued. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Manage Operations' to 'Manage Service Operations'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10734"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Run the service operation day to day: plan and schedule capacity against demand, balance workload across teams and channels, monitor operational quality and service-level attainment in real time, and manage operational incidents and escalations within the operating model."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Service Operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Operates the model, never redefines it (changes route to Define Operating Model). Operational incidents are triaged according to the service operating model. Product-quality, safety, environmental, security, fraud, regulatory, or major continuity incidents follow immediate escalation protocols and are not resolved solely through service operations. Demand signals come from the request capability and order/portal channels; capacity actions on people route through Manage Service Employees within HR frameworks; technology incidents route to IT per the batch 31 split. Operational metrics are evidence-layer (KPI Store boundary).\nIn scope: Capacity planning and scheduling against demand | workload balancing across teams and channels | real-time quality and service-level monitoring | operational incident triage per the operating model with immediate escalation of quality/safety/security/fraud/regulatory/continuity incidents to their protocols\nOut of scope: Operating-model changes (CM-1-3-9-1-1) | substantive incident resolution for escalated categories (Quality; EHS; Security; their protocols) | employment actions (HR) | technology operations (IT)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "The operating model"
   },
   {
    "@language": "en",
    "@value": "demand signals"
   },
   {
    "@language": "en",
    "@value": "operational telemetry"
   },
   {
    "@language": "en",
    "@value": "workforce availability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "A running operation at service level with correctly routed incidents"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The service operation meets its levels every day, and the wrong incidents never stay in service hands."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20085"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the service workforce operationally: plan staffing against forecast demand, schedule and roster within applicable rules, maintain skills and readiness through training coordination, and support the workforce day to day — all within the HR-owned employment frameworks."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review workforce-planning boundary and third-party worker condition adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Service Employees"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Service workforce planning may identify workload, skill, coverage, shift, queue, capacity, and training needs. It does not establish employment status, job classification, compensation, individual performance rating, promotion, disciplinary action, employee relations treatment, or employment termination. Scheduling honors applicable working-time rules as HR/Legal direct. Training content follows the batch 35 content-authority rule (delivery from approved content). Where service is delivered by third parties, workforce oversight is limited to contractually authorized service-capability, qualification, and performance requirements; employment terms remain with the provider. Employee personal data is governed under the enterprise personal-data governance framework.\nIn scope: Staffing plans against forecast demand | scheduling and rostering within applicable rules | skills and readiness development from approved content | day-to-day workforce support | contractually authorized capability/qualification/performance oversight of third-party service workers\nOut of scope: Employment status, classification, compensation, ratings, promotion, discipline, employee relations, termination (HR; line management under HR authority) | third-party employment terms (The provider) | safety/regulatory training authority (Accountable content frameworks)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Demand forecasts"
   },
   {
    "@language": "en",
    "@value": "HR frameworks and working-time rules"
   },
   {
    "@language": "en",
    "@value": "approved training content"
   },
   {
    "@language": "en",
    "@value": "provider contracts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "A staffed, scheduled, ready service workforce within HR frameworks"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The right people, ready and scheduled — without ever borrowing HR's authority."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10949"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage service locations from the occupant side: define space and workplace needs, coordinate readiness, upkeep requests, and moves with the corporate facilities owners, and coordinate safety and access compliance with EHS and Security at service sites."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review occupant-side boundary and safety-escalation sentences adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Facilities"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Occupant, not landlord: Service Facilities management coordinates occupancy readiness, layout/workplace requirements, equipment needs, site-access requirements, and operational fitness. It does not approve leases, capital projects, construction, landlord contracts, building maintenance, or safety standards. Facility readiness findings that indicate safety, accessibility, security, environmental, or emergency concerns are escalated to the accountable EHS, Security, Facilities, or Operations owner. This process states needs, coordinates, and verifies fitness for service operations — it contracts and builds nothing.\nIn scope: Occupancy readiness coordination | layout/workplace and equipment requirements | site-access requirements coordination with Security | operational-fitness verification | escalation of safety, accessibility, security, environmental, and emergency findings to their owners\nOut of scope: Leases, capital projects, construction, landlord contracts, building maintenance (Corporate facilities/Real Estate) | safety standards (EHS) | access-control standards (Security)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "EHS and Security requirements"
   },
   {
    "@language": "en",
    "@value": "Operating model and capacity plans"
   },
   {
    "@language": "en",
    "@value": "corporate facilities services"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Service-ready locations with coordinated, escalated findings"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every service site fit for the operation — with the owners owning what's theirs."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20607"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Own the service operation's technology from the business side: define requirements and business configuration for service platforms (case, telephony, knowledge, workforce tools), drive adoption and fit-for-purpose use, and feed the service capability roadmap — with IT owning the platforms themselves."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review Enablement/IT split and data-control compliance sentences adopted verbatim; batch 31 technical-controls distinction applied to service platforms."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Technology"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Service Enablement owns business requirements, approved business configuration, workflow/knowledge requirements, adoption, and service-roadmap input. IT owns application/platform administration, identity/security, integration operation, release/deployment, technical monitoring, recovery, backup, and technical incident management. Business requirements for knowledge, case, service, telephony, workforce, and self-service tools must comply with approved data, privacy, retention, security, and integration controls. Configuration changes follow the governed change controls; workflow-authority content follows the batch 31 workflow rule (configurations implement approved authority, never create it).\nIn scope: Business requirements and approved business configuration for service platforms | workflow/knowledge requirements under approved data, privacy, retention, security, and integration controls | adoption and fit-for-purpose management | service-roadmap input\nOut of scope: Application/platform administration, identity/security, integration operation, release/deployment, technical monitoring, recovery, backup, technical incident management (IT) | authority creation via configuration (DoA governance owners) | data/privacy control standards (Their owners)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "IT services and controls"
   },
   {
    "@language": "en",
    "@value": "The operating model"
   },
   {
    "@language": "en",
    "@value": "governed change controls"
   },
   {
    "@language": "en",
    "@value": "user and process needs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Fit-for-purpose, adopted service technology with governed business configuration"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Service technology that fits the operation — with IT's authority intact."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-6",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20085"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Operate the contact-center channel for commercial service: manage capacity, queues, and routing across voice and digital contact channels, run channel operations to the service levels, monitor interaction quality, and provide the channel through which the customer-request processes work."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review channel does-not-own list, accessibility/vulnerable-customer sentence, and refined recording/monitoring statement adopted verbatim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.1.6"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Contact Center"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Channel, not case owner: the contact center is the channel the batch 35 request capability works through — the batch 32 channel rule applies (a channel entry point, never an alternate control path). Contact Center operations may manage workforce routing, queue configuration requirements, service-channel capacity, quality monitoring, and approved scripts/knowledge delivery. It does not own case decisions, credit decisions, refunds, order changes, complaint adjudication, consent, or legal determinations. Contact-center channel design may include accessibility, language, communication preference, emergency escalation, and vulnerable-customer requirements where approved by the accountable Legal/Compliance/Customer Experience owners. Telephony/platform operations are IT's per the batch 31 split. Fact-dependent statement: Where voice, chat, video, screen, or other customer interactions are recorded, monitored, transcribed, or analyzed, applicable notice, consent, retention, monitoring, biometric, labor, privacy, and jurisdictional requirements are determined by Legal, Privacy, HR, and Compliance. Contact-center operations implement the approved controls. Interaction personal data is governed under the enterprise personal-data governance framework. When the inquiry is handled through the contact-center channel, Manage Contact Center (CM-1-3-9-1-6) maintains the contact-center capacity, queues, routing, and approved channel operations that Process Inquiries and Requests (CM-1-3-7-5-3) needs to operate its defined process path.\nIn scope: Channel capacity, queue, and routing management | workforce routing and queue configuration requirements | channel operations to service levels | interaction quality monitoring | approved scripts and knowledge delivery | approved accessibility, language, preference, emergency, and vulnerable-customer requirements\nOut of scope: Case decisions, credit decisions, refunds, order changes, complaint adjudication, consent, legal determinations (Their owning processes) | telephony/platform operations (IT) | recording/monitoring requirement determination (Legal; Privacy; HR; Compliance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Legal/Privacy-approved recording controls"
   },
   {
    "@language": "en",
    "@value": "The operating model and service levels"
   },
   {
    "@language": "en",
    "@value": "approved scripts/knowledge"
   },
   {
    "@language": "en",
    "@value": "workforce schedules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "An operating contact channel at service level with quality-monitored, compliant interactions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "A channel that always answers — and never decides."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Reclassified to capability per review — delivery data, customer interaction, and event fulfillment are concurrent controls, not a strict sequence; case-to-service-event linkage and billable-service evidence rules adopted verbatim."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20059"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The capability that executes commercial service work: maintaining the data service delivery runs on, managing the customer interaction during delivery, and fulfilling service events routed from the request capability — concurrent delivery controls operating through to evidenced completion."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Service & Support Delivery"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Customer Requests and Inquiries owns the request experience: intake, case record, prioritization, routing, status communication, follow-up, and closure coordination. Service & Support Enablement provides the service machinery: operating model, service operations, workforce, facilities, technology, and contact-center channel. Service & Support Delivery fulfills service events: delivery data, customer interaction during service, entitlement verification, service execution, completion evidence, and return of outcomes to the request case. Service & Support Measurement measures service resources and outcomes: infrastructure, workforce operational data, and service effectiveness. One customer request may produce zero, one, or many service events. Each service event is linked to the originating case where applicable, but the service event is not itself a new customer-request case. Completion evidence returns to the case record and, where billable, to Billing. Service and Support spans Commercial, Operations, Technology, Facilities, HR, Security, Quality, EHS, and third-party providers. Taxonomy placement in Commercial & Marketing reflects the commercial service context; it does not establish operational ownership of every service resource or service event. A billable service event is invoiced only from approved service-completion evidence, entitlement/contract terms, applicable pricing/tax data, and any required customer acceptance or service confirmation. Service Delivery does not create prices, credits, tax outcomes, or invoices. Delivery operates within entitlements and agreements; it creates no terms, prices, credits, or master data (governed submission only), and honors the governed-answer rule in all customer communication. When the service event is billable and the applicable approved completion and acceptance evidence is available, Service & Support Delivery (CM-1-3-9-2) supplies approved billable service-event completion and entitlement evidence that Create and Distribute Bill (CM-1-3-8-1-1) consumes in its defined work.\nIn scope: Service delivery data stewardship | customer interaction during delivery | service event fulfillment with entitlement verification | completion evidence capture and return to the case and, where billable, to Billing\nOut of scope: The request/case experience (CM-1-3-7-5) | prices, credits, tax outcomes, and invoices (Their owning processes; CM-1-3-8-1) | master data (CM-1-3-7-1; governed submission) | the service machinery (CM-1-3-9-1) | outcome measurement (CM-1-3-9-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Routed service events with case linkage (CM-1-3-7-5)"
   },
   {
    "@language": "en",
    "@value": "delivery data"
   },
   {
    "@language": "en",
    "@value": "entitlements and agreements"
   },
   {
    "@language": "en",
    "@value": "the service machinery (CM-1-3-9-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Fulfilled, evidenced service events with outcomes returned to the case and billing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Service work done, evidenced, and returned to the case — and to billing only through evidence."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review five-way data distinction adopted verbatim. Preferred label 'Manage Service Delivery Data' recorded as alt label and queued — disambiguates the generic locked name. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Manage Data' to 'Manage Service Delivery Data'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11749"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Manage Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Maintain the operational data service delivery runs on: entitlement and coverage data, installed-base and service-history records, appointments, service tasks, and service-event data — captured and verified at delivery time, linked to the governed case and customer records."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.2.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Service Delivery Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Five data distinctions apply: master data belongs to the Master Data processes (governed Party, Account, Product, Price, Tax, Location); case data to Customer Requests and Inquiries (the issue/request record and communication loop); service delivery data to this capability (entitlements, service tasks, service events, appointments, installed base, completion evidence, service-history facts); operational/physical asset data to the relevant Operations/Engineering/Asset/Terminal processes; and billing evidence is consumed by Billing where the service is billable. The case record is stewarded by the request capability (b35) and referenced, not duplicated (the incident-linkage pattern). This process keeps delivery-operational records accurate, linked, and consumable. Personal data handled here is governed under the enterprise personal-data governance framework, with collection, use, retention, and disclosure limited to what the framework and applicable law permit. Retention per the records-management policy.\nIn scope: Entitlement/coverage, installed-base, service-history, appointment, task, and event data stewardship | delivery-time capture and verification | linkage to governed case and customer records | quality and retention control\nOut of scope: Master data (CM-1-3-7-1; governed submission) | the case record (CM-1-3-7-5-2) | operational/physical asset data (Operations/Engineering/Asset/Terminal processes) | billing execution (CM-1-3-8-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Delivery-time captures"
   },
   {
    "@language": "en",
    "@value": "entitlement sources"
   },
   {
    "@language": "en",
    "@value": "governed customer/case references"
   },
   {
    "@language": "en",
    "@value": "records policy"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/continuous"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Accurate, linked service delivery records consumable by fulfillment, the case, and billing evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Delivery always runs on accurate, linked, governed operational data."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review confirmed-information rule adopted verbatim (the governed-answer rule, delivery side). Preferred label 'Manage Customer Interaction in Service Delivery' recorded as alt label and queued. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Manage Customer' to 'Manage Customer Interactions in Service Delivery'. Prior label 'Manage Customer' NOT retained as skos:altLabel per the alias-control exception (bare label is a prefix of live labels and would reintroduce retrieval ambiguity); preserved as prior_name in the identity/migration map."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20085"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage the customer interaction during service delivery: identify and verify the customer per the Security-defined controls, set expectations from confirmed information, keep the customer informed through service notices during the event, and confirm completion."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.2.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Customer Interactions in Service Delivery"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Interaction, not relationship or case: account relationships belong to the commercial processes, the case loop to the request capability (b35). Service delivery interactions may communicate confirmed appointment, entitlement, scope, progress, service completion, and next-step information. They do not promise price, compensation, credit, product quality, tax, legal, regulatory, safety, or contract outcomes unless confirmed by the owning process. Verification per Security-defined identity controls; communications are service notices under the consent rules.\nIn scope: Customer identification and verification per Security controls | expectation-setting from confirmed appointment, entitlement, scope, progress, completion, and next-step information | service notices during the event | completion confirmation\nOut of scope: Promises of price, compensation, credit, product quality, tax, legal, regulatory, safety, or contract outcomes (Owning processes confirm) | the case loop (CM-1-3-7-5) | account relationship management (Commercial processes) | consent creation (Consent framework)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Routed events and confirmed owner information"
   },
   {
    "@language": "en",
    "@value": "Security identity controls"
   },
   {
    "@language": "en",
    "@value": "service-notice channels"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/precedes": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Verified, informed customers through delivery with confirmed completion"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The customer always knows what's confirmed — and never hears a promise nobody owns."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/priorPreferredLabel": [
   {
    "@language": "en",
    "@value": "Manage Customer"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review outcome-status taxonomy and billable-evidence rule adopted verbatim. Preferred label 'Fulfill Service Events' recorded as alt label and queued. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Fulfill Service Event' to 'Fulfill Service Events'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10218"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Fulfill Service Event"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Fulfill individual service events end to end: receive the routed event with its case linkage, verify entitlement from governed delivery data, execute the service work per the applicable agreement and procedures, capture completion evidence, and return the outcome to the case and — where billable — to billing."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.2.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Fulfill Service Events"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Execution within everyone's authority: parts, logistics, and third-party service partners engage through their owning processes and executed agreements (the no-implied-obligations rule); safety-relevant findings escalate immediately per the batch 35 safety rule. Service events close with an explicit outcome status: completed, partially completed, unable to perform, rescheduled, cancelled, requires escalation, or requires follow-on event — each classified billable or non-billable. A billable service event is invoiced only from approved service-completion evidence, entitlement/contract terms, applicable pricing/tax data, and any required customer acceptance or service confirmation. Service Delivery does not create prices, credits, tax outcomes, or invoices. Failed or partial events re-route through the case, never silently closed. One customer request may produce zero, one, or many service events. Each service event is linked to the originating case where applicable, but the service event is not itself a new customer-request case. Completion evidence returns to the case record and, where billable, to Billing. When the service event is billable and has the applicable approved completion and customer-acceptance evidence, Fulfill Service Events (CM-1-3-9-2-3) supplies approved billable service-completion evidence, event status, and agreement references that Create and Distribute Bill (CM-1-3-8-1-1) consumes in its defined work. When the service event originated from a customer-request case, Fulfill Service Events (CM-1-3-9-2-3) supplies case-linked service completion status, evidence, and confirmed outcome records that Process Inquiries and Requests (CM-1-3-7-5-3) consumes in its defined work.\nIn scope: Event receipt with case linkage | entitlement verification from governed data | service execution per agreements and approved procedures | explicit outcome-status closure (completed, partially completed, unable to perform, rescheduled, cancelled, requires escalation, requires follow-on event; billable/non-billable) | completion evidence capture | outcome return to the case and billing\nOut of scope: Case ownership (CM-1-3-7-5) | pricing, credits, tax, invoicing (Their owners; CM-1-3-8-1) | partner terms (Contract management; Legal) | safety/quality determinations (EHS; Quality; their protocols)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-2"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-2-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Routed events with case linkage"
   },
   {
    "@language": "en",
    "@value": "approved procedures"
   },
   {
    "@language": "en",
    "@value": "governed delivery data and entitlements"
   },
   {
    "@language": "en",
    "@value": "partner agreements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/event-driven"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Fulfilled events with explicit outcome statuses and billing-grade completion evidence"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Every routed event ends in an explicit, evidenced outcome — back on the case, and billed only from evidence."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20875"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The process of measuring the service operation on a recurring cycle: infrastructure and channel performance, workforce operational performance, and overall service effectiveness — consolidated into an integrated service performance view."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Periodic process per review, with the integration-purpose scope sentence adopted verbatim — the L4 consolidates, it does not merely group."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Service & Support Measurement"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The process consolidates the three measurement domains into an integrated service performance view for operating-model, workforce, technology, facilities, and service-improvement owners. It does not set staffing, change technology, approve capital, alter service levels, or publish enterprise KPIs. The analysis rules apply in full (b21/b23/b35): measurement analyzes and informs — the owners decide; all metrics are evidence-layer with candidate KPIs routed only via the KPI Store; and this is the governed measurement side of the batch 35 formal-research distinction. Employee measurement per the boundary on CM-1-3-9-3-2. Service & Support Measurement (CM-1-3-9-3) provides the integrated infrastructure, workforce, and service-effectiveness performance view to inform Define Operating Model (CM-1-3-9-1-1); the recipient retains its own decisions.\nIn scope: The recurring service measurement cycle | consolidation of infrastructure, workforce, and effectiveness evidence into an integrated performance view | insight delivery to operating-model, workforce, technology, facilities, and improvement owners\nOut of scope: Staffing, technology, capital, and service-level decisions (Their owners) | enterprise KPI publication (KPI Store governance) | case resolution and delivery (CM-1-3-7-5; CM-1-3-9-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Delivery, operations, channel, and workforce data"
   },
   {
    "@language": "en",
    "@value": "Finance-approved cost methods"
   },
   {
    "@language": "en",
    "@value": "follow-up signals (b35)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "The integrated service performance view informing accountable owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "One integrated, evidence-layer view of how the service operation actually performs."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-1",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20920"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Measure the performance of the service infrastructure from the business perspective: facilities fitness, technology and platform performance, and contact-channel performance — as evidence for the accountable owners."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review availability-distinction sentence adopted verbatim; business outcomes measured here, never implying IT ownership of them."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.3.1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Measure Service Infrastructure"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Business-side measurement: IT's own platform monitoring (b31) is IT's; this measures service-business outcomes of the infrastructure and routes findings to Manage Technology, Manage Facilities, Manage Contact Center, and their corporate counterparts. Service availability measurement distinguishes platform/system availability, contact channel availability, facility readiness, service capacity, integration/data availability, and knowledge availability. Evidence-layer; KPI Store. Measure Service Infrastructure (CM-1-3-9-3-1) provides infrastructure and platform performance evidence that informs Manage Technology (CM-1-3-9-1-5). Measure Service Infrastructure (CM-1-3-9-3-1) provides contact-channel performance, capacity, availability, and readiness findings to inform Manage Contact Center (CM-1-3-9-1-6); the recipient retains its own decisions.\nIn scope: Business-side measurement of facilities fitness, platform performance, and channel performance | availability measurement distinguishing platform/system, contact channel, facility readiness, service capacity, integration/data, and knowledge availability | findings routing to accountable owners\nOut of scope: Technical platform monitoring (IT) | infrastructure decisions (Their owners) | KPI publication (KPI Store governance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Channel, platform, and facility performance data"
   },
   {
    "@language": "en",
    "@value": "operating-model targets"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Evidence-layer infrastructure performance findings routed to owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "The machinery's real performance, measured where the business feels it."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review individual-level data rule adopted verbatim — sensitive contact-center productivity data handled deliberately. Preferred label 'Measure Service Workforce Performance' recorded as alt label and queued. Step 3d naming pass — generic-operational Batch 5 (2026-09-21): renamed from 'Measure Service Employees' to 'Measure Service Workforce Performance'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10218"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Measure Service Employees"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Measure workforce operational performance in the service operation — handle times, quality scores, utilization, schedule adherence, readiness — as evidence for capacity planning, training, and service improvement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.3.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Measure Service Workforce Performance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "The HR boundary, measurement side: individual performance evaluation, ratings, compensation decisions, and discipline are HR's and line management's under HR frameworks; this process's outputs inform them through those frameworks and never substitute for them. Service workforce metrics may be reported at team, queue, role, or aggregate level for capacity and improvement. Use of individual-level data for performance appraisal, compensation, discipline, surveillance, or employment action requires HR-approved process, lawful basis, privacy controls, transparency, and applicable labor/works-council controls. Employee personal data is governed under the enterprise personal-data governance framework exactly as customer data is. Evidence-layer; KPI Store. Measure Service Workforce Performance (CM-1-3-9-3-2) provides service workload, readiness, quality, utilization, and schedule-adherence measures to inform Manage Service Employees (CM-1-3-9-1-3); the recipient retains its own decisions.\nIn scope: Team, queue, role, and aggregate-level workforce operational metrics for capacity and improvement | quality and adherence measurement per approved designs | evidence to workforce planning and training\nOut of scope: Individual performance appraisal, compensation, discipline, surveillance, employment actions (HR-approved processes with lawful basis, privacy, transparency, and labor/works-council controls) | measurement-design authority over HR data (HR; Privacy) | KPI publication (KPI Store governance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "HR/privacy requirements"
   },
   {
    "@language": "en",
    "@value": "Operational workforce data"
   },
   {
    "@language": "en",
    "@value": "approved measurement designs"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Aggregate workforce performance evidence for capacity, training, and improvement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Operational workforce evidence for improvement — never a backdoor appraisal system."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11077"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-9-3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Measure overall service effectiveness: resolution outcomes, service-level attainment, customer satisfaction and effort through governed measurement, and cost-effectiveness per Finance-approved methods — informing the operating model and the accountable owners."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 40 (2026-09-21). Review metric-definition and formal-research control sentences adopted verbatim — the governed side of the batch 35 distinction."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.3.9.3.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Measure Service Effectiveness"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Customer satisfaction/effort, resolution quality, repeat-contact rate, first-contact resolution, fulfillment timeliness, service-level attainment, and cost-effectiveness must be defined under approved measurement frameworks. They may be candidate KPIs but become enterprise KPIs only through KPI Store governance. Formal customer satisfaction, effort, quality, or experience research follows approved research design, sampling, privacy, consent, and analysis controls; case follow-up may supply one input but cannot substitute for a valid measurement program. Cost-effectiveness applies Finance-approved costing methods (the batch 32 profitability pattern — applied, never redefined). Findings inform Define Operating Model and the owning processes; nothing is decided here. Evidence-layer; KPI Store. Measure Service Effectiveness (CM-1-3-9-3-3) provides service effectiveness, resolution, customer effort, and cost findings to inform Define Operating Model (CM-1-3-9-1-1); the recipient retains its own decisions.\nIn scope: Effectiveness measurement under approved frameworks: satisfaction/effort, resolution quality, repeat-contact, first-contact resolution, timeliness, service-level attainment, cost-effectiveness | governed research design, sampling, privacy, consent, and analysis controls | insight delivery to the operating model and owners\nOut of scope: Service, staffing, and model decisions (Their owners) | costing method definition (Finance) | replacing governed research with case feedback (CM-1-3-7-5-4 supplies one input) | enterprise KPI publication (KPI Store governance)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/dependsOnOutputOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-5-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "Case and event outcomes"
   },
   {
    "@language": "en",
    "@value": "Finance-approved cost methods"
   },
   {
    "@language": "en",
    "@value": "governed research responses"
   },
   {
    "@language": "en",
    "@value": "service-level data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "Governed effectiveness findings informing the operating model and owners"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Whether service actually works, for customers and the business — measured properly."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 5
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Information Technology Includes Processes Related To Providing IT Support Across Commercial Operations. It Covers Strategy, Delivery & Governance Processes. Commercial Information Technology Includes Hardware, Software & Communication Infrastructure."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "IT Services"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 2
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L0-downstream-operations",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19948"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-w3c-skos-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The operating businesses and value-chain domains in scope for the enterprise's downstream oil and gas model: Commercial & Marketing, Refining, and the Midstream transportation, terminaling, storage, and bulk-logistics activities that support downstream supply, distribution, and delivery of hydrocarbon feedstocks and refined products."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 42 (2026-09-21). Scheme root approved per the structural-anchor review decision (definition + scope note; no horizon, domain, or relationships; no decision authority). concept_type_check 'not-process' approved under the SCHEME_ROOT_APPROVED gate amendment (option A, the decision owner); primary_purpose and reference_sources populated because the post-#31 gate requires them on newly approved rows. Midstream scope wording per review: in-scope Midstream activities support the downstream model; no categorical industry claim."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Downstream Operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Scheme root, not a process or capability: groups the operating business domains in scope for the downstream enterprise model: Commercial & Marketing, Refining, and Midstream activities where they support downstream supply, terminaling, storage, transportation, distribution, and delivery. It carries no activities, processes, authority, ownership, controls, assets, or decision rights of its own. Functions that enable, govern, or provide enterprise services to these operating domains are grouped under the sibling root Enabling Functions. This root does not assert that all industry Midstream activity is downstream; it defines the Midstream scope included in this enterprise taxonomy."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/structural-anchor"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Anchor the operating side of the enterprise downstream taxonomy — a navigation root grouping Commercial & Marketing, Refining, and in-scope Midstream activities."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 0
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10922"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-w3c-skos-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The enterprise functions in scope that enable, govern, control, support, and provide shared services to the downstream operating businesses: Supply Chain Management, Finance, Shared Services, Process Excellence & IT, Human Resources, Legal & Corporate Communications, and Environment, Health, Safety & Government Reporting."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 42 (2026-09-21). Scheme root approved per the structural-anchor review decision (definition + scope note; no horizon, domain, or relationships; no decision authority conferred by grouping). concept_type_check 'not-process' approved under the SCHEME_ROOT_APPROVED gate amendment (option A, the decision owner); primary_purpose and reference_sources populated because the post-#31 gate requires them on newly approved rows. Expanded preferred presentation 'Environment, Health, Safety & Government Reporting' for the L1 'EHS & Gov Reporting' is queued in the naming-pass artifact (b42 review); the L1 row is not edited."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Enabling Functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Scheme root, not a process or capability: groups the enabling and governance functions in scope for the enterprise taxonomy. It carries no activities, processes, authority, ownership, controls, assets, or decision rights of its own. Authorities such as Finance, Treasury, Tax, Legal, Compliance, Security, IT, HR, EHS, and Data Governance are exercised by named processes, capabilities, governance bodies, and delegated authorities within or across these functions; grouping under this root does not itself confer authority. Operating domains are grouped under the sibling root Downstream Operations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/structural-anchor"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Anchor the enabling side of the enterprise downstream taxonomy — a navigation root grouping the functions that enable and govern the operating businesses."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 0
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-ehs-gov-reporting",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10522"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Protect people, assets, and the environment through process safety; occupational health and safety; environmental management and compliance; emergency preparedness and response; incident, release, and near-miss management; corrective-action learning; and required regulatory reporting to government authorities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "EHS & Gov Reporting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "This domain governs EHS management, environmental and safety compliance, required regulator-facing reporting, and the enterprise coordination of incidents, releases, investigations, corrective actions, and emergency response. It does not replace operational ownership: operating sites, asset owners, maintenance, logistics, product stewardship, and business functions remain accountable for safely executing their work, preventing and containing events, and completing assigned corrective actions. Legal & Corporate Communications advises on legal privilege, enforcement exposure, disclosure, litigation hold, regulator strategy, and approved internal/external communications when those dimensions arise."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/rejected"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-finance",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10922"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Planning, recording, controlling, reporting, and managing the financial resources, performance, obligations, and risks of the downstream business, including financial planning and analysis, accounting, reporting, payroll, treasury, tax, and internal financial controls."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Finance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes budgeting, forecasting, financial and management accounting, period close, statutory and management reporting, accounts payable, expense reimbursement, payroll, treasury, liquidity and cash management, tax, financial compliance, internal controls, audit support, and financial risk management. Supports commercial, supply-chain, refining, midstream, distribution, and enabling-function processes through financial governance, measurement, and transaction processing. Excludes operational execution in those business domains and fixed-asset project accounting where it is intentionally governed and executed as an ERP-native capability outside this taxonomy's modeled scope."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-human-resources",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20958"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The function that plans, attracts, develops, rewards, engages, retains, and transitions the workforce to enable the downstream business, including workforce planning, talent acquisition, onboarding, learning and development, performance management, compensation and benefits, employee and labor relations, HR policy and compliance, workforce information, and HR service delivery."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Human Resources"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes workforce strategy and planning; organizational and position management; recruiting, sourcing, selection, hiring, and onboarding; learning, development, performance, talent, succession, and career management; compensation, benefits, recognition, and payroll-input administration; employee and labor relations; workforce policy, employment compliance, ethics-related workforce processes, and employee communications; workforce data, HR information systems, people analytics, and HR service delivery; and employee transition, redeployment, separation, and retirement. Human Resources owns workforce policies, people processes, employee experience, and workforce information. It provides authorized employee, time, attendance, compensation, and deduction inputs to payroll; Finance or a designated payroll service owns pay calculation, payment execution, withholding/remittance, payroll accounting, and financial control."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/rejected"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-legal-corp-comm",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/18948"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Provide legal counsel and legal-risk management, including contract and transaction support, litigation and dispute resolution, regulatory and compliance advice, corporate governance and entity support, and management of external legal providers; develop and deliver internal corporate communications and approved enterprise messaging."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Legal & Corp Comm"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "In scope: general counsel and legal advice to management and functions; legal review and support for contracts, transactions, claims, disputes, investigations, and litigation; regulatory interpretation and legal/compliance advice; corporate governance, entity management, board/committee administration where retained in the function, and corporate records; intellectual-property and outside-counsel management where not separate domains; employee, leadership, change, policy, crisis, and enterprise-wide internal communications; approval, stewardship, and consistency of official corporate messages. Out of scope (Step 8 decision): government relations, lobbying, and industry-association engagement; investor relations, shareholder engagement, and external board relations; public relations, media relations, community relations, philanthropy, and external reputation campaigns; distributor incentives, trade discounts, channel allowances, and other commercial-program design."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/rejected"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-midstream",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19948"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-downstream-operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The transportation, terminaling, storage, and bulk handling of crude oil, intermediates, and refined products between supply points, refineries, terminals, and downstream distribution locations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Midstream"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes receipt, dispatch, transfer, pipeline, marine, rail, and bulk-truck logistics; terminal and tank-farm operations; inventory management; blending and additive operations where performed outside refinery process units; product segregation; custody transfer; nominations; scheduling; and bulk delivery to downstream depots, customers, or other facilities."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-process-excellence-it",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20094"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The enabling function that drives operational excellence through process governance, standardization, performance management, continuous improvement, and transformation; and enables the enterprise through technology strategy, architecture, platforms, infrastructure, cybersecurity, data and integration, and digital capabilities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Process Excellence & IT"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes enterprise process architecture and governance; process ownership, documentation, standardization, measurement, benchmarking, and maturity assessment; continuous improvement, lean/six-sigma methods, automation, and business transformation; enterprise and solution architecture; portfolio, product, project, and demand management; application, data, integration, cloud, infrastructure, network, end-user, and IT service management; cybersecurity, technology risk, resilience, and disaster recovery; and delivery of digital, analytics, AI, and automation capabilities. Enables and governs cross-functional ways of working and enterprise technology. It does not own the business outcomes or physical execution of refining, midstream, distribution, commercial, finance, HR, legal, or EHS processes, except where a specifically delegated enterprise service is modeled as such."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/rejected"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-refining",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19948"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-downstream-operations"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The operation of petroleum refineries to convert crude oil and other hydrocarbon feedstocks into specification-compliant fuels, blendstocks, lubricants, asphalt, petrochemical feedstocks, and other refined products through separation, conversion, treatment, blending, and associated refinery operations."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refining"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Encompasses refinery production operations and the planning, execution, and recovery activities required to maintain refinery assets, reliability, integrity, safety, and operating availability, including major maintenance and turnarounds."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-shared-services",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/19951"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "An enterprise service-delivery model that consolidates common, repeatable business-support services for multiple business units, legal entities, or regions through a shared organization, standardized processes, common platforms, and defined service levels."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Shared Services"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Delivers selected operational and transactional services on behalf of enterprise functions and business domains, including finance operations, HR operations, payroll administration, procurement operations, IT service delivery, master-data administration, customer and supplier support, and other standardized administrative services. Services may be delivered centrally, regionally, or virtually and are governed through service catalogs, service levels, performance measures, and, where applicable, chargeback or cost-allocation arrangements."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L1-supply-chain-mgmt",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10215"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L0-enabling-functions"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The integrated planning, coordination, and optimization of feedstock, intermediate, product, inventory, capacity, logistics, and information flows across the downstream petroleum value chain — from supply and sourcing through refining, terminaling, distribution, and customer fulfilment."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Supply Chain Mgmt."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes demand and supply balancing; sourcing and replenishment planning; production and refinery supply planning; inventory and working-capital optimization; network, terminal, and distribution planning; transportation and delivery planning; materials management; supplier and carrier coordination; performance management; and supply-chain risk and disruption management. It orchestrates, but does not replace, the physical execution performed by refining, midstream, distribution, procurement, and commercial operations."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 1
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L2-financial-planning-and-performance-management",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L1-finance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The Finance-owned capability that establishes and operates the financial planning and performance-management framework; coordinates, consolidates, challenges, validates, publishes, monitors, and refreshes enterprise and business-unit financial plans and budgets in accordance with the approved planning calendar, planning assumptions, delegated authorities, and financial-control requirements; and measures and reports financial performance against those plans."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Source note (SRC-APQC-PCF-001): PCF Finance & accounting sections as the structural consistency reference (discovery/comparison only)"
   },
   {
    "@language": "en",
    "@value": "Step 3d PTC-001 tree pass (2026-09-21): new Candidate architecture node — structural placement approved via ptc-001-tree-proposal.md (the decision owner). Definition authoring queued as a follow-up mini-batch. Naming: 'Performance Management' covers the reporting, variance-analysis, and escalation loop that turns plans into governed performance — deliberate distinction from a pure budgeting node. This batch validates only the definition, not the node's existence (structural approval granted via ptc-001-tree-proposal.md, the decision owner, 2026-09-21)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Financial Planning and Performance Management"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes the financial planning calendar and planning assumptions; budget development, consolidation, and version governance; capital and operating expenditure planning controls; forecasting; financial performance reporting, variance analysis, escalation, and financial-plan review and approval-workflow administration. Operating domains own their underlying demand, volume, margin, capacity, operating-cost, capital, and resource assumptions and provide their plans and forecasts as inputs. Finance owns the financial planning process, consolidation, control framework, and financial reporting. Final approval remains with the applicable delegated authority. Excludes enterprise strategic direction, portfolio choices, and capital allocation decisions pending PTC-001-B. Excludes fixed-asset project accounting where intentionally governed and executed as an ERP-native capability.\nIn scope: financial planning calendar and planning assumptions | budget development, consolidation, and version governance | capital and operating expenditure planning controls | forecasting | financial performance reporting, variance analysis, and escalation | financial-plan review and approval-workflow administration\nOut of scope: enterprise strategic direction, portfolio choices, and capital allocation decisions (pending PTC-001-B) | underlying demand, volume, margin, capacity, operating-cost, capital, and resource assumptions (operating domains) | final plan and budget approval (applicable delegated authority) | fixed-asset project accounting where intentionally governed and executed as an ERP-native capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "actual financial results against plan baselines"
   },
   {
    "@language": "en",
    "@value": "approved financial-planning calendar and planning assumptions"
   },
   {
    "@language": "en",
    "@value": "business-unit plans, forecasts, and assumption sets from operating domains"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "published, version-governed enterprise and business-unit budgets and financial plans | financial performance reports with variance analysis and escalations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Maintain the governed framework by which enterprise and business-unit financial plans and budgets are built, consolidated, challenged, published, and held to account."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Finance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 2
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L2-refinery-asset-reliability-and-turnaround-coordination",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "R1 Refining reclassification (2026-09-22): new Candidate architecture node — structural placement approved; initially unpopulated; coordination-only. Review trigger: R2 evidence package / refinery maintenance and turnaround operating model."
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-osha-psm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L1-refining"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The Refining capability that coordinates refinery availability, asset-condition and integrity inputs, maintenance and turnaround windows, production-plan impacts, readiness, and recovery interfaces so refinery performance objectives can be planned and managed against approved maintenance, integrity, and turnaround commitments."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Source note (SRC-OSHA-PSM-001): process-safety management boundary: coordination interfaces with maintenance/turnaround windows and integrity inputs; excludes PSM policy ownership and maintenance/turnaround execution"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refinery Asset Reliability and Turnaround Coordination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Coordinates the refinery-operating impact of asset reliability, inspections, integrity findings, planned maintenance, and turnaround work, including availability assumptions, outage-window integration, production-plan and schedule impacts, readiness dependencies, return-to-service coordination, and escalation of material risks or constraints.\n\nDoes not own maintenance strategy, engineering design authority, inspection execution, process-safety policy, work permits, contractor management, capital approval, or maintenance/turnaround execution unless separately assigned by the enterprise operating model."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Coordinate the refinery-operating impact of asset reliability, integrity findings, planned maintenance, and turnaround work — availability assumptions, outage-window integration, production-plan and schedule impacts, readiness dependencies, return-to-service coordination, and escalation of material risks or constraints — against approved maintenance, integrity, and turnaround commitments."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 2
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/L2-refinery-performance-and-risk-coordination",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-apqc-pcf-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-osha-psm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/L1-refining"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The Refining-owned capability that coordinates refinery performance oversight and site-level business-risk management, including the identification, assessment, treatment coordination, monitoring, and escalation of risks that may affect refinery objectives."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Source note (SRC-APQC-PCF-001): structural consistency reference (discovery/comparison only)"
   },
   {
    "@language": "en",
    "@value": "Source note (SRC-OSHA-PSM-001): process-safety management boundary: site business risk excludes EHS/process-safety management"
   },
   {
    "@language": "en",
    "@value": "Step 3d PTC-001 tree pass (2026-09-21): new Candidate architecture node — structural placement approved via ptc-001-tree-proposal.md (the decision owner). Definition authoring queued as a follow-up mini-batch. Name narrowed per the reviewer's second assessment (2026-09-21): 'Performance and Risk Coordination' scopes this to site-level coordination, not enterprise risk ownership. The taxonomy holds no enterprise risk capability; this row must not be read as one. This batch validates only the definition, not the node's existence (structural approval granted via ptc-001-tree-proposal.md, the decision owner, 2026-09-21)."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refinery Performance and Risk Coordination"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Includes coordination of site business-risk ownership and treatment for risks affecting production reliability, throughput, feedstock and product quality, turnaround execution, cost, schedule, asset availability, supply, product disposition, and local stakeholder commitments. Does not operate refinery units; set enterprise risk appetite or policy; replace EHS or process-safety management; administer insurance; approve capital; manage financial-market risk; conduct Internal Audit; or own Legal, Compliance, Security, Cybersecurity, or business-continuity authorities. Refinery performance oversight is currently represented at capability level and will be decomposed into one or more operating processes during the future Refining-domain modeling pass; this capability does not imply that the present risk-coordination child performs all refinery performance-management activities.\nIn scope: site business-risk ownership and treatment coordination for risks affecting production reliability, throughput, feedstock and product quality, turnaround execution, cost, schedule, asset availability, supply, product disposition, and local stakeholder commitments | refinery performance oversight coordination\nOut of scope: operation of refinery units and unit-level scheduling (Refining operations) | enterprise risk appetite and policy | EHS and process-safety management | insurance administration | capital approval | financial-market risk | Internal Audit | Legal, Compliance, Security, Cybersecurity, and business-continuity authorities"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "enterprise risk policy and delegated authorities"
   },
   {
    "@language": "en",
    "@value": "refinery performance data against refinery objectives"
   },
   {
    "@language": "en",
    "@value": "site risk registers, risk assessments, and incident records"
   },
   {
    "@language": "en",
    "@value": "specialist-control requirements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "assigned site-risk ownership and coordinated treatment plans | monitored risk status with escalations"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Hold site-level ownership, treatment, monitoring, and escalation of business risks that can affect refinery objectives — and coordinate the performance oversight that reveals them."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Refining"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 2
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-1-1--CM-1-1-2--forecast-version",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For a given planning cycle, Produce Demand Forecast (CM-1-1-1-1) completes approval and release of the demand-forecast version before Regional Optimization (CM-1-1-2) uses that version as an approved planning input. Forecasting and optimization remain iterative across versions and cycles."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Produce Demand Forecast before Regional Optimization, per forecast version"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/forecast-version"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-01223"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-1-1-4--CM-1-1-2--forecast-version",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For a given forecast cycle and version, Publish Forecast and Generate Component Level Forecast Plan (CM-1-1-1-1-4) publishes and makes the approved forecast available before Regional Optimization (CM-1-1-2) uses that version as an approved planning input. Other optimization work may proceed independently; subsequent forecast revisions can prompt another optimization run."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Publish Forecast and Generate Component Level Forecast Plan before Regional Optimization, per forecast version"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/refinesSequence": [
   {
    "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-1-1--CM-1-1-2--forecast-version"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
