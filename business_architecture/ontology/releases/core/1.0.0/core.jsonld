  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Review link"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "ledger-v2.md, apqcDecision"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "APQC mapping decision"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The recorded outcome of aligning the concept with the APQC Process Classification Framework, taken from the APQC mapping decision list. An audit trail, not a mapping."
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/modules/core/assuredBy",
  "@type": [
   "http://www.w3.org/2002/07/owl#ObjectProperty"
  ],
  "http://purl.org/dc/terms/bibliographicCitation": [
   {
    "@language": "en",
    "@value": "step4-decisions.md, assured-by definition (2026-09-26)"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#domain": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#label": [
   {
    "@language": "en",
    "@value": "assured by"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#range": [
   {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "The object, an assurance activity, performs a defined governance, compliance, quality, review, control-testing or equivalent oversight role over the subject. Not operational support, supply, documentation, evidence, balancing, fulfillment, feeding or mere necessity."
   }
  ]
 },
 {
