    "@language": "en",
    "@value": "Channel portfolio and offerings (CM-1-3-3-3-2/-1)"
   },
   {
    "@language": "en",
    "@value": "engagement performance evidence"
   },
   {
    "@language": "en",
    "@value": "segment definitions (CM-1-3-3-3-3)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/planningLevel": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/planning-level/tactical"
   }
  ],
