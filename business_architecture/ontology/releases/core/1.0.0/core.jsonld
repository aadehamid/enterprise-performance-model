    "@value": "Allocate Exchange & Third-Party Volumes"
   },
   {
    "@language": "en",
    "@value": "Define Product Allocation Priority Rules"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "approved finished-product allocation plan by market, channel, and supply point"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Decide where available finished product is placed across markets, channels, and supply points to protect commitments and regional margin."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-12",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10252"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Planning Parameter Maintenance"
   },
   {
    "@language": "en",
    "@value": "Supply Planning Reference Data Maintenance"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Create, maintain, and retire the reference and parameter data that the regional supply-planning model depends on — such as planning network, sourcing, capacity, lead-time, yield, and product-grouping data — so planning results remain accurate and reproducible."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Defined narrowly per the decision owner's decision (2026-09-18, Option 1): scope is the supply-planning-specific reference and parameter data consumed by the regional planning model, not master data generally. The taxonomy currently carries four parallel master-data nodes — this one, Maintain Production Scheduling Master Data (CM-1-1-7-2-1), Manage Commercial Master Data Stewardship (CM-1-3-7-1), and Prepare Master Data To Create Demand Forecast (CM-1-1-1-1-1). Their consolidation, and whether a single governed master-data capability should own them, is parked for the EPM Data Governance workstream and is deliberately not resolved here. APQC candidate “Maintain master data” was triaged STRONG but accepted by no validator; used as comparative evidence only, not adopted."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.2.12"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Maintain Supply Planning Master Data"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers stewardship of supply-planning-specific reference and parameter data over its lifecycle, including requesting and validating changes, applying effective dates, and confirming that planning results remain consistent after a change. Excludes enterprise master-data policy, standards, and governance, which sit with the Data Governance workstream; excludes customer, price, product, tax, and location master data, owned by Manage Commercial Master Data Stewardship under Order Management; excludes production-scheduling master data, owned by Maintain Production Scheduling Master Data under Refinery Production Planning and Scheduling.\nIn scope: Planning network and location data | sourcing and supply-path data | planning capacity and rate parameters | lead times and transit assumptions | planning yields and product groupings | change request, validation, and effective dating of planning parameters\nOut of scope: Enterprise master-data policy and governance standards (Data Governance) | customer, price, product, tax, and location master data (Manage Commercial Master Data Stewardship, Order Management) | production-scheduling master data (Maintain Production Scheduling Master Data, Refinery Production Planning and Scheduling) | demand-forecast master data preparation (Prepare Master Data To Create Demand Forecast, Produce Demand Forecast (CM-1-1-1-1)) | planning application administration and platform support (Process Excellence & IT)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "enterprise data-governance standards"
   },
   {
    "@language": "en",
    "@value": "network, capacity, and sourcing changes"
   },
   {
    "@language": "en",
    "@value": "planning parameter change requests"
   },
   {
    "@language": "en",
    "@value": "product and grade structure changes"
   },
   {
    "@language": "en",
    "@value": "refinery and logistics capability updates"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/plannedChildNote": [
   {
    "@language": "en",
    "@value": "Maintain Planning Capacity & Rate Parameters"
   },
   {
    "@language": "en",
    "@value": "Maintain Planning Network Data"
   },
   {
    "@language": "en",
    "@value": "Maintain Planning Yield Data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "validated and effective-dated supply-planning reference and parameter data"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Keep the reference and parameter data behind regional supply planning accurate, current, and reproducible."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-13",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10359"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Finished Goods Inventory Planning"
   },
   {
    "@language": "en",
    "@value": "Finished Product Inventory Planning"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Set and optimize the planned finished-product inventory levels and positions for the regional plan period, balancing supply availability, demand coverage, and working-capital cost within established inventory policy and storage constraints."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Boundary resolved per the decision owner's decision (2026-09-18, Option 1): this node owns the planned inventory level and position inside the regional plan, while the Inventory Management cluster under Distribution Planning & Scheduling (CM-1-1-3-7) retains policy, measurement, reconciliation, and replenishment. This preserves both approved scope notes — Regional Optimization explicitly names “inventory positioning” — and the locked SCM rule, by separating the plan-period target decision from ongoing inventory management. No tree change required. “Finished goods” retained from the existing label although “finished product” is the more common downstream term; alt labels carry both."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.2.13"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Plan Finished Goods Inventory"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the planning decision on how much finished product should be held, in which grades, and at which supply points and terminals across the regional plan horizon, including target and minimum operating positions, seasonal and pre-build positions, and the inventory consequences of allocation and production choices. Excludes the setting of inventory policy itself, and excludes inventory measurement, reconciliation, replenishment, consignment, commingled, and re-brand inventory management, all owned by the Inventory Management cluster under Distribution Planning & Scheduling. Excludes physical storage operation, owned by Midstream.\nIn scope: Planned finished-product inventory targets by grade and location | minimum operating and safety positions within policy | seasonal and pre-build inventory positioning | inventory implications of allocation and production plan choices | working-capital and storage-cost trade-offs in the plan\nOut of scope: Finished-product inventory policy setting (Develop Finished Product Inventory Policy, Inventory Management) | inventory measurement and reconciliation (Inventory Management) | replenishment execution (Manage Inventory Replenishment, Inventory Management) | consignment, commingled, lot/batch, and re-brand inventory management (Inventory Management) | physical tank and terminal storage operation (Midstream)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-source"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "approved inventory policy"
   },
   {
    "@language": "en",
    "@value": "demand forecast"
   },
   {
    "@language": "en",
    "@value": "planned production and supply availability"
   },
   {
    "@language": "en",
    "@value": "product specifications and seasonal grade changes"
   },
   {
    "@language": "en",
    "@value": "storage and terminal capacity"
   },
   {
    "@language": "en",
    "@value": "working-capital and storage-cost assumptions"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/plannedChildNote": [
   {
    "@language": "en",
    "@value": "Plan Inventory for Constrained Supply"
   },
   {
    "@language": "en",
    "@value": "Plan Seasonal Inventory Build"
   },
   {
    "@language": "en",
    "@value": "Set Regional Inventory Targets"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "approved planned finished-product inventory targets and positions for the plan period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
