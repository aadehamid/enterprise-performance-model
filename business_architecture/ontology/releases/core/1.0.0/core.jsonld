   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Capture Refinery Constraints"
   },
   {
    "@language": "en",
    "@value": "Constraint Basis Capture"
   },
   {
    "@language": "en",
    "@value": "Establish Operating Envelope"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Compile the limits a refinery production case must respect — unit capacities and rates, blending and product-specification limits, tankage and movement limits, and planned maintenance or turnaround outages — as the feasible operating envelope for the planning period."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node establishes one input of the optimization case, it does not own the underlying business decision or the source data. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. “Refinery level” is read as site-wide rather than unit-detail granularity, consistent with the locked boundary that Refinery Planning sets commercial production-plan targets while Refining owns detailed scheduling and execution. Compiling a constraint does not transfer ownership of it."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Refinery Level Constraints"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers gathering, validating, and stating constraints in planning terms: confirming available unit capacity and rate limits including outage-adjusted availability, recording specification and blending limits, recording tankage and movement limits, and reconciling conflicting or stale limits with the constraint owner. Compiles limits set elsewhere; it does not set them. Excludes deciding maintenance and turnaround scope and timing, and excludes operating-limit ownership and process control, both owned by Refining. Excludes regulatory and permit limit ownership, owned by EHS & Gov Reporting.\nIn scope: Confirm unit capacity, rate, and outage-adjusted availability | record product specification and blending limits | record tankage, movement, and logistics limits | record contractual and regulatory volume limits as planning constraints | reconcile stale or conflicting limits with the constraint owner | publish the case operating envelope\nOut of scope: Setting and owning unit operating limits and process control, owned by Refining | deciding maintenance and turnaround scope and timing, owned by Refining maintenance planning | owning regulatory, permit, and emissions limits, owned by EHS & Gov Reporting | setting product specifications as an offer decision, owned by Offer Design & Development (CM-1-3-3) | detailed unit scheduling within the envelope, owned by Refining"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "planned maintenance and turnaround schedule"
   },
   {
    "@language": "en",
    "@value": "product specification and blending limits"
   },
   {
    "@language": "en",
    "@value": "regulatory, permit, and contractual limits"
   },
   {
    "@language": "en",
    "@value": "tankage, jetty, and pipeline capacity"
   },
   {
    "@language": "en",
    "@value": "unit capacity and rate limits"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "validated refinery operating envelope and constraint set for the case"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Establish the validated feasible operating envelope the production case must respect."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
