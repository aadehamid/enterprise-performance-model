 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/11222"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Reconcile actual regional supply, demand, production, inventory, product movements, and commercial outcomes against the approved plan and its contemporaneous assumptions and constraints; quantify and explain variances; and use the findings to improve subsequent regional planning and optimization cycles."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.5"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Regional Backcasting"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Regional Backcasting preserves and compares the approved planning baseline, actual outcomes, material assumptions, constraints, decisions, and variance explanations for a completed planning period. It produces commercially meaningful plan-versus-actual analysis — such as margin, price, volume, mix, yield, availability, inventory, logistics, quality, and customer-fulfillment variances — and feeds validated lessons into subsequent regional optimization. It does not replace Finance's statutory or management-close processes, SCM's execution control, or operating functions' technical root-cause investigations."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 3
   }
  ]
 },
