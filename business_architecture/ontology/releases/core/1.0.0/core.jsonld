   {
    "@language": "en",
    "@value": "Control-monitoring results with escalated failures and gaps"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Prove the controls the organization relies on for external obligations actually operate, with failures escalated."
   }
  ],
