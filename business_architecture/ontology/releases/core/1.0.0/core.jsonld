   {
    "@language": "en",
    "@value": "approved crude and feedstock allocation to refineries and receipt windows"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Decide which refinery receives which crude and feedstock volumes, and when, so the regional plan is met at best delivered economics."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-11",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/provenance": [
   {
    "@language": "en",
    "@value": "Three allocation concepts coexist at different grains and are deliberately bounded here: plan-level placement (this node), order-level allocation and release (Order Management), and loading-time allocation enforcement (Terminal Loading). Historical note: the “Decision” suffix was retained pending the same naming pass noted on CM-1-1-2-10. Step 3d naming pass — normalization-only judgment Batch 7 (2026-09-22): renamed from 'Product Allocation Decision' to 'Allocate Finished Products'. Prior label retained as altLabel."
   }
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16820"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-ascm-cscp-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-snf-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Finished Product Allocation"
   },
   {
    "@language": "en",
    "@value": "Product Allocation Decision"
   },
   {
    "@language": "en",
    "@value": "Product Allocation"
   },
   {
    "@language": "en",
    "@value": "Supply Allocation"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Assign available finished-product supply to markets, channels, terminals, and customer commitments for a planning period, so limited or constrained volumes are placed where they best serve contractual obligations and regional margin."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.2.11"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Allocate Finished Products"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers plan-level placement of finished product across markets, channels, and supply points, including the commercial priority rules applied when available supply cannot meet all demand, and reallocation when supply, demand, or logistics change. Excludes order-level allocation and release against an individual customer order, owned by Order Management; excludes rack and terminal loading allocation enforcement, owned by Terminal Loading; excludes physical movement and delivery execution, owned by Midstream and Distribution.\nIn scope: Market and channel volume placement | supply-point-to-demand-point assignment | commercial priority rules under constrained supply | exchange and third-party placement within the plan | reallocation on plan change\nOut of scope: Order-level allocation and release (Allocate & Release Order, Order Management) | rack and terminal allocation enforcement (Manage Terminal Lifting Allocation, Terminal Loading) | sales-target setting (Determine & Allocate Sales Targets, Marketing) | pricing and offer construction (Commercial & Marketing pricing processes) | physical delivery (Midstream, Distribution)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/enabledBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-2-13"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/informedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-1-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "available and planned production"
   },
   {
    "@language": "en",
    "@value": "contractual and regulatory supply obligations"
   },
   {
    "@language": "en",
    "@value": "demand forecast"
   },
   {
    "@language": "en",
    "@value": "inventory position"
   },
   {
    "@language": "en",
    "@value": "logistics and terminal capacity"
   },
   {
    "@language": "en",
    "@value": "netback and margin economics"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/plannedChildNote": [
   {
    "@language": "en",
    "@value": "Allocate Constrained Product Supply"
   },
   {
