 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-2",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/20732"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-cmu-refplan-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Crude Assay Evaluation"
   },
   {
    "@language": "en",
    "@value": "Crude Screening"
   },
   {
    "@language": "en",
    "@value": "Evaluate Crude & Feedstock Slate Candidates"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Assess candidate crude oils and feedstocks for processing suitability and economic value in the planning period, using assay and quality data, expected yields against the refinery configuration, and delivered-cost economics, to produce the evaluated set available to the optimization case."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node establishes one input of the optimization case, it does not own the underlying business decision or the source data. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. Boundary against “Plan Optimal Feedstock Slate And Run Rate” (CM-1-2-5-2-3) under Supply And Trading is unresolved: on its label that node duplicates the approved Refinery Planning accountability for slate and throughput targets. Raised as PTC-002 in step3c-parked-tree-changes.md and deliberately not reconciled here, since resolving it is a tree change. This node is bounded as evaluation only, so it does not depend on that outcome. PTC-002 resolved 2026-09-18 (Option 1): Refinery Planning decides the binding slate and run rate; CM-1-2-5-2-3 in Supply And Trading advises only. No tree change. This definition was written to hold either way and is unchanged by the resolution."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.2"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Evaluate Crude & Feedstock"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers technical and economic screening of candidate crudes and feedstocks for planning: confirming assay and quality data is current and complete, estimating yields and processing fit against unit configuration and specification limits, valuing each candidate on a delivered-cost and netback basis, and flagging handling or compatibility issues. Excludes laboratory assay testing and certification, and excludes purchase, negotiation, and trade execution, owned by Supply And Trading (CM-1-2). Approval of the final crude slate remains with Refinery Planning and Optimization (CM-1-1-4).\nIn scope: Confirm assay and quality data currency and completeness | estimate yields and processing fit against refinery configuration | screen against specification and handling limits | value candidates on delivered cost and netback | rank and publish the evaluated crude and feedstock set\nOut of scope: Purchasing, negotiating, and executing crude and feedstock trades, owned by Supply And Trading (CM-1-2) | laboratory assay testing and certification, owned by Refining laboratory services | approving the final crude slate, owned by Refinery Planning and Optimization (CM-1-1-4) | placing secured crude across refineries, owned by Allocate Crude and Feedstock (CM-1-1-2-10) | crude and feedstock master data stewardship, owned by Manage Feedstock Data Quality (CM-1-2-5-1-1)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "candidate supply offers"
   },
   {
    "@language": "en",
    "@value": "crude and feedstock assays and quality data"
   },
   {
    "@language": "en",
    "@value": "delivered cost, freight, and differential data"
   },
   {
    "@language": "en",
    "@value": "product specification limits"
   },
   {
    "@language": "en",
    "@value": "refinery configuration and unit capability"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "evaluated and ranked crude and feedstock set with yield and value estimates"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Produce the technically and economically evaluated crude and feedstock set for the planning period."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-3",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10196"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Capture Crude & Feedstock Availability"
   },
   {
    "@language": "en",
    "@value": "Crude Availability Basis"
   },
   {
    "@language": "en",
    "@value": "Establish Supply Availability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish which crude and feedstock volumes can realistically be secured and delivered inside the planning period — by grade, source, and arrival window — covering already-contracted supply, term liftings, and credible spot opportunities."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node establishes one input of the optimization case, it does not own the underlying business decision or the source data. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. Availability is the volume-and-timing basis; suitability and value sit in Evaluate Crude & Feedstock (CM-1-1-4-7-2), and the placement decision sits in the approved Allocate Crude and Feedstock (CM-1-1-2-10). The taxonomy label says “Crude”; feedstock is included because the sibling optimization basis and the parent scope both treat them together."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.3"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Crude Availability"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers the supply-side volume basis of an optimization case: confirming contracted and term volumes, identifying credible additional spot availability, and stating arrival windows and any logistics or quality qualifications. Establishes what is available, not what is bought or where it is sent. Excludes securing supply and executing trades, owned by Supply And Trading (CM-1-2); excludes arrival and delivery scheduling, owned by Plan Feedstock Arrival (CM-1-2-5-3-3); excludes placing secured supply across refineries, owned by Allocate Crude and Feedstock (CM-1-1-2-10).\nIn scope: Confirm contracted and term supply volumes and lifting windows | identify credible incremental spot availability | state arrival windows and delivery qualifications | flag logistics, quality, or compatibility limits on availability | publish the available supply basis for the case\nOut of scope: Securing, negotiating, and executing supply, owned by Supply And Trading (CM-1-2) | scheduling arrivals and deliveries, owned by Plan Feedstock Arrival (CM-1-2-5-3-3) and Schedule Feedstock Delivery (CM-1-2-5-3-2) | placing secured crude across refineries, owned by Allocate Crude and Feedstock (CM-1-1-2-10) | judging processing suitability or value, owned by Evaluate Crude & Feedstock (CM-1-1-4-7-2) | managing feedstock inventory, owned by Manage Feedstock Inventory (CM-1-2-5-4-2)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/review-link"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/constrainedBy": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "lifting and nomination schedules"
   },
   {
    "@language": "en",
    "@value": "marine and pipeline logistics availability"
   },
   {
    "@language": "en",
    "@value": "port and tankage receipt limits"
   },
   {
    "@language": "en",
    "@value": "supplier availability advice"
   },
   {
    "@language": "en",
    "@value": "term and spot supply contracts"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "available crude and feedstock supply basis by grade, source, and arrival window"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Establish the crude and feedstock volumes and arrival windows available to the planning period."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-4",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/16820"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-bjce-refps-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-gloss-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/src-eia-lfmm-001"
   },
   {
    "@id": "https://w3id.org/lsc/ontology/source/step3c-definition-workbook"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#altLabel": [
   {
    "@language": "en",
    "@value": "Capture Planning Price Basis"
   },
   {
    "@language": "en",
    "@value": "Establish Price Assumptions"
   },
   {
    "@language": "en",
    "@value": "Price Assumption Capture"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#broader": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Establish the price and economic assumption set used to value crude, feedstock, and finished-product streams in the optimization case — market reference prices, quality and location differentials, freight, and internal transfer values — for the planning period."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#editorialNote": [
   {
    "@language": "en",
    "@value": "Batch 02 (2026-09-18). Read as a case-basis assembly step inside the CM-1-1-4-7 Refinery Optimization run cycle: this node establishes one input of the optimization case, it does not own the underlying business decision or the source data. Sibling “Capture …” nodes were defined together so their boundaries partition the case basis without overlap. The distinction that matters is assumption versus transaction: this node sets the prices a case is evaluated against, while the Marketing and Sales pricing nodes set prices a customer actually pays. The recorded assumption set is also the contemporaneous basis the locked backcasting rule requires, since Regional and Distribution Backcasting compare actuals to the approved plan and its original assumptions, never a later reforecast."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#inScheme": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#notation": [
   {
    "@value": "CM 1.1.4.7.4"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Product/Crude/Feedstock Price"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#scopeNote": [
   {
    "@language": "en",
    "@value": "Covers assembling and confirming the planning price basis: selecting reference quotations and forward curves, applying grade and location differentials and freight, setting internal transfer and intermediate stream values, and recording the assumption set so a case can be reproduced and later backcast. These are planning assumptions, not transactable prices. Excludes setting customer sales prices, owned by Sales Pricing Management (CM-1-3-6-3); excludes pricing strategy, owned by Pricing Strategy Management (CM-1-3-3-2); excludes price master data, owned by Maintain Price & Discount Master Data (CM-1-3-7-1-2).\nIn scope: Select reference price quotations and forward curves | apply quality, grade, and location differentials | apply freight and delivery cost assumptions | set internal transfer and intermediate stream values | record and version the price assumption set for the case\nOut of scope: Setting and implementing customer sales prices, owned by Sales Pricing Management (CM-1-3-6-3) | pricing strategy and approach, owned by Pricing Strategy Management (CM-1-3-3-2) | price and discount master data stewardship, owned by Maintain Price & Discount Master Data (CM-1-3-7-1-2) | price risk management and hedging, owned by Supply And Trading (CM-1-2-2) | transaction and invoice pricing, owned by Finance"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/apqcMappingDecision": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/no-candidate"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/cadence": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/cadence/monthly"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/conceptKind": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/concept-kind/process"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/keyInputFlow": [
   {
    "@language": "en",
    "@value": "freight and logistics cost rates"
   },
   {
    "@language": "en",
    "@value": "internal transfer pricing policy"
   },
   {
    "@language": "en",
    "@value": "operating cost assumptions"
   },
   {
    "@language": "en",
    "@value": "published market quotations and forward curves"
   },
   {
    "@language": "en",
    "@value": "quality and location differentials"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/operatingMode": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/operating-mode/periodic"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryOutputFlow": [
   {
    "@language": "en",
    "@value": "versioned price and economic assumption set for the planning period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/primaryPurpose": [
   {
    "@language": "en",
    "@value": "Establish the reproducible price and economic assumption set used to value the optimization case."
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/responsibleDomain": [
   {
    "@language": "en",
    "@value": "Commercial & Marketing"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/taxonomyLevel": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#integer",
    "@value": 4
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-5",
  "@type": [
   "http://www.w3.org/2004/02/skos/core#Concept"
  ],
  "http://purl.org/dc/terms/references": [
   {
    "@id": "https://w3id.org/lsc/ontology/source/apqc-pcf-7.2.2/element/10226"
   }
  ],
