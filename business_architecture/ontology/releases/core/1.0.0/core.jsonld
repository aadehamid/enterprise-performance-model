   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00008"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-3-7-9--CM-1-1-3-6--replenishment-requirement",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For each replenishment requirement or approved revision, Manage Inventory Replenishment (CM-1-1-3-7-9) establishes and releases the required product, quantity, destination, and timing before Physical Distribution Scheduling (CM-1-1-3-6) schedules the corresponding movement. Scheduling constraints may feed back into a revised replenishment requirement."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Inventory Replenishment before Physical Distribution Scheduling, per replenishment requirement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-7-9"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-3-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/replenishment-requirement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00068"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-4--CM-1-1-7-2--scheduling-horizon",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For each scheduling horizon, Refinery Planning and Optimization (CM-1-1-4) makes the applicable approved plan or authorized revision available before Production Scheduling (CM-1-1-7-2) releases the corresponding executable schedule. Scheduling preparation may overlap planning, and feasibility feedback may trigger plan revisions."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Refinery Planning and Optimization before Production Scheduling, per scheduling horizon"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-7-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/scheduling-horizon"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-01241"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-1-4-7-8--CM-1-1-4--plan-selection-decision",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For each plan-selection decision that uses scenario analysis, Perform Scenario Analysis (CM-1-1-4-7-8) provides the relevant evaluated alternatives before the corresponding production plan is selected and approved within Refinery Planning and Optimization (CM-1-1-4). This is an internal step-level sequence, not a sequence preceding the start of the parent process."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Perform Scenario Analysis before Refinery Planning and Optimization, per plan-selection decision"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4-7-8"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-1-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/linksToAncestor": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceCondition": [
   {
    "@language": "en",
    "@value": "For each plan-selection decision that uses scenario analysis"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/plan-selection-decision"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00112"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-2-8--CM-1-2-3-1-6--delivery-period",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Perform Lease Actualization (CM-1-2-3-1-6) follows establishment of the applicable effective lease-contract terms and required division-of-interest references maintained under Manage Lease Contract (CM-1-2-1-2-8), applying them to the relevant delivery or production period. Subsequent changes and corrections are handled through controlled updates."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Manage Lease Contract before Perform Lease Actualization, per delivery period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-2-8"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-3-1-6"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/delivery-period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00307"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3--CM-1-2-3-1--physical-movement",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For trade-linked physical movements, Actualizations (CM-1-2-3-1) follows initial Trade Capture (CM-1-2-1-3), using the captured trade and associated movement references to record and validate actual quantities and other applicable movement facts. Subsequent amendments and corrections remain controlled."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Trade Capture before Actualizations, per physical movement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceCondition": [
   {
    "@language": "en",
    "@value": "For trade-linked physical movements"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/physical-movement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-01289"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-11--CM-1-2-4-1-15--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Where a power transaction involves a separately captured transmission arrangement, Capture Transmission Deals (CM-1-2-1-3-11) records the applicable terms before Settle Power (CM-1-2-4-1-15) calculates or validates the associated transmission-related charges. Other power-settlement activities may proceed independently."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Transmission Deals before Settle Power, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-11"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1-15"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceCondition": [
   {
    "@language": "en",
    "@value": "Where a power transaction involves a separately captured transmission arrangement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00188"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-11--CM-1-2-4-1-7--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Where ISO/power-pool settlement includes items arising from a captured transmission arrangement, initial capture of the relevant arrangement under Capture Transmission Deals (CM-1-2-1-3-11) precedes validation of those items under Settle ISO/Power Pools (CM-1-2-4-1-7). Other settlement activities may proceed independently."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Transmission Deals before Settle ISO/Power Pools, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-11"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceCondition": [
   {
    "@language": "en",
    "@value": "Where ISO/power-pool settlement includes items arising from a captured transmission arrangement"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00351"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-3--CM-1-2-2-2--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Capture Physical Trades (CM-1-2-1-3-3) records the agreed commercial terms and makes the required trade data available to Confirmations Management (CM-1-2-2-2) for prompt counterparty confirmation. Initial capture precedes submission for confirmation; discrepancies may require controlled correction of the captured record."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Physical Trades before Confirmations Management, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-3"
   }
  ],
