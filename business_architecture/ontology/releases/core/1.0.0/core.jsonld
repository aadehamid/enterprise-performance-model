  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00193"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-5--CM-1-2-4-1-14--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Capture Storage Deals (CM-1-2-1-3-5) records the agreed storage-service terms before those terms are used by Settle Terminal/Storage (CM-1-2-4-1-14) to calculate and validate applicable charges. Settlement follows the agreement’s billing schedule and may occur periodically or in advance while the contract and storage operations remain active."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Storage Deals before Settle Terminal/Storage, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-5"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1-14"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00200"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-7--CM-1-2-2-2--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Capture Financial (OTC) Trades (CM-1-2-1-3-7) records the agreed transaction terms and makes the required trade data available to Confirmations Management (CM-1-2-2-2) for prompt counterparty confirmation. Initial capture precedes submission for confirmation; discrepancies and subsequent amendments are handled through controlled correction and confirmation procedures."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Financial (OTC) Trades before Confirmations Management, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00206"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-1-3-7--CM-1-2-4-1-11--transaction",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Settle Financial OTC Trades (CM-1-2-4-1-11) follows initial Capture Financial (OTC) Trades (CM-1-2-1-3-7), using the captured transaction terms and applicable settlement-period inputs to calculate and validate payment obligations, subject to the required confirmation, reconciliation, and authorization controls."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Capture Financial (OTC) Trades before Settle Financial OTC Trades, per transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-1-3-7"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1-11"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/transaction"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00319"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-3-1--CM-1-2-4-1--delivery-period",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For each physical delivery or settlement period, Actualizations (CM-1-2-3-1) records and validates the relevant actual quantities and movement facts before Settlements (CM-1-2-4-1) uses those inputs to calculate or validate the corresponding charges. Settlement preparation and contractually permitted provisional billing may proceed before every input is final; subsequent corrections are handled through controlled true-ups."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Actualizations before Settlements, per delivery period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-3-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/delivery-period"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-01291"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-4-1--CM-1-2-4-2-4--posting",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Manage AR/AP & Actuals (CM-1-2-4-2-4) follows the applicable settlement calculation and invoice validation under Settlements (CM-1-2-4-1) when posting the corresponding receivable, payable, or adjustment. Accruals and other financial-actuals activities may proceed independently; subsequent settlement changes are reflected through controlled adjustments."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Settlements before Manage AR/AP & Actuals, per posting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-1"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/posting"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-00374"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-2-4-4--CM-1-2-4-2-4--demurrage-claim",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6115309253"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "Demurrage Management (CM-1-2-4-4) precedes the claim-specific posting activities within Manage AR/AP & Actuals (CM-1-2-4-2-4) by providing the calculated, validated, and authorized demurrage amount and supporting references. Subsequent claim revisions are reflected through controlled accounting adjustments; unrelated AR/AP activity proceeds independently."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Demurrage Management before Manage AR/AP & Actuals, per demurrage claim"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/source-confirmed"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-2-4-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/demurrage-claim"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sourceRow": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#string",
    "@value": "REL-01294"
   }
  ]
 },
 {
  "@id": "https://w3id.org/lsc/ontology/sequence/CM-1-3-6-2-4--CM-1-3-7-2-2--quote-version",
  "@type": [
   "https://w3id.org/lsc/ontology/modules/core/ScopedSequence"
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "urn:epm:issue:205:comment:6116668059"
   }
  ],
  "http://www.w3.org/2004/02/skos/core#definition": [
   {
    "@language": "en",
    "@value": "For each customer quote or renewal version whose composition is owned by Develop Quote (CM-1-3-6-2-4), that version is developed and receives the required authorization before Issue Quotes & Renewals (CM-1-3-7-2-2) issues it to the customer. Preparatory issuance activities may proceed in parallel; revised versions repeat the applicable development and authorization steps."
   }
  ],
  "http://www.w3.org/2004/02/skos/core#prefLabel": [
   {
    "@language": "en",
    "@value": "Develop Quote before Issue Quotes & Renewals, per quote version"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/earlierProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-6-2-4"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/evidenceBasis": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/evidence-basis/reference-model-assumption"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/laterProcess": [
   {
    "@id": "https://w3id.org/lsc/ontology/process/CM-1-3-7-2-2"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceCondition": [
   {
    "@language": "en",
    "@value": "whose composition is owned by Develop Quote (CM-1-3-6-2-4)"
   }
  ],
  "https://w3id.org/lsc/ontology/modules/core/sequenceScope": [
   {
    "@id": "https://w3id.org/lsc/ontology/modules/core/scope-unit/quote-version"
   }
  ],
