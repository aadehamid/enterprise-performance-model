@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://w3id.org/lsc/ontology/catalog> a dcat:Catalog ;
    dcat:dataset <https://w3id.org/lsc/ontology/modules/core/2.0.0-rc.1> .

<https://w3id.org/lsc/ontology/modules/core/2.0.0-rc.1> a dcat:Dataset ;
    dcterms:isVersionOf <https://w3id.org/lsc/ontology/modules/core> ;
    dcterms:title "LSC Core Process Ontology 2.0.0-rc.1"@en ;
    owl:versionInfo "2.0.0-rc.1" ;
    dcat:distribution <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.jsonld>,
        <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.ttl>,
        <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/shapes.ttl> .

<https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.jsonld> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.jsonld> ;
    dcat:mediaType "application/ld+json" .

<https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/core.ttl> ;
    dcat:mediaType "text/turtle" .

<https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/shapes.ttl> a dcat:Distribution ;
    dcat:downloadURL <https://w3id.org/lsc/ontology/modules/core/releases/2.0.0-rc.1/shapes.ttl> ;
    dcat:mediaType "text/turtle" .

