table:view-mips-mpr-executive-summary-fact-vw a skos:Concept,
        dp:PlatformDataProduct,
        dp:PlatformTable ;
    dcterms:isPartOf product:master-pricing ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    skos:inScheme dp:PlatformTables ;
    skos:notation "view-mips-mpr-executive-summary-fact-vw"^^xsd:string ;
    skos:prefLabel "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"@en ;
    skos:topConceptOf dp:PlatformTables ;
    prov:wasDerivedFrom table:gold-mips-mpr-executive-summary-fact ;
    dp:classificationReason "Projects the gold Executive Summary fact, another data product, as a metric view for the Executive Summary Genie agent: a derived data product."^^xsd:string ;
    dp:classificationTest "logic"^^xsd:string ;
    dp:dataProductKind kind:derived ;
    dp:dependsOnSystem system:kittyhawk,
        system:mips,
        system:mpr ;
    dp:fullName "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"^^xsd:string ;
    dp:layer layer:metric-view ;
    dp:sandbox true ;
    dp:servesMeasure measure:additional-market-prices,
        measure:crude-prices,
        measure:distillate-prices,
        measure:gasoline-prices .

