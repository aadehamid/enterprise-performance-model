    prov:used table:view-mpr-mips-crack-spread-price-fact-metrics-vw .

agent:executive-summary-kpis-analytics a prov:SoftwareAgent ;
    rdfs:label "Executive Summary KPIs Analytics"@en ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    prov:used table:view-mips-mpr-benchmark-prices-fact-vw,
        table:view-mips-mpr-executive-summary-fact-vw .

column:gold-mips-mpr-executive-summary-fact--assessment_amount a dp:PlatformColumn ;
    prov:wasDerivedFrom column:silver-mips-price-assessment-fact--assessment_amount ;
    dp:columnName "assessment_amount"^^xsd:string ;
    dp:columnOf table:gold-mips-mpr-executive-summary-fact .

column:gold-mips-mpr-executive-summary-fact--changevalue a dp:PlatformColumn ;
    prov:wasDerivedFrom column:silver-mips-price-assessment-fact--assessment_amount,
        column:silver-mips-price-assessment-fact--previous_amount ;
    dp:columnName "ChangeValue"^^xsd:string ;
    dp:columnOf table:gold-mips-mpr-executive-summary-fact .

column:gold-mips-mpr-executive-summary-fact--previous_amount a dp:PlatformColumn ;
    prov:wasDerivedFrom column:silver-mips-price-assessment-fact--previous_amount ;
    dp:columnName "Previous_amount"^^xsd:string ;
    dp:columnOf table:gold-mips-mpr-executive-summary-fact .

column:gold-mpr-mips-crack-spread-price-fact--crack_spread_price_amount a dp:PlatformColumn ;
    prov:wasDerivedFrom column:silver-mpr-price-detail-fact--settle_price_amount ;
    dp:columnName "Crack_Spread_Price_Amount"^^xsd:string ;
    dp:columnOf table:gold-mpr-mips-crack-spread-price-fact .

column:view-mips-mpr-benchmark-prices-fact-vw--settle_price_amount a dp:PlatformColumn ;
    prov:wasDerivedFrom column:silver-mpr-price-detail-fact--settle_price_amount ;
    dp:columnName "Settle_Price_Amount"^^xsd:string ;
    dp:columnOf table:view-mips-mpr-benchmark-prices-fact-vw .

