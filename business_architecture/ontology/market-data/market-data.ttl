# Benchmark series of the market-data module (Step 7; EPM-DEC-001-0057, EPM-DEC-001-0066).
# Built by build_market_data.py from regions.csv, benchmarks.csv, series.csv, market-prices.csv and
# enumerations.csv. Do not edit by hand.
@prefix benchmark: <https://w3id.org/lsc/ontology/modules/market-data/benchmark/> .
@prefix bkind: <https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix enumeration: <https://w3id.org/lsc/ontology/modules/market-data/enumeration/> .
@prefix leg: <https://w3id.org/lsc/ontology/modules/market-data/leg/> .
@prefix measure: <https://w3id.org/lsc/ontology/modules/kpi/measure/> .
@prefix mkt: <https://w3id.org/lsc/ontology/modules/market-data/> .
@prefix price: <https://w3id.org/lsc/ontology/modules/market-data/price/> .
@prefix region: <https://w3id.org/lsc/ontology/modules/market-data/region/> .
@prefix series: <https://w3id.org/lsc/ontology/modules/market-data/series/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://w3id.org/lsc/ontology/source/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

enumeration:additional-market-prices a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    mkt:enumerates measure:additional-market-prices ;
    mkt:idColumn "MIPSDisplayName"^^xsd:string ;
    mkt:nameColumn "MIPSDisplayName"^^xsd:string ;
    mkt:rowFilter "MIPSDisplayName is one of the agent's ten renewables prices or two NGL prices."@en ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"^^xsd:string .

enumeration:crack-spreads a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    skos:note "127 series in 44 groups on 2026-10-25."@en ;
    mkt:enumerates measure:crack-spreads ;
    mkt:groupColumn "MIPS_Groups_Text"^^xsd:string ;
    mkt:idColumn "Price_Master_ID"^^xsd:string ;
    mkt:nameColumn "Price_Master_Name"^^xsd:string ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mpr_mips_crack_spread_price_fact_metrics_vw"^^xsd:string .

enumeration:crude-prices-benchmarks a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    skos:note "Five instruments."@en ;
    mkt:enumerates measure:crude-prices ;
    mkt:idColumn "Price_Master_ID"^^xsd:string ;
    mkt:nameColumn "Price_Master_Name"^^xsd:string ;
    mkt:rowFilter "The view's own definition keeps Price Master IDs 572, 747, 750, 752 and 9471."@en ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mips_mpr_benchmark_prices_fact_vw"^^xsd:string .

enumeration:crude-prices-differentials a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    mkt:enumerates measure:crude-prices ;
    mkt:groupColumn "Price_Sheet_Name"^^xsd:string ;
    mkt:idColumn "MIPSDisplayName"^^xsd:string ;
    mkt:nameColumn "MIPSDisplayName"^^xsd:string ;
    mkt:rowFilter "Price_Sheet_Name is 'Crude Reporting Sheet - Domestic Roll' or 'Crude Reporting Sheet Calendar Month Roll', and MIPSDisplayName is one of the agent's ten crude differentials."@en ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"^^xsd:string .

enumeration:distillate-prices a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    mkt:enumerates measure:distillate-prices ;
    mkt:groupColumn "Price_Group_Name"^^xsd:string ;
    mkt:idColumn "MIPSDisplayName"^^xsd:string ;
    mkt:nameColumn "MIPSDisplayName"^^xsd:string ;
    mkt:rowFilter "Price_Group_Name is 'Basis' or 'Cash', and MIPSDisplayName is one of the agent's nine distillate blends."@en ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"^^xsd:string .

enumeration:gasoline-prices a mkt:SeriesEnumeration ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    mkt:enumerates measure:gasoline-prices ;
    mkt:groupColumn "Price_Group_Name"^^xsd:string ;
    mkt:idColumn "MIPSDisplayName"^^xsd:string ;
    mkt:nameColumn "MIPSDisplayName"^^xsd:string ;
    mkt:rowFilter "Price_Group_Name is 'Basis' or 'Cash', and MIPSDisplayName is one of the agent's eight gasoline blends."@en ;
    mkt:sourceView "idp_sbx.semantic_sem_commercial.mips_mpr_executive_summary_fact_vw"^^xsd:string .

