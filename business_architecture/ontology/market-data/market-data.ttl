# Benchmark series of the market-data module (Step 7; EPM-DEC-001-0057, EPM-DEC-001-0066).
# Built by build_market_data.py from regions.csv, benchmarks.csv and series.csv. Do not edit by hand.
@prefix benchmark: <https://w3id.org/lsc/ontology/modules/market-data/benchmark/> .
@prefix bkind: <https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix leg: <https://w3id.org/lsc/ontology/modules/market-data/leg/> .
@prefix measure: <https://w3id.org/lsc/ontology/modules/kpi/measure/> .
@prefix mkt: <https://w3id.org/lsc/ontology/modules/market-data/> .
@prefix region: <https://w3id.org/lsc/ontology/modules/market-data/region/> .
@prefix series: <https://w3id.org/lsc/ontology/modules/market-data/series/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://w3id.org/lsc/ontology/source/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

series:crack-blended-3-2-1 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "MPC's blended crack spread: the Gulf Coast, Mid-Continent and West Coast crack spreads, weighted by MPC's refining capacity by region in each period."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-blended-3-2-1"^^xsd:string ;
    skos:prefLabel "Blended 3-2-1 crack spread"@en ;
    skos:scopeNote "Beginning in the second quarter of 2024, MPC weighted the blended crack spread 42 percent Gulf Coast, 40 percent Mid-Continent and 18 percent West Coast, based on its refining capacity by region in each period (MPC FY2025 Form 10-K, Item 7). The weights for 2026 are in the Q2 2026 Form 10-Q (MPC-S03; mpc-performance-measures-evidence.md, row 10)."@en ;
    mkt:blendOf series:crack-gulf-coast-3-2-1,
        series:crack-mid-continent-3-2-1,
        series:crack-west-coast-3-2-1 ;
    mkt:excludesRINCost true ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mpr-37439 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-economics-crack-spread-kpi-definition ;
    skos:definition "MPC Economics' published Group 3 (Tulsa) 3-2-1 crack: three barrels of WTI crude against two barrels of Group 3 CBOB and one of Group 3 ULSD, with the RVO cost deducted from each product barrel."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mpr-37439"^^xsd:string ;
    skos:prefLabel "Group 3-2-1 Crack WTI, ex-RIN"@en ;
    skos:scopeNote "Computed daily by MPC Economics' Ex-RVO formula, ((CBOB x 42 x 2) + (ULSD x 42 x 1)) / 3 - Crude - (RVO x 42), with product prices in dollars per gallon and crude in dollars per barrel; the monthly series is the mean of the daily published values (crack-spread-kpi-definition.md, sections 3.2 and 5.3). MPC's price data labels this treatment ex-RIN."@en ;
    mkt:excludesRINCost false ;
    mkt:leg leg:crack-mpr-37439--mpr-13056,
        leg:crack-mpr-37439--mpr-13076,
        leg:crack-mpr-37439--mpr-747,
        leg:crack-mpr-37439--mpr-9408 ;
    mkt:priceMasterId "37439"^^xsd:string ;
    mkt:region region:group-3 ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mpr-37443 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-economics-crack-spread-kpi-definition ;
    skos:definition "MPC Economics' published PNW 3-2-1 crack, an ANS crack by its MIPS group, with the RVO cost deducted. The definition does not list its input legs."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mpr-37443"^^xsd:string ;
    skos:prefLabel "PNW 3-2-1 Crack, ex-RIN"@en ;
    skos:scopeNote "Computed daily by MPC Economics' Ex-RVO formula, ((CBOB x 42 x 2) + (ULSD x 42 x 1)) / 3 - Crude - (RVO x 42), with product prices in dollars per gallon and crude in dollars per barrel; the monthly series is the mean of the daily published values (crack-spread-kpi-definition.md, sections 3.2 and 5.3). MPC's price data labels this treatment ex-RIN."@en ;
    mkt:excludesRINCost false ;
    mkt:legsUnstated true ;
    mkt:priceMasterId "37443"^^xsd:string ;
    mkt:region region:pnw ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mpr-37464 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-economics-crack-spread-kpi-definition ;
    skos:definition "MPC Economics' MPC-weighted 3-2-1: the USGC, Chicago and LA ex-RIN cracks weighted to approximate a realized MPC 3-2-1."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mpr-37464"^^xsd:string ;
    skos:prefLabel "Blended 3-2-1 Crack, ex-RIN"@en ;
    skos:scopeNote "MPC Economics weights the three ex-RIN cracks USGC 0.40, Chicago 0.40 and LA 0.20 before 5 May 2024, and USGC 0.42, Chicago 0.40 and LA 0.18 after (crack-spread-kpi-definition.md, section 4.4)."@en ;
    mkt:blendOf series:crack-mpr-36855,
        series:crack-mpr-37438,
        series:crack-mpr-43870 ;
    mkt:excludesRINCost false ;
    mkt:priceMasterId "37464"^^xsd:string ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mpr-37471 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-economics-crack-spread-kpi-definition ;
    skos:definition "MPC Economics' published SLC 3-2-1 crack, a WTI crack, with the RVO cost deducted. The definition does not list its input legs."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mpr-37471"^^xsd:string ;
    skos:prefLabel "SLC 3-2-1 Crack WTI, ex-RIN"@en ;
    skos:scopeNote "Computed daily by MPC Economics' Ex-RVO formula, ((CBOB x 42 x 2) + (ULSD x 42 x 1)) / 3 - Crude - (RVO x 42), with product prices in dollars per gallon and crude in dollars per barrel; the monthly series is the mean of the daily published values (crack-spread-kpi-definition.md, sections 3.2 and 5.3). MPC's price data labels this treatment ex-RIN."@en ;
    mkt:excludesRINCost false ;
    mkt:legsUnstated true ;
    mkt:priceMasterId "37471"^^xsd:string ;
    mkt:region region:slc ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mpr-42023 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-economics-crack-spread-kpi-definition ;
    skos:definition "The second published result of MPC Economics' MPC-weighted 3-2-1, from the same three ex-RIN cracks. The definition does not say how it differs from the Blended 3-2-1 Crack, ex-RIN."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mpr-42023"^^xsd:string ;
    skos:prefLabel "MPC Internal Blended 3-2-1 Crack, ex-RIN"@en ;
    skos:scopeNote "MPC Economics weights the three ex-RIN cracks USGC 0.40, Chicago 0.40 and LA 0.20 before 5 May 2024, and USGC 0.42, Chicago 0.40 and LA 0.18 after (crack-spread-kpi-definition.md, section 4.4)."@en ;
    mkt:blendOf series:crack-mpr-36855,
        series:crack-mpr-37438,
        series:crack-mpr-43870 ;
    mkt:excludesRINCost false ;
    mkt:priceMasterId "42023"^^xsd:string ;
    mkt:seriesOf measure:crack-spreads .

series:crack-nymex-3-2-1 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:cme-trading-crack-spreads-2024 ;
    skos:altLabel "NYMEX 3-2-1"@en,
        "NYMEX 3-2-1 Crack"@en ;
    skos:definition "The exchange-traded crack spread: three NYMEX WTI crude oil futures against two RBOB gasoline futures and one NY Harbor ULSD futures. Not one of MPC's benchmarks."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-nymex-3-2-1"^^xsd:string ;
    skos:prefLabel "NYMEX 3:2:1 crack spread"@en ;
    skos:scopeNote "Shares the name 3-2-1 with MPC's regional crack spreads but is a different series: its legs are exchange futures, and its gasoline leg is RBOB, which MPC's benchmarks do not use. MPC Economics publishes it as NYMEX 3-2-1 Crack (Price Master 39998) and calls the diesel leg NYMEX Heating Oil (crack-spread-kpi-definition.md, section 4.3)."@en ;
    mkt:leg leg:crack-nymex-3-2-1--nymex-ny-harbor-ulsd,
        leg:crack-nymex-3-2-1--nymex-rbob,
        leg:crack-nymex-3-2-1--nymex-wti ;
    mkt:priceMasterId "39998"^^xsd:string ;
    mkt:seriesOf measure:crack-spreads .

