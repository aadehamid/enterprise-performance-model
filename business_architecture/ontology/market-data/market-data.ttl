leg:crack-gulf-coast-3-2-1--meh a mkt:Leg ;
    mkt:barrels 3 ;
    mkt:benchmark benchmark:meh .

leg:crack-gulf-coast-3-2-1--usgc-cbob a mkt:Leg ;
    mkt:barrels 2 ;
    mkt:benchmark benchmark:usgc-cbob .

leg:crack-gulf-coast-3-2-1--usgc-ulsd a mkt:Leg ;
    mkt:barrels 1 ;
    mkt:benchmark benchmark:usgc-ulsd .

leg:crack-mid-continent-3-2-1--chicago-cbob a mkt:Leg ;
    mkt:barrels 2 ;
    mkt:benchmark benchmark:chicago-cbob .

leg:crack-mid-continent-3-2-1--chicago-ulsd a mkt:Leg ;
    mkt:barrels 1 ;
    mkt:benchmark benchmark:chicago-ulsd .

leg:crack-mid-continent-3-2-1--wti a mkt:Leg ;
    mkt:barrels 3 ;
    mkt:benchmark benchmark:wti .

leg:crack-nymex-3-2-1--nymex-ny-harbor-ulsd a mkt:Leg ;
    mkt:barrels 1 ;
    mkt:benchmark benchmark:nymex-ny-harbor-ulsd .

leg:crack-nymex-3-2-1--nymex-rbob a mkt:Leg ;
    mkt:barrels 2 ;
    mkt:benchmark benchmark:nymex-rbob .

leg:crack-nymex-3-2-1--nymex-wti a mkt:Leg ;
    mkt:barrels 3 ;
    mkt:benchmark benchmark:nymex-wti .

leg:crack-west-coast-3-2-1--ans a mkt:Leg ;
    mkt:barrels 3 ;
    mkt:benchmark benchmark:ans .

leg:crack-west-coast-3-2-1--la-carb-diesel a mkt:Leg ;
    mkt:barrels 1 ;
    mkt:benchmark benchmark:la-carb-diesel .

leg:crack-west-coast-3-2-1--la-carbob a mkt:Leg ;
    mkt:barrels 2 ;
    mkt:benchmark benchmark:la-carbob .

series:crack-gulf-coast-3-2-1 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:altLabel "USGC 3-2-1 MEH ex-RIN"@en ;
    skos:definition "MPC's Gulf Coast crack spread: three barrels of MEH crude producing two barrels of USGC CBOB gasoline and one barrel of USGC ULSD."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-gulf-coast-3-2-1"^^xsd:string ;
    skos:prefLabel "Gulf Coast 3-2-1 crack spread"@en ;
    mkt:excludesRINCost true ;
    mkt:leg leg:crack-gulf-coast-3-2-1--meh,
        leg:crack-gulf-coast-3-2-1--usgc-cbob,
        leg:crack-gulf-coast-3-2-1--usgc-ulsd ;
    mkt:region region:gulf-coast ;
    mkt:seriesOf measure:crack-spreads .

series:crack-mid-continent-3-2-1 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:altLabel "Chicago WTI 3-2-1 ex-RIN"@en ;
    skos:definition "MPC's Mid-Continent crack spread: three barrels of WTI crude producing two barrels of Chicago CBOB gasoline and one barrel of Chicago ULSD."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-mid-continent-3-2-1"^^xsd:string ;
    skos:prefLabel "Mid-Continent 3-2-1 crack spread"@en ;
    mkt:excludesRINCost true ;
    mkt:leg leg:crack-mid-continent-3-2-1--chicago-cbob,
        leg:crack-mid-continent-3-2-1--chicago-ulsd,
        leg:crack-mid-continent-3-2-1--wti ;
    mkt:region region:mid-continent ;
    mkt:seriesOf measure:crack-spreads .

series:crack-west-coast-3-2-1 a skos:Concept,
        mkt:BenchmarkSeries ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "MPC's West Coast crack spread: three barrels of ANS crude producing two barrels of LA CARBOB and one barrel of LA CARB Diesel."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "crack-west-coast-3-2-1"^^xsd:string ;
    skos:prefLabel "West Coast 3-2-1 crack spread"@en ;
