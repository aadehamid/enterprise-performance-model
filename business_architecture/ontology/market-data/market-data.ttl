        leg:crack-west-coast-3-2-1--la-carbob ;
    mkt:region region:west-coast ;
    mkt:seriesOf measure:crack-spreads .

region:gulf-coast a skos:Concept ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "MPC's Gulf Coast refining region: the Galveston Bay (Texas City, Texas) and Garyville, Louisiana refineries."@en ;
    skos:inScheme mkt:RefiningRegions ;
    skos:notation "gulf-coast"^^xsd:string ;
    skos:prefLabel "Gulf Coast"@en .

region:mid-continent a skos:Concept ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "MPC's Mid-Continent refining region: the Catlettsburg, Robinson, Detroit, El Paso, St. Paul Park, Canton, Mandan and Salt Lake City refineries."@en ;
    skos:inScheme mkt:RefiningRegions ;
    skos:notation "mid-continent"^^xsd:string ;
    skos:prefLabel "Mid-Continent"@en .

region:west-coast a skos:Concept ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "MPC's West Coast refining region: the Los Angeles, Anacortes and Kenai refineries."@en ;
    skos:inScheme mkt:RefiningRegions ;
    skos:notation "west-coast"^^xsd:string ;
    skos:prefLabel "West Coast"@en .

