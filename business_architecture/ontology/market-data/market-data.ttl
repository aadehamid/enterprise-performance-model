        mkt:Benchmark ;
    dcterms:source src:mpc-performance-measures-evidence ;
    skos:definition "The Chicago CBOB gasoline price, a benchmark price in MPC's marketing areas."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "chicago-cbob"^^xsd:string ;
    skos:prefLabel "Chicago CBOB"@en ;
    mkt:benchmarkKind bkind:product-benchmark ;
    mkt:region region:mid-continent .

