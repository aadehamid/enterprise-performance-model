price:alaska-north-slope-ans-vs-ice-brent a skos:Concept,
        mkt:MarketPrice ;
    dcterms:source src:decision-owner-pricing-assets-2026-10-25 ;
    skos:definition "The Alaska North Slope (ANS) vs. ICE Brent differential, one of the ten crude differentials the Executive Summary view reports for Crude Market Pricing."@en ;
    skos:inScheme mkt:Series ;
    skos:notation "price-alaska-north-slope-ans-vs-ice-brent"^^xsd:string ;
    skos:prefLabel "Alaska North Slope (ANS) vs. ICE Brent"@en ;
    skos:topConceptOf mkt:Series ;
    mkt:priceOf measure:crude-prices ;
    mkt:reportedAs "differential"^^xsd:string .

