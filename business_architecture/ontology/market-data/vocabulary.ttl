# The market-data module's vocabulary (Step 7; EPM-DEC-001-0057, EPM-DEC-001-0066): the published series of a
# market measure, the benchmark prices and crude markers they are built from, and the refining
# regions they track. Market Data governs benchmark identifiers and assessment conventions
# (EPM-DEC-001-0046). Definitions only, never prices (EPM-DEC-001-0005).
@prefix mkt: <https://w3id.org/lsc/ontology/modules/market-data/> .
@prefix bkind: <https://w3id.org/lsc/ontology/modules/market-data/benchmark-kind/> .
@prefix kpi: <https://w3id.org/lsc/ontology/modules/kpi/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mkt:BenchmarkSeries a owl:Class ;
    rdfs:label "benchmark series"@en ;
    skos:definition "One published series of a market measure, identified by what it is built from: its region, its crude and product legs and their ratio, and what it leaves out. Two series of the same measure are different series when any of these differ."@en ;
    dcterms:bibliographicCitation "competency question 31; EPM-DEC-001-0046, EPM-DEC-001-0057"@en .

mkt:Benchmark a owl:Class ;
    rdfs:label "benchmark price"@en ;
    skos:definition "A published price that a series is built from: a crude marker, a refined-product benchmark at a named market, or a compliance cost such as the RVO."@en ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 7 (business_architecture/reference/mpc/mpc-performance-measures-evidence.md, row 11); EPM-DEC-001-0057; EPM-DEC-001-0066"@en .

mkt:Leg a owl:Class ;
    rdfs:label "series leg"@en ;
    skos:definition "One part of a series' recipe: a benchmark and the number of barrels of it."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0057"@en .

mkt:RefiningRegions a skos:ConceptScheme ;
    rdfs:label "refining regions"@en ;
    skos:definition "MPC's three refining regions, by the names MPC uses."@en ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 2 (mpc-performance-measures-evidence.md, finding 3)"@en .

mkt:MarketRegions a skos:ConceptScheme ;
    rdfs:label "market regions"@en ;
    skos:definition "The product market regions of MPC Economics' published 3-2-1 crack series: USGC, Chicago, Group 3 (Tulsa), LA, PNW and SLC. They are price markets, not MPC's refining regions."@en ;
    dcterms:bibliographicCitation "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 4.1; EPM-DEC-001-0066"@en .

mkt:Series a skos:ConceptScheme ;
    rdfs:label "market series and prices"@en ;
    skos:definition "The benchmark series, benchmark prices and market prices the market-data module defines."@en ;
    skos:changeNote "market-data 1.1.0 (2026-10-26): the definition names the market prices the pricing views add; the label was \"benchmark series\" (EPM-DEC-001-0100)."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0057"@en .

mkt:seriesOf a owl:ObjectProperty ;
    rdfs:label "series of"@en ;
    rdfs:domain mkt:BenchmarkSeries ; rdfs:range kpi:MeasureDefinition ;
    skos:definition "The measure of the kpi module that the series is one published form of."@en ;
    dcterms:bibliographicCitation "competency question 31; EPM-DEC-001-0057"@en .

mkt:region a owl:ObjectProperty ;
    rdfs:label "region"@en ;
    rdfs:range skos:Concept ;
    skos:definition "The refining region a series tracks, or the market region of a series or a benchmark's market."@en ;
    dcterms:bibliographicCitation "competency question 34; EPM-DEC-001-0057; EPM-DEC-001-0066"@en .

mkt:leg a owl:ObjectProperty ;
    rdfs:label "leg"@en ;
    rdfs:domain mkt:BenchmarkSeries ; rdfs:range mkt:Leg ;
    skos:definition "One leg of the series' recipe."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0057"@en .

mkt:benchmark a owl:ObjectProperty ;
    rdfs:label "benchmark"@en ;
    rdfs:domain mkt:Leg ; rdfs:range mkt:Benchmark ;
    skos:definition "The benchmark price the leg uses."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0057"@en .

mkt:barrels a owl:DatatypeProperty ;
    rdfs:label "barrels"@en ;
    rdfs:domain mkt:Leg ; rdfs:range xsd:integer ;
    skos:definition "The number of barrels of the benchmark in the recipe, as in the 3 and 2 and 1 of a 3-2-1 crack spread. A ratio, not a price."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0057"@en .

mkt:blendOf a owl:ObjectProperty ;
    rdfs:label "blend of"@en ;
    rdfs:domain mkt:BenchmarkSeries ; rdfs:range mkt:BenchmarkSeries ;
    skos:definition "A series the blended series is weighted from. The weights are stated in the series' scope note, with their source and period, because they change."@en ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 7 (mpc-performance-measures-evidence.md, row 10)"@en .

mkt:excludesRINCost a owl:DatatypeProperty ;
    rdfs:label "excludes RIN cost"@en ;
    rdfs:domain mkt:BenchmarkSeries ; rdfs:range xsd:boolean ;
    skos:definition "True when the series does not reflect the market cost of RINs, as MPC's 10-K crack spreads do not (MPC Economics' Inc-RVO treatment). False when the series deducts the RVO cost (MPC Economics' Ex-RVO treatment, which MPC's price data labels ex-RIN). A series with RIN costs and one without are different series."@en ;
    skos:scopeNote "The labels run opposite to this property's name: an ex-RIN series deducts the RVO cost, so it has false here (EPM-DEC-001-0066)."@en ;
    dcterms:bibliographicCitation "MPC FY2025 Form 10-K, Item 7: the crack spreads \"do not reflect the market cost of RINs\" (mpc-performance-measures-evidence.md, row 10); MPC Economics, 3-2-1 Crack Spread KPI Definition, section 3 (reference/internal/crack-spread-kpi-definition.md); competency question 31"@en .

mkt:priceMasterId a owl:DatatypeProperty ;
    rdfs:label "Price Master ID"@en ;
    rdfs:range xsd:string ;
    skos:definition "The identifier MPC's price data (MPR Price Master) gives the series or input price. An identifier, not a price."@en ;
    dcterms:bibliographicCitation "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 4; EPM-DEC-001-0066"@en .

mkt:legsUnstated a owl:DatatypeProperty ;
    rdfs:label "legs unstated"@en ;
    rdfs:domain mkt:BenchmarkSeries ; rdfs:range xsd:boolean ;
    skos:definition "True when the source names the published series but does not list its input legs."@en ;
    dcterms:bibliographicCitation "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 4.2 note; EPM-DEC-001-0066"@en .

mkt:benchmarkKind a owl:ObjectProperty ;
    rdfs:label "benchmark kind"@en ;
    rdfs:domain mkt:Benchmark ; rdfs:range skos:Concept ;
    skos:definition "Whether the benchmark is a crude marker, a refined-product benchmark or a compliance cost."@en ;
    dcterms:bibliographicCitation "mpc-performance-measures-evidence.md, row 11; EPM-DEC-001-0066"@en .

mkt:BenchmarkKind a skos:ConceptScheme ; skos:hasTopConcept bkind:crude-marker, bkind:product-benchmark, bkind:compliance-cost ; rdfs:label "benchmark kind"@en ;
    skos:definition "The kinds of benchmark price a series is built from."@en ;
    dcterms:bibliographicCitation "mpc-performance-measures-evidence.md, row 11; EPM-DEC-001-0066"@en .
bkind:crude-marker a skos:Concept ; skos:inScheme mkt:BenchmarkKind ; skos:topConceptOf mkt:BenchmarkKind ; skos:prefLabel "Crude marker"@en ; skos:notation "crude-marker" ;
    skos:definition "A published crude oil price that a crack spread uses for its crude leg."@en .
bkind:product-benchmark a skos:Concept ; skos:inScheme mkt:BenchmarkKind ; skos:topConceptOf mkt:BenchmarkKind ; skos:prefLabel "Product benchmark"@en ; skos:notation "product-benchmark" ;
    skos:definition "A published refined-product price at a named market, used for a crack spread's product legs."@en .
bkind:compliance-cost a skos:Concept ; skos:inScheme mkt:BenchmarkKind ; skos:topConceptOf mkt:BenchmarkKind ; skos:prefLabel "Compliance cost"@en ; skos:notation "compliance-cost" ;
    skos:definition "A published per-gallon compliance cost, such as the RVO, that an Ex-RVO crack deducts from each product barrel."@en ;
    dcterms:bibliographicCitation "MPC Economics, 3-2-1 Crack Spread KPI Definition, section 3.2; EPM-DEC-001-0066"@en .

# Since 1.1.0: the other pricing measures' prices, and where the full list of each measure's series is
# (EPM-DEC-001-0097, items 4 and 5). Definitions only, never prices.
mkt:MarketPrice a owl:Class ;
    rdfs:label "market price"@en ;
    skos:definition "A named market price that a pricing measure of the kpi module presents, as the decision owner's pricing views report it: a product price at a market, a crude differential, a futures settlement, or a renewables or NGL price. A definition, never a price."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, items 4 and 5"@en .

mkt:priceOf a owl:ObjectProperty ;
    rdfs:label "price of"@en ;
    rdfs:range kpi:MeasureDefinition ;
    skos:definition "The pricing measure of the kpi module that presents this price. A benchmark that a pricing view also reports carries it too."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 4"@en .

mkt:reportedAs a owl:DatatypeProperty ;
    rdfs:label "reported as"@en ;
    rdfs:range xsd:string ;
    skos:definition "How the pricing view reports the price: basis (a differential to the futures contract), cash, differential, settlement or assessment."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 4"@en .

mkt:SeriesEnumeration a owl:Class ;
    rdfs:label "series enumeration"@en ;
    skos:definition "Where the complete list of a measure's series is: a view and the columns that identify, name and group each series, with the rows' filter. The module names only examples; the view lists them all."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:enumerates a owl:ObjectProperty ;
    rdfs:label "enumerates"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range kpi:MeasureDefinition ;
    skos:definition "The measure whose series the enumeration lists."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:sourceView a owl:DatatypeProperty ;
    rdfs:label "source view"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range xsd:string ;
    skos:definition "The full name of the view that lists the series, catalog, schema and view."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:idColumn a owl:DatatypeProperty ;
    rdfs:label "identifier column"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range xsd:string ;
    skos:definition "The view's column whose distinct values are the series."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:nameColumn a owl:DatatypeProperty ;
    rdfs:label "name column"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range xsd:string ;
    skos:definition "The view's column that names each series."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:groupColumn a owl:DatatypeProperty ;
    rdfs:label "group column"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range xsd:string ;
    skos:definition "The view's column that groups the series."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .

mkt:rowFilter a owl:DatatypeProperty ;
    rdfs:label "row filter"@en ;
    rdfs:domain mkt:SeriesEnumeration ; rdfs:range rdf:langString ;
    skos:definition "Which of the view's rows belong to the measure, in words, as the agent's filters state it."@en ;
    dcterms:bibliographicCitation "EPM-DEC-001-0097, item 5"@en .
