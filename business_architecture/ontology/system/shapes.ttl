# SHACL shapes for the system module (Step 7; EPM-DEC-001-0055). A stated cardinality on every
# property (EPM-DEC-001-0020, rule 2; playbook Appendix B).
@prefix sys: <https://w3id.org/lsc/ontology/modules/system/> .
@prefix kind: <https://w3id.org/lsc/ontology/modules/system/kind/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shp: <https://w3id.org/lsc/ontology/modules/system/shapes/> .

shp:System a sh:NodeShape ;
    sh:targetClass sys:System ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:languageIn ( "en" ) ; sh:message "A system has exactly one English name." ] ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue sys:Systems ] ;
    sh:property [ sh:path skos:altLabel ; sh:minCount 0 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path skos:editorialNote ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
                  sh:message "A system says why it has no definition." ] ;
    sh:property [ sh:path skos:definition ; sh:maxCount 0 ;
                  sh:message "No source defines the systems, so none carries a definition (EPM-DEC-001-0055)." ] ;
    sh:property [ sh:path sys:systemKind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( kind:application kind:office-tool kind:document ) ] ;
    sh:property [ sh:path sys:supports ; sh:minCount 0 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
