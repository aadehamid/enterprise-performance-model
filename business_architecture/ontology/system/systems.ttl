    dcterms:source src:decision-owner-answers-2026-10-24-systems,
        src:downstream-process-map ;
    skos:altLabel "DPO"@en ;
    skos:definition "An MPC-built optimization model and application that produces the distribution plan for the prompt month to M+3, across pipelines, marine and inventory. Planners build a base distribution plan in it, reconcile it with the XPIMS refinery plan, update its network constraints, and hand over the final distribution plan. It is also used in the distribution backcast, to evaluate actuals cases and optimization cases."@en ;
    skos:inScheme sys:Systems ;
    skos:notation "dpo"^^xsd:string ;
    skos:prefLabel "Distribution Planning Optimizer"@en ;
