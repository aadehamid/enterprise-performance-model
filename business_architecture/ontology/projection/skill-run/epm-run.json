{
  "mode": "releases",
  "projection_config": "epm-config.json",
  "inputs_script": "inputs.py",
  "releases": "../../releases",
  "release_graphs": ["shapes", "catalog"],
  "out": "~/lpg-out/epm",
  "robot_jar": "~/epm-lpg/robot.jar",
  "target_env": "~/.config/neo4j/aura.env",
  "replace_target": true,
  "databricks": {"env": "~/.config/databricks/epm.env", "table": "epm_triples"},
  "queries": "queries.json",
  "rebuild": {"source": "databricks", "out": "~/lpg-out/epm-rebuild"}
}
