# Q7 Which data products have no owning process? (no process produces them, directly or through the value streams)
PREFIX dp: <https://w3id.org/lsc/ontology/modules/data-product/>
PREFIX vs: <https://w3id.org/lsc/ontology/modules/value-stream/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?product ?name WHERE {
  ?product a dp:DataProduct ; skos:prefLabel ?name .
  FILTER NOT EXISTS { ?product dp:producedBy ?process }
  FILTER NOT EXISTS { ?step vs:produces ?product }
  FILTER NOT EXISTS { ?product skos:broader ?line . ?step vs:produces ?line }
}
