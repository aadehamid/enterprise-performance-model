# Q1. What is the full root-to-leaf path of process P? Rows: concepts with no path to a top concept (must be none).
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX core: <https://w3id.org/lsc/ontology/modules/core/>
PREFIX mod: <https://w3id.org/lsc/ontology/modules/>
PREFIX apqc: <https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/>

SELECT ?c WHERE { ?c skos:inScheme mod:core . FILTER NOT EXISTS { ?c skos:broader* ?top . ?top skos:topConceptOf mod:core } }
