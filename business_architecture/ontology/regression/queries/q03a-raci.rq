# Q3. Who is Accountable / Responsible / Consulted / Informed for process P? (one row per process, level and role)
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX mod: <https://w3id.org/lsc/ontology/modules/>
PREFIX orgm: <https://w3id.org/lsc/ontology/modules/organization/>
PREFIX raci: <https://w3id.org/lsc/ontology/modules/organization/raci-level/>

SELECT DISTINCT ?process ?level ?role ?roleName WHERE {
  ?a a orgm:ResponsibilityAssignment ; orgm:forProcess ?process ; orgm:raciLevel ?level ; orgm:assignedRole ?role .
  ?process skos:inScheme mod:core . ?role skos:prefLabel ?roleName }
