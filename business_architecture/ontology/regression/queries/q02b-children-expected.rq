# Q2. Which processes have children expected that are not yet modeled? (every planned child note)
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX core: <https://w3id.org/lsc/ontology/modules/core/>
PREFIX mod: <https://w3id.org/lsc/ontology/modules/>
PREFIX src: <https://w3id.org/lsc/ontology/source/>
PREFIX proc: <https://w3id.org/lsc/ontology/process/>

SELECT ?c ?planned WHERE { ?c core:plannedChildNote ?planned . }
