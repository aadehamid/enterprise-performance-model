# Q18. When a definition changes, what stays the same (the identity) and what gets a new version? (each concept keeps its IRI and notation; the module carries the version)
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX core: <https://w3id.org/lsc/ontology/modules/core/>
PREFIX mod: <https://w3id.org/lsc/ontology/modules/>
PREFIX apqc: <https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/>

SELECT ?c ?notation ?version WHERE { mod:core owl:versionInfo ?version . ?c skos:inScheme mod:core ; skos:notation ?notation . }
