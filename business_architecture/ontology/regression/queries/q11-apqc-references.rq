# Q11. Which local processes reference APQC element E?
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX core: <https://w3id.org/lsc/ontology/modules/core/>
PREFIX mod: <https://w3id.org/lsc/ontology/modules/>
PREFIX apqc: <https://w3id.org/lsc/ontology/modules/core/apqc-mapping-decision/>

SELECT ?c ?element ?id WHERE { ?c dcterms:references ?element . ?element dcterms:identifier ?id . }
