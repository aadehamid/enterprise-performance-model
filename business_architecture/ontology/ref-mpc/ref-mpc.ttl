# Reference instances for Marathon Petroleum Corporation (Step 5, slice 4; EPM-DEC-001-0015,
# EPM-DEC-001-0033). Public facts from MPC's FY2025 Form 10-K (MPC-S01 in
# business_architecture/reference/mpc/source-register.md), plus the two LEIs from GLEIF
# (EPM-DEC-001-0023: GLEIF is mapped at Step 5, not imported). Each instance cites its source.
# The organizations, segments and refineries hold as of their dcterms:date; the control
# relationship holds as of its orgm:asOf. The core and organization modules stay
# company-neutral: this module refers to their terms by IRI.
@prefix refmpc: <https://w3id.org/lsc/ontology/modules/ref-mpc/> .
@prefix orgm: <https://w3id.org/lsc/ontology/modules/organization/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix src: <https://w3id.org/lsc/ontology/source/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lsc/ontology/modules/ref-mpc> a owl:Ontology ;
    dcterms:title "LSC reference instances: Marathon Petroleum Corporation"@en ;
    dcterms:description "Public reference facts about MPC and MPLX, kept apart from the company-neutral modules (EPM-DEC-001-0015)."@en .

# ---- The source ----

src:mpc-s01 a dcterms:BibliographicResource ;
    dcterms:title "Marathon Petroleum Corporation, Form 10-K for the fiscal year ended 2025-12-31"@en ;
    dcterms:identifier "0001510295-26-000009" ;
    dcterms:issued "2026-02-26"^^xsd:date ;
    dcterms:bibliographicCitation "https://www.sec.gov/Archives/edgar/data/1510295/000151029526000009/mpc-20251231.htm"@en .

src:gleif-lei a dcterms:BibliographicResource ;
    dcterms:title "GLEIF LEI records (Level 1 and Level 2), golden copy published 2026-10-13"@en ;
    dcterms:identifier "GLEIF API v1, lei-records" ;
    dcterms:issued "2026-10-13"^^xsd:date ;
    dcterms:bibliographicCitation "https://api.gleif.org/api/v1/lei-records"@en .

# ---- Legal entities ----

refmpc:mpc a org:FormalOrganization ;
    skos:prefLabel "Marathon Petroleum Corporation"@en ;
    skos:altLabel "MPC"@en ;
    org:identifier "3BNYRYQHD39K4LCKQF12" ;
    rdfs:seeAlso <https://api.gleif.org/api/v1/lei-records/3BNYRYQHD39K4LCKQF12> ;
    dcterms:source src:mpc-s01, src:gleif-lei ; dcterms:date "2025-12-31"^^xsd:date .

refmpc:mplx a org:FormalOrganization ;
    skos:prefLabel "MPLX LP"@en ;
    skos:altLabel "MPLX"@en ;
    org:identifier "5493000CZJ19CK4P3G36" ;
    rdfs:seeAlso <https://api.gleif.org/api/v1/lei-records/5493000CZJ19CK4P3G36> ;
    skos:scopeNote "A master limited partnership that MPC sponsors. A separate legal entity, not a unit of MPC: MPC's control of it is the control relationship below, not org:subOrganizationOf."@en ;
    skos:note "GLEIF lists this LEI's registration as LAPSED (last updated 2023-08-04) and records no accounting-consolidation parent (reporting exception NO_KNOWN_PERSON), so the control relationship below has no GLEIF Level 2 counterpart."@en ;
    dcterms:source src:mpc-s01, src:gleif-lei ; dcterms:date "2025-12-31"^^xsd:date .

refmpc:mpc-controls-mplx a orgm:ControlRelationship ;
    orgm:controllingEntity refmpc:mpc ;
    orgm:controlledEntity refmpc:mplx ;
    orgm:ownershipShare 0.64 ;
    orgm:asOf "2025-12-31"^^xsd:date ;
    skos:note "The filing states the share as approximate: \"As of December 31, 2025, we owned the general partner of MPLX and approximately 64 percent of the outstanding MPLX common units.\" MPC controls and consolidates MPLX (Item 1, Overview; Item 7)."@en ;
    dcterms:source src:mpc-s01 .

# ---- Reportable segments (three, per the filing) ----

refmpc:segment-refining-and-marketing a org:OrganizationalUnit ;
    skos:prefLabel "Refining & Marketing"@en ;
    org:unitOf refmpc:mpc ;
    skos:definition "MPC's reportable segment that refines crude oil and other feedstocks at its refineries and sells refined products."@en ;
    dcterms:source src:mpc-s01 ; dcterms:date "2025-12-31"^^xsd:date .

refmpc:segment-midstream a org:OrganizationalUnit ;
    skos:prefLabel "Midstream"@en ;
    org:unitOf refmpc:mpc ;
    skos:definition "MPC's reportable segment that gathers, transports, stores and distributes crude oil, refined products and natural gas liquids, and processes natural gas. It is primarily MPLX."@en ;
    skos:scopeNote "A reporting segment of MPC, separate from the legal entity MPLX whose operations roll up into it (EPM-DEC-001-0015)."@en ;
    dcterms:source src:mpc-s01 ; dcterms:date "2025-12-31"^^xsd:date .

refmpc:segment-renewable-diesel a org:OrganizationalUnit ;
    skos:prefLabel "Renewable Diesel"@en ;
    org:unitOf refmpc:mpc ;
    skos:definition "MPC's reportable segment that processes renewable feedstocks into renewable diesel."@en ;
    dcterms:source src:mpc-s01 ; dcterms:date "2025-12-31"^^xsd:date .

# ---- Refineries (13, named in Item 2; capacity waits for a dated-quantity pattern, Step 7) ----

