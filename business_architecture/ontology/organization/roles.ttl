role:vp-rvco a org:Role ;
    dcterms:source src:downstream-process-map ;
    skos:altLabel "VP RVCO"@en ;
    skos:editorialNote "RVCO expanded as Refinery Value Chain Optimization, with the evidence on the Refinery Value Chain Optimization Advisor role (Hamid, 2026-10-18 (EPM-DEC-001-0045)). Kept apart from the long VP string, as the role questions package proposed: it is Accountable where that VP is Informed."@en ;
    skos:prefLabel "VP Refinery Value Chain Optimization"@en .

role:refinery-technical-representative a org:Role ;
    dcterms:source src:downstream-process-map ;
    skos:altLabel "Refinery Technical Service Representative"@en,
        "Refinery technical representative"@en ;
    skos:definition "Represents refinery technical expertise in planning and backcasting reviews, including review of operating assumptions, technical constraints and modeled refinery performance."@en ;
    skos:editorialNote "The surviving role for the Refinery Technical Service Representative (Hamid, 2026-10-18 (EPM-DEC-001-0045), question 3). The definition is Claude's EPM working definition, inferred from the backcasting processes it is consulted on; it is not an MPC position description."@en ;
    skos:prefLabel "Refinery Technical Representative"@en .

role:rvco-advisor a org:Role ;
    dcterms:source src:downstream-process-map ;
    skos:altLabel "RVCO Advisor"@en ;
    skos:definition "Advises on refinery and commercial optimization by evaluating feedstock choices, production plans, product placement, operating constraints and economic opportunities."@en ;
    skos:editorialNote "RVCO expanded as Refinery Value Chain Optimization (Hamid, 2026-10-18 (EPM-DEC-001-0045)). externally corroborated: an MPC job posting reads \"Refinery Value Chain Optimization (RVCO) is seeking a motivated employee with interest in commercial optimization\" (talents.vaia.com job 29020474, read 2026-10-18, third-party host). The definition is Claude's EPM working definition, not an MPC position description."@en ;
    skos:hiddenLabel "RCVO Advisor"@en ;
    skos:prefLabel "Refinery Value Chain Optimization Advisor"@en .

role:vp-clean-products-rvco-crude-trading-ngls-asphalt-petchem a org:Role ;
