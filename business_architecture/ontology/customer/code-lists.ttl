    skos:inScheme cust:agreement-type ;
    skos:notation "fuel-supply" ;
    skos:prefLabel "Fuel Supply"@en ;
    skos:topConceptOf cust:agreement-type .

<https://w3id.org/lsc/ontology/modules/customer/agreement-type/offtake> a skos:Concept ;
