proc:CM-1-2-2 a skos:Concept ;
    skos:broader proc:CM-1-2 ;
    skos:definition "Confirmations and Risk management consists of processes performed in the middle office to minimize risk of losses in the trading book due to change in market conditions i.e. commodity prices, interest rates, credit spreads, foreign-exchange rates. Middle office is responsible for managing confirmations, scenario modelling and price forecasting."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2.2" ;
    skos:prefLabel "Confirmations & Risk Management"@en .

