    skos:inScheme mod:core ;
    skos:notation "CM 1.3.3.3.3" ;
    skos:prefLabel "Segment Channels"@en .

proc:CM-1-3-3-3-4 a skos:Concept ;
    skos:broader proc:CM-1-3-3-3 ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.3.3.3.4" ;
    skos:prefLabel "Develop Channel Structure, Size & Engagement Model"@en .

proc:CM-1-3-3-3-5 a skos:Concept ;
    skos:broader proc:CM-1-3-3-3 ;
