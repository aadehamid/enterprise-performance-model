proc:CM-1-3-9 a skos:Concept ;
    skos:broader proc:CM-1-3 ;
    skos:definition "Customer service & support consist of processes such as all support & service offerings to consumers & business partners both from a conceptual & operational view. It ranges from defining the methods of interaction (e.g., on site, call center, web), along defining, setting up & operating facilities & technology down to managing service staff."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.3.9" ;
    skos:prefLabel "Customer Service & Support"@en .

