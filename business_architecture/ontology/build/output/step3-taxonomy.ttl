proc:CM-1-1-5-4-2 a skos:Concept ;
    skos:broader proc:CM-1-1-5-4 ;
    skos:definition "Publish backcasting case results to Planning DB"@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.5.4.2" ;
    skos:prefLabel "Publish LP Price Adjusted Forecast Results"@en .

