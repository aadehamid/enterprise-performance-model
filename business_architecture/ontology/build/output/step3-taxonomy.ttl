proc:CM-1-1-5-1-2-6 a skos:Concept ;
    skos:broader proc:CM-1-1-5-1-2 ;
    skos:definition "Receive actual data for product pricing"@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.5.1.2.6" ;
    skos:prefLabel "Receive actual data product prices"@en .

proc:CM-1-1-5-2 a skos:Concept ;
    skos:broader proc:CM-1-1-5 ;
    skos:definition "Receive latest XPIMS forecast model and update data inputs to establish the aggregated month average forecast for regional backcast"@en ;
    skos:inScheme mod:core ;
