    skos:inScheme mod:core ;
    skos:notation "CM 1.1.4.4.1" ;
    skos:prefLabel "Evaluate Market Scenarios Identified for Prompt Month Horizon"@en ;
    intake:level "L5"@en .

proc:CM-1-1-4-4-2 a skos:Concept ;
