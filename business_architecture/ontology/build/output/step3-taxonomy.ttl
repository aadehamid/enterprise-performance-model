    skos:prefLabel "Set up and stabilize base case for Distribution Backcast"@en .

proc:CM-1-2-3 a skos:Concept ;
    skos:broader proc:CM-1-2 ;
    skos:definition "Actualizations is performed by scheduler who assigns the final ticket volumes to the trades according to the preset priority."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2.3" ;
    skos:prefLabel "Actualizations"@en .

