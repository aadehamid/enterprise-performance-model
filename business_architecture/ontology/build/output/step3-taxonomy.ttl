    skos:prefLabel "Settlements"@en .

mod:core a skos:ConceptScheme ;
    dcterms:description "SKOS taxonomy of Lagos Specialty Chemicals' downstream petroleum business processes (levels L0-L6), derived from business_architecture/business_process/downstream_process_map.json. The core module namespace serves as the ConceptScheme."@en ;
    dcterms:title "LSC downstream process taxonomy"@en ;
    skos:hasTopConcept proc:L0-downstream-operations,
        proc:L0-enabling-functions .

