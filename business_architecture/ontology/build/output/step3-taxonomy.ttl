proc:CM-1-1-5 a skos:Concept ;
    dcterms:source [ a dcterms:BibliographicResource ;
            dcterms:title "Human-authored definition, approved by Hamid (2026-09-18)"@en ] ;
    skos:broader proc:CM-1-1 ;
    skos:definition "Reconcile actual regional supply, demand, production, inventory, product movements, and commercial outcomes against the approved plan and its contemporaneous assumptions and constraints; quantify and explain variances; and use the findings to improve subsequent regional planning and optimization cycles."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.5" ;
    skos:prefLabel "Regional Backcasting"@en ;
    skos:scopeNote "Regional Backcasting preserves and compares the approved planning baseline, actual outcomes, material assumptions, constraints, decisions, and variance explanations for a completed planning period. It produces commercially meaningful plan-versus-actual analysis — such as margin, price, volume, mix, yield, availability, inventory, logistics, quality, and customer-fulfillment variances — and feeds validated lessons into subsequent regional optimization. It does not replace Finance's statutory or management-close processes, SCM's execution control, or operating functions' technical root-cause investigations."@en .

proc:CM-1-1-5-6 a skos:Concept ;
    skos:broader proc:CM-1-1-5 ;
    skos:definition "Build and run actuals case stack in XPIMS"@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.5.6" ;
    skos:prefLabel "Evaluate actuals cases"@en .

proc:CM-1-3 a skos:Concept ;
    skos:broader proc:CM-1 ;
    skos:definition "Marketing Includes Processes Such As Performing Market Analysis, Developing Marketing Strategy, New Product Development, Managing Retail Marketing Operations. It Includes Processes Required To Take The Products & Services From Strategic Conception, Through Planning To Operational Execution."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.3" ;
    skos:prefLabel "Marketing"@en .

proc:CM-1-3-5-3 a skos:Concept ;
