proc:CM-1-1 a skos:Concept ;
    skos:broader proc:CM-1 ;
    skos:definition "Planning And Optimization Includes Processes Such As Demand Forecasting, Local And Regional Optimization, Backcasting And Inventory Management Across The Value Chain."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1" ;
    skos:prefLabel "Planning & Scheduling"@en .

proc:CM-1-1-4 a skos:Concept ;
    dcterms:source [ a dcterms:BibliographicResource ;
            dcterms:title "Human-authored definition, approved by Hamid (2026-09-18)"@en ] ;
    skos:broader proc:CM-1-1 ;
    skos:definition "Develop the commercially optimal refinery production plan — selecting crude and feedstock intake, refinery operating modes, unit-throughput targets, product yield and quality targets, and production horizons — to fulfill commercial commitments and maximize margin within feasible refinery, supply, inventory, product-specification, and contractual constraints."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.4" ;
    skos:prefLabel "Refinery Planning"@en ;
    skos:scopeNote "Refinery Planning owns the commercial and economic production-plan targets supplied to the refinery, including feedstock and crude-slate choices, target throughput and operating modes, target product yields and specifications, planned production availability, and economically preferred production alternatives. It does not own detailed unit-operation scheduling, tank and transfer line-ups, blend execution, process control, operating procedures, maintenance, turnaround execution, or the operational decision to depart from plan for safety, reliability, or immediate process conditions; those belong to Refining and its operating functions."@en .

proc:CM-1-2 a skos:Concept ;
    skos:broader proc:CM-1 ;
    skos:definition "Supply And Trading Includes Processes Such As Managing Supply, Demand And Trading Of Crude Oil And Refined Products. It Involves Trading As Well As Planning & Managing Movements In The Most Efficient Way, Including Primary & Secondary Distribution."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2" ;
    skos:prefLabel "Supply And Trading"@en .

proc:CM-1-2-4-3 a skos:Concept ;
    skos:broader proc:CM-1-2-4 ;
