    skos:notation "CM 1.2.1.3" ;
    skos:prefLabel "Trade Capture"@en .

proc:CM-1-1-3-7 a skos:Concept ;
    skos:broader proc:CM-1-1-3 ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.3.7" ;
    skos:prefLabel "Inventory"@en .

proc:CM-1-2-4-2 a skos:Concept ;
    skos:broader proc:CM-1-2-4 ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2.4.2" ;
    skos:prefLabel "Accounting"@en .

proc:CM-1-1-2 a skos:Concept ;
    dcterms:source [ a dcterms:BibliographicResource ;
            dcterms:title "Human-authored definition, approved by Hamid (2026-09-18)"@en ] ;
    skos:broader proc:CM-1-1 ;
    skos:definition "Optimize the integrated regional supply, demand, production, inventory, and product-movement plan to maximize commercial margin and reliably fulfill customer commitments within refinery, terminal, transportation, product-quality, and contractual constraints."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.2" ;
    skos:prefLabel "Regional Optimization"@en ;
    skos:scopeNote "Regional Optimization determines the commercially preferred regional supply-and-disposition plan, including demand allocation, supply sourcing, product placement, inventory positioning, exchanges, and inter-regional movements. It does not directly operate refinery units, terminals, pipelines, vessels, trucks, or retail/wholesale delivery activities; those functions provide capabilities, constraints, and execution feedback to the optimization cycle."@en .

proc:CM-1-2-2-3 a skos:Concept ;
    skos:broader proc:CM-1-2-2 ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2.2.3" ;
    skos:prefLabel "Market Risk Management"@en .

