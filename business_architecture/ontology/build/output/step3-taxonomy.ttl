    intake:processHorizon "periodic"@en ;
    intake:referenceSources "SRC-APQC-PCF-001"@en ;
    intake:relatedConcepts "precedes: Source & Collect Information | precedes: Analyze Data | precedes: Document Findings | governed-by: Consumer Analysis"@en ;
    intake:responsibleDomain "Commercial & Marketing"@en ;
