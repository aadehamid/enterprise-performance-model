proc:CM-1-1-6 a skos:Concept ;
    dcterms:source [ a dcterms:BibliographicResource ;
            dcterms:title "Human-authored definition, approved by Hamid (2026-09-18)"@en ] ;
    skos:broader proc:CM-1-1 ;
    skos:definition "Reconcile actual distribution inventory availability, movements, deliveries, transportation costs, and customer fulfillment outcomes against the approved distribution plan and its contemporaneous assumptions and constraints; quantify and explain variances; and use validated lessons to improve subsequent distribution planning and optimization cycles."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.1.6" ;
    skos:prefLabel "Distribution Backcasting"@en ;
    skos:scopeNote "Distribution Backcasting preserves and compares the approved distribution baseline, actual inventory availability and deployment, shipments, deliveries, transportation performance and cost, service outcomes, material constraints, decisions, and variance explanations for a completed period. It identifies commercially meaningful drivers — such as demand, supply availability, allocation, inventory, route or mode, freight, carrier capacity, terminal/rack availability, delivery reliability, and customer-service effects — and feeds validated findings into subsequent distribution planning. It does not dispatch equipment, operate terminals or transportation assets, conduct product movements, perform delivery, or replace Finance's freight-payment and financial-close processes."@en .

