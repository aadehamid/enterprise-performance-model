    skos:inScheme mod:core ;
    skos:notation "CM 1.3.6.8" ;
    skos:prefLabel "Compliance Management"@en .

src:apqc-pcf-7.2.2 a dcterms:BibliographicResource ;
    dcterms:issued "2025-05-30" ;
    dcterms:publisher "APQC"@en ;
    dcterms:rights "Used with attribution per the APQC/IBM license."@en ;
    dcterms:title "APQC Process Classification Framework (PCF) for Downstream Petroleum, version 7.2.2"@en .

proc:CM-1-1-2-2-1 a skos:Concept ;
    skos:broader proc:CM-1-1-2-2 ;
