proc:CM-1-2-1 a skos:Concept ;
    skos:broader proc:CM-1-2 ;
    skos:definition "Trading management consists of processes performed in the front office such as forecasting, pre-trade analysis, managing counterparty credit and contracts, executing and capturing trades."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1.2.1" ;
