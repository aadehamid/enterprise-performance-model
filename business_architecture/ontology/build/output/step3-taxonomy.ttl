proc:CM-1 a skos:Concept ;
    dcterms:source [ a dcterms:BibliographicResource ;
            dcterms:title "Human-authored definition, approved by Hamid (2026-09-18)"@en ] ;
    skos:broader proc:L0-downstream-operations ;
    skos:definition "The downstream business function that creates, manages, and optimizes the commercial value of petroleum products and services through market strategy, customer and channel management, supply and trading, commercial planning and scheduling, pricing, sales, and order-to-cash activities."@en ;
    skos:inScheme mod:core ;
    skos:notation "CM 1" ;
    skos:prefLabel "Commercial & Marketing"@en ;
    skos:scopeNote "Spans the commercial hydrocarbon lifecycle from supply acquisition and commercial optimization through product positioning, customer order capture, allocation, fulfilment coordination, invoicing, payment, and commercial performance management. It coordinates with refining, midstream, distribution, finance, and enterprise IT, but does not itself encompass their underlying physical operations or enterprise-wide technology services."@en .

