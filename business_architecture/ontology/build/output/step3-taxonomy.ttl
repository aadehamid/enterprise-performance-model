    skos:prefLabel "Set up and Stabilize Aggregated Forecast Model"@en .

proc:CM-1-1-5-3 a skos:Concept ;
    skos:broader proc:CM-1-1-5 ;
    skos:definition "Update pricing to actuals and evaluate impact in backcasting dashboard (outside of LP)"@en ;
    skos:inScheme mod:core ;
