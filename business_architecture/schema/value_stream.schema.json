
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-performance-model.local/schemas/value_stream.schema.json",
  "title": "Downstream O&G Commercial Value Stream",
  "description": "Value stream overlay: Domain -> Value Stream -> Stage -> uses Capability -> realized through Process. Processes reference (not duplicate) LSC process hierarchy nodes via linkedProcessIds, and carry sparse produces/consumes links to Data Portfolios (dp-*) or, for whole-line affinity, Data Product Lines (dpl-*). Assignment rules: critical-path only, ~1-3 primary links per process (max 4 per relation), one clear producer where the process owns a system of record.",
  "type": "object",
  "required": ["meta", "id", "name", "domain", "stages"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "generatedAt": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "catalogFile": { "type": "string", "description": "Relative path to the data product portfolio catalog these links resolve against" },
        "processMapFile": { "type": "string", "description": "Relative path to the LSC process map linkedProcessIds resolve against" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "id": { "type": "string", "pattern": "^vs-[a-z0-9-]+$" },
    "name": { "type": "string" },
    "domain": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "trigger": { "type": ["string", "null"] },
    "outcome": { "type": ["string", "null"] },
    "capabilities": {
      "type": "array",
      "description": "Capabilities used by this value stream's stages; enduring abilities, reusable across value streams",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^cap-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "alignsToProcessGroups": {
            "type": "array",
            "description": "LSC L2/L3 ids this capability loosely aligns to (e.g. 'CM 1.2')",
            "items": { "type": "string" }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "sequence", "processes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^stg-[a-z0-9-]+$" },
          "name": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "description": { "type": ["string", "null"] },
          "processes": {
            "type": "array",
            "items": { "$ref": "#/$defs/process" }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Notable non-linear flows (loops, informs relationships) between processes",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string", "enum": ["loops_to", "informs", "feeds"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "gapAnalysis": {
      "type": "array",
      "description": "Source taxonomy items missing or collapsed in the LSC process map; documentation only, no auto-created nodes",
      "items": {
        "type": "object",
        "required": ["item", "status"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["missing", "collapsed", "partial", "renamed"] },
          "closestProcessIds": { "type": "array", "items": { "type": "string" } },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "required": ["id", "name", "capabilityId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
        "slideRef": { "type": ["string", "null"], "description": "Letter/label on the source slide (e.g. 'a')" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "capabilityId": { "type": "string", "pattern": "^cap-[a-z0-9-]+$" },
        "linkedProcessIds": {
          "type": "array",
          "description": "LSC process map node ids this value-stream process realizes/references (e.g. 'CM 1.2.1.3')",
          "items": { "type": "string" }
        },
        "produces": {
          "type": "array",
          "maxItems": 4,
          "description": "Primary data portfolios (dp-*) or product lines (dpl-*) this process owns/publishes",
          "items": { "type": "string", "pattern": "^(dp|dpl)-[a-z0-9-]+$" }
        },
        "consumes": {
          "type": "array",
          "maxItems": 4,
          "description": "Primary data portfolios (dp-*) or product lines (dpl-*) this process critically depends on",
          "items": { "type": "string", "pattern": "^(dp|dpl)-[a-z0-9-]+$" }
        },
        "rationale": { "type": ["string", "null"], "description": "Industry grounding for the sparse assignment" }
      }
    }
  }
}
