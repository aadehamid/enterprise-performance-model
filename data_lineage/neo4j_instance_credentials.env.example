# Copy to neo4j_instance_credentials.env (same folder) and fill in. Never commit the copy.
# The loaders (src/) and the portal backend both read this file.

# --- Neo4j ---------------------------------------------------------------
NEO4J_URL=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
# Database the portal queries. Load the synthetic catalog into it first.
# Neo4j Community and Aura Free have one database: use neo4j.
NEO4J_DATABASE=lsc

# --- Source database for the real loaders (optional) ---------------------
# Any SQLAlchemy URL. The generated catalog ships a Power BI export for load_powerbi_lineage.py:
# SOURCE_DB_URL=duckdb:///synthetic_data/source.duckdb
# SOURCE_DB_URL=sqlite:///source.db
# SOURCE_DB_URL=postgresql+psycopg://postgres:<password>@localhost:5432/lsc_source
# SOURCE_DB_URL=mssql+pyodbc://localhost\SQLEXPRESS/lsc_source?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# --- LLM: set LLM_PROVIDER to one of azure | openai | anthropic | google --
LLM_PROVIDER=openai
# Model or deployment name for the chosen provider, e.g. gpt-5.4, claude-sonnet-4-6, gemini-2.5-pro
LLM_MODEL=<model-name>
LLM_TEMPERATURE=0

# azure
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_NAME=<your-deployment-name>

# openai, and any OpenAI-compatible service (OpenRouter, Groq, Together, Mistral, DeepSeek, xAI, Ollama, LM Studio):
# keep LLM_PROVIDER=openai and uncomment OPENAI_BASE_URL. Leave it commented for api.openai.com: an empty value breaks the client.
OPENAI_API_KEY=<your-openai-or-compatible-key>
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# anthropic
ANTHROPIC_API_KEY=<your-anthropic-key>

# google (Vertex AI). Authenticate with `gcloud auth application-default login`
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON file.
GOOGLE_PROJECT=<your-gcp-project-id>
GOOGLE_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
