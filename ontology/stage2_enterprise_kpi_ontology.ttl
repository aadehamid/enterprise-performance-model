    ekpi:observedForPeriod data:Day_20260630 ;
    ekpi:observedForDimensionValue data:HoustonRackTerminal3, data:ULSDDieselProduct ;
    ekpi:computedAgainstTarget data:Target_99pct_Q4FY26 ;
    ekpi:computedAgainstThreshold data:RedThreshold_97pct ;
    ekpi:hasObservationStatus data:ObsStatus_OnTarget .

