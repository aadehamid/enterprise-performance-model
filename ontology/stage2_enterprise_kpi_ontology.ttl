ekpi:datasetName a owl:DatatypeProperty ;
    rdfs:label "dataset name"@en ; rdfs:domain ekpi:Dataset ; rdfs:range xsd:string .

ekpi:refreshFrequency a owl:DatatypeProperty ;
    rdfs:label "refresh frequency"@en ; rdfs:domain ekpi:Dataset ; rdfs:range xsd:string .

ekpi:ruleExpression a owl:DatatypeProperty ;
    rdfs:label "rule expression"@en ; rdfs:domain ekpi:DataQualityRule ; rdfs:range xsd:string .

ekpi:versionNumber a owl:DatatypeProperty ;
    rdfs:label "version number"@en ; rdfs:domain ekpi:Version ; rdfs:range xsd:string .

ekpi:versionDate a owl:DatatypeProperty ;
    rdfs:label "version date"@en ; rdfs:domain ekpi:Version ; rdfs:range xsd:date .

ekpi:eventTimestamp a owl:DatatypeProperty ;
    rdfs:label "event timestamp"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:ApprovalEvent ekpi:AuditEvent ) ] ;
    rdfs:range xsd:dateTime .

ekpi:unitName a owl:DatatypeProperty ;
    rdfs:label "unit name"@en ; rdfs:domain ekpi:OrganizationalUnit ; rdfs:range xsd:string .

ekpi:unitType a owl:DatatypeProperty ;
    rdfs:label "unit type"@en ; rdfs:domain ekpi:OrganizationalUnit ; rdfs:range xsd:string .

ekpi:periodStart a owl:DatatypeProperty ;
    rdfs:label "period start"@en ; rdfs:domain ekpi:TimePeriod ; rdfs:range xsd:date ;
    rdfs:comment "v2.0.0 fix: declared in the Stage 1 design table but never implemented in Stage 2 v1.0.0 (zero TimePeriod individuals existed)."@en .

ekpi:periodEnd a owl:DatatypeProperty ;
    rdfs:label "period end"@en ; rdfs:domain ekpi:TimePeriod ; rdfs:range xsd:date .

ekpi:periodGranularity a owl:DatatypeProperty ;
    rdfs:label "period granularity"@en ; rdfs:domain ekpi:TimePeriod ; rdfs:range xsd:string .

ekpi:dimensionValueLabel a owl:DatatypeProperty ;
    rdfs:label "dimension value label"@en ; rdfs:domain ekpi:DimensionValue ; rdfs:range xsd:string .

ekpi:hasObservedValue a owl:DatatypeProperty ;
    rdfs:label "has observed value"@en ; rdfs:domain ekpi:KPIObservation ; rdfs:range xsd:decimal ;
    rdfs:comment "The actual measured numeric value of one KPIObservation."@en .

ekpi:relationshipType a owl:DatatypeProperty ;
    rdfs:label "relationship type"@en ; rdfs:domain ekpi:SemanticRelationship ; rdfs:range xsd:string .

ekpi:assignmentStartDate a owl:DatatypeProperty ;
    rdfs:label "assignment start date"@en ; rdfs:domain ekpi:StewardshipAssignment ; rdfs:range xsd:date .

ekpi:assignmentEndDate a owl:DatatypeProperty ;
    rdfs:label "assignment end date"@en ; rdfs:domain ekpi:StewardshipAssignment ; rdfs:range xsd:date ;
    rdfs:comment "Left unasserted on open-ended (still-active) assignments."@en .

##############################################################################
# 5. OWL RESTRICTIONS
# v2.0.0 adds restrictions that operationalize the KPI-vs-Metric and
# Gold-vs-Silver-vs-Raw distinctions the review flagged as "asserted only
# as prose" (Priority 2, item 4) — mirroring Casey Hart's bedroom/closet
# example: a logical fact a reasoner can check, not only a human-readable
# comment.
##############################################################################

# Every KPI must have at least one documented KPIDefinition.
ekpi:KPI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ekpi:hasDefinition ;
    owl:someValuesFrom ekpi:KPIDefinition
] .

# What formally distinguishes a governed KPI from a plain Metric: a KPI must
# have an accountable BusinessOwner. A Metric need not.
ekpi:KPI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ekpi:ownedBy ;
    owl:someValuesFrom ekpi:BusinessOwner
] .

# CertifiedDefinition is inferable: a KPIDefinition whose certification status is Certified.
ekpi:CertifiedDefinition owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        ekpi:KPIDefinition
        [ a owl:Restriction ;
          owl:onProperty ekpi:hasCertificationStatus ;
          owl:hasValue data:Status_Certified ]
    )
] .

# A RawLayerDataset must trace back to at least one SourceField — that is
# what makes it "raw" rather than merely "unlabeled."
ekpi:RawLayerDataset rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prov:wasDerivedFrom ;
    owl:someValuesFrom ekpi:SourceField
] .

# A SilverLayerDataset must trace back to at least one RawLayerDataset.
ekpi:SilverLayerDataset rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty prov:wasDerivedFrom ;
    owl:someValuesFrom ekpi:RawLayerDataset
] .

# A GoldLayerDataset must feed at least one SemanticModel — that is what
# makes it "gold" (consumption-ready) rather than merely "cleansed."
ekpi:GoldLayerDataset rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ekpi:feedsSemanticModel ;
    owl:someValuesFrom ekpi:SemanticModel
] .

##############################################################################
# 6. CONTROLLED VOCABULARY INDIVIDUALS
##############################################################################

data:Status_Draft      a ekpi:CertificationStatus ; rdfs:label "Draft"@en .
data:Status_InReview    a ekpi:CertificationStatus ; rdfs:label "In Review"@en .
data:Status_Certified   a ekpi:CertificationStatus ; rdfs:label "Certified"@en .
data:Status_Deprecated  a ekpi:CertificationStatus ; rdfs:label "Deprecated"@en .

data:Criticality_High   a ekpi:Criticality ; rdfs:label "High"@en .
data:Criticality_Medium a ekpi:Criticality ; rdfs:label "Medium"@en .
data:Criticality_Low    a ekpi:Criticality ; rdfs:label "Low"@en .

data:Severity_Red    a ekpi:ThresholdSeverity ; rdfs:label "Red"@en .
data:Severity_Yellow a ekpi:ThresholdSeverity ; rdfs:label "Yellow"@en .
data:Severity_Green  a ekpi:ThresholdSeverity ; rdfs:label "Green"@en .

data:AggType_SUM   a ekpi:AggregationType ; rdfs:label "SUM"@en .
data:AggType_AVG   a ekpi:AggregationType ; rdfs:label "AVG"@en .
data:AggType_LAST  a ekpi:AggregationType ; rdfs:label "LAST"@en .
data:AggType_RATIO a ekpi:AggregationType ; rdfs:label "RATIO"@en .

data:ObsStatus_OnTarget a ekpi:ObservationStatus ; rdfs:label "On Target"@en .
data:ObsStatus_Watch    a ekpi:ObservationStatus ; rdfs:label "Watch"@en .
data:ObsStatus_Breach   a ekpi:ObservationStatus ; rdfs:label "Breach"@en .

##############################################################################
# 7. WORKED EXAMPLE — Downstream Oil & Gas Commercial:
#    "Rack Price Capture Rate %"
#
#    Business context: Downstream Commercial value stream, Pricing & Margin
#    Management function, Rack Price Management & Publication capability,
#    Rack Price Setting business process. Measures how much of the published
#    OPIS rack benchmark price a terminal actually realizes in rack revenue —
#    a direct proxy for margin leakage at the rack.
#
#    End-to-end path (two source systems feeding one KPI):
#    RightAngle CTRM (realized revenue)  -\
#                                           >-- KPI: Rack Price Capture Rate %
#    OPIS Market Data Service (benchmark)-/        -> Semantic Model -> Dashboard
##############################################################################

### --- 7.A Business architecture individuals ---

data:DownstreamCommercialDomain a ekpi:BusinessDomain ;
    rdfs:label "Downstream Commercial"@en ;
    rdfs:comment "Level 1 business domain covering market intelligence, physical trading, pricing & margin management, marketing & channels, terminals & logistics, quality & loss control, risk, performance management, and finance & settlements."@en .

data:DownstreamCommercialValueStream a ekpi:ValueStream ;
    rdfs:label "Downstream Commercial Value Stream"@en ;
    rdfs:comment "End-to-end commercial value stream spanning three stages: (1) Market & Strategy Formation, (2) Execution & Operations, (3) Risk, Performance & Control — which feeds back into stage 1."@en .

data:PricingMarginManagementFunction a ekpi:BusinessFunction ;
    rdfs:label "Pricing & Margin Management"@en ;
    rdfs:comment "Level 2 recurring commercial function covering master/rack pricing and operational margin management."@en .

data:RackPriceManagementCapability a ekpi:BusinessCapability ;
    rdfs:label "Rack Price Management & Publication"@en ;
    rdfs:comment "Level 3 capability: set and govern rack prices against benchmark and zone/freight differentials."@en .

data:MarginPerformanceManagementCapability a ekpi:BusinessCapability ;
    rdfs:label "Commercial Performance & KPI Management"@en .

data:RackPriceSettingProcess a ekpi:BusinessProcess ;
    rdfs:label "Rack Price Setting"@en ;
    rdfs:comment "Level 3 business process that ingests market benchmarks, applies zone/freight differentials, and publishes governed rack price sheets."@en ;
    ekpi:hasProcessStep data:Step_IngestOPISBenchmark, data:Step_ApplyZoneDifferential,
                         data:Step_PublishRackSheet, data:Step_ReconcileRealizedVsPublished .

data:Step_IngestOPISBenchmark a ekpi:ProcessStep ;
    rdfs:label "Ingest OPIS Benchmark"@en .

data:Step_ApplyZoneDifferential a ekpi:ProcessStep ;
    rdfs:label "Apply Zone & Freight Differential"@en .

data:Step_PublishRackSheet a ekpi:ProcessStep ;
    rdfs:label "Publish Rack Price Sheet"@en .

data:Step_ReconcileRealizedVsPublished a ekpi:ProcessStep ;
    rdfs:label "Reconcile Realized vs. Published Price"@en .

data:ProtectGrowCommercialMarginGoal a ekpi:BusinessGoal ;
    rdfs:label "Protect and Grow Commercial Margin"@en .

data:ImproveRackCapture99pctQ4FY26 a ekpi:StrategicObjective ;
    rdfs:label "Improve Rack Price Capture Rate to 99% by Q4 FY26"@en ;
    ekpi:narrowsGoal data:ProtectGrowCommercialMarginGoal .

data:CommercialPricingDistributionTeam a ekpi:OrganizationalUnit ;
    rdfs:label "Commercial Pricing & Distribution Team"@en ;
    ekpi:unitName "Commercial Pricing & Distribution Team" ;
    ekpi:unitType "Commercial Function Team" .

data:CommercialPricingManager a ekpi:BusinessOwner ;
    rdfs:label "Commercial Pricing Manager"@en ;
    foaf:name "Commercial Pricing Manager (Role)" ;
    ekpi:belongsToUnit data:CommercialPricingDistributionTeam .

data:CommercialDataSteward a ekpi:DataSteward ;
    rdfs:label "Commercial Data Steward"@en ;
    ekpi:belongsToUnit data:CommercialPricingDistributionTeam .

### --- 7.B KPI model individuals ---

data:RackPriceCaptureRateKPI a ekpi:KPI ;
    rdfs:label "Rack Price Capture Rate %"@en ;
    ekpi:kpiCode "KPI-COM-001" ;
    ekpi:criticality data:Criticality_High ;
    ekpi:alignsToObjective data:ImproveRackCapture99pctQ4FY26 ;
    ekpi:supportsCapability data:RackPriceManagementCapability, data:MarginPerformanceManagementCapability ;
    ekpi:supportsValueStream data:DownstreamCommercialValueStream ;
    ekpi:belongsToDomain data:DownstreamCommercialDomain ;
    ekpi:measuresProcess data:RackPriceSettingProcess ;
    ekpi:hasDefinition data:RackPriceCaptureRateDefinition_v1 ;
    ekpi:hasAggregationRule data:AvgOverTerminalDayRule ;
    ekpi:hasUnitOfMeasure data:PercentUnit ;
    ekpi:hasTarget data:Target_99pct_Q4FY26 ;
    ekpi:hasThreshold data:RedThreshold_97pct ;
    ekpi:slicedByDimension data:TerminalDimension, data:ProductDimension ;
    ekpi:hasGrain data:PerTerminalPerProductPerDayGrain ;
    ekpi:derivedFromMeasure data:RealizedRackRevenueMeasure, data:PublishedRackBenchmarkMeasure ;
    ekpi:ownedBy data:CommercialPricingManager ;
    ekpi:stewardedBy data:CommercialDataSteward ;
    ekpi:hasStewardshipAssignment data:CommercialPricingStewardshipAssignment ;
    ekpi:governedByPolicy data:KPICertificationPolicy .

data:RackPriceCaptureRateDefinition_v1 a ekpi:CertifiedDefinition ;
    rdfs:label "Rack Price Capture Rate % Definition v1"@en ;
    ekpi:definitionText "Percentage of the published OPIS rack benchmark price per gallon that is actually realized in terminal rack revenue, computed per terminal per product per day."@en ;
    ekpi:effectiveDate "2026-07-15"^^xsd:date ;
    ekpi:hasFormula data:RackPriceCaptureRateFormula ;
    ekpi:hasCertificationStatus data:Status_Certified ;
    ekpi:hasVersion data:RackCaptureDef_Version1 ;
    ekpi:auditedBy data:AuditEvent_20260715 ;
    ekpi:consumedBy data:CommercialPricingDashboard, data:CommercialMarginScorecard, data:DailyRackReconciliationReport .

data:RackPriceCaptureRateFormula a ekpi:KPIFormula ;
    rdfs:label "Rack Price Capture Rate Formula"@en ;
    ekpi:formulaExpression "Rack Price Capture Rate % = (Realized Rack Revenue per Gallon / Published OPIS Rack Benchmark per Gallon) * 100" ;
    ekpi:implementedBy data:RackCaptureCalcLogic_SQL .

data:RackCaptureCalcLogic_SQL a ekpi:CalculationLogic ;
    rdfs:label "Rack Price Capture Rate SQL Logic"@en ;
    ekpi:logicExpression "SELECT terminal_id, product_code, business_date, SUM(realized_revenue_per_gal) / SUM(published_benchmark_per_gal) * 100 AS rack_capture_pct FROM gold.rack_price_capture GROUP BY terminal_id, product_code, business_date" ;
    rdfs:comment "Joins realized terminal rack revenue against the published OPIS benchmark for the same terminal, product, and business date."@en .

data:AvgOverTerminalDayRule a ekpi:AggregationRule ;
    rdfs:label "Average Over Terminal-Day"@en ;
    ekpi:aggregationType data:AggType_AVG .

data:PercentUnit a ekpi:UnitOfMeasure ;
    rdfs:label "Percent"@en ;
    ekpi:unitSymbol "%" .

data:FY26_Q4 a ekpi:TimePeriod ;
    rdfs:label "FY26 Q4"@en ;
    ekpi:periodStart "2026-07-01"^^xsd:date ;
    ekpi:periodEnd "2026-09-30"^^xsd:date ;
    ekpi:periodGranularity "Quarter" .

data:Day_20260630 a ekpi:TimePeriod ;
    rdfs:label "2026-06-30"@en ;
    ekpi:periodStart "2026-06-30"^^xsd:date ;
    ekpi:periodEnd "2026-06-30"^^xsd:date ;
    ekpi:periodGranularity "Day" .

data:Day_20260731 a ekpi:TimePeriod ;
    rdfs:label "2026-07-31"@en ;
    ekpi:periodStart "2026-07-31"^^xsd:date ;
    ekpi:periodEnd "2026-07-31"^^xsd:date ;
    ekpi:periodGranularity "Day" .

data:Target_99pct_Q4FY26 a ekpi:Target ;
    rdfs:label "Target 99% FY26 Q4"@en ;
    ekpi:targetValue "99.0"^^xsd:decimal ;
    ekpi:targetPeriod data:FY26_Q4 .

data:RedThreshold_97pct a ekpi:Threshold ;
    rdfs:label "Red Threshold 97%"@en ;
    ekpi:thresholdValue "97.0"^^xsd:decimal ;
    ekpi:thresholdSeverity data:Severity_Red .

data:TerminalDimension a ekpi:Dimension ; rdfs:label "Terminal"@en .
data:ProductDimension  a ekpi:Dimension ; rdfs:label "Product"@en .

data:HoustonRackTerminal3 a ekpi:DimensionValue ;
    ekpi:valueOfDimension data:TerminalDimension ;
    ekpi:dimensionValueLabel "Houston Rack Terminal 3" .

data:BeaumontRackTerminal1 a ekpi:DimensionValue ;
    ekpi:valueOfDimension data:TerminalDimension ;
    ekpi:dimensionValueLabel "Beaumont Rack Terminal 1" .

data:ULSDDieselProduct a ekpi:DimensionValue ;
    ekpi:valueOfDimension data:ProductDimension ;
    ekpi:dimensionValueLabel "ULSD Diesel" .

data:RBOBGasolineProduct a ekpi:DimensionValue ;
    ekpi:valueOfDimension data:ProductDimension ;
    ekpi:dimensionValueLabel "RBOB Gasoline" .

data:PerTerminalPerProductPerDayGrain a ekpi:Grain ;
    rdfs:label "Per Terminal Per Product Per Day"@en ;
    ekpi:grainLabel "terminal x product x day" .

data:RealizedRackRevenueMeasure a ekpi:Measure ;
    rdfs:label "Realized Rack Revenue per Gallon"@en ;
    ekpi:derivedFromDataset data:RackLiftings_GoldDataset .

data:PublishedRackBenchmarkMeasure a ekpi:Measure ;
    rdfs:label "Published OPIS Rack Benchmark per Gallon"@en ;
    ekpi:derivedFromDataset data:OPISBenchmark_GoldDataset .

