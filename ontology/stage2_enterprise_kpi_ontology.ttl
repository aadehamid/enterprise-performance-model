##############################################################################
# Enterprise KPI Ontology (Stage 2) — v2.0.0
# A governed semantic foundation for KPI definitions, lineage, governance,
# business-architecture alignment, and analytics consumption.
#
# v2.0.0 changelog (see "Ontology Review & Improvement Plan" for full detail):
#   1. Removed heterogeneous "bucket" superclasses (BusinessArchitectureElement,
#      SemanticAsset, LineageNode, GovernanceElement). Module membership is now
#      recorded honestly via dcterms:isPartOf pointing at a skos:Collection per
#      module, instead of a false rdfs:subClassOf claim. ConsumptionAsset is kept
#      as a real superclass because its members genuinely share one kind:
#      "a surface a human consumes KPI values through."
#   2. Added the missing Observation/Fact layer: ekpi:KPIObservation,
#      ekpi:DimensionValue, ekpi:ObservationStatus — so the graph can answer
#      "what was this KPI, for which asset/terminal, on which day, and was
#      it on target" — not just "how is this KPI defined."
#   3. Reconciled every Stage 1 vs Stage 2 gap found in the review: TimePeriod
#      now has real individuals and real datatype properties; Target now has
#      a working targetPeriod object property; Synonym was removed as a
#      redundant class (skos:altLabel already covers it — see design doc);
#      SemanticRelationship, ValueStream, BusinessFunction, ProcessStep,
#      DataProduct, AnalyticalModel, AccessRule, OrganizationalUnit are all
#      now backed by real individuals in the worked example below.
#   4. Added owl:Restriction axioms that operationalize key subclass
#      distinctions (KPI vs Metric, Gold vs Silver vs Raw).
#   5. Introduced a small property hierarchy via rdfs:subPropertyOf.
#   6. Closed three previously free-text fields into owl:oneOf controlled
#      vocabularies: Criticality, ThresholdSeverity, AggregationType.
#   7. Promoted CalculationLogic's SQL text into a real ekpi:logicExpression
#      datatype property (kept the rdfs:comment as a human-friendly gloss too).
#   8. Anchored ekpi:Role as rdfs:subClassOf foaf:Agent.
#   9. Replaced the "Asset Uptime %" (Operations) worked example with a
#      Downstream Oil & Gas Commercial worked example: Rack Price Capture
#      Rate %, grounded in the Downstream Commercial value stream, capability
#      map, business processes, and data products.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <http://schema.org/> .

# Enterprise ontology namespace (schema: classes + properties)
@prefix ekpi:    <https://ontology.enterprise.example.com/kpi-store/core#> .
# Enterprise instance/individual namespace (data)
@prefix data:    <https://data.enterprise.example.com/kpi-store/> .

@base <https://ontology.enterprise.example.com/kpi-store/core#> .

##############################################################################
# 1. ONTOLOGY HEADER AND METADATA
##############################################################################

<https://ontology.enterprise.example.com/kpi-store/core>
    a owl:Ontology ;
    rdfs:label "Enterprise KPI Ontology"@en ;
    dcterms:title "Enterprise KPI Ontology" ;
    dcterms:description "A governed ontology linking business architecture, KPI definitions, a semantic model, medallion-architecture lineage, consumption assets, and governance for an enterprise KPI store. v2.0.0 corrects the class-tree, adds a KPI observation/fact layer, and re-grounds the worked example in Downstream Oil & Gas Commercial (Rack Price Capture Rate %)."@en ;
    dcterms:creator "Enterprise Data & Analytics Governance Team" ;
    dcterms:created "2026-08-01"^^xsd:date ;
    dcterms:modified "2026-08-02"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0.0" ;
    owl:versionIRI <https://ontology.enterprise.example.com/kpi-store/core/2026-08-02#> ;
    owl:priorVersion <https://ontology.enterprise.example.com/kpi-store/core/2026-08-01#> .

##############################################################################
# 1B. MODULE TAGS
# Modules are recorded as skos:Collection individuals, not as OWL superclasses.
# Every class below declares dcterms:isPartOf one of these — this replaces the
# v1.0.0 "bucket superclass" pattern (BusinessArchitectureElement, SemanticAsset,
# LineageNode, GovernanceElement) that falsely implied shared kind-hood between
# heterogeneous concepts. See Ontology Review & Improvement Plan, Priority 1 #1.
##############################################################################

ekpi:BusinessArchitectureModule a skos:Collection ;
    rdfs:label "Business Architecture Module"@en .

ekpi:KPIModelModule a skos:Collection ;
    rdfs:label "KPI Model Module"@en .

ekpi:SemanticModelModule a skos:Collection ;
    rdfs:label "Semantic Model Module"@en .

ekpi:LineageModule a skos:Collection ;
    rdfs:label "Lineage & Data Architecture Module"@en .

ekpi:ConsumptionModule a skos:Collection ;
    rdfs:label "Consumption Module"@en .

ekpi:GovernanceModule a skos:Collection ;
    rdfs:label "Governance Module"@en .

##############################################################################
# 2. CLASS DECLARATIONS
##############################################################################

### --- 2.A Business Architecture ---------------------------------------
# No abstract "BusinessArchitectureElement" bucket superclass (removed in
# v2.0.0). Module membership is recorded via dcterms:isPartOf only.

ekpi:BusinessCapability a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Capability"@en ;
    rdfs:comment "An enterprise ability to do something of value, e.g. Rack Price Management & Publication."@en .

ekpi:ValueStream a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Value Stream"@en ;
    rdfs:comment "An end-to-end sequence of activities delivering value to a stakeholder, e.g. the Downstream Commercial value stream."@en .

ekpi:BusinessDomain a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Domain"@en ;
    rdfs:comment "A logical grouping of related business activity, e.g. Downstream Commercial."@en .

ekpi:BusinessFunction a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Function"@en ;
    rdfs:comment "A recurring organizational activity grouping, e.g. Pricing & Margin Management."@en .

ekpi:BusinessProcess a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Process"@en ;
    rdfs:comment "A structured set of activities producing a specific outcome, e.g. Rack Price Setting."@en .

ekpi:ProcessStep a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Process Step"@en ;
    rdfs:comment "An atomic activity within a BusinessProcess."@en .

ekpi:BusinessGoal a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Goal"@en ;
    rdfs:comment "A directional business intent, e.g. Protect and Grow Commercial Margin."@en .

ekpi:StrategicObjective a owl:Class ;
    rdfs:subClassOf ekpi:BusinessGoal ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Strategic Objective"@en ;
    rdfs:comment "A specific, time-bound target that operationalizes a BusinessGoal."@en .

ekpi:OrganizationalUnit a owl:Class ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Organizational Unit"@en ;
    rdfs:comment "A team, department, plant, or site, e.g. the Commercial Pricing & Distribution Team."@en .

ekpi:Role a owl:Class ;
    rdfs:subClassOf foaf:Agent ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Role"@en ;
    rdfs:comment "A functional responsibility a person can hold. Anchored to foaf:Agent so ownership/approval/stewardship semantics connect to a recognized upper-level 'agent' concept (fix applied per ontology review, item 9)."@en .

ekpi:BusinessOwner a owl:Class ;
    rdfs:subClassOf ekpi:Role ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Business Owner"@en ;
    rdfs:comment "Accountable for the business meaning and use of a governed asset."@en .

ekpi:DataSteward a owl:Class ;
    rdfs:subClassOf ekpi:Role ;
    dcterms:isPartOf ekpi:BusinessArchitectureModule ;
    rdfs:label "Data Steward"@en ;
    rdfs:comment "Accountable for data quality and definitional integrity of a governed asset."@en .

### --- 2.B KPI Model -----------------------------------------------------

ekpi:PerformanceIndicator a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Performance Indicator"@en ;
    rdfs:comment "Genuine superclass (not a bucket): both Metric and Measure are, by definition, quantifications of performance."@en .

ekpi:Metric a owl:Class ;
    rdfs:subClassOf ekpi:PerformanceIndicator ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Metric"@en ;
    rdfs:comment "A quantifiable value derived from one or more Measures. Broader than KPI."@en .

ekpi:KPI a owl:Class ;
    rdfs:subClassOf ekpi:Metric ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "KPI"@en ;
    rdfs:comment "A governed, named indicator of performance against a goal."@en .

ekpi:Measure a owl:Class ;
    rdfs:subClassOf ekpi:PerformanceIndicator ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Measure"@en ;
    rdfs:comment "A raw or lightly aggregated quantity computed from data; a building block of a KPI."@en .

ekpi:KPIObservation a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "KPI Observation"@en ;
    rdfs:comment "The measured Fact/event layer: one dated, dimensioned, valued reading of a KPI (e.g. Rack Price Capture Rate for Terminal X, Product Y, on Day Z). Added in v2.0.0 to close the biggest functional gap flagged in the ontology review: without this class the graph could describe a KPI's definition and lineage but never an actual observed value over time."@en .

ekpi:DimensionValue a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Dimension Value"@en ;
    rdfs:comment "A specific value along a Dimension axis (e.g. 'Houston Rack Terminal 3' as a value of the Terminal Dimension), as opposed to Dimension itself which names the axis."@en .

ekpi:ObservationStatus a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Observation Status"@en ;
    rdfs:comment "A controlled-vocabulary state describing a KPIObservation relative to its Target/Threshold: OnTarget, Watch, or Breach."@en ;
    owl:oneOf ( data:ObsStatus_OnTarget data:ObsStatus_Watch data:ObsStatus_Breach ) .

ekpi:KPIDefinition a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "KPI Definition"@en ;
    rdfs:comment "The versioned, documented specification of a KPI."@en .

ekpi:BusinessDefinition a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Business Definition"@en ;
    rdfs:comment "The authoritative textual definition of a BusinessTerm."@en .

ekpi:CertifiedDefinition a owl:Class ;
    rdfs:subClassOf ekpi:KPIDefinition, ekpi:BusinessDefinition ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Certified Definition"@en ;
    rdfs:comment "A KPIDefinition or BusinessDefinition that has passed governance certification."@en .

ekpi:KPIFormula a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "KPI Formula"@en ;
    rdfs:comment "The mathematical expression defining how a KPI is calculated."@en .

ekpi:CalculationLogic a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Calculation Logic"@en ;
    rdfs:comment "Implementation-level logic (SQL, DAX, pseudo-code) realizing a KPIFormula."@en .

ekpi:AggregationRule a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Aggregation Rule"@en ;
    rdfs:comment "Rule describing how a measure rolls up across time or dimensions."@en .

ekpi:UnitOfMeasure a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Unit of Measure"@en ;
    rdfs:comment "The unit a KPI, Measure, or KPIObservation is expressed in, e.g. percent, USD, hours."@en .

ekpi:Target a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Target"@en ;
    rdfs:comment "A desired value for a KPI within a given TimePeriod (see ekpi:targetPeriod)."@en .

ekpi:Threshold a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "A boundary value that triggers a status such as red, yellow, or green."@en .

ekpi:Dimension a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Dimension"@en ;
    rdfs:comment "An axis for slicing a KPI, e.g. Terminal or Product. Contrast with DimensionValue, which is a specific value on this axis."@en .

ekpi:TimePeriod a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Time Period"@en ;
    rdfs:comment "A defined interval a KPI value or Target applies to, e.g. a day or a fiscal quarter."@en .

ekpi:Grain a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Grain"@en ;
    rdfs:comment "The lowest level of detail at which a KPI or Measure is recorded."@en .

ekpi:Criticality a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Criticality"@en ;
    rdfs:comment "Closed controlled vocabulary for KPI criticality (v2.0.0 fix: was previously free xsd:string)."@en ;
    owl:oneOf ( data:Criticality_High data:Criticality_Medium data:Criticality_Low ) .

ekpi:ThresholdSeverity a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Threshold Severity"@en ;
    rdfs:comment "Closed controlled vocabulary for threshold severity (v2.0.0 fix: was previously free xsd:string)."@en ;
    owl:oneOf ( data:Severity_Red data:Severity_Yellow data:Severity_Green ) .

ekpi:AggregationType a owl:Class ;
    dcterms:isPartOf ekpi:KPIModelModule ;
    rdfs:label "Aggregation Type"@en ;
    rdfs:comment "Closed controlled vocabulary for aggregation type (v2.0.0 fix: was previously free xsd:string)."@en ;
    owl:oneOf ( data:AggType_SUM data:AggType_AVG data:AggType_LAST data:AggType_RATIO ) .

### --- 2.C Semantic Model -------------------------------------------------
# No abstract "SemanticAsset" bucket superclass (removed in v2.0.0).
# Synonym was removed as a class: it was never instantiated (an orphan class
# per the ontology review) and skos:altLabel already covers the same need
# directly on BusinessTerm individuals — modeling it twice would be redundant.

ekpi:SemanticLayer a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Layer"@en ;
    rdfs:comment "The platform or service hosting one or more SemanticModels."@en .

ekpi:SemanticModel a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Model"@en ;
    rdfs:comment "A governed logical model binding business meaning to physical gold-layer data."@en .

ekpi:SemanticEntity a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Entity"@en ;
    rdfs:comment "A business-meaningful object in the semantic model, e.g. Rack Loading Transaction, Terminal, Product."@en .

ekpi:SemanticAttribute a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Attribute"@en ;
    rdfs:comment "A descriptive field on a SemanticEntity."@en .

ekpi:SemanticMeasure a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Measure"@en ;
    rdfs:comment "The semantic-layer representation of a Measure or KPI, bound to gold data and an aggregation rule."@en .

ekpi:SemanticRelationship a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Semantic Relationship"@en ;
    rdfs:comment "A named relationship between two SemanticEntity instances, e.g. 'Rack Loading occurs at Terminal'. Instantiated in v2.0.0 (was an orphan/untested class in v1.0.0)."@en .

ekpi:BusinessTerm a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Business Term"@en ;
    rdfs:comment "A controlled-vocabulary business word or phrase (glossary entry). Modeled as a SKOS Concept."@en .

ekpi:MappingRule a owl:Class ;
    dcterms:isPartOf ekpi:SemanticModelModule ;
    rdfs:label "Mapping Rule"@en ;
    rdfs:comment "An explicit rule mapping a BusinessTerm or SemanticAttribute to a physical column or field."@en .

### --- 2.D Lineage & Data Architecture -------------------------------------
# No abstract "LineageNode" bucket superclass (removed in v2.0.0).

ekpi:OperationalSystem a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Operational System"@en ;
    rdfs:comment "A source-of-record system, e.g. OPIS Market Data Service, RightAngle CTRM/ETRM."@en .

ekpi:SourceApplication a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Source Application"@en ;
    rdfs:comment "A specific application instance within an OperationalSystem."@en .

ekpi:SourceTable a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Source Table"@en ;
    rdfs:comment "A physical or logical table in a source application."@en .

ekpi:SourceField a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Source Field"@en ;
    rdfs:comment "A column in a SourceTable; the ultimate physical origin of a data value."@en .

ekpi:Dataset a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "Genuine abstract superclass for datasets across the medallion layers — lets lineage properties (hasQualityRule, transformedBy) be declared once instead of three times."@en .

ekpi:RawLayerDataset a owl:Class ;
    rdfs:subClassOf ekpi:Dataset ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Raw Layer Dataset"@en ;
    rdfs:comment "Bronze/raw ingested copy of source data, minimally transformed."@en .

ekpi:SilverLayerDataset a owl:Class ;
    rdfs:subClassOf ekpi:Dataset ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Silver Layer Dataset"@en ;
    rdfs:comment "Cleansed, conformed, business-rule-applied dataset."@en .

ekpi:GoldLayerDataset a owl:Class ;
    rdfs:subClassOf ekpi:Dataset ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Gold Layer Dataset"@en ;
    rdfs:comment "Curated, aggregate-ready dataset intended for consumption."@en .

ekpi:RawLayerDataset owl:disjointWith ekpi:GoldLayerDataset .
ekpi:RawLayerDataset owl:disjointWith ekpi:SilverLayerDataset .
ekpi:SilverLayerDataset owl:disjointWith ekpi:GoldLayerDataset .

ekpi:DataProduct a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Data Product"@en ;
    rdfs:comment "A packaged, owned, discoverable data asset that wraps a Gold dataset, e.g. the Rack Price Sheet."@en .

ekpi:DataPipeline a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Data Pipeline"@en ;
    rdfs:comment "An orchestrated set of TransformationSteps moving or transforming data between layers."@en .

ekpi:TransformationStep a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Transformation Step"@en ;
    rdfs:comment "An atomic transformation, e.g. join, filter, aggregate, within a pipeline."@en .

ekpi:DataQualityRule a owl:Class ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Data Quality Rule"@en ;
    rdfs:comment "A rule such as not-null or range-check applied to a dataset or field."@en .

ekpi:ProvenanceEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    dcterms:isPartOf ekpi:LineageModule ;
    rdfs:label "Provenance Event"@en ;
    rdfs:comment "A specific run or execution that produced or transformed data. Equivalent to prov:Activity."@en .

### --- 2.E Consumption ------------------------------------------------------
# ConsumptionAsset is KEPT as a real superclass: unlike the removed buckets,
# its members genuinely share one kind — "a surface a human consumes KPI
# values through" — so rdfs:subClassOf is an honest claim here.

ekpi:ConsumptionAsset a owl:Class ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Consumption Asset"@en ;
    rdfs:comment "Genuine superclass for anything a human (or downstream model) consumes KPI values through."@en .

ekpi:Report a owl:Class ;
    rdfs:subClassOf ekpi:ConsumptionAsset ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Report"@en ;
    rdfs:comment "A static or on-demand document presenting KPI or measure values."@en .

ekpi:Dashboard a owl:Class ;
    rdfs:subClassOf ekpi:ConsumptionAsset ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Dashboard"@en ;
    rdfs:comment "An interactive, typically live, visualization surface."@en .

ekpi:Scorecard a owl:Class ;
    rdfs:subClassOf ekpi:ConsumptionAsset ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Scorecard"@en ;
    rdfs:comment "A structured, goal-vs-actual performance view, usually tied to a StrategicObjective."@en .

ekpi:AnalyticalModel a owl:Class ;
    rdfs:subClassOf ekpi:ConsumptionAsset ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Analytical Model"@en ;
    rdfs:comment "A downstream model, e.g. a forecast or ML model, consuming certified measures or KPIs."@en .

ekpi:ConsumerUseCase a owl:Class ;
    dcterms:isPartOf ekpi:ConsumptionModule ;
    rdfs:label "Consumer Use Case"@en ;
    rdfs:comment "A named business use case describing why or how a KPI is consumed."@en .

### --- 2.F Governance --------------------------------------------------------
# No abstract "GovernanceElement" bucket superclass (removed in v2.0.0).

ekpi:Policy a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Policy"@en ;
    rdfs:comment "A high-level governance rule, e.g. every KPI must have a certified owner."@en .

ekpi:Standard a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Standard"@en ;
    rdfs:comment "A concrete specification implementing a Policy, e.g. a naming standard."@en .

ekpi:Control a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Control"@en ;
    rdfs:comment "An enforceable check implementing a Standard, technical or procedural."@en .

ekpi:AccessRule a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Access Rule"@en ;
    rdfs:comment "A rule restricting who can view or edit a governed asset, e.g. commercial pricing confidentiality."@en .

ekpi:CertificationStatus a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Certification Status"@en ;
    rdfs:comment "A controlled-vocabulary state: Draft, InReview, Certified, or Deprecated."@en ;
    owl:oneOf ( data:Status_Draft data:Status_InReview data:Status_Certified data:Status_Deprecated ) .

ekpi:Version a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Version"@en ;
    rdfs:comment "A versioned snapshot of a governed asset."@en .

ekpi:ApprovalEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Approval Event"@en ;
    rdfs:comment "A recorded approval or sign-off action."@en .

ekpi:AuditEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Audit Event"@en ;
    rdfs:comment "A recorded change or access event for traceability."@en .

ekpi:StewardshipAssignment a owl:Class ;
    dcterms:isPartOf ekpi:GovernanceModule ;
    rdfs:label "Stewardship Assignment"@en ;
    rdfs:comment "A time-bound assignment linking a DataSteward to a governed asset. Populated with real properties in v2.0.0 (was an inert individual with no properties in v1.0.0 — see ekpi:assignmentSteward / assignmentStartDate below)."@en .

##############################################################################
# 3. OBJECT PROPERTY DECLARATIONS (with domain/range)
##############################################################################

### --- Property hierarchy (super-properties; v2.0.0 fix) ---
# Introduced so the graph can be queried "give me everything that specifies
# this KPI" / "give me every governance record" / "give me every semantic
# component" without listing every narrow predicate by name.

ekpi:hasSpecificationElement a owl:ObjectProperty ;
    rdfs:label "has specification element"@en ;
    rdfs:comment "Super-property grouping every predicate that attaches a piece of a KPI's formal specification (formula, aggregation, unit, target, threshold, time period, grain)."@en .

ekpi:hasGovernanceRecord a owl:ObjectProperty ;
    rdfs:label "has governance record"@en ;
    rdfs:comment "Super-property grouping every predicate that attaches a governance fact (certification status, version, audit event, access rule) to a governed asset."@en .

ekpi:hasSemanticComponent a owl:ObjectProperty ;
    rdfs:label "has semantic component"@en ;
    rdfs:comment "Super-property grouping every predicate that attaches a component of a SemanticModel (entity, measure, attribute, relationship)."@en .

### --- Business alignment ---

ekpi:alignsToGoal a owl:ObjectProperty ;
    rdfs:label "aligns to goal"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:BusinessGoal ;
    rdfs:comment "Relates a KPI to the BusinessGoal it supports."@en .

ekpi:alignsToObjective a owl:ObjectProperty ;
    rdfs:label "aligns to objective"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:StrategicObjective ;
    rdfs:comment "Relates a KPI to the StrategicObjective it supports."@en .

ekpi:supportsCapability a owl:ObjectProperty ;
    rdfs:label "supports capability"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:BusinessCapability .

ekpi:supportsValueStream a owl:ObjectProperty ;
    rdfs:label "supports value stream"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:ValueStream .

ekpi:belongsToDomain a owl:ObjectProperty ;
    rdfs:label "belongs to domain"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:BusinessDomain .

ekpi:measuresProcess a owl:ObjectProperty ;
    rdfs:label "measures process"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:BusinessProcess .

ekpi:hasProcessStep a owl:ObjectProperty ;
    rdfs:label "has process step"@en ;
    rdfs:domain ekpi:BusinessProcess ; rdfs:range ekpi:ProcessStep .

ekpi:narrowsGoal a owl:ObjectProperty ;
    rdfs:label "narrows goal"@en ;
    rdfs:domain ekpi:StrategicObjective ; rdfs:range ekpi:BusinessGoal ;
    rdfs:comment "Relates a specific StrategicObjective individual to the broader BusinessGoal individual it operationalizes."@en .

ekpi:belongsToUnit a owl:ObjectProperty ;
    rdfs:label "belongs to unit"@en ;
    rdfs:domain ekpi:Role ; rdfs:range ekpi:OrganizationalUnit ;
    rdfs:comment "Relates a Role (and by extension the BusinessOwner/DataSteward holding it) to the OrganizationalUnit it sits in."@en .

### --- KPI specification ---

ekpi:hasDefinition a owl:ObjectProperty ;
    rdfs:label "has definition"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:KPIDefinition ;
    rdfs:comment "Relates a KPI to its documented, versioned KPIDefinition."@en .

ekpi:isDefinitionOf a owl:ObjectProperty ;
    owl:inverseOf ekpi:hasDefinition ;
    rdfs:label "is definition of"@en .

ekpi:hasFormula a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has formula"@en ;
    rdfs:domain ekpi:KPIDefinition ; rdfs:range ekpi:KPIFormula .

ekpi:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    rdfs:domain ekpi:KPIFormula ; rdfs:range ekpi:CalculationLogic .

ekpi:hasAggregationRule a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has aggregation rule"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:KPI ekpi:Measure ) ] ;
    rdfs:range ekpi:AggregationRule .

ekpi:hasUnitOfMeasure a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has unit of measure"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:KPI ekpi:Measure ekpi:KPIObservation ) ] ;
    rdfs:range ekpi:UnitOfMeasure .

ekpi:hasTarget a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has target"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:Target .

ekpi:hasThreshold a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has threshold"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:Threshold .

ekpi:targetPeriod a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "target period"@en ;
    rdfs:domain ekpi:Target ; rdfs:range ekpi:TimePeriod ;
    rdfs:comment "The TimePeriod a Target value applies to, e.g. FY26 Q4. v2.0.0 fix: this property was declared in the Stage 1 design table but never implemented in Stage 2 v1.0.0 — it is now declared and asserted on the worked example's Target individual."@en .

ekpi:slicedByDimension a owl:ObjectProperty ;
    rdfs:label "sliced by dimension"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:Dimension .

ekpi:hasTimePeriod a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has time period"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:TimePeriod .

ekpi:hasGrain a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSpecificationElement ;
    rdfs:label "has grain"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:KPI ekpi:Measure ) ] ;
    rdfs:range ekpi:Grain .

ekpi:derivedFromMeasure a owl:ObjectProperty ;
    rdfs:label "derived from measure"@en ;
    rdfs:domain ekpi:KPI ; rdfs:range ekpi:Measure .

ekpi:derivedFromDataset a owl:ObjectProperty ;
    rdfs:label "derived from dataset"@en ;
    rdfs:domain ekpi:Measure ; rdfs:range ekpi:GoldLayerDataset .

### --- KPI Observation / fact layer (v2.0.0 addition) ---

ekpi:measuresKPI a owl:ObjectProperty ;
    rdfs:label "measures KPI"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:KPI ;
    rdfs:comment "Relates a specific observed value/event to the KPI it is a reading of."@en .

ekpi:observedForPeriod a owl:ObjectProperty ;
    rdfs:label "observed for period"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:TimePeriod .

ekpi:observedForDimensionValue a owl:ObjectProperty ;
    rdfs:label "observed for dimension value"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:DimensionValue ;
    rdfs:comment "Which specific dimension values (e.g. which terminal, which product) this observation applies to."@en .

ekpi:valueOfDimension a owl:ObjectProperty ;
    rdfs:label "value of dimension"@en ;
    rdfs:domain ekpi:DimensionValue ; rdfs:range ekpi:Dimension .

ekpi:hasObservationStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has observation status"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:ObservationStatus ;
    rdfs:comment "Functional: one observation has exactly one status relative to Target/Threshold."@en .

ekpi:computedAgainstTarget a owl:ObjectProperty ;
    rdfs:label "computed against target"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:Target .

ekpi:computedAgainstThreshold a owl:ObjectProperty ;
    rdfs:label "computed against threshold"@en ;
    rdfs:domain ekpi:KPIObservation ; rdfs:range ekpi:Threshold .

### --- Lineage / medallion ---

ekpi:originatesIn a owl:ObjectProperty ;
    rdfs:label "originates in"@en ;
    rdfs:domain ekpi:SourceField ; rdfs:range ekpi:OperationalSystem .

ekpi:transformedBy a owl:ObjectProperty ;
    rdfs:label "transformed by"@en ;
    rdfs:domain ekpi:Dataset ; rdfs:range ekpi:TransformationStep .

ekpi:partOfPipeline a owl:ObjectProperty ;
    rdfs:label "part of pipeline"@en ;
    rdfs:domain ekpi:TransformationStep ; rdfs:range ekpi:DataPipeline .

ekpi:hasQualityRule a owl:ObjectProperty ;
    rdfs:label "has quality rule"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:Dataset ekpi:SourceField ) ] ;
    rdfs:range ekpi:DataQualityRule .

ekpi:wrapsDataset a owl:ObjectProperty ;
    rdfs:label "wraps dataset"@en ;
    rdfs:domain ekpi:DataProduct ; rdfs:range ekpi:Dataset ;
    rdfs:comment "Relates a packaged, owned DataProduct to the Gold dataset it wraps for downstream consumption."@en .

# Generic PROV-based lineage edges reused across the whole chain:
#   RawLayerDataset -> SilverLayerDataset -> GoldLayerDataset, and SourceField -> RawLayerDataset,
# are all expressed with prov:wasDerivedFrom so the graph stays interoperable with PROV tooling.

### --- Semantic model bridges ---

ekpi:feedsSemanticModel a owl:ObjectProperty ;
    rdfs:label "feeds semantic model"@en ;
    rdfs:domain ekpi:GoldLayerDataset ; rdfs:range ekpi:SemanticModel .

ekpi:isFedBy a owl:ObjectProperty ;
    owl:inverseOf ekpi:feedsSemanticModel ;
    rdfs:label "is fed by"@en .

ekpi:hasSemanticEntity a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSemanticComponent ;
    rdfs:label "has semantic entity"@en ;
    rdfs:domain ekpi:SemanticModel ; rdfs:range ekpi:SemanticEntity .

ekpi:hasSemanticMeasure a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSemanticComponent ;
    rdfs:label "has semantic measure"@en ;
    rdfs:domain ekpi:SemanticModel ; rdfs:range ekpi:SemanticMeasure .

ekpi:hasSemanticAttribute a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSemanticComponent ;
    rdfs:label "has semantic attribute"@en ;
    rdfs:domain ekpi:SemanticEntity ; rdfs:range ekpi:SemanticAttribute .

ekpi:hasSemanticRelationship a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasSemanticComponent ;
    rdfs:label "has semantic relationship"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:SemanticModel ekpi:SemanticEntity ) ] ;
    rdfs:range ekpi:SemanticRelationship ;
    rdfs:comment "v2.0.0: instantiates the previously-orphan SemanticRelationship class."@en .

ekpi:hasSourceEntity a owl:ObjectProperty ;
    rdfs:label "has source entity"@en ;
    rdfs:domain ekpi:SemanticRelationship ; rdfs:range ekpi:SemanticEntity .

ekpi:hasTargetEntity a owl:ObjectProperty ;
    rdfs:label "has target entity"@en ;
    rdfs:domain ekpi:SemanticRelationship ; rdfs:range ekpi:SemanticEntity .

ekpi:mapsToBusinessTerm a owl:ObjectProperty ;
    rdfs:label "maps to business term"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:SemanticMeasure ekpi:SemanticAttribute ) ] ;
    rdfs:range ekpi:BusinessTerm .

ekpi:mappedByRule a owl:ObjectProperty ;
    rdfs:label "mapped by rule"@en ;
    rdfs:domain ekpi:SemanticAttribute ; rdfs:range ekpi:MappingRule .

ekpi:realizesKPI a owl:ObjectProperty ;
    rdfs:label "realizes KPI"@en ;
    rdfs:domain ekpi:SemanticMeasure ; rdfs:range ekpi:KPI ;
    rdfs:comment "States that a SemanticMeasure is the governed, physical-data-bound implementation of a KPI."@en .

### --- Consumption ---

ekpi:consumedBy a owl:ObjectProperty ;
    rdfs:label "consumed by"@en ;
    rdfs:domain [ owl:unionOf ( ekpi:SemanticMeasure ekpi:KPIDefinition ) ] ;
    rdfs:range ekpi:ConsumptionAsset .

ekpi:usedInUseCase a owl:ObjectProperty ;
    rdfs:label "used in use case"@en ;
    rdfs:domain ekpi:ConsumptionAsset ; rdfs:range ekpi:ConsumerUseCase .

### --- Governance ---

ekpi:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:range ekpi:BusinessOwner .

ekpi:stewardedBy a owl:ObjectProperty ;
    rdfs:label "stewarded by"@en ;
    rdfs:range ekpi:DataSteward ;
    rdfs:comment "Denormalized shortcut naming the CURRENT steward of an asset directly, for cheap querying. The authoritative, time-bound record of who was steward and for how long lives on the StewardshipAssignment reached via hasStewardshipAssignment — both are kept deliberately, not redundantly (see ontology review, Priority 2 item 5)."@en .

ekpi:hasStewardshipAssignment a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasGovernanceRecord ;
    rdfs:label "has stewardship assignment"@en ;
    rdfs:range ekpi:StewardshipAssignment .

ekpi:assignmentSteward a owl:ObjectProperty ;
    rdfs:label "assignment steward"@en ;
    rdfs:domain ekpi:StewardshipAssignment ; rdfs:range ekpi:DataSteward ;
    rdfs:comment "v2.0.0 fix: StewardshipAssignment individuals previously had no properties beyond a label. This property (plus assignmentStartDate/assignmentEndDate) now makes the assignment a real, queryable fact."@en .

ekpi:governedByPolicy a owl:ObjectProperty ;
    rdfs:label "governed by policy"@en ;
    rdfs:range ekpi:Policy .

ekpi:implementsStandard a owl:ObjectProperty ;
    rdfs:label "implements standard"@en ;
    rdfs:domain ekpi:Policy ; rdfs:range ekpi:Standard .

ekpi:enforcedByControl a owl:ObjectProperty ;
    rdfs:label "enforced by control"@en ;
    rdfs:domain ekpi:Standard ; rdfs:range ekpi:Control .

ekpi:hasCertificationStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf ekpi:hasGovernanceRecord ;
    rdfs:label "has certification status"@en ;
    rdfs:range ekpi:CertificationStatus ;
    rdfs:comment "Functional: a governed asset has exactly one current certification status."@en .

ekpi:hasVersion a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasGovernanceRecord ;
    rdfs:label "has version"@en ;
    rdfs:range ekpi:Version .

ekpi:approvedBy a owl:ObjectProperty ;
    rdfs:label "approved by"@en ;
    rdfs:domain ekpi:Version ; rdfs:range ekpi:ApprovalEvent .

ekpi:auditedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasGovernanceRecord ;
    rdfs:label "audited by"@en ;
    rdfs:range ekpi:AuditEvent .

ekpi:restrictedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf ekpi:hasGovernanceRecord ;
    rdfs:label "restricted by"@en ;
    rdfs:range ekpi:AccessRule .

