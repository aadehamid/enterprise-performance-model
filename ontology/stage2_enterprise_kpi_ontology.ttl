    ekpi:measuresKPI data:RackPriceCaptureRateKPI ;
    ekpi:hasObservedValue "96.2"^^xsd:decimal ;
    ekpi:hasUnitOfMeasure data:PercentUnit ;
    ekpi:observedForPeriod data:Day_20260731 ;
    ekpi:observedForDimensionValue data:BeaumontRackTerminal1, data:RBOBGasolineProduct ;
    ekpi:computedAgainstTarget data:Target_99pct_Q4FY26 ;
    ekpi:computedAgainstThreshold data:RedThreshold_97pct ;
    ekpi:hasObservationStatus data:ObsStatus_Breach .

### --- 7.D Lineage individuals — Chain A: realized revenue (RightAngle CTRM) ---

data:RightAngleCTRM a ekpi:OperationalSystem ;
    rdfs:label "RightAngle CTRM/ETRM"@en .

data:RightAngleTerminalBillingApp a ekpi:SourceApplication ;
    rdfs:label "RightAngle Terminal Billing"@en .

data:TerminalLiftingTxnTable a ekpi:SourceTable ;
    rdfs:label "TERMINAL_LIFTING_TXN"@en .

data:NetPricePerGalField a ekpi:SourceField ;
    rdfs:label "NET_PRICE_PER_GAL"@en ;
    ekpi:fieldName "NET_PRICE_PER_GAL" ;
    ekpi:originatesIn data:RightAngleCTRM .

data:RackLiftings_RawDataset a ekpi:RawLayerDataset ;
    rdfs:label "rack_liftings_raw"@en ;
    ekpi:datasetName "raw.rack_liftings" ;
    prov:wasDerivedFrom data:NetPricePerGalField .

data:RackLiftings_SilverDataset a ekpi:SilverLayerDataset ;
    rdfs:label "rack_liftings_silver"@en ;
    ekpi:datasetName "silver.rack_liftings" ;
    prov:wasDerivedFrom data:RackLiftings_RawDataset .

data:RackLiftings_GoldDataset a ekpi:GoldLayerDataset ;
    rdfs:label "rack_liftings_gold"@en ;
    ekpi:datasetName "gold.rack_liftings" ;
    prov:wasDerivedFrom data:RackLiftings_SilverDataset ;
    ekpi:feedsSemanticModel data:CommercialPricingSemanticModel ;
    ekpi:hasQualityRule data:NotNullNetPriceRule .

data:NotNullNetPriceRule a ekpi:DataQualityRule ;
    rdfs:label "Net Price Not Null"@en ;
    ekpi:ruleExpression "net_price_per_gal IS NOT NULL" .

data:RackLiftingsPipeline a ekpi:DataPipeline ;
    rdfs:label "Rack Liftings Medallion Pipeline"@en .

data:RackLiftings_RawToSilverStep a ekpi:TransformationStep ;
    rdfs:label "Rack Liftings Raw to Silver Cleanse Step"@en ;
    ekpi:partOfPipeline data:RackLiftingsPipeline ;
    prov:wasAssociatedWith data:RackLiftings_SilverDataset .

data:RackLiftings_SilverToGoldStep a ekpi:TransformationStep ;
    rdfs:label "Rack Liftings Silver to Gold Aggregation Step"@en ;
    ekpi:partOfPipeline data:RackLiftingsPipeline ;
    prov:wasAssociatedWith data:RackLiftings_GoldDataset .

data:RackLiftings_SilverDataset ekpi:transformedBy data:RackLiftings_RawToSilverStep .
data:RackLiftings_GoldDataset ekpi:transformedBy data:RackLiftings_SilverToGoldStep .

data:RackLiftingsGoldLoadRun_20260731 a ekpi:ProvenanceEvent ;
    rdfs:label "Rack Liftings Gold Load Run 2026-07-31"@en ;
    prov:generated data:RackLiftings_GoldDataset .

data:RackLiftings_GoldDataset prov:wasGeneratedBy data:RackLiftingsGoldLoadRun_20260731 .

### --- 7.E Lineage individuals — Chain B: published benchmark (OPIS) ---

data:OPISMarketDataService a ekpi:OperationalSystem ;
    rdfs:label "OPIS Market Data Service"@en .

data:OPISRackPriceFeedApp a ekpi:SourceApplication ;
    rdfs:label "OPIS Rack Price Feed"@en .

data:OPISRackPriceDailyTable a ekpi:SourceTable ;
    rdfs:label "OPIS_RACK_PRICE_DAILY"@en .

data:RackPriceUSDGalField a ekpi:SourceField ;
    rdfs:label "RACK_PRICE_USD_GAL"@en ;
    ekpi:fieldName "RACK_PRICE_USD_GAL" ;
    ekpi:originatesIn data:OPISMarketDataService .

data:OPISBenchmark_RawDataset a ekpi:RawLayerDataset ;
    rdfs:label "opis_rack_benchmark_raw"@en ;
    ekpi:datasetName "raw.opis_rack_benchmark" ;
    prov:wasDerivedFrom data:RackPriceUSDGalField .

data:OPISBenchmark_SilverDataset a ekpi:SilverLayerDataset ;
    rdfs:label "opis_rack_benchmark_silver"@en ;
    ekpi:datasetName "silver.opis_rack_benchmark" ;
    prov:wasDerivedFrom data:OPISBenchmark_RawDataset .

data:OPISBenchmark_GoldDataset a ekpi:GoldLayerDataset ;
    rdfs:label "opis_rack_benchmark_gold"@en ;
    ekpi:datasetName "gold.opis_rack_benchmark" ;
    prov:wasDerivedFrom data:OPISBenchmark_SilverDataset ;
    ekpi:feedsSemanticModel data:CommercialPricingSemanticModel ;
    ekpi:hasQualityRule data:RangeCheckBenchmarkRule .

data:RangeCheckBenchmarkRule a ekpi:DataQualityRule ;
    rdfs:label "Benchmark Price Range Check"@en ;
    ekpi:ruleExpression "rack_price_usd_gal BETWEEN 0.50 AND 6.00" .

data:RackPriceSheetDataProduct a ekpi:DataProduct ;
    rdfs:label "Rack Price Sheet"@en ;
    rdfs:comment "Packaged, owned data product wrapping the OPIS benchmark gold dataset for downstream consumption by pricing analysts and terminal systems."@en ;
    ekpi:wrapsDataset data:OPISBenchmark_GoldDataset .

### --- 7.F Semantic model individuals ---

data:EnterpriseSemanticLayer a ekpi:SemanticLayer ;
    rdfs:label "Enterprise BI Semantic Layer"@en .

data:CommercialPricingSemanticModel a ekpi:SemanticModel ;
    rdfs:label "Commercial Pricing Semantic Model"@en ;
    ekpi:hasSemanticEntity data:RackLoadingTransactionEntity, data:TerminalEntity, data:ProductEntity ;
    ekpi:hasSemanticMeasure data:RackPriceCaptureSemanticMeasure ;
    ekpi:hasSemanticRelationship data:RackLoading_OccursAt_Terminal, data:RackLoading_For_Product ;
    ekpi:restrictedBy data:CommercialPricingAccessRule .

data:RackLoadingTransactionEntity a ekpi:SemanticEntity ;
    rdfs:label "Rack Loading Transaction"@en ;
    ekpi:hasSemanticAttribute data:TerminalCodeAttribute, data:NetPriceAttribute .

data:TerminalEntity a ekpi:SemanticEntity ;
    rdfs:label "Terminal"@en .

data:ProductEntity a ekpi:SemanticEntity ;
    rdfs:label "Product"@en .

data:TerminalCodeAttribute a ekpi:SemanticAttribute ;
    rdfs:label "Terminal Code"@en ;
    ekpi:mappedByRule data:TerminalCodeMappingRule .

data:TerminalCodeMappingRule a ekpi:MappingRule ;
    rdfs:label "Terminal Code Mapping Rule"@en ;
    rdfs:comment "Maps semantic attribute RackLoadingTransaction.TerminalCode to gold.rack_liftings.terminal_id."@en .

data:NetPriceAttribute a ekpi:SemanticAttribute ;
    rdfs:label "Net Price Per Gallon"@en ;
    ekpi:mappedByRule data:NetPriceMappingRule .

data:NetPriceMappingRule a ekpi:MappingRule ;
    rdfs:label "Net Price Mapping Rule"@en ;
    rdfs:comment "Maps semantic attribute RackLoadingTransaction.NetPricePerGallon to gold.rack_liftings.net_price_per_gal."@en .

data:RackLoading_OccursAt_Terminal a ekpi:SemanticRelationship ;
    rdfs:label "Rack Loading occurs at Terminal"@en ;
    ekpi:hasSourceEntity data:RackLoadingTransactionEntity ;
    ekpi:hasTargetEntity data:TerminalEntity ;
    ekpi:relationshipType "occursAtTerminal" .

data:RackLoading_For_Product a ekpi:SemanticRelationship ;
    rdfs:label "Rack Loading is for Product"@en ;
    ekpi:hasSourceEntity data:RackLoadingTransactionEntity ;
    ekpi:hasTargetEntity data:ProductEntity ;
    ekpi:relationshipType "forProduct" .

data:RackPriceCaptureSemanticMeasure a ekpi:SemanticMeasure ;
    rdfs:label "Rack Price Capture Rate (Semantic Measure)"@en ;
    ekpi:mapsToBusinessTerm data:RackPriceCaptureBusinessTerm ;
    ekpi:realizesKPI data:RackPriceCaptureRateKPI ;
    ekpi:consumedBy data:CommercialPricingDashboard, data:CommercialMarginScorecard,
                     data:DailyRackReconciliationReport, data:RackPriceLeakageForecastModel .

data:RackPriceCaptureBusinessTerm a ekpi:BusinessTerm ;
    skos:prefLabel "Rack Price Capture Rate"@en ;
    skos:altLabel "Rack Margin Capture"@en, "Price Realization Rate"@en ;
    skos:definition "The share of the published rack benchmark price that a terminal actually realizes in rack revenue."@en .

### --- 7.G Consumption individuals ---

data:CommercialPricingDashboard a ekpi:Dashboard ;
    rdfs:label "Commercial Pricing Performance Dashboard"@en ;
    ekpi:usedInUseCase data:DailyCommercialPricingReview .

data:CommercialMarginScorecard a ekpi:Scorecard ;
    rdfs:label "Commercial Margin Scorecard"@en ;
    ekpi:usedInUseCase data:DailyCommercialPricingReview .

data:DailyRackReconciliationReport a ekpi:Report ;
    rdfs:label "Daily Rack Pricing Reconciliation Report"@en ;
    ekpi:usedInUseCase data:DailyCommercialPricingReview .

data:RackPriceLeakageForecastModel a ekpi:AnalyticalModel ;
    rdfs:label "Rack Price Leakage Forecast Model"@en ;
    rdfs:comment "Forecasts terminals/products at risk of rack price leakage using the certified semantic measure as input."@en ;
    ekpi:usedInUseCase data:DailyCommercialPricingReview .

data:DailyCommercialPricingReview a ekpi:ConsumerUseCase ;
    rdfs:label "Daily Commercial Pricing Review"@en .

### --- 7.H Governance individuals ---

data:CommercialPricingAccessRule a ekpi:AccessRule ;
    rdfs:label "Commercial Pricing Confidential Data Access Rule"@en ;
    rdfs:comment "Restricts view/edit of commercial pricing KPI definitions and semantic measures to the Commercial Pricing & Distribution Team and above."@en .

data:KPICertificationPolicy a ekpi:Policy ;
    rdfs:label "KPI Certification Policy"@en ;
    ekpi:implementsStandard data:KPINamingStandard .

data:KPINamingStandard a ekpi:Standard ;
    rdfs:label "KPI Naming Standard"@en ;
    ekpi:enforcedByControl data:KPICodeUniquenessControl .

data:KPICodeUniquenessControl a ekpi:Control ;
    rdfs:label "KPI Code Uniqueness Control"@en .

data:RackCaptureDef_Version1 a ekpi:Version ;
    rdfs:label "v1"@en ;
    ekpi:versionNumber "1" ;
    ekpi:versionDate "2026-07-15"^^xsd:date ;
    ekpi:approvedBy data:ApprovalEvent_20260715 .

data:ApprovalEvent_20260715 a ekpi:ApprovalEvent ;
    rdfs:label "Approval of v1"@en ;
    ekpi:eventTimestamp "2026-07-15T10:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith data:CommercialPricingManager .

data:AuditEvent_20260715 a ekpi:AuditEvent ;
    rdfs:label "Audit of v1 Approval"@en ;
    ekpi:eventTimestamp "2026-07-15T10:05:00"^^xsd:dateTime .

data:CommercialPricingStewardshipAssignment a ekpi:StewardshipAssignment ;
    rdfs:label "Commercial Data Steward Assignment for Rack Price Capture Rate"@en ;
    ekpi:assignmentSteward data:CommercialDataSteward ;
    ekpi:assignmentStartDate "2026-07-15"^^xsd:date .

